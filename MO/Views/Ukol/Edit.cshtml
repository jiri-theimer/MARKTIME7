@model UkolViewModel
@inject BL.Factory _f

@{
    var isFromUkoly = Model.Ret == "ukoly" && !string.IsNullOrEmpty(Model.RetD);
    var backLabel = isFromUkoly ? _f.tra("Zpět do přehledu úkolů") : _f.tra("Zpět");

    string backUrl;
    if (isFromUkoly)
    {
        backUrl = Model.RetD + "#task-" + Model.pid;
    }
    else if (Model.Ret == "week" && !string.IsNullOrEmpty(Model.RetD))
    {
        backUrl = Url.Action("Week", "Calendar", new { d = Model.RetD });
    }
    else if (Model.Ret == "day" && !string.IsNullOrEmpty(Model.RetD))
    {
        backUrl = Url.Action("Day", "Calendar", new { d = Model.RetD });
    }
    else
    {
        backUrl = Url.Action("Tasks", "Home");
    }
}

<div class="grid gap-3">

    <div class="flex items-center justify-between">
        <a href="@backUrl" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">arrow_back</span>
            @backLabel
        </a>
    </div>

    @if (Model.pid > 0)
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-3 gap-1">
                <div class="flex items-start justify-between gap-2">
                    <div class="font-bold text-base" style="overflow-wrap:break-word;">@Model.Name</div>
                    @if (!string.IsNullOrEmpty(Model.WorkflowStatusName))
                    {
                        <div class="badge badge-sm badge-outline gap-1.5 shrink-0">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background-color:@Model.WorkflowStatusColor;flex-shrink:0;"></span>
                            @Model.WorkflowStatusName
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.ProjectDisplay))
                {
                    <div class="text-xs text-base-content/50">@Model.ProjectDisplay</div>
                }
                <div class="text-xs text-base-content/50">
                    @Model.TaskType @(!string.IsNullOrEmpty(Model.Owner) ? " · " + _f.tra("Vlastník") + ": " + Model.Owner : "")
                </div>
            </div>
        </div>

        @if (Model.IsReadOnly)
        {
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-3 gap-2">
                    @if (!string.IsNullOrEmpty(Model.PlanFrom))
                    {
                        <div>
                            <div class="text-xs text-base-content/50">@_f.tra("Plánované zahájení úkolu")</div>
                            <div>@DateTime.Parse(Model.PlanFrom).ToString("d. M. yyyy")</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PlanUntil))
                    {
                        <div>
                            <div class="text-xs text-base-content/50">@_f.tra("Termín (plánované dokončení)")</div>
                            <div>@DateTime.Parse(Model.PlanUntil).ToString("d. M. yyyy")</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notepad))
                    {
                        <div>
                            <div class="text-xs text-base-content/50">@_f.tra("Poznámka")</div>
                            <div style="white-space:pre-wrap;">@Model.Notepad</div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <form method="post" asp-action="Edit">
                <input type="hidden" asp-for="pid" />
                <input type="hidden" asp-for="Ret" />
                <input type="hidden" asp-for="RetD" />

                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body p-3 gap-2">

                        <label class="form-control">
                            <div class="label"><span class="label-text font-semibold">@_f.tra("Název") *</span></div>
                            <input asp-for="Name" class="input input-bordered w-full" autocapitalize="sentences" />
                        </label>

                        <label class="form-control">
                            <div class="label"><span class="label-text font-semibold">@_f.tra("Stav")</span></div>
                            <select asp-for="TargetB02ID" class="select select-bordered w-full">
                                @foreach (var s in Model.StatusOptions)
                                {
                                    <option value="@s.Id" selected="@(s.Id == Model.TargetB02ID)">@s.Text</option>
                                }
                            </select>
                        </label>

                        <div class="grid grid-cols-2 gap-2">
                            <label class="form-control">
                                <div class="label"><span class="label-text">@_f.tra("Plánované zahájení úkolu")</span></div>
                                <input type="date" asp-for="PlanFrom" class="input input-bordered input-sm w-full" />
                            </label>
                            <label class="form-control">
                                <div class="label"><span class="label-text">@_f.tra("Termín (plánované dokončení)")</span></div>
                                <input type="date" asp-for="PlanUntil" class="input input-bordered input-sm w-full" />
                            </label>
                        </div>

                        <label class="form-control">
                            <div class="label"><span class="label-text font-semibold">@_f.tra("Poznámka")</span></div>
                            <textarea asp-for="Notepad" class="textarea textarea-bordered w-full" rows="4"
                                      autocapitalize="sentences"></textarea>
                        </label>

                    </div>
                </div>

                <div class="grid gap-2 mt-3">
                    <button type="submit" class="btn btn-success btn-block">
                        <span class="material-icons-outlined" style="font-size:20px;">check</span>
                        @_f.tra("Uložit")
                    </button>

                    @if (Model.p41ID > 0)
                    {
                        <a asp-controller="Ukon" asp-action="New" asp-route-p41id="@Model.p41ID" asp-route-p56id="@Model.pid"
                           class="btn btn-ghost btn-block">
                            <span class="material-icons-outlined" style="font-size:18px;">schedule</span>
                            @_f.tra("Vykázat úkon")
                        </a>
                    }

                    <a href="@backUrl" class="btn btn-ghost btn-block">@backLabel</a>
                </div>
            </form>
        }
    }

</div>