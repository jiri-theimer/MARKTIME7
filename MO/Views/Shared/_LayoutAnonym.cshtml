@model BaseViewModel
@inject BL.Factory _f
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@(string.IsNullOrEmpty(Model?.PageTitle) ? "MARKtime" : Model.PageTitle + " — MARKtime")</title>

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />

    <link rel="icon" href="~/favicon.ico" />
    @RenderSection("header_content", required: false)
</head>
<body class="min-h-screen bg-base-200 flex flex-col" style="overflow-x:hidden;">

    <header class="navbar bg-base-100 shadow-sm">
        <div class="flex-1 px-2 gap-1">
            <img src="~/images/logo.png" alt="MARKtime" class="h-7 w-auto" />
            <span class="badge badge-warning badge-sm">BETA</span>
        </div>
    </header>

    <main class="flex-1 px-3 pt-6 pb-12 flex items-start justify-center">
        <div class="w-full max-w-md">
            @{
                var _bvm = Model as MO.Models.BaseViewModel;
                var _msg = _bvm?.Message ?? TempData["Message"]?.ToString();
                var _msgSuccess = _bvm?.MessageSuccess ?? TempData["MessageSuccess"]?.ToString();
            }
            @if (!string.IsNullOrEmpty(_msgSuccess))
            {
                <div role="alert" class="alert alert-success mb-3">
                    <span class="material-icons-outlined">check_circle</span>
                    <span>@_msgSuccess</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(_msg))
            {
                <div role="alert" class="alert alert-error mb-3">
                    <span class="material-icons-outlined">error_outline</span>
                    <span>@Html.Raw(_msg)</span>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>