@model BaseViewModel
@inject BL.Factory _f
@{
    var activeAction = (string)ViewContext.RouteData.Values["action"] ?? "";
    var activeController = (string)ViewContext.RouteData.Values["controller"] ?? "";

    // Pomocná funkce pro označení aktivní položky docku (pro CSS třídu .dock-active)
    string IsActive(params string[] actions)
    {
        return actions.Any(a => string.Equals(a, activeAction, StringComparison.OrdinalIgnoreCase))
            ? "dock-active"
            : "";
    }

    // Kalendář: akce "Index" koliduje s Home/Index, proto tady kontrolujeme i controller.
    // Přidání/editace úkonu (Ukon/New, Ukon/Edit, Ukon/Copy) se otevírá z kalendáře, takže i tam
    // má dock položka "Kalendář" zůstat zvýrazněná.
    var isCalendarActive =
        (string.Equals(activeController, "Calendar", StringComparison.OrdinalIgnoreCase)
            && new[] { "Index", "Day", "Week", "ToggleWeekend" }.Any(a => string.Equals(a, activeAction, StringComparison.OrdinalIgnoreCase)))
        || (string.Equals(activeController, "Ukon", StringComparison.OrdinalIgnoreCase)
            && new[] { "New", "Edit", "Copy" }.Any(a => string.Equals(a, activeAction, StringComparison.OrdinalIgnoreCase)));

    // Ukony filtrované podle formátu (Hodiny/Peníze/Kusovník) - všechny tři vedou na stejnou akci,
    // rozlišit aktivní položku jde jen podle query parametru "format".
    string IsUkonyFormatActive(string formatValue)
    {
        if (!string.Equals(activeController, "Home", StringComparison.OrdinalIgnoreCase)) return "";
        if (!string.Equals(activeAction, "Ukony", StringComparison.OrdinalIgnoreCase)) return "";
        var currentFormat = Context.Request.Query["format"].ToString();
        return string.Equals(currentFormat, formatValue) ? "dock-active" : "";
    }

    // Zda uživateli právě běží nějaké stopky - pro vizuální indikaci ikony v navbaru
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var hasRunningStopwatch = isAuthenticated && _f.CurrentUser != null
        && _f.p68StopWatchBL.GetList(_f.CurrentUser.pid).Any(p => p.p68IsRunning);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@(string.IsNullOrEmpty(Model?.PageTitle) ? "MARKtime" : Model.PageTitle + " — MARKtime")</title>

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/p31status.css" asp-append-version="true" />

    <link rel="icon" href="~/favicon.ico" />

    @* ===== PWA ===== *@
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MARKtime" />
    <meta name="mobile-web-app-capable" content="yes" />

    <style>
            @@keyframes stopkyPulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(220,38,38,.6);
                }

                70% {
                    box-shadow: 0 0 0 6px rgba(220,38,38,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(220,38,38,0);
                }
            }

            .stopky-live-dot {
                position: absolute;
                top: 6px;
                right: 6px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #dc2626;
                animation: stopkyPulse 1.6s infinite;
            }

            /* Sbalovací sekce (<details>/<summary>) se šipkou vpravo - sdíleno napříč MO */
            .mo-details-summary {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: .5rem;
            }

            .mo-details-chevron {
                transition: transform .15s ease;
                flex-shrink: 0;
            }

            details[open] > .mo-details-summary .mo-details-chevron {
                transform: rotate(180deg);
            }

            /* .btn-success chybí ve staticky zkompilovaném app.css - definice zrcadlí přesně
                                   stejný vzorec, jaký DaisyUI používá pro .btn-primary (--btn-color/--btn-fg). */
            .btn-success {
                --btn-color: var(--color-success);
                --btn-fg: var(--color-success-content);
            }

            /* mycombo - ruční oprava přetékání dlouhého (50+ znaků) textu mimo šířku obrazovky.
                           Psáno jako čisté CSS s !important, aby to nezáviselo na tom, co je (ne)aktuálně
                           ve staticky zkompilovaném app.css, a spolehlivě to přebilo Tailwind/DaisyUI třídy. */
            #ukonForm,
            #ukonForm .card,
            #ukonForm .card-body,
            #ukonForm label {
                min-width: 0 !important;
            }

            .mc-wrap {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                box-sizing: border-box !important;
            }

                .mc-wrap > button {
                    display: flex !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    min-width: 0 !important;
                    box-sizing: border-box !important;
                }

            .mc-trigger-text {
                display: block !important;
                flex: 1 1 auto !important;
                min-width: 0 !important;
                max-width: 100% !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
            }

            .mc-item .flex {
                min-width: 0 !important;
            }

            .mc-item .font-medium {
                min-width: 0 !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
            }

            /* Neurčitý loading overlay (např. nahrávání přílohy) */
            #mo-upload-overlay {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 9999;
                background: rgba(0,0,0,.55);
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 1rem;
                color: #fff;
            }

                #mo-upload-overlay.open {
                    display: flex;
                }

            #mo-upload-spinner {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                border: 4px solid rgba(255,255,255,.3);
                border-top-color: #fff;
                animation: moSpin .8s linear infinite;
            }

            @@keyframes moSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* Drawer (menu "Více") - zkompilované CSS používá moderní allow-discrete/@@starting-style
                                   přechod pro visibility/opacity, který u některých (hlavně mobilních) prohlížečů při
                                   prvním otevření po načtení stránky nesprávně vůbec nezobrazí panel - až po dalším
                                   překreslení. Vypnutím přechodu se panel zobrazí okamžitě, bez animace, ale spolehlivě. */
            .drawer-side {
                transition: none !important;
            }

            /* Drawer řízený přímo přes JS třídu (viz moOpenDrawer/moCloseDrawer) - nezávisí na
                                   CSS :checked triku, který se na některých zařízeních ukázal jako nespolehlivý. */
            #mo-drawer-side {
                /* Vynutit pozici a rozměry přes position:fixed, nezávisle na CSS grid mechanismu
                                       (.drawer/.drawer-end), který se u některých prohlížečů při úplně prvním
                                       vykreslení stránky uplatnil nesprávně (panel se objevil vlevo). Overlay a
                                       samotný panel (aside) se pozicují každý zvlášť, ať to nezávisí na flex/grid. */
                position: fixed !important;
                inset: 0 !important;
                width: 100% !important;
                height: 100dvh !important;
            }

                #mo-drawer-side .drawer-overlay {
                    position: fixed !important;
                    inset: 0 !important;
                }

                #mo-drawer-side > aside {
                    position: fixed !important;
                    top: 0 !important;
                    right: 0 !important;
                    left: auto !important;
                    height: 100dvh !important;
                    translate: 0 !important;
                    transform: none !important;
                    transition: none !important;
                }

                #mo-drawer-side.mo-open {
                    visibility: visible !important;
                    opacity: 1 !important;
                    pointer-events: auto !important;
                }

                    #mo-drawer-side.mo-open > *:not(.drawer-overlay) {
                        translate: 0 !important;
                        transform: none !important;
                    }
    </style>

    @* Nastavit skin ihned, ještě před vykreslením - žádné probliknutí *@
    <script>
            (function () {
                try {
                    var t = localStorage.getItem('mo-theme') || 'light';
                    document.documentElement.setAttribute('data-theme', t);
                } catch (e) { }
            })();
    </script>
</head>
<body class="min-h-screen bg-base-200" style="overflow-x:hidden;">

    @* Drawer "Více" - řízeno přímo přes JS třídu (ne přes CSS :checked trik), inline skript
       přímo v layoutu (ne v cachovaném externím souboru), aby fungovalo spolehlivě i při
       problémech s načítáním/cachováním externích JS souborů. *@
    <script>
            function moOpenDrawer(e) {
                if (e) e.preventDefault();
                var side = document.getElementById('mo-drawer-side');
                if (side) side.classList.add('mo-open');
                var cb = document.getElementById('mo-drawer');
                if (cb) cb.checked = true;
            }
            function moCloseDrawer(e) {
                if (e) e.preventDefault();
                var side = document.getElementById('mo-drawer-side');
                if (side) side.classList.remove('mo-open');
                var cb = document.getElementById('mo-drawer');
                if (cb) cb.checked = false;
            }
    </script>

    @* Neurčitý loading overlay - použití: moShowUploadOverlay('Nahrávám přílohu...') *@
    <div id="mo-upload-overlay">
        <div id="mo-upload-spinner"></div>
        <div id="mo-upload-overlay-text"></div>
    </div>

    <div class="drawer drawer-end">
        <input id="mo-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col min-h-screen">

            @* ===== Top navbar ===== *@
            <header class="navbar bg-base-100 shadow-sm sticky top-0 z-30">
                <div class="flex-1">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-ghost px-2 normal-case gap-1">
                        <img src="~/images/logo.png" alt="MARKtime" class="h-7 w-auto" />

                    </a>
                </div>

                <div class="flex-none gap-2">
                    @if (isAuthenticated)
                    {
                        <a asp-controller="Ukon" asp-action="QuickAdd" class="btn btn-ghost btn-sm btn-circle" title="@_f.tra("Nový úkon")">
                            <span class="material-icons-outlined" style="font-size:22px;">add</span>
                        </a>
                        <a asp-controller="Stopky" asp-action="Index" class="btn btn-ghost btn-sm btn-circle" style="position:relative;" title="@_f.tra("Stopky")">
                            <span class="material-icons-outlined @(hasRunningStopwatch ? "text-primary" : "")" style="font-size:20px;">history_toggle_off</span>
                            @if (hasRunningStopwatch)
                            {
                                <span class="stopky-live-dot"></span>
                            }
                        </a>
                    }

                    @* Theme switcher (light/dark) - DaisyUI theme-controller *@
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm">
                            <span class="material-icons-outlined" style="font-size:18px;">palette</span>
                        </div>
                        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-40 w-32 p-2 shadow">
                            <li>
                                <label class="flex gap-2 cursor-pointer">
                                    <input type="radio" name="theme-dropdown"
                                           class="theme-controller"
                                           aria-label="Light" value="light"
                                           onchange="moSetTheme('light')" />
                                    <span>@_f.tra("Light")</span>
                                </label>
                            </li>
                            <li>
                                <label class="flex gap-2 cursor-pointer">
                                    <input type="radio" name="theme-dropdown"
                                           class="theme-controller"
                                           aria-label="Dark" value="dark"
                                           onchange="moSetTheme('dark')" />
                                    <span>@_f.tra("Dark")</span>
                                </label>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>


            @* ===== Hlavní obsah ===== *@
            <main class="flex-1 px-3 pt-3 pb-24">
                @* pb-24 dělá místo pro dock *@
                @if (!string.IsNullOrEmpty(Model?.PageTitle) && Model?.HideHeaderTitle != true)
                {
                    <h1 class="text-2xl font-bold mb-3">@Model.PageTitle</h1>
                }

                @* Centrální zobrazení zpráv — z BaseViewModel.Message nebo TempData (po redirectu) *@
                @{
                    var _bvm = Model as MO.Models.BaseViewModel;
                    var _msg = _bvm?.Message ?? TempData["Message"]?.ToString();
                    var _msgSuccess = _bvm?.MessageSuccess ?? TempData["MessageSuccess"]?.ToString();
                }
                @if (!string.IsNullOrEmpty(_msgSuccess))
                {
                    <div role="alert" class="alert alert-success mb-3">
                        <span class="material-icons-outlined">check_circle</span>
                        <span>@_msgSuccess</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_msg))
                {
                    <div role="alert" class="alert alert-error mb-3">
                        <span class="material-icons-outlined">error_outline</span>
                        <span>@Html.Raw(_msg)</span>
                    </div>
                }

                @* Messages4Notify — BL notifikační zprávy (Key: "error" nebo "info") *@
                @if (_f.CurrentUser?.Messages4Notify != null)
                {
                    @foreach (var c in _f.CurrentUser.Messages4Notify)
                    {
                        var _notifyCls = c.Key == "info" ? "alert-info" : "alert-error";
                        var _notifyIcon = c.Key == "info" ? "info" : "error_outline";
                        <div role="alert" class="alert @_notifyCls mb-2">
                            <span class="material-icons-outlined">@_notifyIcon</span>
                            <span>@Html.Raw(c.Value)</span>
                        </div>
                    }
                }

                @RenderBody()
            </main>


            @* ===== Bottom dock ===== *@
            <nav class="dock dock-sm bg-base-100 border-t border-base-300"
                 style="padding-bottom: env(safe-area-inset-bottom);">

                <a asp-controller="Calendar" asp-action="Index" data-mo-cal-link class="@(isCalendarActive ? "dock-active" : "")">
                    <span class="material-icons-outlined" style="font-size:22px;">today</span>
                    <span class="dock-label">@_f.tra("Kalendář")</span>
                </a>

                <a asp-controller="Home" asp-action="Ukony" asp-route-format="1" class="@IsUkonyFormatActive("1")">
                    <span class="material-icons-outlined" style="font-size:22px;">schedule</span>
                    <span class="dock-label">@_f.tra("Hodiny")</span>
                </a>

                <a asp-controller="Home" asp-action="Ukony" asp-route-format="2" class="@IsUkonyFormatActive("2")">
                    <span class="material-icons-outlined" style="font-size:22px;">payments</span>
                    <span class="dock-label">@_f.tra("Peníze")</span>
                </a>

                <a asp-controller="Home" asp-action="Ukony" asp-route-format="3" class="@IsUkonyFormatActive("3")">
                    <span class="material-icons-outlined" style="font-size:22px;">inventory_2</span>
                    <span class="dock-label">@_f.tra("Kusovník")</span>
                </a>

                <a asp-controller="Home" asp-action="Tasks" class="@IsActive("Tasks")">
                    <span class="material-icons-outlined" style="font-size:22px;">task_alt</span>
                    <span class="dock-label">@_f.tra("Úkoly")</span>
                </a>

                @* Více otevře pravý drawer - onclick navíc k label/checkbox mechanismu, ať to
                   funguje spolehlivě i kdyby checkbox trik selhal *@
                <label for="mo-drawer" class="cursor-pointer" onclick="moOpenDrawer(event)">
                    <span class="material-icons-outlined" style="font-size:22px;">menu</span>
                    <span class="dock-label">@_f.tra("Více")</span>
                </label>

            </nav>
        </div>

        @* ===== Drawer "Více" (pravý panel) ===== *@
        <div class="drawer-side z-50" id="mo-drawer-side">
            <label for="mo-drawer" aria-label="close sidebar" class="drawer-overlay" onclick="moCloseDrawer(event)"></label>

            <aside class="bg-base-100 min-h-full w-72 p-4">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-bold">@_f.tra("Více")</h2>
                    <label for="mo-drawer" class="btn btn-ghost btn-sm btn-circle" onclick="moCloseDrawer(event)">
                        <span class="material-icons-outlined" style="font-size:20px;">close</span>
                    </label>
                </div>

                <ul class="menu menu-lg gap-1 p-0">
                    <li>
                        <a asp-controller="Home" asp-action="MyProfile" class="@IsActive("MyProfile")">
                            <span class="material-icons-outlined" style="font-size:20px;">person</span>
                            @_f.tra("Profil")
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Stopky" asp-action="Index" class="@IsActive("Stopky")">
                            <span class="material-icons-outlined" style="font-size:20px;">history_toggle_off</span>
                            @_f.tra("Stopky")
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Settings" class="@IsActive("Settings")">
                            <span class="material-icons-outlined" style="font-size:20px;">settings</span>
                            @_f.tra("Nastavení")
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Help" class="@IsActive("Help")">
                            <span class="material-icons-outlined" style="font-size:20px;">help_outline</span>
                            @_f.tra("Nápověda")
                        </a>
                    </li>
                </ul>

                @if (isAuthenticated)
                {
                    <ul class="menu menu-lg gap-1 p-0 mt-2 pt-2 border-t border-base-300">
                        <li>
                            <a asp-controller="Home" asp-action="Logout" style="color:var(--color-error,#dc2626);">
                                <span class="material-icons-outlined" style="font-size:20px;">logout</span>
                                @_f.tra("Odhlásit")
                            </a>
                        </li>
                    </ul>
                }

                <div class="mt-6 pt-4 border-t border-base-300 text-xs text-base-content/50">
                    @_f.tra("Verze") @_f.App.AppBuild
                </div>
            </aside>
        </div>

    </div>

    <script src="~/js/mo-prefs.js" asp-append-version="true"></script>
    <script src="~/js/mo-upload-overlay.js" asp-append-version="true"></script>
    <script src="~/js/mo-double-submit-guard.js" asp-append-version="true"></script>
    <script src="~/js/mo-sw-register.js" asp-append-version="true"></script>

    @await RenderSectionAsync("scripts", required: false)

    <script src="~/js/mycombo.js" asp-append-version="true"></script>
</body>
</html>