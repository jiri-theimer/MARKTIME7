@model EntryViewModel
@inject BL.Factory _f

@{
    var isNew = Model.pid == 0;
    var dayUrl = Url.Action("Day", "Calendar", new { d = Model.Date.ToString("yyyy-MM-dd") });
}

<div class="grid gap-3">

    @* Header *@
    <div class="flex items-center justify-between">
        <a href="@dayUrl" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">arrow_back</span>
            @_f.tra("Zpět")
        </a>
        <div class="text-sm text-base-content/60">
            @Model.Date.ToString("d. MMMM yyyy")
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div role="alert" class="alert alert-error">
            <span class="material-icons-outlined">error_outline</span>
            <span>@Model.Message</span>
        </div>
    }

    <form method="post" asp-action="Save">
        <input type="hidden" asp-for="pid" />
        <input type="hidden" asp-for="Date" />

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body gap-3">

                @* Projekt - povinný *@
                <label class="form-control">
                    <div class="label">
                        <span class="label-text font-semibold">@_f.tra("Projekt") *</span>
                    </div>
                    <mycombo asp-for="p41ID"
                             selected-text="@Model.SelectedProjectText"
                             items="@Model.ProjectComboItems"
                             placeholder="@_f.tra("Vyberte projekt")"
                             event-after-change="loadTasksForProject" />
                </label>

                @* Úkol - volitelný, populated podle projektu *@
                <label class="form-control">
                    <div class="label">
                        <span class="label-text font-semibold">@_f.tra("Úkol")</span>
                        <span class="label-text-alt text-base-content/50">@_f.tra("volitelně")</span>
                    </div>
                    <select asp-for="p56ID" id="p56ID" class="select select-bordered w-full">
                        <option value="0">— @_f.tra("bez úkolu") —</option>
                        @foreach (var t in Model.TaskList)
                        {
                            <option value="@t.pid" selected="@(t.pid == Model.p56ID)">
                                @t.p56Name
                            </option>
                        }
                    </select>
                </label>

                @* Hodiny - povinné *@
                <label class="form-control">
                    <div class="label">
                        <span class="label-text font-semibold">@_f.tra("Hodiny") *</span>
                        <span class="label-text-alt text-base-content/50">např. 1.5 nebo 01:30</span>
                    </div>
                    <input asp-for="Hours"
                           class="input input-bordered w-full"
                           inputmode="decimal"
                           autocomplete="off"
                           enterkeyhint="next"
                           placeholder="0" />
                </label>

                @* Čas od - do, volitelné *@
                <div class="grid grid-cols-2 gap-2">
                    <label class="form-control">
                        <div class="label">
                            <span class="label-text">@_f.tra("Čas od")</span>
                        </div>
                        <input asp-for="TimeFrom" type="time"
                               class="input input-bordered w-full" />
                    </label>
                    <label class="form-control">
                        <div class="label">
                            <span class="label-text">@_f.tra("Čas do")</span>
                        </div>
                        <input asp-for="TimeUntil" type="time"
                               class="input input-bordered w-full" />
                    </label>
                </div>

                @* Popis - povinný *@
                <label class="form-control">
                    <div class="label">
                        <span class="label-text font-semibold">@_f.tra("Popis") *</span>
                    </div>
                    <textarea asp-for="Description"
                              class="textarea textarea-bordered w-full"
                              rows="3"
                              autocapitalize="sentences"></textarea>
                </label>

            </div>
        </div>

        <div class="grid gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-block">
                <span class="material-icons-outlined" style="font-size:20px;">check</span>
                @_f.tra("Uložit")
            </button>

            @if (!isNew)
            {
                <button type="submit" formaction="@Url.Action("Delete", new { id = Model.pid, d = Model.Date.ToString("yyyy-MM-dd") })"
                        class="btn btn-error btn-outline btn-block"
                        onclick="return confirm('@_f.tra("Opravdu smazat tento úkon?")');">
                    <span class="material-icons-outlined" style="font-size:20px;">delete</span>
                    @_f.tra("Smazat")
                </button>
            }

            <a href="@dayUrl" class="btn btn-ghost btn-block">@_f.tra("Storno")</a>
        </div>
    </form>

</div>

@section scripts {
    <script>
        // Po výběru projektu načti úkoly přes AJAX
        async function loadTasksForProject(p41id) {
            const sel = document.getElementById('p56ID');
            sel.innerHTML = '<option value="0">— načítám —</option>';

            if (!p41id || p41id == '0') {
                sel.innerHTML = '<option value="0">— bez úkolu —</option>';
                return;
            }

            try {
                const resp = await fetch('@Url.Action("TasksForProject")?p41id=' + encodeURIComponent(p41id));
                const tasks = await resp.json();

                let html = '<option value="0">— bez úkolu —</option>';
                tasks.forEach(t => {
                    html += `<option value="${t.pid}">${escapeHtml(t.name)}</option>`;
                });
                sel.innerHTML = html;
            } catch (e) {
                sel.innerHTML = '<option value="0">— bez úkolu —</option>';
            }
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));
        }
    </script>
}
