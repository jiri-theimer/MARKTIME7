@model DayViewModel
@inject BL.Factory _f

@{
    var monthAnchor = new DateTime(Model.Date.Year, Model.Date.Month, 1).ToString("yyyy-MM-01");
    var weekAnchor = BO.Code.Bas.get_first_prev_monday(Model.Date).ToString("yyyy-MM-dd");
    var prevDay = Model.Date.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDay = Model.Date.AddDays(1).ToString("yyyy-MM-dd");
}

<div class="grid gap-3">

    @* Top: zpět + prev/next den *@
    <div class="flex items-center justify-between gap-2">
        <a id="backLink" href="@Url.Action("Index", "Calendar", new { d = monthAnchor })"
           data-month-href="@Url.Action("Index", "Calendar", new { d = monthAnchor })"
           data-week-href="@Url.Action("Week", "Calendar", new { d = weekAnchor })"
           data-month-label="@_f.tra("Měsíc")"
           data-week-label="@_f.tra("Týden agenda")"
           class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">arrow_back</span>
            <span id="backLinkLabel">@_f.tra("Měsíc")</span>
        </a>

        <div class="flex gap-1">
            <a asp-controller="Stopky" asp-action="Index" class="btn btn-ghost btn-sm" title="@_f.tra("Stopky")">
                <span class="material-icons-outlined" style="font-size:20px;">history_toggle_off</span>
            </a>
            <a asp-action="Day" asp-route-d="@prevDay" class="btn btn-ghost btn-sm">
                <span class="material-icons-outlined" style="font-size:20px;">chevron_left</span>
            </a>
            <a asp-action="Day" asp-route-d="@nextDay" class="btn btn-ghost btn-sm">
                <span class="material-icons-outlined" style="font-size:20px;">chevron_right</span>
            </a>
        </div>
    </div>

    @* Header karta s datem a souhrnem *@
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs uppercase text-base-content/60">@Model.DayName</div>
                    <div class="text-2xl font-bold">@Model.Date.ToString("d. MMMM yyyy")</div>
                </div>
                <div class="text-right">
                    <div class="text-xs text-base-content/60">@_f.tra("Celkem")</div>
                    <div class="text-2xl font-bold @(Model.TotalHours > 0 ? "text-primary" : "")">
                        @MO.Code.HoursFormat.Show(Model.TotalHours, _f)
                    </div>
                </div>
            </div>
            @if (Model.IsHoliday)
            {
                <div class="badge badge-error badge-outline mt-2">
                    <span class="material-icons-outlined" style="font-size:14px;">event_busy</span>
                    @Model.HolidayName
                </div>
            }
        </div>
    </div>

    @* Úkoly s termínem tento den *@
    @if (Model.TasksDue.Count > 0)
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-3 gap-1">
                <div class="text-xs uppercase text-base-content/50 font-semibold">
                    @_f.tra("Úkoly s termínem")
                </div>
                @foreach (var task in Model.TasksDue)
                {
                    <a asp-controller="Ukol" asp-action="Edit" asp-route-id="@task.pid"
                       asp-route-ret="day" asp-route-retd="@Model.Date.ToString("yyyy-MM-dd")"
                       class="flex items-center gap-2 text-sm px-2 py-1.5 rounded bg-warning/10 hover:bg-warning/20 transition">
                        <span class="material-icons-outlined text-warning" style="font-size:16px;">task_alt</span>
                        <div class="min-w-0 flex-1">
                            <div class="truncate">@task.p56Name</div>
                            @if (!string.IsNullOrEmpty(task.p41Name))
                            {
                                <div class="text-xs text-base-content/50 truncate">@task.p41Name</div>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    @* Kalendářové termíny (o22Milestone) tento den - jen pro čtení *@
    @if (Model.Milestones.Count > 0)
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-3 gap-1">
                <div class="text-xs uppercase text-base-content/50 font-semibold">
                    @_f.tra("Termíny")
                </div>
                @foreach (var m in Model.Milestones)
                {
                    <div class="flex items-center gap-2 text-sm px-2 py-1.5 rounded bg-info/10">
                        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background-color:@m.o21Color;flex-shrink:0;"></span>
                        <div class="min-w-0 flex-1">
                            <div class="truncate">@m.o22Name</div>
                            @if (!string.IsNullOrEmpty(m.p41Name))
                            {
                                <div class="text-xs text-base-content/50 truncate">@m.ProjectWithClient</div>
                            }
                        </div>
                        @if (!m.o22IsAllDay && m.o22PlanFrom.HasValue)
                        {
                            <div class="text-xs text-base-content/50 shrink-0">@m.o22PlanFrom.Value.ToString("HH:mm")</div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* Seznam úkonů *@
    @if (!Model.Entries.Any())
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center py-8">
                <span class="material-icons-outlined text-base-content/30" style="font-size:48px;">
                    receipt_long
                </span>
                <div class="text-base-content/60">@_f.tra("Žádné úkony za tento den.")</div>
            </div>
        </div>
    }
    else
    {
        var _pids = Model.Entries.Select(e => e.pid).ToHashSet();
        // Kusovníkové úkony navázané přes p31MasterID na jiný (viditelný) úkon dne se nezobrazují
        // jako samostatná karta, ale vypíšou se pod svým "mistrem".
        var _topLevel = Model.Entries.Where(e => e.p31MasterID == 0 || !_pids.Contains(e.p31MasterID));

        @foreach (var entry in _topLevel)
        {
            var _trCls = MO.Code.TheGridRowSymbol.p31_tr_cssclass(entry) ?? "";
            var _symbol = MO.Code.TheGridRowSymbol.p31_symbol(entry);
            var _children = entry.p33ID == BO.p33IdENUM.Cas
                ? Model.Entries.Where(e => e.p31MasterID == entry.pid).ToList()
                : new List<BO.p31Worksheet>();
            <div id="entry-@entry.pid" class="card bg-base-100 shadow-sm hover:bg-base-300 transition @_trCls">
                <div class="card-body p-3">
                    <div class="flex items-start gap-2">

                        @* Klikatelná oblast pro editaci *@
                        <a asp-controller="Ukon" asp-action="Edit" asp-route-id="@entry.pid"
                           class="min-w-0 flex-1 block">
                            <div class="font-semibold text-sm" style="overflow-wrap:break-word;">@entry.Project</div>
                            @if (!string.IsNullOrEmpty(entry.p32Name))
                            {
                                <div class="text-xs text-base-content/50">@entry.p32Name</div>
                            }
                            <div class="text-sm text-base-content/80" style="white-space:pre-wrap;">@entry.p31Text</div>
                            @if (entry.p31DateTimeFrom_Orig.HasValue && entry.p31DateTimeUntil_Orig.HasValue)
                            {
                                <div class="text-xs text-base-content/60 mt-1">
                                    @entry.p31DateTimeFrom_Orig.Value.ToString("HH:mm") –
                                    @entry.p31DateTimeUntil_Orig.Value.ToString("HH:mm")
                                </div>
                            }
                        </a>

                        @* Pravý sloupec: symbol + hodiny/částka/kusy + kopírovat *@
                        <div class="flex flex-col items-end gap-1 shrink-0">
                            @if (!string.IsNullOrEmpty(_symbol))
                            {
                                <div>@Html.Raw(_symbol)</div>
                            }
                            <div class="font-bold text-primary text-sm">
                                @if (entry.p33ID == BO.p33IdENUM.PenizeBezDPH || entry.p33ID == BO.p33IdENUM.PenizeVcDPHRozpisu)
                                {
                                    @(MO.Code.AmountFormat.Thousands(entry.p31Amount_WithoutVat_Orig)) @entry.j27Code_Billing_Orig
                                }
                                else if (entry.p33ID == BO.p33IdENUM.Kusovnik)
                                {
                                    @(entry.p31Value_Orig.ToString("0.##")) <text>@_f.tra("ks")</text>
                                }
                                else
                                {
                                    @MO.Code.HoursFormat.Show(entry.p31Hours_Orig, _f)
                                }
                            </div>
                            <button type="button"
                                    onclick="openCopyDialog(@entry.pid, '@Model.Date.ToString("yyyy-MM-dd")')"
                                    title="Kopírovat úkon"
                                    class="text-base-content/30 hover:text-primary transition"
                                    style="line-height:1;">
                                <span class="material-icons-outlined" style="font-size:18px;">content_copy</span>
                            </button>
                        </div>

                    </div>

                    @* Svázané kusovníkové úkony *@
                    @if (_children.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-t border-base-200 grid gap-1">
                            @foreach (var child in _children)
                            {
                                <a asp-controller="Ukon" asp-action="Edit" asp-route-id="@child.pid"
                                   class="flex items-center justify-between gap-2 text-sm hover:bg-base-200 rounded px-1 -mx-1 py-0.5">
                                    <div class="min-w-0 text-base-content/70 truncate">
                                        @child.p32Name
                                        @if (!string.IsNullOrEmpty(child.p31Text))
                                        {
                                            <text> — @child.p31Text</text>
                                        }
                                    </div>
                                    <div class="shrink-0 font-semibold">
                                        @child.p31Value_Orig.ToString("0.##") @_f.tra("ks")
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* Sešity — "Vykázat do..." *@
    <style>
            .sesit-btn {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.375rem 0.5rem;
                border-radius: 0.375rem;
                font-size: 0.875rem;
                color: rgba(0,0,0,0.6);
                border-left: 3px solid transparent;
                transition: all .15s;
                text-decoration: none;
            }

                .sesit-btn:hover {
                    background: #eef2ff;
                    border-left-color: #6366f1;
                    padding-left: 0.625rem;
                    color: rgba(0,0,0,0.85);
                }
    </style>
    <div class="mt-2">
        <div class="text-xs uppercase text-base-content/50 font-semibold mb-1 px-1">
            @_f.tra("Vykázat do...")
        </div>
        <div class="flex flex-col">
            @foreach (var s in Model.SesitList)
            {
                <a asp-controller="Ukon" asp-action="New"
                   asp-route-d="@Model.Date.ToString("yyyy-MM-dd")"
                   asp-route-p34id="@s.pid"
                   class="sesit-btn">
                    <span class="material-icons-outlined" style="font-size:18px;color:rgba(0,0,0,0.35);">
                        @(s.p33ID == BO.p33IdENUM.Cas ? "schedule" :
                          s.p33ID == BO.p33IdENUM.Kusovnik ? "inventory_2" : "payments")
                    </span>
                    <span style="flex:1">@s.p34Name</span>
                    <span style="font-size:0.75rem;color:rgba(0,0,0,0.3);">@s.p33Name</span>
                </a>
            }
        </div>
    </div>

</div>

@* Dialog pro výběr data při kopírování úkonu *@
<style>
    #copyDialog {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999;
        background: rgba(0,0,0,.45);
        align-items: flex-end;
    }

        #copyDialog.open {
            display: flex;
        }

    #copyDialogBox {
        background: #fff;
        border-radius: 1rem 1rem 0 0;
        padding: 1.25rem;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
    }
</style>
<div id="copyDialog" onclick="if(event.target===this) closeCopyDialog()">
    <div id="copyDialogBox">
        <div style="font-weight:600;margin-bottom:1rem;">@_f.tra("Zkopírovat úkon — datum")</div>

        <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="same" checked
                       onchange="onCopyDateChange(this.value)" />
                <span id="labelSame">@_f.tra("Stejné datum")</span>
            </label>
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="today"
                       onchange="onCopyDateChange(this.value)" />
                <span>@_f.tra("Dnešní datum")</span>
            </label>
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="custom"
                       onchange="onCopyDateChange(this.value)" />
                <span>@_f.tra("Jiné datum")</span>
            </label>
            <input type="date" id="copyCustomDate"
                   style="display:none;margin-left:1.5rem;padding:.375rem .5rem;border:1px solid #d1d5db;border-radius:.375rem;font-size:.875rem;" />
        </div>

        <div style="display:flex;gap:.5rem;">
            <button onclick="confirmCopy()"
                    style="flex:1;padding:.5rem;background:#6366f1;color:#fff;border:none;border-radius:.5rem;font-size:.9rem;cursor:pointer;">
                @_f.tra("Kopírovat")
            </button>
            <button onclick="closeCopyDialog()"
                    style="padding:.5rem 1rem;border:1px solid #d1d5db;border-radius:.5rem;font-size:.9rem;cursor:pointer;background:#fff;">
                @_f.tra("Storno")
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var _copyId = 0;
        var _copyOrigDate = '';
        var _todayDate = '@DateTime.Today.ToString("yyyy-MM-dd")';

        function openCopyDialog(id, origDate) {
            _copyId = id;
            _copyOrigDate = origDate;
            document.getElementById('labelSame').textContent = '@_f.tra("Stejné datum")' + ' (' + formatDate(origDate) + ')';
            document.querySelector('input[name="copyDate"][value="same"]').checked = true;
            document.getElementById('copyCustomDate').style.display = 'none';
            document.getElementById('copyCustomDate').value = origDate;
            document.getElementById('copyDialog').classList.add('open');
        }

        function closeCopyDialog() {
            document.getElementById('copyDialog').classList.remove('open');
        }

        function onCopyDateChange(val) {
            document.getElementById('copyCustomDate').style.display = val === 'custom' ? 'block' : 'none';
        }

        function confirmCopy() {
            var mode = document.querySelector('input[name="copyDate"]:checked').value;
            var d;
            if (mode === 'same')   d = _copyOrigDate;
            else if (mode === 'today') d = _todayDate;
            else {
                d = document.getElementById('copyCustomDate').value;
                if (!d) { alert('@_f.tra("Zadejte datum.")'); return; }
            }
            closeCopyDialog();
            window.location.href = '/Ukon/Copy?id=' + _copyId + '&d=' + encodeURIComponent(d);
        }

        function formatDate(iso) {
            if (!iso) return '';
            var p = iso.split('-');
            return p[2] + '. ' + p[1] + '. ' + p[0];
        }

        document.addEventListener('DOMContentLoaded', function () {
            var hash = window.location.hash;
            if (!hash || hash.indexOf('#entry-') !== 0) return;

            var el = document.querySelector(hash);
            if (!el) return;

            el.scrollIntoView({ block: 'center', behavior: 'smooth' });

            el.classList.add('mo-highlight-flash');
            setTimeout(function () {
                el.classList.remove('mo-highlight-flash');
            }, 2000);
        });
    </script>
    <style>
        @@keyframes moHighlightFlash {
            0% {
                box-shadow: 0 0 0 3px rgba(250,204,21,.9);
            }

            100% {
                box-shadow: 0 0 0 3px rgba(250,204,21,0);
            }
        }

        .mo-highlight-flash {
            animation: moHighlightFlash 2s ease-out;
        }
    </style>
}