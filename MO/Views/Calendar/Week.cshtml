@model WeekViewModel
@inject BL.Factory _f

@{
    var today = DateTime.Today;
    var prevWeek = Model.d1.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.d1.AddDays(7).ToString("yyyy-MM-dd");
    var monthAnchor = new DateTime(Model.d0.Year, Model.d0.Month, 1).ToString("yyyy-MM-01");
}

<div class="grid gap-3">

    @* Navigace: předchozí / rozsah + tabs / další týden *@
    <div class="flex items-center justify-between gap-2">
        <a asp-action="Week" asp-route-d="@prevWeek" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">chevron_left</span>
        </a>

        <div class="text-center flex-1">
            <div class="flex items-center justify-center gap-2" style="flex-wrap:wrap;">
                <span class="font-semibold text-lg leading-tight">@Model.PageTitle</span>
                <div class="tabs tabs-boxed tabs-xs">
                    <a asp-action="Index" asp-route-d="@monthAnchor" class="tab text-xs">@_f.tra("Měsíc")</a>
                    <a asp-action="Week" asp-route-d="@Model.d1.ToString("yyyy-MM-dd")" class="tab tab-active text-xs">@_f.tra("Týden agenda")</a>
                </div>
            </div>
            <div class="text-xs text-base-content/60">
                <a asp-controller="Stats" asp-action="Index"
                   asp-route-d1="@Model.d1.ToString("yyyy-MM-dd")"
                   asp-route-d2="@Model.d2.ToString("yyyy-MM-dd")"
                   asp-route-label="@Model.PageTitle">
                    @_f.tra("Celkem"): <strong>@MO.Code.HoursFormat.Show(Model.WeekTotalHours, _f)</strong>
                </a>
            </div>
        </div>

        <a asp-action="Week" asp-route-d="@nextWeek" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">chevron_right</span>
        </a>
    </div>

    @* Dny týdne *@
    @foreach (var day in Model.Days)
    {
        var isToday = day.Date.Date == today;
        var headerStyle = isToday ? "" : "background-color:#dbe7f5;";

        <div class="mt-5 first:mt-0">
            @* Hlavička dne - klik vede do Day view (přidání úkonu, plný detail) *@
            <a asp-action="Day" asp-route-d="@day.Date.ToString("yyyy-MM-dd")"
               style="@headerStyle"
               class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-lg mb-2 transition hover:brightness-95
                @(isToday ? "bg-primary text-primary-content" : "")">
                <div class="flex items-baseline gap-2" style="flex-wrap:wrap;">
                    <span class="badge badge-sm font-bold tracking-wide @(isToday ? "bg-primary-content/20 border-none text-primary-content" : "badge-ghost")">
                        @day.DayName
                    </span>
                    <div class="text-lg font-extrabold">
                        @day.Date.ToString("d. M.")
                    </div>
                    @if (isToday)
                    {
                        <span class="badge badge-sm bg-primary-content/20 border-none text-primary-content">@_f.tra("Dnes")</span>
                    }
                    @if (day.IsHoliday)
                    {
                        <span class="badge badge-error badge-outline badge-sm">@day.HolidayName</span>
                    }
                </div>
                @if (day.TotalHours > 0 || day.MoneyEntryCount > 0 || day.TasksDue.Count > 0 || day.Milestones.Count > 0)
                {
                    <div class="flex items-center gap-1.5">
                        @if (day.TotalHours > 0)
                        {
                            <div class="font-bold text-sm @(isToday ? "" : "text-primary")">@MO.Code.HoursFormat.Show(day.TotalHours, _f)</div>
                        }
                        @if (day.MoneyEntryCount > 0)
                        {
                            <div class="badge badge-sm gap-0.5 @(isToday ? "bg-primary-content/20 border-none text-primary-content" : "badge-secondary")"
                                 title="@day.MoneyEntryCount @_f.tra("peněžních úkonů")">
                                <span class="material-icons-outlined" style="font-size:12px;">payments</span>@day.MoneyEntryCount
                            </div>
                        }
                        @if (day.TasksDue.Count > 0)
                        {
                            <div class="badge badge-sm gap-0.5 @(isToday ? "bg-primary-content/20 border-none text-primary-content" : "badge-warning")"
                                 title="@day.TasksDue.Count @_f.tra("úkolů s termínem")">
                                <span class="material-icons-outlined" style="font-size:12px;">task_alt</span>@day.TasksDue.Count
                            </div>
                        }
                        @if (day.Milestones.Count > 0)
                        {
                            <div class="badge badge-sm gap-0.5 @(isToday ? "bg-primary-content/20 border-none text-primary-content" : "badge-info")"
                                 title="@day.Milestones.Count @_f.tra("termínů v kalendáři")">
                                <span class="material-icons-outlined" style="font-size:12px;">event</span>@day.Milestones.Count
                            </div>
                        }
                    </div>
                }
            </a>

            @if (day.TasksDue.Count > 0)
            {
                <div class="grid gap-1 mt-1 mb-1">
                    @foreach (var task in day.TasksDue)
                    {
                        <a asp-controller="Ukol" asp-action="Edit" asp-route-id="@task.pid"
                           asp-route-ret="week" asp-route-retd="@Model.d0.ToString("yyyy-MM-dd")"
                           class="flex items-center gap-2 text-xs px-2 py-1 rounded bg-warning/10 hover:bg-warning/20 transition">
                            <span class="material-icons-outlined text-warning" style="font-size:14px;">task_alt</span>
                            <span class="truncate flex-1">@task.p56Name</span>
                            @if (!string.IsNullOrEmpty(task.p41Name))
                            {
                                <span class="text-base-content/40 shrink-0">@task.p41Name</span>
                            }
                        </a>
                    }
                </div>
            }

            @if (day.Milestones.Count > 0)
            {
                <div class="grid gap-1 mt-1 mb-1">
                    @foreach (var m in day.Milestones)
                    {
                        <div class="flex items-center gap-2 text-xs px-2 py-1 rounded bg-info/10">
                            <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background-color:@m.o21Color;flex-shrink:0;"></span>
                            <span class="truncate flex-1">@m.o22Name</span>
                            @if (!string.IsNullOrEmpty(m.p41Name))
                            {
                                <span class="text-base-content/40 shrink-0">@m.p41Name</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (!day.Entries.Any())
            {
                <div class="text-xs text-base-content/40 px-1 py-1 italic">@_f.tra("Bez úkonů")</div>
            }
            else
            {
                <div class="grid gap-1.5 mt-1">
                    @foreach (var entry in day.Entries)
                    {
                        var _trCls = MO.Code.TheGridRowSymbol.p31_tr_cssclass(entry) ?? "";
                        var _symbol = MO.Code.TheGridRowSymbol.p31_symbol(entry);
                        <div id="entry-@entry.pid" class="card bg-base-100 shadow-sm hover:bg-base-300 transition @_trCls">
                            <div class="card-body p-2.5">
                                <div class="flex items-start gap-2">

                                    <a asp-controller="Ukon" asp-action="Edit" asp-route-id="@entry.pid"
                                       asp-route-ret="week" asp-route-retd="@Model.d1.ToString("yyyy-MM-dd")"
                                       class="min-w-0 flex-1 block">
                                        <div class="flex items-baseline gap-2" style="flex-wrap:wrap;">
                                            @if (entry.p31DateTimeFrom_Orig.HasValue && entry.p31DateTimeUntil_Orig.HasValue)
                                            {
                                                <span class="text-xs text-base-content/50 shrink-0">
                                                    @entry.p31DateTimeFrom_Orig.Value.ToString("HH:mm")–@entry.p31DateTimeUntil_Orig.Value.ToString("HH:mm")
                                                </span>
                                            }
                                            <span class="font-semibold text-sm min-w-0" style="overflow-wrap:break-word;">@entry.Project</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(entry.p32Name))
                                        {
                                            <div class="text-xs text-base-content/50">@entry.p32Name</div>
                                        }
                                        <div class="text-sm text-base-content/80" style="white-space:pre-wrap;">@entry.p31Text</div>
                                    </a>

                                    <div class="flex flex-col items-end gap-1 shrink-0">
                                        @if (!string.IsNullOrEmpty(_symbol))
                                        {
                                            <div>@Html.Raw(_symbol)</div>
                                        }
                                        <div class="font-bold text-primary text-sm">
                                            @if (entry.p33ID == BO.p33IdENUM.PenizeBezDPH || entry.p33ID == BO.p33IdENUM.PenizeVcDPHRozpisu)
                                            {
                                                @(MO.Code.AmountFormat.Thousands(entry.p31Amount_WithoutVat_Orig)) @entry.j27Code_Billing_Orig
                                            }
                                            else
                                            {
                                                @MO.Code.HoursFormat.Show(entry.p31Hours_Orig, _f)
                                            }
                                        </div>
                                        <button type="button"
                                                onclick="openCopyDialog(@entry.pid, '@day.Date.ToString("yyyy-MM-dd")')"
                                                title="Kopírovat úkon"
                                                class="text-base-content/30 hover:text-primary transition"
                                                style="line-height:1;">
                                            <span class="material-icons-outlined" style="font-size:16px;">content_copy</span>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* Přepínač víkendu *@
    <form method="post" asp-action="ToggleWeekend" asp-route-d="@Model.d1.ToString("yyyy-MM-dd")"
          onsubmit="moRememberShowWeekend(@((!Model.ShowWeekend).ToString().ToLower()))"
          class="flex items-center justify-end gap-2 mt-2">
        <input type="hidden" name="view" value="week" />
        <button type="submit" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:18px;">
                @(Model.ShowWeekend ? "visibility_off" : "visibility")
            </span>
            @(Model.ShowWeekend ? _f.tra("Skrýt víkend") : _f.tra("Zobrazit víkend"))
        </button>
    </form>

</div>

@* Dialog pro výběr data při kopírování úkonu *@
<style>
    #copyDialog {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999;
        background: rgba(0,0,0,.45);
        align-items: flex-end;
    }

        #copyDialog.open {
            display: flex;
        }

    #copyDialogBox {
        background: #fff;
        border-radius: 1rem 1rem 0 0;
        padding: 1.25rem;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
    }
</style>
<div id="copyDialog" onclick="if(event.target===this) closeCopyDialog()">
    <div id="copyDialogBox">
        <div style="font-weight:600;margin-bottom:1rem;">@_f.tra("Zkopírovat úkon — datum")</div>

        <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem;">
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="same" checked
                       onchange="onCopyDateChange(this.value)" />
                <span id="labelSame">@_f.tra("Stejné datum")</span>
            </label>
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="today"
                       onchange="onCopyDateChange(this.value)" />
                <span>@_f.tra("Dnešní datum")</span>
            </label>
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;">
                <input type="radio" name="copyDate" value="custom"
                       onchange="onCopyDateChange(this.value)" />
                <span>@_f.tra("Jiné datum")</span>
            </label>
            <input type="date" id="copyCustomDate"
                   style="display:none;margin-left:1.5rem;padding:.375rem .5rem;border:1px solid #d1d5db;border-radius:.375rem;font-size:.875rem;" />
        </div>

        <div style="display:flex;gap:.5rem;">
            <button onclick="confirmCopy()"
                    style="flex:1;padding:.5rem;background:#6366f1;color:#fff;border:none;border-radius:.5rem;font-size:.9rem;cursor:pointer;">
                @_f.tra("Kopírovat")
            </button>
            <button onclick="closeCopyDialog()"
                    style="padding:.5rem 1rem;border:1px solid #d1d5db;border-radius:.5rem;font-size:.9rem;cursor:pointer;background:#fff;">
                @_f.tra("Storno")
            </button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        moRememberCalendarType('week');

        // Odskrolovat na konkrétní záznam, pokud se vracíme z editace (URL #entry-<pid>)
        document.addEventListener('DOMContentLoaded', function () {
            if (location.hash && location.hash.indexOf('#entry-') === 0) {
                var el = document.getElementById(location.hash.substring(1));
                if (el) {
                    el.scrollIntoView({ block: 'center', behavior: 'instant' });
                    el.style.transition = 'box-shadow .3s';
                    el.style.boxShadow = '0 0 0 3px #6366f1';
                    setTimeout(function () { el.style.boxShadow = ''; }, 1500);
                }
            }
        });

        var _copyId = 0;
        var _copyOrigDate = '';
        var _todayDate = '@DateTime.Today.ToString("yyyy-MM-dd")';

        function openCopyDialog(id, origDate) {
            _copyId = id;
            _copyOrigDate = origDate;
            document.getElementById('labelSame').textContent = '@_f.tra("Stejné datum")' + ' (' + formatDate(origDate) + ')';
            document.querySelector('input[name="copyDate"][value="same"]').checked = true;
            document.getElementById('copyCustomDate').style.display = 'none';
            document.getElementById('copyCustomDate').value = origDate;
            document.getElementById('copyDialog').classList.add('open');
        }

        function closeCopyDialog() {
            document.getElementById('copyDialog').classList.remove('open');
        }

        function onCopyDateChange(val) {
            document.getElementById('copyCustomDate').style.display = val === 'custom' ? 'block' : 'none';
        }

        function confirmCopy() {
            var mode = document.querySelector('input[name="copyDate"]:checked').value;
            var d;
            if (mode === 'same')   d = _copyOrigDate;
            else if (mode === 'today') d = _todayDate;
            else {
                d = document.getElementById('copyCustomDate').value;
                if (!d) { alert('@_f.tra("Zadejte datum.")'); return; }
            }
            closeCopyDialog();
            window.location.href = '/Ukon/Copy?id=' + _copyId + '&d=' + encodeURIComponent(d);
        }

        function formatDate(iso) {
            if (!iso) return '';
            var p = iso.split('-');
            return p[2] + '. ' + p[1] + '. ' + p[0];
        }
    </script>
}