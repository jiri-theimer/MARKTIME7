@model EntryMoneyViewModel
@inject BL.Factory _f

@{
    var isNew = Model.pid == 0;
    var isFromUkony = Model.Ret == "ukony" && !string.IsNullOrEmpty(Model.RetD);
    var dayUrl = Model.Ret == "week" && !string.IsNullOrEmpty(Model.RetD)
        ? Url.Action("Week", "Calendar", new { d = Model.RetD }) + "#entry-" + Model.pid
        : isFromUkony
            ? Model.RetD + "#entry-" + Model.pid
            : Url.Action("Day", "Calendar", new { d = Model.Date.ToString("yyyy-MM-dd") });
    var backLabel = isFromUkony ? _f.tra("Zpět do přehledu úkonů") : _f.tra("Zpět");
    var activityHidden = Model.ActivityEntryFlag == 1;  // AktivitaSeNezadava
    var activityRequired = Model.ActivityEntryFlag == 3; // AktivitaJePovinna
    var isDphRozpis = Model.p33ID == BO.p33IdENUM.PenizeVcDPHRozpisu;
    var isVydaj = Model.IncomeStatementFlag == (int)BO.p34IncomeStatementFlagENUM.Vydaj;
}

<div class="grid gap-3">

    <div class="flex items-center justify-between">
        <a href="@dayUrl" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">arrow_back</span>
            @backLabel
        </a>
        <div class="text-sm text-base-content/60">@Model.Date.ToString("d. MMMM yyyy")</div>
    </div>

    <form method="post" asp-action="SaveMoney" id="ukonForm" enctype="multipart/form-data">
        <input type="hidden" asp-for="pid" />
        <input type="hidden" asp-for="Ret" />
        <input type="hidden" asp-for="RetD" />
        <input type="hidden" asp-for="UploadGuid" />
        <input type="hidden" name="oper" id="oper" value="" />

        @* Datum — v editaci zobrazit a umožnit změnu *@
        @if (!isNew)
        {
            <div class="flex items-center gap-2 px-1">
                <span class="material-icons-outlined text-base-content/40" style="font-size:16px;">calendar_today</span>
                <button type="button" onclick="toggleDateEdit()"
                        class="text-sm text-base-content/60 hover:text-base-content transition">
                    <span id="dateLabel">@Model.Date.ToString("d. MMMM yyyy")</span>
                    <span class="material-icons-outlined" style="font-size:14px;vertical-align:middle;">edit</span>
                </button>
            </div>
            <div id="dateEditRow" style="display:none;" class="px-1">
                <input type="date" id="DatePicker"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       onchange="onDateChange(this.value)"
                       class="input input-bordered input-sm w-full" />
            </div>
            <input type="hidden" asp-for="Date" id="DateHidden" />
        }
        else
        {
            <input type="hidden" asp-for="Date" />
        }

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body gap-3">

                @* Sešit - klik otevře dialog s výběrem (jen sešity typu Peníze) *@
                <input type="hidden" asp-for="p34ID" />
                @if (!string.IsNullOrEmpty(Model.SelectedSesitText))
                {
                    <button type="button" onclick="openSesitDialog()"
                            class="flex items-center justify-between gap-2 px-1 py-1 text-sm text-base-content/70 w-full"
                            style="cursor:pointer;background:none;border:none;">
                        <span class="flex items-center gap-2">
                            <span class="material-icons-outlined" style="font-size:18px;">payments</span>
                            <span>@Model.SelectedSesitText</span>
                        </span>
                        <span class="material-icons-outlined text-base-content/40" style="font-size:18px;">unfold_more</span>
                    </button>
                }

                @* Projekt - mycombo, postback při změně (přenačtení aktivit) *@
                <label class="form-control">
                    <div class="label">
                        <span class="label-text font-semibold">@_f.tra("Projekt") *</span>
                    </div>
                    <mycombo asp-for="p41ID"
                             selected-text="@Model.SelectedProjectText"
                             items="@Model.ProjectComboItems"
                             placeholder="@_f.tra("vyberte projekt")"
                             event-after-change="onProjectChange" />
                </label>

                @* Aktivita - jen pokud to sešit dovoluje *@
                @if (!activityHidden)
                {
                    <label class="form-control">
                        <div class="label">
                            <span class="label-text font-semibold">
                                @_f.tra("Aktivita")@(activityRequired ? " *" : "")
                            </span>
                            @if (!activityRequired)
                            {
                                <span class="label-text-alt text-base-content/50">@_f.tra("volitelně")</span>
                            }
                        </div>
                        @if (Model.p34ID > 0 && Model.p41ID > 0)
                        {
                            <mycombo asp-for="p32ID"
                                     selected-text="@Model.SelectedActivityText"
                                     items="@Model.ActivityComboItems"
                                     placeholder="@_f.tra("vyberte aktivitu")"
                                     event-after-change="onActivityChange" />
                        }
                        else
                        {
                            <div class="text-sm text-base-content/50 italic px-1">
                                @_f.tra("Nejprve vyberte sešit a projekt.")
                            </div>
                            <input type="hidden" asp-for="p32ID" />
                        }
                    </label>
                }
                else
                {
                    <input type="hidden" asp-for="p32ID" value="0" />
                }

                @* Úkol - volitelný, jen pokud u projektu existují úkoly *@
                @if (Model.TaskList.Any())
                {
                    <label class="form-control">
                        <div class="label">
                            <span class="label-text font-semibold">@_f.tra("Úkol")</span>
                            <span class="label-text-alt text-base-content/50">@_f.tra("volitelně")</span>
                        </div>
                        <select asp-for="p56ID" id="p56ID" class="select select-bordered w-full">
                            <option value="0">— @_f.tra("bez úkolu") —</option>
                            @foreach (var t in Model.TaskList)
                            {
                                <option value="@t.pid" selected="@(t.pid == Model.p56ID)">@t.p56Name</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <input type="hidden" asp-for="p56ID" value="0" />
                }

                @* Částka bez DPH - povinné *@
                <div class="grid grid-cols-2 gap-2">
                    <label class="form-control">
                        <div class="label">
                            <span class="label-text font-semibold">@_f.tra("Bez DPH") *</span>
                        </div>
                        <input asp-for="AmountWithoutVat" id="AmountWithoutVat" class="input input-bordered w-full"
                               inputmode="decimal" autocomplete="off" enterkeyhint="next" placeholder="0" />
                    </label>

                    <label class="form-control">
                        <div class="label">
                            <span class="label-text font-semibold">@_f.tra("Měna") *</span>
                        </div>
                        <select asp-for="j27ID" class="select select-bordered w-full">
                            <option value="0">— @_f.tra("vyberte měnu") —</option>
                            @foreach (var c in Model.CurrencyComboItems)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.j27ID)">@c.Code - @c.Text</option>
                            }
                        </select>
                    </label>
                </div>

                @* DPH rozpis - pouze pro sešit typu "Peníze s rozpisem DPH" *@
                @if (isDphRozpis)
                {
                    <div class="grid grid-cols-3 gap-2">
                        <label class="form-control">
                            <div class="label"><span class="label-text">@_f.tra("DPH %")</span></div>
                            <input asp-for="VatRatePercent" id="VatRatePercent" class="input input-bordered w-full"
                                   inputmode="decimal" autocomplete="off" placeholder="0" />
                        </label>
                        <label class="form-control">
                            <div class="label"><span class="label-text">@_f.tra("Částka DPH")</span></div>
                            <input asp-for="AmountVat" id="AmountVat" class="input input-bordered w-full"
                                   inputmode="decimal" autocomplete="off" placeholder="0" />
                        </label>
                        <label class="form-control">
                            <div class="label"><span class="label-text">@_f.tra("Vč. DPH")</span></div>
                            <input asp-for="AmountWithVat" id="AmountWithVat" class="input input-bordered w-full"
                                   inputmode="decimal" autocomplete="off" placeholder="0" />
                        </label>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="VatRatePercent" />
                    <input type="hidden" asp-for="AmountVat" />
                    <input type="hidden" asp-for="AmountWithVat" />
                }

                @* Kód dokladu a druh úhrady - pouze pro výdaj *@
                @if (isVydaj)
                {
                    <div class="grid grid-cols-2 gap-2">
                        <label class="form-control">
                            <div class="label">
                                <span class="label-text font-semibold">@_f.tra("Kód dokladu")</span>
                                <span class="label-text-alt text-base-content/50">@_f.tra("volitelně")</span>
                            </div>
                            <input asp-for="DocumentCode" class="input input-bordered w-full" autocomplete="off" />
                        </label>
                        <label class="form-control">
                            <div class="label">
                                <span class="label-text font-semibold">@_f.tra("Druh úhrady")</span>
                                <span class="label-text-alt text-base-content/50">@_f.tra("volitelně")</span>
                            </div>
                            <mycombo asp-for="j19ID"
                                     selected-text="@Model.SelectedPaymentTypeText"
                                     items="@Model.PaymentTypeComboItems"
                                     placeholder="@_f.tra("druh úhrady")" />
                        </label>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="DocumentCode" />
                    <input type="hidden" asp-for="j19ID" />
                }

                @* Popis - povinnost řídí nastavení aktivity, validaci provede server *@
                <label class="form-control">
                    <div class="label"><span class="label-text font-semibold">@_f.tra("Popis")</span></div>
                    <textarea asp-for="Description" class="textarea textarea-bordered w-full"
                              rows="3" autocapitalize="sentences"></textarea>
                </label>

                @* Uživatelská pole (freefields) *@
                @if (Model.ff1?.VisibleInputsCount > 0)
                {
                    <partial name="_FreeFields" model="Model.ff1" />
                }

            </div>
        </div>
    </form>

    @* Přílohy u dosud neuloženého záznamu - soubor se jen dočasně nahraje (staging) a commitne
       se až po úspěšném uložení úkonu (viz UploadGuid a oper="stage_attachment"). Form tag je
       uzavřený výše, proto file input odkazuje na hlavní formulář přes atribut form="ukonForm". *@
    @if (isNew)
    {
        <div class="card bg-base-100 shadow-sm mt-3">
            <div class="card-body p-3 gap-2">
                <div class="text-sm font-semibold">@_f.tra("Přílohy")</div>

                @if (Model.StagedAttachments.Any())
                {
                    <div class="grid gap-2">
                        @foreach (var att in Model.StagedAttachments)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <span class="material-icons-outlined text-base-content/40" style="font-size:18px;">description</span>
                                <span class="flex-1 truncate">@att.p85FreeText01</span>
                                <span class="text-xs text-base-content/40 shrink-0">@MO.Code.FileSizeFormat.Show(att.p85FreeNumber01)</span>
                                <button type="button" class="btn btn-ghost btn-xs btn-square"
                                        onclick="submitOper('delete_staged_@att.pid')">
                                    <span class="material-icons-outlined" style="font-size:16px;color:var(--color-error,#dc2626);">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-sm text-base-content/50 italic">@_f.tra("Zatím žádné přílohy (např. fotka účtenky).")</div>
                }

                <input type="file" id="stagingFileInput" name="stagingFile" form="ukonForm" accept="image/*"
                       style="display:none;" onchange="moShowUploadOverlay('@_f.tra("Nahrávám přílohu...")'); submitOper('stage_attachment')" />
                <div class="grid grid-cols-2 gap-2 mt-1">
                    <button type="button" class="btn btn-primary btn-sm" onclick="pickAttachmentFile('stagingFileInput', true)">
                        <span class="material-icons-outlined" style="font-size:18px;">photo_camera</span>
                        @_f.tra("Vyfotit")
                    </button>
                    <button type="button" class="btn btn-primary btn-outline btn-sm" onclick="pickAttachmentFile('stagingFileInput', false)">
                        <span class="material-icons-outlined" style="font-size:18px;">photo_library</span>
                        @_f.tra("Vybrat soubor")
                    </button>
                </div>
            </div>
        </div>
    }

    @* Přílohy u již uloženého záznamu - commitují se okamžitě, vlastní (samostatné) formuláře *@
    @if (!isNew)
    {
        <div class="card bg-base-100 shadow-sm mt-3">
            <div class="card-body p-3 gap-2">
                <div class="text-sm font-semibold">@_f.tra("Přílohy")</div>

                @if (Model.Attachments.Any())
                {
                    <div class="grid gap-2">
                        @foreach (var att in Model.Attachments)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <span class="material-icons-outlined text-base-content/40" style="font-size:18px;">description</span>
                                <a asp-controller="Ukon" asp-action="DownloadAttachment" asp-route-guid="@att.o27Guid"
                                   target="_blank" class="flex-1 truncate hover:underline">
                                    @att.o27OriginalFileName
                                </a>
                                <span class="text-xs text-base-content/40 shrink-0">@MO.Code.FileSizeFormat.Show(att.o27FileSize)</span>
                                <form method="post" asp-action="DeleteAttachment" style="display:inline;"
                                      onsubmit="return confirm('@_f.tra("Opravdu smazat tuto přílohu?")');">
                                    <input type="hidden" name="pid" value="@Model.pid" />
                                    <input type="hidden" name="attachmentId" value="@att.pid" />
                                    <input type="hidden" name="ret" value="@Model.Ret" />
                                    <input type="hidden" name="retd" value="@Model.RetD" />
                                    <button type="submit" class="btn btn-ghost btn-xs btn-square">
                                        <span class="material-icons-outlined" style="font-size:16px;color:var(--color-error,#dc2626);">delete</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-sm text-base-content/50 italic">@_f.tra("Zatím žádné přílohy (např. fotka účtenky).")</div>
                }

                <form method="post" asp-action="UploadAttachment" enctype="multipart/form-data" id="uploadAttachmentForm">
                    <input type="hidden" name="pid" value="@Model.pid" />
                    <input type="hidden" name="ret" value="@Model.Ret" />
                    <input type="hidden" name="retd" value="@Model.RetD" />
                    <input type="file" id="uploadAttachmentInput" name="file" accept="image/*"
                           style="display:none;" onchange="moShowUploadOverlay('@_f.tra("Nahrávám přílohu...")'); document.getElementById('uploadAttachmentForm').submit();" />
                    <div class="grid grid-cols-2 gap-2 mt-1">
                        <button type="button" class="btn btn-primary btn-sm" onclick="pickAttachmentFile('uploadAttachmentInput', true)">
                            <span class="material-icons-outlined" style="font-size:18px;">photo_camera</span>
                            @_f.tra("Vyfotit")
                        </button>
                        <button type="button" class="btn btn-primary btn-outline btn-sm" onclick="pickAttachmentFile('uploadAttachmentInput', false)">
                            <span class="material-icons-outlined" style="font-size:18px;">photo_library</span>
                            @_f.tra("Vybrat soubor")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="grid gap-2 mt-3">
        <button type="submit" form="ukonForm" class="btn btn-success btn-block">
            <span class="material-icons-outlined" style="font-size:20px;">check</span>
            @_f.tra("Uložit")
        </button>

        @if (!isNew)
        {
            <button type="submit" form="ukonForm"
                    formaction="@Url.Action("Delete", new { id = Model.pid, d = Model.Date.ToString("yyyy-MM-dd"), ret = Model.Ret, retd = Model.RetD })"
                    class="btn btn-error btn-outline btn-block"
                    onclick="return confirm('@_f.tra("Opravdu smazat tento úkon?")');">
                <span class="material-icons-outlined" style="font-size:20px;">delete</span>
                @_f.tra("Smazat")
            </button>
        }

        <a href="@dayUrl" class="btn btn-ghost btn-block">@backLabel</a>
    </div>


</div>

@* Dialog pro výběr sešitu *@
<style>
    #sesitDialog {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999;
        background: rgba(0,0,0,.45);
        align-items: flex-end;
    }

        #sesitDialog.open {
            display: flex;
        }

    #sesitDialogBox {
        background: #fff;
        border-radius: 1rem 1rem 0 0;
        padding: 1.25rem;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        max-height: 80vh;
        overflow-y: auto;
    }
</style>
<div id="sesitDialog" onclick="if(event.target===this) closeSesitDialog()">
    <div id="sesitDialogBox">
        <div style="font-weight:600;margin-bottom:1rem;">@_f.tra("Vyberte sešit")</div>

        <div style="display:flex;flex-direction:column;gap:.25rem;margin-bottom:1rem;">
            @foreach (var s in Model.SesitComboItems)
            {
                <button type="button" onclick="selectSesit(@s.Id, '@s.Tag')"
                        style="text-align:left;padding:.6rem .75rem;border-radius:.5rem;border:none;cursor:pointer;font-size:.9rem;
                    background:@(s.Id == Model.p34ID ? "#eef2ff" : "transparent");
                    color:@(s.Id == Model.p34ID ? "#4338ca" : "inherit");
                    font-weight:@(s.Id == Model.p34ID ? "600" : "400");">
                    <div>@s.Text</div>
                    @if (Model.pid == 0)
                    {
                        <div style="font-size:.75rem;font-weight:400;color:#9ca3af;">@s.Meta</div>
                    }
                </button>
            }
        </div>

        <button onclick="closeSesitDialog()"
                style="width:100%;padding:.5rem;border:1px solid #d1d5db;border-radius:.5rem;font-size:.9rem;cursor:pointer;background:#fff;">
            @_f.tra("Storno")
        </button>
    </div>
</div>

@section scripts {
    <script>
        var CURRENT_FORM_TYPE = 'money';

        function toggleDateEdit() {
            var row = document.getElementById('dateEditRow');
            row.style.display = row.style.display === 'none' ? 'block' : 'none';
        }

        function openSesitDialog() {
            document.getElementById('sesitDialog').classList.add('open');
        }
        function closeSesitDialog() {
            document.getElementById('sesitDialog').classList.remove('open');
        }
        function selectSesit(id, formatTag) {
            closeSesitDialog();

            if (formatTag !== CURRENT_FORM_TYPE) {
                var d = document.getElementById('DateHidden')
                    ? document.getElementById('DateHidden').value
                    : '@Model.Date.ToString("yyyy-MM-dd")';
                var p41id = @Model.p41ID;
                var url = '/Ukon/New?d=' + encodeURIComponent(d) + '&p34id=' + id;
                if (p41id > 0) url += '&p41id=' + p41id;
                window.location.href = url;
                return;
            }

            document.getElementById('p34ID').value = id;
            document.getElementById('oper').value = 'p34change';
            document.getElementById('ukonForm').submit();
        }

        function onDateChange(val) {
            var hidden = document.getElementById('DateHidden');
            if (hidden) hidden.value = val;
            var label = document.getElementById('dateLabel');
            if (label && val) {
                var p = val.split('-');
                var d = new Date(parseInt(p[0]), parseInt(p[1]) - 1, parseInt(p[2]));
                label.textContent = d.toLocaleDateString('@System.Globalization.CultureInfo.CurrentUICulture.Name',
                    { day: 'numeric', month: 'long', year: 'numeric' });
            }
            toggleDateEdit();
        }

        function onProjectChange(p41id) {
            document.getElementById('oper').value = 'p41change';
            document.getElementById('ukonForm').submit();
        }

        function onActivityChange(p32id) {
            document.getElementById('oper').value = 'p32change';
            document.getElementById('ukonForm').submit();
        }

        function submitOper(oper) {
            document.getElementById('oper').value = oper;
            document.getElementById('ukonForm').submit();
        }

        // Jedno skryté file pole slouží pro obě tlačítka (Vyfotit / Vybrat soubor) - "capture"
        // se nastaví (nebo odebere) těsně před otevřením výběru, ať se prohlížeč nezachová
        // pokaždé stejně a uživatel měl vždy obě možnosti k dispozici.
        function pickAttachmentFile(inputId, useCamera) {
            var input = document.getElementById(inputId);
            if (useCamera) {
                input.setAttribute('capture', 'environment');
            } else {
                input.removeAttribute('capture');
            }
            input.click();
        }

        // Parsovat částku - "1234,56" / "1234.56" → desetinné číslo
        function parseAmount(s) {
            if (!s) return null;
            var n = parseFloat(String(s).replace(',', '.'));
            return isNaN(n) ? null : n;
        }

        @if (isDphRozpis)
        {
                <text>
                // DPH rozpis: dopočítat chybějící hodnoty ze zadaných (bez DPH / DPH% / vč. DPH)
                function round2(n) { return Math.round(n * 100) / 100; }

                // Bez DPH + sazba -> DPH, vč. DPH
                function calcFromBezAndRate() {
                    var bez = parseAmount(document.getElementById('AmountWithoutVat').value);
                    var sazba = parseAmount(document.getElementById('VatRatePercent').value);
                    if (sazba === null) sazba = 0;   // prázdné pole DPH % ("0" je jen placeholder) = sazba 0 %
                    if (bez === null) return;
                    var dph = round2(bez * sazba / 100);
                    setComputed('AmountVat', dph);
                    setComputed('AmountWithVat', round2(bez + dph));
                }

                // Vč. DPH + sazba -> bez DPH, DPH
                function calcFromTotalAndRate() {
                    var svc = parseAmount(document.getElementById('AmountWithVat').value);
                    var sazba = parseAmount(document.getElementById('VatRatePercent').value);
                    if (sazba === null) sazba = 0;
                    if (svc === null) return;
                    var bez = round2(svc / (1 + sazba / 100));
                    setComputed('AmountWithoutVat', bez);
                    setComputed('AmountVat', round2(svc - bez));
                }

                // Bez DPH + vč. DPH (bez známé sazby) -> jen částka DPH
                function calcVatFromDiff() {
                    var bez = parseAmount(document.getElementById('AmountWithoutVat').value);
                    var svc = parseAmount(document.getElementById('AmountWithVat').value);
                    if (bez === null || svc === null) return;
                    setComputed('AmountVat', round2(svc - bez));
                }

                // Zapíše hodnotu dopočítanou skriptem a označí pole příznakem "jen dopočítáno" - ať se
                // taková hodnota v dalším kroku nesplete se skutečně zadaným vstupem od uživatele
                // (jinak by se např. sazba 0 % "propsaná" do Vč. DPH mohla vzít jako reálně zadaná
                // celková částka a při doplnění skutečné sazby by se špatně přepočítala částka Bez DPH).
                function setComputed(id, val) {
                    var el = document.getElementById(id);
                    el.value = val;
                    el.dataset.autoFilled = 'true';
                }

                // true, jen pokud pole má hodnotu A tu hodnotu tam sám napsal uživatel (ne skript)
                function hasRealValue(el) {
                    return !!el.value && el.dataset.autoFilled !== 'true';
                }

                document.addEventListener('DOMContentLoaded', function () {
                    var elBez = document.getElementById('AmountWithoutVat');
                    var elSazba = document.getElementById('VatRatePercent');
                    var elVcDph = document.getElementById('AmountWithVat');

                    // Jakmile uživatel do pole sám zasáhne, přestává se brát jako "jen dopočítané"
                    [elBez, elSazba, elVcDph].forEach(function (el) {
                        el.addEventListener('input', function () { el.dataset.autoFilled = 'false'; });
                    });

                    elBez.addEventListener('change', function () {
                        // Pokud je už vyplněná (reálně, ne dopočítaná) celková částka vč. DPH, ale sazba
                        // ne, uživatel má pravděpodobně doklad se známou celkovou částkou - nepřepisovat
                        // ji, jen dopočítat DPH z rozdílu. Jinak přepočítat vč. DPH ze sazby (i nulové).
                        if (!hasRealValue(elSazba) && hasRealValue(elVcDph)) calcVatFromDiff();
                        else calcFromBezAndRate();
                    });
                    elSazba.addEventListener('change', function () {
                        // Sazbu bereme jako výchozí pramen pravdy - pokud je reálně zadaná celková
                        // částka vč. DPH, dopočítáme z ní (typický postup: "mám doklad na 1210 Kč vč. DPH 21 %").
                        if (hasRealValue(elVcDph)) calcFromTotalAndRate();
                        else if (hasRealValue(elBez)) calcFromBezAndRate();
                    });
                    elVcDph.addEventListener('change', function () {
                        if (hasRealValue(elSazba)) calcFromTotalAndRate();
                        else if (hasRealValue(elBez)) calcVatFromDiff();
                    });
                });
                </text>
        }
    </script>
}