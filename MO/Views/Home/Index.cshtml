@model HomeIndexViewModel
@inject BL.Factory _f

<div class="grid gap-3">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
            <h2 class="card-title">
                @_f.tra("Vítejte")@if (_f.CurrentUser != null) {
                <span>, @_f.CurrentUser.FullNameAsc</span>
            }
        </h2>
        <p class="text-base-content/70">
            @_f.tra("Toto je mobilní rozhraní MARKtime. Použijte spodní menu pro navigaci.")
        </p>
    </div>
</div>

<partial name="_Stats" model="Model.Stats" />

<div class="grid grid-cols-2 gap-3">
    <a asp-controller="Calendar" asp-action="Index" data-mo-cal-link class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">today</span>
            <span class="font-medium">@_f.tra("Kalendář")</span>
        </div>
    </a>
    <a asp-action="Ukony" asp-route-format="1" class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">schedule</span>
            <span class="font-medium">@_f.tra("Hodiny")</span>
        </div>
    </a>
    <a asp-action="Ukony" asp-route-format="2" class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">payments</span>
            <span class="font-medium">@_f.tra("Peníze")</span>
        </div>
    </a>
    <a asp-action="Ukony" asp-route-format="3" class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">inventory_2</span>
            <span class="font-medium">@_f.tra("Kusovník")</span>
        </div>
    </a>
    <a asp-action="Tasks" class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">task_alt</span>
            <span class="font-medium">@_f.tra("Úkoly")</span>
        </div>
    </a>
    <a asp-controller="Stopky" asp-action="Index" class="card bg-base-100 shadow-sm hover:bg-base-300 transition">
        <div class="card-body items-center text-center p-4">
            <span class="material-icons-outlined text-primary" style="font-size:32px;">history_toggle_off</span>
            <span class="font-medium">@_f.tra("Stopky")</span>
        </div>
    </a>
</div>
</div>