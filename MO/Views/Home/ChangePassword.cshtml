@model ChangePasswordViewModel

<div class="grid gap-3">

    <div class="flex items-center justify-between">
        <a asp-controller="Home" asp-action="Settings" class="btn btn-ghost btn-sm">
            <span class="material-icons-outlined" style="font-size:20px;">arrow_back</span>
            Zpět
        </a>
        <div class="text-lg font-bold">Změna hesla</div>
        <div style="width:64px;"></div>
    </div>

    <form method="post" asp-action="ChangePassword">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-3 gap-2">

                <label class="form-control">
                    <div class="label"><span class="label-text font-semibold">Současné heslo</span></div>
                    <input type="password" asp-for="CurrentPassword" class="input input-bordered w-full"
                           autocomplete="current-password" />
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text font-semibold">Nové heslo</span></div>
                    <input type="password" asp-for="NewPassword" class="input input-bordered w-full"
                           autocomplete="new-password" />
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text font-semibold">Ověření nového hesla</span></div>
                    <input type="password" asp-for="VerifyPassword" class="input input-bordered w-full"
                           autocomplete="new-password" />
                </label>

            </div>
        </div>

        <div class="grid gap-2 mt-3">
            <button type="submit" class="btn btn-success btn-block">
                <span class="material-icons-outlined" style="font-size:20px;">check</span>
                Potvrdit
            </button>
        </div>
    </form>

</div>