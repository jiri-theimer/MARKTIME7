@model UkolyListViewModel
@inject BL.Factory _f

@{
    var today = DateTime.Today;
    var weekStart = BO.Code.Bas.get_first_prev_monday(today);
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var monthEnd = monthStart.AddMonths(1).AddDays(-1);

    string PeriodBtnCls(DateTime? d1, DateTime? d2)
    {
        bool isActive = Model.DateFrom?.Date == d1?.Date && Model.DateTo?.Date == d2?.Date;
        return "btn btn-xs " + (isActive ? "btn-primary" : "btn-ghost");
    }

    // Návratová URL na tento přehled se stejným filtrem - "Zpět do přehledu úkolů" na detailu úkolu
    var backToUkolyUrl = Url.Action("Tasks", "Home", new
    {
        d1 = Model.DateFrom?.ToString("yyyy-MM-dd"),
        d2 = Model.DateTo?.ToString("yyyy-MM-dd"),
        state = Model.StateFilter
    });
}

<div class="grid gap-3">

    <div class="text-lg font-bold">@_f.tra("Úkoly")</div>

    @* ===== Filtr ===== *@
    <form method="get" asp-action="Tasks" class="card bg-base-100 shadow-sm">
        <div class="card-body p-3 gap-2">

            <div class="grid grid-cols-2 gap-2">
                <label class="form-control">
                    <div class="label"><span class="label-text">@_f.tra("Termín od")</span></div>
                    <input type="date" name="d1" value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           class="input input-bordered input-sm w-full" />
                </label>
                <label class="form-control">
                    <div class="label"><span class="label-text">@_f.tra("Termín do")</span></div>
                    <input type="date" name="d2" value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           class="input input-bordered input-sm w-full" />
                </label>
            </div>

            <div class="flex gap-1" style="flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;">
                <a class="@PeriodBtnCls(null, null)" style="flex-shrink:0;"
                   asp-action="Tasks" asp-route-state="@Model.StateFilter">
                    @_f.tra("Bez omezení")
                </a>
                <a class="@PeriodBtnCls(today, today)" style="flex-shrink:0;"
                   asp-action="Tasks" asp-route-d1="@today.ToString("yyyy-MM-dd")" asp-route-d2="@today.ToString("yyyy-MM-dd")"
                   asp-route-state="@Model.StateFilter">
                    @_f.tra("Dnes")
                </a>
                <a class="@PeriodBtnCls(weekStart, today)" style="flex-shrink:0;"
                   asp-action="Tasks" asp-route-d1="@weekStart.ToString("yyyy-MM-dd")" asp-route-d2="@today.ToString("yyyy-MM-dd")"
                   asp-route-state="@Model.StateFilter">
                    @_f.tra("Tento týden")
                </a>
                <a class="@PeriodBtnCls(monthStart, monthEnd)" style="flex-shrink:0;"
                   asp-action="Tasks" asp-route-d1="@monthStart.ToString("yyyy-MM-dd")" asp-route-d2="@monthEnd.ToString("yyyy-MM-dd")"
                   asp-route-state="@Model.StateFilter">
                    @_f.tra("Tento měsíc")
                </a>
            </div>

            <label class="form-control">
                <div class="label"><span class="label-text">@_f.tra("Stav")</span></div>
                <select name="state" class="select select-bordered select-sm w-full">
                    <option value="0" selected="@(Model.StateFilter == 0)">@_f.tra("Otevřené")</option>
                    <option value="1" selected="@(Model.StateFilter == 1)">@_f.tra("Vše")</option>
                    <option value="2" selected="@(Model.StateFilter == 2)">@_f.tra("Uzavřené")</option>
                </select>
            </label>

            <button type="submit" class="btn btn-primary btn-sm btn-block mt-1">
                <span class="material-icons-outlined" style="font-size:16px;">filter_alt</span>
                @_f.tra("Filtrovat")
            </button>
        </div>
    </form>

    @* ===== Souhrn ===== *@
    <div class="px-1 text-sm text-base-content/60">
        @Model.TotalCount @_f.tra("úkolů")
    </div>

    @if (Model.IsTruncated)
    {
        <div role="alert" class="alert alert-warning">
            <span class="material-icons-outlined" style="font-size:18px;">warning</span>
            <span>@_f.tra("Výsledek je oříznut na prvních 300 záznamů - zúžte prosím filtr.")</span>
        </div>
    }

    @* ===== Seznam úkolů ===== *@
    @if (!Model.Entries.Any())
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center py-8">
                <span class="material-icons-outlined text-base-content/30" style="font-size:48px;">task_alt</span>
                <div class="text-base-content/60">@_f.tra("Žádné úkoly nevyhovují filtru.")</div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-2">
            @* Karta vede na Ukol/Edit - zobrazení detailu a jednoduchá aktualizace stavu/termínu/poznámky *@
            @foreach (var task in Model.Entries)
            {
                var isOverdue = task.p56PlanUntil.HasValue && task.p56PlanUntil.Value.Date < today
                    && task.p56OutlookStatus != BO.p56OutlookStatusEnum.Dokonceno;

                <div id="task-@task.pid" class="card bg-base-100 shadow-sm hover:bg-base-300 transition @(isOverdue ? "ring-1 ring-error" : "")">
                    <a asp-controller="Ukol" asp-action="Edit" asp-route-id="@task.pid"
                       asp-route-ret="ukoly" asp-route-retd="@backToUkolyUrl" class="card-body p-3 block">
                        <div class="flex items-start gap-2">
                            <div class="min-w-0 flex-1">
                                <div class="font-semibold text-sm" style="overflow-wrap:break-word;">@task.p56Name</div>
                                @if (!string.IsNullOrEmpty(task.p41Name))
                                {
                                    <div class="text-xs text-base-content/50">@task.ProjectWithClient</div>
                                }
                                @if (task.p56PlanUntil.HasValue)
                                {
                                    <div class="text-xs mt-1 @(isOverdue ? "text-error font-semibold" : "text-base-content/60")">
                                        <span class="material-icons-outlined" style="font-size:12px;vertical-align:middle;">event</span>
                                        @_f.tra("Termín") @task.p56PlanUntil.Value.ToString("d. M. yyyy")
                                        @if (isOverdue)
                                        {
                                            <text> · @_f.tra("po termínu")</text>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="badge badge-sm badge-outline gap-1.5 shrink-0">
                                <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background-color:@task.b02Color;flex-shrink:0;"></span>
                                @task.b02Name
                            </div>
                        </div>
                    </a>

                    @if (task.p41ID > 0)
                    {
                        <div class="px-3 pb-3">
                            <a asp-controller="Ukon" asp-action="New" asp-route-p41id="@task.p41ID" asp-route-p56id="@task.pid"
                               class="btn btn-ghost btn-xs">
                                <span class="material-icons-outlined" style="font-size:14px;">schedule</span>
                                @_f.tra("Vykázat úkon")
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    }

</div>

@section scripts {
    <script>
        (function () {
            var STORAGE_KEY = 'mo-tasks-filter';
            var params = new URLSearchParams(window.location.search);
            var hasAnyFilterParam = params.has('d1') || params.has('d2') || params.has('state');

            if (!hasAnyFilterParam) {
                // Na stránku jsme přišli bez filtru v URL (např. z dockové navigace) -
                // pokud máme uložený poslední filtr, přesměrovat na něj.
                var saved = null;
                try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)); } catch (e) { saved = null; }

                if (saved && (saved.d1 || saved.d2 || saved.state)) {
                    var qs = new URLSearchParams(saved).toString();
                    window.location.replace(window.location.pathname + '?' + qs + window.location.hash);
                    return;
                }
            }

            // Uložit aktuálně použitý (vykreslený) filtr pro příště
            var current = {
                d1: '@Model.DateFrom?.ToString("yyyy-MM-dd")',
                d2: '@Model.DateTo?.ToString("yyyy-MM-dd")',
                state: '@Model.StateFilter'
            };
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(current)); } catch (e) { }
        })();

        document.addEventListener('DOMContentLoaded', function () {
            var hash = window.location.hash;
            if (!hash || hash.indexOf('#task-') !== 0) return;

            var el = document.querySelector(hash);
            if (!el) return;

            el.scrollIntoView({ block: 'center', behavior: 'smooth' });

            // Krátké zvýraznění, ať je jasné, na který záznam se odscrollovalo
            el.classList.add('mo-highlight-flash');
            setTimeout(function () {
                el.classList.remove('mo-highlight-flash');
            }, 2000);
        });
    </script>
    <style>
        @@keyframes moHighlightFlash {
            0% {
                box-shadow: 0 0 0 3px rgba(250,204,21,.9);
            }

            100% {
                box-shadow: 0 0 0 3px rgba(250,204,21,0);
            }
        }

        .mo-highlight-flash {
            animation: moHighlightFlash 2s ease-out;
        }
    </style>
}