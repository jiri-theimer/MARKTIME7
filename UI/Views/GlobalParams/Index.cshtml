@model UI.Models.GlobalParamsViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Doplňující parametry");
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
}

@addTagHelper *, UI


<div class="bg-light" style="padding:10px;">
    @if (Model.lisO58.Count() > 0)
    {
        <button id="cmdSave" class="btn btn-success" onclick="_submit()">@_f.tra("Uložit změny")</button>
    }
    

    <button type="button" id="cmdClose" onclick="_window_close()" class="btn btn-light">@_f.tra("Zavřít")</button>



</div>


<form id="form1" asp-controller="GlobalParams" asp-action="Index" method="POST">
    <input type="hidden" asp-for="prefix" />
    <input type="hidden" asp-for="pid" />

    <div style="max-width:1000px">

        @foreach (var c in Model.lisO58.Where(p => p.o58IsPerUser))
        {
            <button type="button" class="btn btn-sm bog" onclick="handle_add_row(@c.pid)">
                <span class="material-icons-outlined-btn menu_new_record">add_circle_outline</span>
                @c.o58Name
            </button>
        }


        @if (Model.lisO58.Count() == 0)
        {
            <div class="alert alert-primary" role="alert">
                Pro tuto entitu (@(BO.Code.Entity.GetAlias(Model.prefix))) zatím neexistují doplňující parametry.
                <hr />
                Doplňující parametry se definují v administraci <a target="_blank" href="/Admin/Page?area=misc&prefix=o58"><strong>ZDE</strong></a>.
            </div>
        }

        <table class="table table-hover" style="table-layout: fixed;">
            
            @for (int i = 0; i < Model.lisO59.Count; i++)
            {
                <tr style="@(Model.lisO59[i].CssTempDisplay)">
                    <td>
                        <span>
                            @Model.lisO59[i].o58Name
                        </span>
                        <input type="hidden" asp-for="lisO59[i].o58ID" />
                        <input type="hidden" asp-for="lisO59[i].pid" />
                        <input type="hidden" asp-for="lisO59[i].o58Name" />
                        <input type="hidden" asp-for="lisO59[i].x24ID" />
                        <input type="hidden" asp-for="lisO59[i].o58IsPerUser" />
                        <input type="hidden" asp-for="lisO59[i].ComboPerson" />
                        
                        
                        <input type="hidden" asp-for="lisO59[i].IsTempDeleted" value="@Model.lisO59[i].IsTempDeleted" />
                        <input type="hidden" asp-for="lisO59[i].TempGuid" value="@Model.lisO59[i].TempGuid" />
                        
                        
                    </td>
                    <td style="width:200px;">
                        @if (Model.lisO59[i].o58IsPerUser)
                        {
                            <mycombo entity="j02User" placeholder="Uživatel" asp-for="lisO59[i].j02ID" selectedtext="@Model.lisO59[i].ComboPerson" view-flag="2"></mycombo>
                        
                            
                        }
                    </td>
                    
                    <td>
                        
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tDecimal)
                        {
                            <mynumber asp-for="lisO59[i].o59ValueNum" decimal-digits="2" placeholder="Hodnota"></mynumber>
                        }
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tInteger)
                        {
                            <mynumber asp-for="lisO59[i].o59ValueNum" decimal-digits="0"></mynumber>
                        }
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tDate)
                        {
                            <mydate asp-for="lisO59[i].o59ValueDate" include-time="false"></mydate>
                        }
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tDateTime)
                        {
                            <mydate asp-for="lisO59[i].o59ValueDate" include-time="true"></mydate>
                        }
                       
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tString)
                        {
                            <input type="text" class="form-control" asp-for="lisO59[i].o59ValueString" placeholder="Hodnota" />
                        }
                        @if (Model.lisO59[i].x24ID == BO.x24IdENUM.tBoolean)
                        {
                            <input type="checkbox" asp-for="lisO59[i].o59ValueBoolean" />
                            <mylabel class="col-form-label" text="ANO" bez-dvojtecky="true" explicit-for="lisO59_@(i)__o59ValueBoolean"></mylabel>
                        }
                    </td>
                    <td>
                        <input type="text" class="form-control" asp-for="lisO59[i].o59Memo" placeholder="Poznámka" />
                    </td>
                    <td style="width:40px;">
                        @if (Model.lisO59[i].o58IsPerUser)
                        {
                            <button type="button" class="btn btn-danger" title="@_f.tra("Odstranit řádek")" onclick="handle_delete_row('@(Model.lisO59[i].TempGuid)')">x</button>
                        }
                            
                    </td>

                </tr>
            }
        </table>




    </div>

</form>



<script type="text/javascript">
    $(document).ready(function () {






    })

   

    function handle_delete_row(guid) {
        _postback("delete_row", "guid=" + guid);
      

    }
    function handle_add_row(o58id) {
        _postback("add_row","o58id="+o58id);
       
    }

</script>



