@model UI.Models.AI.AiGridViewModel
@inject BL.Factory _f
@{
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    var chatSettings = new UI.Models.AI.AiChatSettings
    {
        Intro = _f.tra("Napište, jaké sloupce má tabulka zobrazit nebo které záznamy chcete vidět. Např.: „přidej klienta a datum splatnosti“, „dej částky na konec“, „jen neuhrazené po splatnosti“, „úkoly po termínu, kde jsem řešitel“."),
        Thinking = _f.tra("Připravuji návrh…"),
        Feature = Model.Feature
    };
}

<link rel="stylesheet" href="~/css/ai/aigrid.css" asp-append-version="true" />

<div class="ai-toolbar">
    <span class="ai-toolbar-title">@Model.EntityName – @Model.TableName</span>
    <button type="button" id="cmdAiClear" class="btn btn-warning me-2" title="@_f.tra("Začít znovu – smaže konverzaci, sloupce i filtr")">@_f.tra("Vyčistit")</button>
    <button type="button" id="cmdClose" onclick="_window_close()" class="btn btn-light">@_f.tra("Zavřít")</button>
</div>

<div class="row ai-wrap">
    <!-- CHAT (společná komponenta) -->
    <div class="col-12 col-md-5 ai-chat-pane">
        <partial name="~/Views/Shared/AI/_AiChat.cshtml" model="chatSettings" />
    </div>

    <!-- NÁVRH -->
    <div class="col-12 col-md-7 ai-form-col">
        <label class="form-label">@_f.tra("Sloupce tabulky (zleva doprava)")</label>
        <div id="ai_columns" class="ai-col-list"></div>
        <select id="ai_add" class="form-select form-select-sm mt-1"></select>

        <div id="ai_fixed" class="mt-3">
            <label class="form-label">@_f.tra("Pevné filtry nad tabulkou") <small class="text-muted">(@_f.tra("platí pro všechny tabulky této entity"))</small></label>
            <div class="row g-2">
                <div class="col-12 col-lg-6" id="ai_box_period">
                    <select id="ai_period" class="form-select form-select-sm" title="@_f.tra("Časové období")"></select>
                    <select id="ai_period_field" class="form-select form-select-sm mt-1" title="@_f.tra("Datum, ke kterému se období vztahuje")"></select>
                    <div id="ai_period_custom" class="ai-period-custom mt-1" style="display:none;">
                        <input id="ai_d1" type="date" class="form-control form-control-sm" />
                        <input id="ai_d2" type="date" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <select id="ai_state" class="form-select form-select-sm ai-box" title="@_f.tra("Stav úkonů")"></select>
                    <select id="ai_tab" class="form-select form-select-sm ai-box mt-1" title="@_f.tra("Formát úkonů")"></select>
                    <select id="ai_archive" class="form-select form-select-sm ai-box mt-1" title="@_f.tra("Archiv")"></select>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">@_f.tra("Sloupcový filtr")</label>
            <div id="ai_filters"></div>
            <select id="ai_add_filter" class="form-select form-select-sm mt-1"></select>
            <div id="ai_box_match" class="form-check mt-1">
                <input id="ai_match_any" type="checkbox" class="form-check-input" />
                <label for="ai_match_any" class="form-check-label">@_f.tra("Stačí splnit jednu z podmínek (NEBO)")</label>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label">@_f.tra("Název nové tabulky")</label>
            <input id="ai_name" class="form-control form-control-sm" maxlength="100" placeholder="@_f.tra("Vyplňte pro „Uložit jako novou tabulku“")" />
        </div>

        <div id="ai_warnings" class="alert alert-warning py-1 px-2 mt-2" style="display:none;"></div>

        <div class="mt-2">
            @if (Model.CanOverwrite)
            {
                <button id="ai_overwrite" type="button" class="btn btn-primary me-2">@_f.tra("Přepsat tabulku") „@Model.TableName“</button>
            }
            <button id="ai_save" type="button" class="btn btn-success me-2">@_f.tra("Uložit jako novou tabulku")</button>
            <button id="ai_apply_filter" type="button" class="btn bog" title="@_f.tra("Tabulku nemění, jen nastaví pevné filtry a sloupcový filtr")">@_f.tra("Použít jen filtry")</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    var _ai_catalog = @Html.Raw(Model.CatalogJson);
    var _ai_fixed = @Html.Raw(Model.FixedJson);      // nabídky pevných filtrů (null = filtr v gridu není)
    var _ai_initial = @Html.Raw(Model.InitialJson);
    var _ai_initial_warnings = @Html.Raw(Model.InitialWarningsJson);
    var _ai_j72id = @Model.J72ID;
    var _ai_pathname = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CallerPathName ?? ""));
    var _ai_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        error = _f.tra("Chyba"),
        add = _f.tra("+ přidat sloupec…"),
        left = _f.tra("Posunout doleva"),
        right = _f.tra("Posunout doprava"),
        remove = _f.tra("Odebrat"),
        nameRequired = _f.tra("Vyplňte název nové tabulky."),
        addFilter = _f.tra("+ přidat podmínku…"),
        valuesHint = _f.tra("více hodnot oddělte středníkem"),
        ops = new
        {
            contains = _f.tra("obsahuje"),
            notcontains = _f.tra("neobsahuje"),
            starts = _f.tra("začíná na"),
            equal = _f.tra("je rovno"),
            notequal = _f.tra("není rovno"),
            empty = _f.tra("je prázdné"),
            notempty = _f.tra("není prázdné"),
            interval = _f.tra("od – do"),
            gtzero = _f.tra("je větší než nula"),
            zeroorempty = _f.tra("je nula nebo prázdné"),
            yes = _f.tra("ANO"),
            no = _f.tra("NE")
        }
    }));
</script>
<script src="~/js/ai/aigrid.js" asp-append-version="true"></script>
