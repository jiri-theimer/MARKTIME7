@model UI.Models.Guru.TotalCloudRegisterViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Registrace");
    Layout = "~/Views/Shared/_LayoutAnonym.cshtml";
}

@section header_content
{
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="lg-wrap">
    <div class="lg-card">
        <a href="/Login/UserLogin"><img class="lg-logo" src="/images/logo_default.png" alt="MARKTIME" /></a>

        @if (Model.IsClosed)
        {
            <h1 class="lg-title">@_f.tra("Registrace")</h1>
            <div class="lg-alert" role="alert">@Model.Message</div>
        }
        else
        {
            <div id="rgStep1">
                <h1 class="lg-title">@_f.tra("Založte si účet zdarma")</h1>
                <p class="lg-hint">@_f.tra("Pro jednoho uživatele zdarma a navždy, bez omezení funkcí.")</p>

                <div class="lg-alert" id="rgError" role="alert" hidden="@(Model.Message == null)">@Model.Message</div>

                @if (Model.AllowGoogle)
                {
                    <a href="/CreateLicenseFree/GoogleSignIn?countrycode=@Model.CountryCode" class="btn lg-google">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                        </svg>
                        @_f.tra("Pokračovat přes Google")
                    </a>
                    <div class="lg-or"><span>@_f.tra("nebo e-mailem")</span></div>
                }

                <form id="rgForm" method="post" action="/CreateLicenseFree/SendLink" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="countrycode" value="@Model.CountryCode" />
                    <div class="lg-field">
                        <label for="rgEmail">@_f.tra("Váš e-mail")</label>
                        <input type="email" id="rgEmail" name="email" class="form-control" autocomplete="email" autocapitalize="none" spellcheck="false" maxlength="100" required autofocus />
                    </div>
                    @if (Model.TurnstileSiteKey != null)
                    {
                        <div class="rg-turnstile"><div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="light" data-size="flexible" data-language="cs"></div></div>
                    }
                    <button type="submit" id="rgSend" class="btn lg-submit" data-busy="@_f.tra("Odesílám…")">@_f.tra("Pokračovat")</button>
                </form>

                <p class="rg-note">@_f.tra("Pošleme vám odkaz, kterým registraci dokončíte. E-mail bude zároveň vaše přihlašovací jméno.")</p>
                <p class="rg-note">@_f.tra("Pokračováním souhlasíte s") <a href="/docs/marktime_sluzba_podminky.pdf" target="_blank" rel="noopener" class="lg-link">@_f.tra("podmínkami užití služby")</a>.</p>
            </div>

            <div id="rgStep2" class="lg-center" hidden>
                <div class="lg-done" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.2-8 5-8-5V6l8 5 8-5v2.2z" /></svg>
                </div>
                <h1 class="lg-title">@_f.tra("Zkontrolujte e-mail")</h1>
                <p class="rg-sent">@_f.tra("Na adresu") <b id="rgSentTo"></b> @_f.tra("jsme poslali odkaz pro dokončení registrace. Platí 24 hodin.")</p>
                <p class="rg-note">@_f.tra("Zpráva nedorazila? Podívejte se do nevyžádané pošty, nebo") <a href="#" id="rgAgain" class="lg-link">@_f.tra("zadejte e-mail znovu")</a>.</p>
            </div>
        }

        <div class="lg-back">
            @_f.tra("Už účet máte?") <a href="/Login/UserLogin" class="lg-link">@_f.tra("Přihlásit se")</a>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.TurnstileSiteKey != null)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <script src="~/js/register.js" asp-append-version="true"></script>
}
