@model UI.Models.Guru.CreateLicenseFreeGoogleViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = "Registrace přes Google";
    Layout = "~/Views/Shared/_LayoutAnonym.cshtml";
}

<div style="margin:auto; max-width:900px;">

    <h4>Registrace nové licence MARKTIME-FREELANCE přes Google</h4>

    @if (Model.Message != null)
    {
        <div class="alert alert-danger" role="alert">
            <h4>@Html.Raw(Model.Message)</h4>
        </div>
    }

    <div class="alert alert-success d-flex align-items-center" style="max-width:750px;">
        <span class="material-icons-outlined-btn me-2">check_circle</span>
        Google účet ověřen. Doplňte prosím název firmy a dokončete registraci.
    </div>

    <form asp-controller="CreateLicenseFree" asp-action="GoogleRegister" method="post"
          style="max-width:750px;">

        @Html.AntiForgeryToken()

        <div class="row mt-3">
            <label class="col-sm-3 col-form-label">Kód země:</label>
            <div class="col-sm-4">
                <select class="form-select" asp-for="CountryCode">
                    <option value="CZ">CZ</option>
                    <option value="SK">SK</option>
                </select>
            </div>
        </div>

        <div class="row mt-2">
            <label class="col-sm-3 col-form-label">E-mail:</label>
            <div class="col-sm-4">
                <input class="form-control" type="text" value="@Model.Email" readonly
                       style="background-color:#e9ecef;" />
                <input type="hidden" asp-for="Email" />
            </div>
            <div class="col-sm-5 d-flex align-items-center">
                <small class="text-muted">Přebráno z Google účtu.</small>
            </div>
        </div>

        <div class="row mt-2">
            <label class="col-sm-3 col-form-label" for="p93Company">
                Název firmy: <span class="text-danger">*</span>
            </label>
            <div class="col-sm-4">
                <input class="form-control"
                       asp-for="p93Company"
                       required="true"
                       value="@Model.p93Company"
                       autofocus />
                <span asp-validation-for="p93Company" class="text-danger small"></span>
            </div>
        </div>

        <div class="row mt-2">
            <label class="col-sm-3 col-form-label" for="FirstName">
                Jméno: <span class="text-danger">*</span>
            </label>
            <div class="col-sm-4">
                <input class="form-control"
                       asp-for="FirstName"
                       required="true"
                       value="@Model.FirstName" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-sm-5 d-flex align-items-center">
                <small class="text-muted">Předvyplněno z Google, lze upravit.</small>
            </div>
        </div>

        <div class="row mt-2">
            <label class="col-sm-3 col-form-label" for="LastName">
                Příjmení: <span class="text-danger">*</span>
            </label>
            <div class="col-sm-4">
                <input class="form-control"
                       asp-for="LastName"
                       required="true"
                       value="@Model.LastName" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
            <div class="col-sm-5 d-flex align-items-center">
                <small class="text-muted">Předvyplněno z Google, lze upravit.</small>
            </div>
        </div>

        <hr class="mt-4" />

        <div class="row">
            <div class="col-sm-9 offset-sm-3">
                <input type="submit" value="Vytvořit účet" class="btn btn-success btn-lg" />
            </div>
        </div>

        <div class="mt-3">
            <small class="text-muted">
                Vytvořením účtu souhlasíte s
                <a href="/docs/marktime_sluzba_podminky.pdf" target="_blank">podmínkami užití služby</a>.<br />
                Heslo bude automaticky vygenerováno a zasláno na váš e-mail.
                Po přihlášení si ho doporučujeme změnit.
            </small>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
