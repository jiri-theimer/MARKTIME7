@model TheGridReportViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = "GRID-REPORT";
    Layout = "~/Views/Shared/_LayoutModal.cshtml";

    //při chybě (chybí šablona sestavy) controller sloupce nenaplní – stránka se má i tak vykreslit s hláškou
    var _cols = Model.GridColumns ?? new List<BO.TheGridColumn>();
    var _groupCols = _cols.Where(p => !p.IsShowTotals && !p.IsNotUseP31TOTALS).ToList();
    bool _isReady = Model.GridColumns != null && !string.IsNullOrEmpty(Model.TrdxRepSourceFileName);
    int _selCount = string.IsNullOrEmpty(Model.pids) ? 0 : Model.pids.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
}

@addTagHelper *, UI

<style type="text/css">
    /* GRID-REPORT: lišta, nastavení v jednom pruhu, náhled sestavy vyplňuje zbytek okna */
    .gr-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding: 8px 12px; background-color: #f7f8fa; border-bottom: 1px solid #e3e6ea; }
    .gr-title { font-weight: 700; font-size: 110%; color: #1f2328; }
    .gr-scope { padding: 1px 10px; border-radius: 999px; background-color: #e7eefc; color: #1f3b7a; font-size: 88%; white-space: nowrap; }
    .gr-bar-right { margin-left: auto; display: flex; flex-wrap: wrap; gap: 6px; }
    .gr-bar .btn { white-space: nowrap; }

    .gr-settings { display: flex; flex-wrap: wrap; gap: 8px; padding: 8px 12px; }
    .gr-settings.gr-collapsed { display: none; }     /* sbalené nastavení: celé okno pro náhled */
    .gr-card { flex: 0 1 auto; min-width: 0; border: 1px solid #e3e6ea; border-radius: 10px; background-color: #fff; padding: 5px 10px 7px 10px; }
    .gr-card-title { font-size: 76%; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #6b7480; margin-bottom: 3px; }
    .gr-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px; }
    .gr-field { display: flex; flex-direction: column; gap: 2px; }
    .gr-field > label { font-size: 82%; color: #59636e; margin: 0; }
    .gr-field .form-control, .gr-field .form-select { min-width: 0; }
    .gr-w-header { width: 230px; max-width: 100%; }
    .gr-w-col { width: 170px; max-width: 100%; }
    .gr-w-num { width: 58px; text-align: right; }
    .gr-check { display: flex; align-items: center; gap: 6px; margin: 0; padding-bottom: 5px; font-size: 92%; white-space: nowrap; cursor: pointer; }    /* v řádku polí, zarovnané na spodní linku */

    /* pruh pro nastavení šířek sloupců */
    .gr-resizer { display: flex; align-items: stretch; gap: 8px; margin: 0 12px 10px 12px; padding: 8px 10px; border: 1px dashed #c9d1da; border-radius: 10px; background-color: #fff; overflow-x: auto; }
    .gr-resizer-hint { flex: 0 0 auto; display: flex; align-items: center; gap: 6px; font-size: 85%; color: #59636e; white-space: nowrap; }
    #tabResizer { flex: 0 0 auto; width: auto; background-color: #fff; font-size: 80%; table-layout: fixed; }     /* nemačkat: šířky odpovídají sestavě, pruh se posouvá vodorovně */
    #tabResizer th { position: relative; text-align: center; font-weight: normal; background-color: #f1f3f5; border-right: 2px solid #9aa3ad; color: #47515c; height: 34px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 6px; }
    #tabResizer th:hover { background-color: #e7eefc; }
    #tabResizer .resizer { position: absolute; top: 0; right: -8px; bottom: 0; left: auto; width: 16px; cursor: col-resize; }

    /* náhled sestavy */
    .gr-viewer { position: relative; margin: 0 12px; border: 1px solid #e3e6ea; border-radius: 10px; overflow: hidden; background-color: #fff; min-height: 240px; }
    .gr-viewer iframe { display: block; width: 100%; height: 100%; border: 0; }
    .gr-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: rgba(255,255,255,.75); color: #59636e; }
    .gr-loading.gr-hidden { display: none; }
    .gr-empty { padding: 30px; color: #59636e; }
</style>

<form id="form1" asp-controller="TheGridReport" asp-action="Index" method="POST">
    <input type="hidden" asp-for="j72id" />
    <input type="hidden" asp-for="master_prefix" />
    <input type="hidden" asp-for="master_pid" />
    <input type="hidden" asp-for="pids" />
    <input type="hidden" asp-for="guid" />
    <input type="hidden" asp-for="p31guid" />
    <input type="hidden" asp-for="ResizedField" />
    <input type="hidden" asp-for="ResizedWidth" />
    <input type="hidden" asp-for="TrdxRepDestFileName" />

    <div class="gr-bar">
        <span class="gr-title">GRID-REPORT</span>
        @if (_selCount > 0)
        {
            <span class="gr-scope">@_f.tra("Vybrané záznamy"): @_selCount</span>
        }
        else
        {
            <span class="gr-scope">@_f.tra("Všechny záznamy tabulky")</span>
        }

        <div class="gr-bar-right">
            <button id="cmdSettings" type="button" class="btn btn-sm btn-light" onclick="gr_toggle_settings()" title="@_f.tra("Skrýt nebo zobrazit nastavení sestavy")">
                <span class="material-icons-outlined-btn">tune</span>
                @_f.tra("Nastavení")
            </button>
            <button id="cmdSendByMail" type="button" class="btn btn-sm btn-light" onclick="send_by_mail()" disabled="@(!_isReady)">
                <span class="material-icons-outlined-btn">email</span>
                @_f.tra("Odeslat poštou")
            </button>
            <button type="button" class="btn btn-sm btn-light" onclick="postback('reload')" title="@_f.tra("Načíst sestavu znovu s aktuálními daty")">
                <span class="material-icons-outlined-btn">refresh</span>
                @_f.tra("Občerstvit")
            </button>
            <button type="button" id="cmdClose" onclick="_window_close()" class="btn btn-sm btn-light">
                <span class="material-icons-outlined-btn">close</span>
                @_f.tra("Zavřít")
            </button>
        </div>
    </div>

    <div id="divSettings" class="gr-settings">
        <div class="gr-card">
            <div class="gr-card-title">@_f.tra("Obsah sestavy")</div>
            <div class="gr-row">
                <div class="gr-field">
                    <label for="Header">@_f.tra("Nadpis sestavy")</label>
                    <input type="text" class="form-control form-control-sm gr-w-header" asp-for="Header" autocomplete="off" onchange="postback('header')" />
                </div>
                <div class="gr-field">
                    <label for="GroupByColumn">@_f.tra("Souhrny podle sloupce")</label>
                    <select asp-for="GroupByColumn" class="form-select form-select-sm gr-w-col" onchange="postback('groupby')">
                        <option value="">@_f.tra("Bez souhrnů")</option>
                        @foreach (var fld in _groupCols)
                        {
                            <option value="@fld.UniqueName">@fld.Header</option>
                        }
                    </select>
                </div>
                @if (!Model.IsShowGroupsOnly)
                {
                    <div class="gr-field">
                        <label for="PageBreakColumn">@_f.tra("Odstránkovat podle sloupce")</label>
                        <select asp-for="PageBreakColumn" class="form-select form-select-sm gr-w-col" onchange="postback('pageby')">
                            <option value="">@_f.tra("Bez odstránkování")</option>
                            @foreach (var fld in _groupCols)
                            {
                                <option value="@fld.UniqueName">@fld.Header</option>
                            }
                        </select>
                    </div>
                }
                @if (Model.GroupByColumn != null && Model.PageBreakColumn == null)
                {
                    <label class="gr-check" for="IsShowGroupsOnly" title="@_f.tra("Zobrazovat pouze řádky souhrnů a součtové sloupce")">
                        <input type="checkbox" asp-for="IsShowGroupsOnly" onchange="postback('refresh')" />
                        @_f.tra("Jen souhrny")
                    </label>
                }
            </div>
        </div>

        <div class="gr-card">
            <div class="gr-card-title">@_f.tra("Stránka")</div>
            <div class="gr-row">
                <div class="gr-field">
                    <label>@_f.tra("Orientace A4")</label>
                    <div class="btn-group btn-group-sm" role="group">
                        <input id="opgNaVysku" class="btn-check" asp-for="PageOrientation" type="radio" value="1" onchange="postback('orientation')" />
                        <label class="btn btn-outline-secondary" for="opgNaVysku">@_f.tra("Na výšku")</label>
                        <input id="opgNaSirku" class="btn-check" asp-for="PageOrientation" type="radio" value="2" onchange="postback('orientation')" />
                        <label class="btn btn-outline-secondary" for="opgNaSirku">@_f.tra("Na šířku")</label>
                    </div>
                </div>
                <div class="gr-field">
                    <label for="ZoomPercentage" title="@_f.tra("Poměr šířky sloupců sestavy oproti sloupcům v tabulce")">@_f.tra("Šířka sloupců")</label>
                    <select asp-for="ZoomPercentage" class="form-select form-select-sm" onchange="postback('zoom')" title="@_f.tra("Poměr šířky sloupců sestavy oproti sloupcům v tabulce")">
                        <option value="100">100%</option>
                        <option value="90">90%</option>
                        <option value="80">80%</option>
                        <option value="70">70%</option>
                        <option value="60">60%</option>
                        <option value="50">50%</option>
                    </select>
                </div>
                <div class="gr-field">
                    <label for="MaxTopRecs">@_f.tra("Nejvýše řádků")</label>
                    <select asp-for="MaxTopRecs" class="form-select form-select-sm" onchange="postback('toprecs')">
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                        <option value="2000">2000</option>
                        <option value="5000">5000</option>
                    </select>
                </div>
                <label class="gr-check" for="IsEnableResizer" title="@_f.tra("Možnost nastavovat šířky sloupců")">
                    <input type="checkbox" asp-for="IsEnableResizer" onchange="postback('IsEnableResizer')" />
                    @_f.tra("Šířky sloupců ručně")
                </label>
            </div>
        </div>

        <div class="gr-card">
            <div class="gr-card-title">@_f.tra("Okraje (v milimetrech)")</div>
            <div class="gr-row">
                <div class="gr-field">
                    <label for="MarginLeft">@_f.tra("Vlevo")</label>
                    <input asp-for="MarginLeft" type="number" min="0" max="50" class="form-control form-control-sm gr-w-num" onchange="postback('margins')" />
                </div>
                <div class="gr-field">
                    <label for="MarginRight">@_f.tra("Vpravo")</label>
                    <input asp-for="MarginRight" type="number" min="0" max="50" class="form-control form-control-sm gr-w-num" onchange="postback('margins')" />
                </div>
                <div class="gr-field">
                    <label for="MarginTop">@_f.tra("Nahoře")</label>
                    <input asp-for="MarginTop" type="number" min="0" max="50" class="form-control form-control-sm gr-w-num" onchange="postback('margins')" />
                </div>
                <div class="gr-field">
                    <label for="MarginBottom">@_f.tra("Dole")</label>
                    <input asp-for="MarginBottom" type="number" min="0" max="50" class="form-control form-control-sm gr-w-num" onchange="postback('margins')" />
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsEnableResizer && _cols.Count > 0)
    {
        <div id="divResizer" class="gr-resizer">
            <div class="gr-resizer-hint">
                <span class="material-icons-outlined-btn">swap_horiz</span>
                @_f.tra("Šířku změníte tažením pravého okraje sloupce")
            </div>
            <button id="cmdResetWidths" type="button" class="btn btn-sm btn-light" style="flex:0 0 auto;" onclick="reset_resizer()" title="@_f.tra("Nahodí šířky sloupců do výchozího (továrního) stavu")">
                <span class="material-icons-outlined-btn">restart_alt</span>
                @_f.tra("Výchozí šířky")
            </button>
            <table id="tabResizer">
                <tr id="tr_columns">
                    @foreach (var c in _cols)
                    {
                        <th id="@c.UniqueName" title="@c.Header (@(c.Rezerva)px)" style="width:@(c.Rezerva)px;">@c.Header</th>
                    }
                </tr>
            </table>
        </div>
    }
</form>

<div id="divViewer" class="gr-viewer">
    @if (_isReady)
    {
        <iframe id="fra1" scrolling="no" src="/TheGridReport/ReportViewer?guid=@(Uri.EscapeDataString(Model.guid ?? ""))"></iframe>
        <div id="divLoading" class="gr-loading">
            <span class="spinner-border spinner-border-sm" role="status"></span>
            @_f.tra("Připravuji sestavu…")
        </div>
    }
    else
    {
        <div class="gr-empty">@_f.tra("Sestavu se nepodařilo připravit.")</div>
    }
</div>


<script type="text/javascript">
    var _gr_trdxfile = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrdxRepDestFileName ?? ""));
    var _gr_header = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Header ?? ""));

    $(document).ready(function () {
        try {
            if (localStorage.getItem("gridreport-settings") === "0") document.getElementById("divSettings").classList.add("gr-collapsed");
        } catch (e) { }
        gr_fit();
        var t = null;
        $(window).on("resize", function () {    //náhled sleduje velikost okna
            clearTimeout(t);
            t = setTimeout(gr_fit, 100);
        });

        var fra = document.getElementById("fra1");
        if (fra) {
            fra.addEventListener("load", function () {
                $("#divLoading").addClass("gr-hidden");
            });
        }

        //Enter v poli (nadpis, okraje) nesmí odeslat formulář jako potvrzení okna: potvrdí jen hodnotu pole
        document.getElementById("form1").addEventListener("keydown", function (e) {
            if (e.key === "Enter" && e.target.tagName === "INPUT") {
                e.preventDefault();
                e.target.blur();
            }
        });

        InitResizer();
    });

    function gr_fit() {     //náhled vyplní okno až ke spodnímu okraji
        var box = document.getElementById("divViewer");
        if (!box) return;
        var h = window.innerHeight - box.getBoundingClientRect().top - 10;
        if (h < 240) h = 240;
        box.style.height = parseInt(h) + "px";
    }

    function gr_toggle_settings() {     //skrýt/zobrazit nastavení – na menším okně zůstane víc místa pro náhled
        var collapsed = document.getElementById("divSettings").classList.toggle("gr-collapsed");
        try { localStorage.setItem("gridreport-settings", collapsed ? "0" : "1"); } catch (e) { }
        gr_fit();
    }

    function postback(oper) {
        $("#divLoading").removeClass("gr-hidden");
        _postback(oper);
    }

    function reset_resizer() {
        postback("reset");
    }

    function InitResizer() {
        if (!document.getElementById("tr_columns")) return;
        $("#tr_columns").find("th")
            .prepend("<div class='resizer'></div>")
            .resizable({
                resizeHeight: false,
                handleSelector: "",
                onDragStart: function (e, $el, opt) {
                    // only drag resizer
                    if (!$(e.target).hasClass("resizer"))
                        return false;
                    return true;
                },
                onDragEnd: function (e, $el, opt) {
                    $("#ResizedField").val($el.attr("id"));
                    $("#ResizedWidth").val($el.width());
                    postback("resize");
                }
            });
    }

    function send_by_mail() {
        _window_open("/Mail/SendMail?trdxfile=" + encodeURIComponent(_gr_trdxfile) + "&mailsubject=" + encodeURIComponent(_gr_header), 1);
    }

    function hardrefresh(pid) {

    }
</script>
