@model UI.Models.wrk.WorkflowDialogViewModel
@inject BL.Factory _f


@{
    if (Model.b02ID>0 || Model.b01ID > 0)
    {
        Model.PageTitle = "Workflow";
    }
    else
    {
        Model.PageTitle = "Notepad"; 
    }

    if (Model.RecordEntity != "o22" && Model.RecordEntity != "p31" && Model.RecordEntity != "j02")
    {
        Model.PageTitle = $"{Model.PageTitle}: {_f.CBL.GetObjectAlias(Model.RecordEntity, Model.RecordPid)}";
    }

    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    Model.PageSymbol = "speaker_notes";

    IEnumerable<BO.b05Workflow_History> _lisB05 = null;
    if (Model.Caller != "portal")
    {
        _lisB05 = _f.WorkflowBL.GetList_b05(Model.RecordEntity, Model.RecordPid, 0, 0, 0);
    }


}

@addTagHelper *, UI


@section header_content{
    @if (Model.Notepad != null)
    {
        <link href="~/lib/froala-editor/css/froala_editor.pkgd.min.css" rel="stylesheet" type="text/css" />
    }
    <link rel="stylesheet" href="~/css/workflowdialog.css" asp-append-version="true" />
}

@{
    // kroky workflow (bez „Doplnit poznámku“ = pid 0) + cílové stavy pro dlaždice
    var _steps = Model.lisB06 == null ? new List<BO.b06WorkflowStep>() : Model.lisB06.Where(p => p.pid > 0).ToList();
    var _targets = new Dictionary<int, BO.b02WorkflowStatus>();
    foreach (var c in _steps.Where(p => p.b02ID_Target > 0))
    {
        if (!_targets.ContainsKey(c.b02ID_Target)) _targets[c.b02ID_Target] = _f.b02WorkflowStatusBL.Load(c.b02ID_Target);
    }
    bool _isNoteOnly = Model.SelectedB06ID == 0;
}


<div class="wd-bar">
    <button id="cmdSave" class="btn btn-success" onclick="_submit()">
        <span class="material-icons-outlined-btn">save</span>
        @_f.tra("Uložit a zavřít")
    </button>
    @if (Model.RecordPid > 0 && Model.RecordEntity != "j02")
    {
        <button id="cmdSaveAndNotify" class="btn btn-light" onclick="_postback('mail')">
            <span class="material-icons-outlined-btn">alternate_email</span>
            @_f.tra("Uložit a notifikovat")
        </button>
    }
    <button id="cmdClose" onclick="_window_close()" class="btn btn-light">@_f.tra("Zavřít")</button>
    @if (_f.CurrentUser.IsAdmin && Model.RecB01 != null)
    {
        <myshowmore></myshowmore>
        <span class="showmore">
            <button id="cmdSaveAndNotify" class="btn btn-light wd-restart" onclick="_postback('restart')">
                <span class="material-icons-outlined-btn">restart_alt</span>
                @_f.tra("Nahodit do úvodního stavu workflow šablony")
            </button>
        </span>
    }

    @if (Model.RecB02 != null)
    {
        <div class="wd-state" title="@_f.tra("Aktuální stav")">
            <span class="wd-state-label">@_f.tra("Aktuální stav"):</span>
            <span class="wd-dot" style="background:@(string.IsNullOrEmpty(Model.RecB02.b02Color) ? "#c5ccd3" : Model.RecB02.b02Color)"></span>
            <strong>@Model.RecB02.b02Name</strong>
        </div>
    }
</div>

<div id="divMail" style="display:none;margin:10px;">
    <button id="cmdSaveAndNotify" class="btn btn-success" onclick="_postback('send')">@_f.tra("Odeslat notifikaci")</button>
</div>



@Html.Raw("<div class='modal_record_container'>")

<form id="form1" asp-controller="workflow_dialog" asp-action="Index" method="POST">

    <div class="wd">
    @* volba kroku: dlaždice místo seznamu přepínačů; stejné id/name jako dřív (hidden SelectedB06ID, chkSelectedB06ID_{pid}, myradiolist_checked → b06id_onchange) *@
    <input type="hidden" id="SelectedB06ID" name="SelectedB06ID" value="@Model.SelectedB06ID" />
    @if (_steps.Count > 0)
    {
        <div id="divRadioList" class="wd-steps" role="radiogroup" aria-label="@_f.tra("Krok")">
            <label class="wd-step wd-step-note@(_isNoteOnly ? " wd-on" : "")" for="chkSelectedB06ID_0">
                <input type="radio" class="form-check-input" id="chkSelectedB06ID_0" name="mySelectedB06ID" onclick="myradiolist_checked('SelectedB06ID','0','b06id_onchange')" @(_isNoteOnly ? "checked" : "") />
                <span class="material-icons-outlined-nosize">edit_note</span>
                <span class="wd-step-text"><span class="wd-step-name">@_f.tra("Doplnit poznámku")</span><span class="wd-step-sub">@_f.tra("stav se nemění")</span></span>
            </label>
            <span class="wd-steps-or">@_f.tra("nebo posunout")</span>
            @foreach (var c in _steps)
            {
                BO.b02WorkflowStatus t = c.b02ID_Target > 0 && _targets.ContainsKey(c.b02ID_Target) ? _targets[c.b02ID_Target] : null;
                string name = !string.IsNullOrWhiteSpace(c.b06Name) ? c.b06Name : (t != null ? t.b02Name : c.NameWithTargetStatus);
                bool on = Model.SelectedB06ID == c.pid;
                <label class="wd-step@(on ? " wd-on" : "")" for="chkSelectedB06ID_@(c.pid)">
                    <input type="radio" class="form-check-input" id="chkSelectedB06ID_@(c.pid)" name="mySelectedB06ID" onclick="myradiolist_checked('SelectedB06ID','@(c.pid)','b06id_onchange')" @(on ? "checked" : "") />
                    <span class="wd-step-text">
                        <span class="wd-step-name">@name</span>
                        @if (t != null && !string.IsNullOrWhiteSpace(c.b06Name) && !string.Equals(c.b06Name.Trim(), t.b02Name?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="wd-step-sub"><span class="material-icons-outlined-nosize">arrow_forward</span><span class="wd-dot" style="background:@(string.IsNullOrEmpty(t.b02Color) ? "#c5ccd3" : t.b02Color)"></span>@t.b02Name</span>
                        }
                        else if (t != null)
                        {
                            <span class="wd-step-sub"><span class="wd-dot" style="background:@(string.IsNullOrEmpty(t.b02Color) ? "#c5ccd3" : t.b02Color)"></span>@_f.tra("nový stav")</span>
                        }
                    </span>
                </label>
            }
        </div>
    }

    @if (Model.RecB06 != null && (Model.RecB06.b06NomineeFlag == BO.b06NomineeFlagENum.RucniPovinna || Model.RecB06.b06NomineeFlag == BO.b06NomineeFlagENum.RucniNepovinna))
    {
        <div class="card wd-card">
            <div class="card-header">
                <span class="material-icons-outlined-nosize">how_to_reg</span>
                @_f.tra("Nominace")
                @if (Model.RecB06.x67ID_Nominee > 0)
                {
                    <span class="badge-light">
                        @(_f.x67EntityRoleBL.Load(Model.RecB06.x67ID_Nominee).x67Name)

                    </span>
                }                                
            </div>
            <div class="card-body">
                @if (Model.RecordEntity == "p91")
                {
                    @await Html.PartialAsync("~/Views/Shared/_RoleAssignRO.cshtml", new UI.Models.Tab1.p56Tab1() { prefix = "p91", pid = Model.RecordPid })
                }
                @if (Model.RecordEntity == "p41")
                {
                    @await Html.PartialAsync("~/Views/Shared/_RoleAssignRO.cshtml", new UI.Models.Tab1.p41Tab1() { prefix = "p41", pid = Model.RecordPid })
                }
                @if (Model.RecordEntity == "o23")
                {
                    @await Html.PartialAsync("~/Views/Shared/_RoleAssignRO.cshtml", new UI.Models.Tab1.o23Tab1() { prefix = "o23", pid = Model.RecordPid })
                }
                @if (Model.RecordEntity == "p28")
                {
                    @await Html.PartialAsync("~/Views/Shared/_RoleAssignRO.cshtml", new UI.Models.Tab1.p28Tab1() { prefix = "p28", pid = Model.RecordPid })
                }
                @if (Model.RecordEntity == "p56")
                {
                    @await Html.PartialAsync("~/Views/Shared/_RoleAssignRO.cshtml", new UI.Models.Tab1.p56Tab1() { prefix = "p56", pid = Model.RecordPid })
                }
                <mycombochecklist placeholder="Nominovat jednotlivce" asp-for="@Model.Nominee_j02IDs" entity="j02User" selectedtext="@Model.Nominee_Persons"></mycombochecklist>
                <p></p>
                <mycombochecklist placeholder="Nominovat týmy" asp-for="@Model.Nominee_j11IDs" entity="j11Team" selectedtext="@Model.Nominee_j11Names"></mycombochecklist>
               
            </div>
        </div>


    }



    @if (Model.Notepad != null)
    {
        <div class="wd-note">
            @if (Model.RecB06 != null && Model.RecB06.b06NotepadFlag == BO.b06NotepadFlagEnum.NotepadIsRequired && !_isNoteOnly)
            {
                <span class="wd-note-req">@_f.tra("Poznámka je u tohoto kroku povinná.")</span>
            }
            @Html.EditorFor(m => m.Notepad, "~/Views/Shared/_Notepad.cshtml")
        </div>
    }

    @if (Model.RecB06.b06GeoFlag == BO.b06GeoFlagEnum.LoadFromCurrentUser)
    {
        <iframe id="mapa" style="border:none;width:100%;height:500px;display:none;"></iframe>
    }
    @if (Model.SelectedB06ID == 0 && Model.RecordEntity !="p91")
    {
        <div class="wd-meta">
            <div class="wd-meta-name">
                <input type="text" asp-for="b05Name" placeholder="@_f.tra("Název / předmět")" class="form-control" />
            </div>
            <div class="wd-meta-date" title="@_f.tra("Datum záznamu")">
                <mydate asp-for="b05Date" include-time="false"></mydate>
            </div>
            <div class="wd-flags">
                @if (Model.SelectedB02ID == 0 && Model.RecordEntity != null && Model.RecordEntity != "j02" && Model.RecordEntity != "p31")
                {
                    <label class="wd-flag" for="chkIsTab1">
                        <input id="chkIsTab1" type="checkbox" class="form-check-input" asp-for="IsTab1" />
                        <span>@_f.tra("Připnout na první záložku") <span class="wd-flag-ent">@(BO.Code.Entity.GetAlias(Model.RecordEntity))</span></span>
                    </label>
                }
                @if (Model.SelectedB02ID == 0 && (BO.Code.Entity.GetPrefixDb(Model.RecordEntity) == "p41" || Model.RecordEntity == "p28"))
                {
                    <label class="wd-flag" for="chkIsBillingMemo">
                        <input id="chkIsBillingMemo" type="checkbox" class="form-check-input" asp-for="IsBillingMemo" />
                        <span>@_f.tra("Fakturační poznámka")</span>
                    </label>
                }
                @if (Model.SelectedB02ID == 0 && (Model.RecordEntity == "p28" || Model.RecordEntity == "p91" || Model.IsPortalAccess))
                {
                    <label class="wd-flag" for="chkIsPortalAccess">
                        <input id="chkIsPortalAccess" type="checkbox" class="form-check-input" asp-for="IsPortalAccess" />
                        <span>@_f.tra("Publikovatelné na klientském portálu")</span>
                    </label>
                }
            </div>
        </div>
    }
    </div>

    <input type="hidden" asp-for="RecordEntity" />
    <input type="hidden" asp-for="RecordPid" />
    <input type="hidden" asp-for="b01ID" />
    <input type="hidden" asp-for="b02ID" />
    <input type="hidden" asp-for="current_user_lon" />
    <input type="hidden" asp-for="current_cuser_lat" />
    <input type="hidden" asp-for="NameIsRequired" />
    <input type="hidden" asp-for="Caller" />
    <input type="hidden" asp-for="UploadGuid" />
</form>




@Html.Raw("</div>")

<div class="wd-extra">
@if (Model.UploadGuid != null)
{
    <iframe id="fraUpload" src="/Dropzone/UploadInFrame?entity=b05&guid=@Model.UploadGuid" frameborder="0" scrolling="yes" style="max-width:1200px;height:60px;"></iframe>
}

<div>
    @Html.EditorFor(m => m.reminder, "~/Views/Shared/_Reminder.cshtml")
</div>

@if (_lisB05 !=null && _lisB05.Count() > 0)
{
    <div class="wd-history">
        <button type="button" class="btn btn-sm btn-light wd-history-btn" onclick="toggle_history()">
            <span class="material-icons-outlined-nosize">history</span>
            @_f.tra("Historie")
            <span class="wd-count">@(_lisB05.Count())</span>
            <span class="material-icons-outlined-nosize wd-chev">expand_more</span>
        </button>
    </div>

    <div id="history" style="display:none;">
        @await Html.PartialAsync("~/Views/Shared/_lisB05.cshtml",_lisB05)
    </div>

}
</div>



@if (Model.RecordEntity == "p91")
{

    <iframe id="fraPdfPreview" frameborder="0" style="width:100%;height:800px;" src="/p91/PdfPreview?pid=@Model.RecordPid" scrolling="auto"></iframe>

}

<script type="text/javascript">
    $(document).ready(function () {

    @if (Model.RecB06.b06GeoFlag == BO.b06GeoFlagEnum.LoadFromCurrentUser)
    {
        <text>
                getLocation();
        </text>
    }

            $("#cmdMail").click(function () {
                $("#divMail").toggle();
            });

            if (document.getElementById("fraPdfPreview"))
            {
                var offset = $("#fraPdfPreview").offset();
                var fra=document.getElementById("fraPdfPreview");
                $(fra).css("height", _device.innerHeight-offset.top-7);
            }
    })

    function toggle_history() {
        $("#history").toggle();
        $(".wd-history-btn").toggleClass("wd-open", $("#history").is(":visible"));
    }

    function b06id_onchange(b06id) {
        _postback("b06id");
    }


    function getLocation() {
        _notify_message("Načítám souřadnice polohy...", "info");

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(showPosition);
        } else {
            x.innerHTML = "Geolocation is not supported by this browser.";
        }
    }

    function showPosition(position) {

        $("#current_user_lon").val(position.coords.longitude);
        $("#current_cuser_lat").val(position.coords.latitude);

        showMap();
    }


    function showMap() {
        _notify_message("Poloha: " + $("#current_user_lon").val() + " - " + $("#current_cuser_lat").val(), "info");
        $("#mapa").css("display", "block");
        var x = $("#current_user_lon").val();
        var y = $("#current_cuser_lat").val();
        document.getElementById("mapa").src = "https://frame.mapy.cz/turisticka?source=coor&id=" + x + "%2C" + y + "&ds=1&x=" + x + "&y=" + y + "&z=17";

    }

    function hardrefresh(pid, flag) {
        location.replace(location.href);
    }
</script>