@model UI.Models.TreePageViewModel
@inject BL.Factory _f

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    Model.PageTitle = _f.tra("Strom");
    var _modes = new List<(string Value, string Text)>() {
        ("p41", _f.tra("Strom projektů")), ("p28", _f.tra("Klient projektu")), ("j18", _f.tra("Středisko projektu")),
        ("p42", _f.tra("Typ projektu")), ("p51", _f.tra("Ceník fakturačních sazeb")) };
}

@addTagHelper *, UI

@section header_content {
    <link rel="stylesheet" href="~/css/treepage.css" asp-append-version="true" />
}


<div class="input-group tp-toolbar">
    <ul class="nav nav-tabs">
        <li class="onetab">
            <a id="cmdMore" class="nav-link onetab-offcanvas" tabindex="-1" role="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_more" title="@_f.tra("Nastavení stromu")">
                <span class="onetab-caret"></span>
                @_f.tra("Strom")
            </a>
        </li>
    </ul>

    <div class="tp-mode" title="@_f.tra("Stromová struktura podle")">
        <select id="tp_groupby" class="form-select" onchange="reload_setting(this)">
            @foreach (var m in _modes)
            {
                <option value="@m.Value" selected="@(Model.groupby == m.Value)">@m.Text</option>
            }
        </select>
    </div>

    <div class="tp-search position-relative">
        <input type="text" id="treeSearch" oninput="searchTree(this)" onfocus="this.select()" class="form-control pe-5" autocomplete="off"
               placeholder="@_f.tra("Najít")…" title="@_f.tra("Hledá v názvech od 3 znaků")" />
        <button type="button" class="tp-clear" tabindex="-1" onclick="clearTreeSearch()" aria-label="@_f.tra("Vymazat")">✕</button>
        <div id="tp_search_info" class="tp-search-info" aria-live="polite"></div>
    </div>

    @if (Model.TheGridQueryButton != null)
    {
        <div>
            @Html.EditorFor(m => Model.TheGridQueryButton, "~/Views/Shared/_ButtonGridQuery.cshtml")
        </div>
    }

    @if (Model.periodinput != null)
    {
        <div title="@_f.tra("Zobrazí jen projekty, které mají v období úkony")">
            @await Component.InvokeAsync("myPeriod", Model.periodinput)
        </div>
    }

    @if (Model.p31statequery != null)
    {
        <div>
            @Html.EditorFor(m => Model.p31statequery, "~/Views/Shared/_p31StateQuery.cshtml")
        </div>
    }

    <div>
        <a class="btn descreet_link_over_grid" href="javascript:tree_approve()" title="@_f.tra("Schválit/Vyúčtovat úkony vybraného projektu")"><span class="material-icons-outlined-btn" style="color:green;">approval</span></a>
    </div>

    <div>
        <myshowmore></myshowmore>
    </div>

    <div class="showmore">
        @Html.EditorFor(m => Model.recordbinquery, "~/Views/Shared/_RecordBinQuery.cshtml")
    </div>
</div>


@Html.Raw("<div id='splitter_container'>")
@Html.Raw("<div id='splitter_panel1'>")

<div id="tree1" class="treeds p-3">
    @if (Model.lisTreeNodes == null || Model.lisTreeNodes.Count == 0)
    {
        <div class="tp-empty">@_f.tra("Filtru neodpovídá žádný projekt.")</div>
    }
    else
    {
        @await Html.PartialAsync("~/Views/Shared/_TreeDsRenderHelper.cshtml", Model.lisTreeNodes)
    }
</div>

@Html.Raw("</div>")

<div id="splitter_resizer" class="splitter-resizer-left2right"></div>

@Html.Raw("<div id='splitter_panel2'>")

<div class="tabs_container bgp41">
    <ul id="navtabs" class="nav nav-tabs">
        <li style="padding-top:6px;">
            <a id="cmdRCM" class="cm" onclick="rcm_from_tabs(event)" title="MENU"><span class="material-icons-outlined">menu</span></a>
        </li>
        @foreach (var tab in Model.NavTabs)
        {
            <li class="nav-item onetab">
                <a class="@tab.CssClass" id="tab@(tab.Entity)" href="@tab.Url" target="fra_subgrid" onclick="return tabclick(this)" title="@tab.Tooltip">
                    @Html.Raw(tab.Name)
                    @if (tab.Badge != null)
                    {
                        @Html.Raw(tab.Badge)
                    }
                </a>
            </li>
        }
    </ul>
</div>

<div id="divTabContent">
    <iframe id="fra_subgrid" name="fra_subgrid" src="@Model.DefaultNavTabUrl" frameborder="1" scrolling="yes" style="width:100%;" onload="$('#divTabContent').css('background','none');"></iframe>
</div>

@Html.Raw("</div>")
@Html.Raw("</div>")


<div class="offcanvas offcanvas-start" tabindex="-1" data-bs-scroll="true" data-bs-backdrop="true" data-bs-keyboard="true" id="offcanvas_more">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">@_f.tra("Nastavení stromu")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="mb-3">
            <label for="ProjectMask" class="form-label">@_f.tra("Maska zobrazení projektu")</label>
            <select asp-for="ProjectMask" class="form-select" onchange="reload_setting_mask(this)">
                <option value="NameWithClient">@_f.tra("Klient+název projektu")</option>
                <option value="p41Name">@_f.tra("Název projektu")</option>
            </select>
        </div>
        <button type="button" class="btn btn-light bog" onclick="reload()"><span class="material-icons-outlined-btn">refresh</span> @_f.tra("Občerstvit")</button>
    </div>
</div>

<input type="hidden" asp-for="pid" />

@{
    var _tpConfig = new
    {
        groupby = Model.groupby,
        pid = Model.pid.ToString(),
        binquery = Model.recordbinquery != null ? Model.recordbinquery.Value : 0,
        j72id = Model.TheGridQueryButton != null ? Model.TheGridQueryButton.j72id : 0,
        txt = new
        {
            minChars = _f.tra("Zadejte aspoň 3 znaky."),
            noHits = _f.tra("Nic nenalezeno."),
            hits = _f.tra("Nalezeno"),
            noProject = _f.tra("Nejdříve vyberte projekt ve stromu.")
        }
    };
}
@* výchozí System.Text.Json escapuje < > & – bezpečné uvnitř <script> *@
<script type="text/javascript">window._tp = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_tpConfig));</script>
<script src="~/js/recpage.js" asp-append-version="true"></script>
<script src="~/js/treepage.js" asp-append-version="true"></script>
