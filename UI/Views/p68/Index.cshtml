@model UI.Models.p31oper.p68ViewModel
@inject BL.Factory _f

@{
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    Model.PageTitle = _f.tra("Stopky");
    Model.PageSymbol = "history_toggle_off";
}

@addTagHelper *, UI

<link rel="stylesheet" href="~/css/p68.css" asp-append-version="true" />

<div class="sw-toolbar">
    <button type="button" class="btn btn-success" onclick="sw_oper('new_start', 0)" title="@_f.tra("Nový časovač se rovnou spustí, běžící se zastaví")">
        <span class="material-icons-outlined-btn">play_arrow</span> @_f.tra("Spustit nový časovač")
    </button>
    <button type="button" class="btn btn-light" onclick="sw_oper('add', 0)" title="@_f.tra("Přidat časovač bez spuštění – např. pro ruční zadání času")">
        <span class="material-icons-outlined-btn">add</span> @_f.tra("Přidat")
    </button>

    <div class="sw-total" title="@_f.tra("Součet naměřeného času všech časovačů")">
        @_f.tra("Celkem") <strong id="sw_total"></strong>
    </div>

    <div class="sw-toolbar-right">
        <button type="button" id="cmdClearAll" class="btn btn-light" onclick="sw_clear_all(this)" title="@_f.tra("Odstranit všechny časovače")">
            <span class="material-icons-outlined-btn" style="color:#b02a37;">delete_sweep</span><span class="sw-clear-text">@_f.tra("Vyčistit vše")</span>
        </button>
        <button type="button" id="cmdOpenNewTab" class="btn btn-light" onclick="window.open('/p68/Index');_window_close();" title="@_f.tra("Otevřít v nové záložce – stopky máte stále po ruce")">
            <span class="material-icons-outlined-btn">open_in_new</span>
        </button>
        <button type="button" id="cmdClose" class="btn btn-light" onclick="_window_close()">
            <span class="material-icons-outlined-btn">close</span>@_f.tra("Zavřít")
        </button>
    </div>
</div>

<div id="sw_rows" class="sw-rows">
    <partial name="_Rows" model="Model" />
</div>

<script type="text/javascript">
    var _sw_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        error = _f.tra("Operaci se nepodařilo provést."),
        clearConfirm = _f.tra("Klikněte znovu – smaže vše"),
        clearText = _f.tra("Vyčistit vše")
    }));

    var _sw_t0 = 0;           // čas vykreslení karet (ms) – běžící hodiny se počítají od něj
    var _sw_tick = null;

    $(function () {
        if (window == top) $("#cmdOpenNewTab").hide();
        sw_after_render();
    });

    // ------------------------------------------------------------------ operace (AJAX, vrací znovu vykreslené karty)

    function sw_oper(oper, pid, extra, done) {
        var data = $.extend({ oper: oper, p68id: pid, p41id: 0, secs: 0 }, extra || {});
        $.post(_ep("/p68/Oper"), data, function (html) {
            $("#sw_rows").html(html);
            sw_after_render();
            if (done) done();
        }).fail(function () { _notify_message(_sw_txt.error, "error"); });
    }

    function sw_reload() {
        $.get(_ep("/p68/Rows"), function (html) { $("#sw_rows").html(html); sw_after_render(); });
    }

    // po vykreslení: běžící hodiny, součet, posun na kartu, ikona v liště hlavního okna
    function sw_after_render() {
        _sw_t0 = Date.now();
        if (_sw_tick) clearInterval(_sw_tick);
        sw_show_time();
        if ($("#sw_meta").data("running") == 1) _sw_tick = setInterval(sw_show_time, 1000);

        var jump = $("#sw_meta").data("jump");
        if (jump && document.getElementById("sw" + jump)) {
            document.getElementById("sw" + jump).scrollIntoView({ block: "nearest", behavior: "smooth" });
            $("#sw" + jump).addClass("sw-flash");
        }
        $("#cmdClearAll").toggle($("#sw_meta").data("count") > 0);

        try { if (window.parent && window.parent !== window && window.parent._stopky_refresh) window.parent._stopky_refresh(); } catch (e) { }
        try { if (window.opener && window.opener._stopky_refresh) window.opener._stopky_refresh(); } catch (e) { }
    }

    function sw_hms(s) {
        var h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, x = s % 60;
        return h + ":" + (m < 10 ? "0" : "") + m + ":" + (x < 10 ? "0" : "") + x;
    }

    function sw_show_time() {
        var plus = Math.floor((Date.now() - _sw_t0) / 1000);
        $(".sw-clock").each(function () { $(this).text(sw_hms(parseInt($(this).data("elapsed"), 10) + plus)); });
        var total = parseInt($("#sw_meta").data("total"), 10) || 0;
        if ($("#sw_meta").data("running") == 1) total += plus;
        $("#sw_total").text(sw_hms(total).replace(/:\d\d$/, ""));     // H:MM
        document.title = ($("#sw_meta").data("running") == 1 ? "⏱ " + sw_hms(total) + " · " : "") + "Stopky";
    }

    // ------------------------------------------------------------------ pole karty

    function sw_p41id_change(p41id, pid) {
        sw_oper("p41id", pid, { p41id: p41id });
    }

    function sw_p32id_change(p32id, rowindex) {
        sw_save(rowindex, false);
    }

    // text, aktivita a ručně zadaný čas (bez překreslení – kromě změny času, kvůli součtu)
    function sw_save(rowindex, durChanged) {
        var pid = $("#lisRows_" + rowindex + "__pid").val();
        var p32id = document.getElementById("lisRows_" + rowindex + "__p32ID") ? $("#lisRows_" + rowindex + "__p32ID").val() : 0;
        var data = {
            pid: pid,
            p68text: $("#lisRows_" + rowindex + "__p68Text").val(),
            durhhmm: durChanged ? $("#sw_dur_" + pid).val() : "",
            p32id: p32id
        };
        $.post(_ep("/p68/SaveClientChanges"), data, function () {
            if (durChanged) sw_reload();
        }).fail(function () { _notify_message(_sw_txt.error, "error"); });
    }

    // vykázat jako úkon: běžící časovač nejdřív zastavit; po uložení úkonu se časovač odstraní (p31Controller)
    function sw_report(pid, running) {
        var open = function () { _window_open("/p31/Record?pid=0&p68id=" + pid, 3); };
        if (running) sw_oper("stop", pid, null, open); else open();
    }

    // „Vyčistit vše“ bez potvrzovacího dialogu: první klik tlačítko „nabije“, druhý do 3 s smaže
    var _sw_clear_armed = null;
    function sw_clear_all(btn) {
        var $t = $(btn).find(".sw-clear-text");
        if (_sw_clear_armed) {
            clearTimeout(_sw_clear_armed); _sw_clear_armed = null;
            $(btn).removeClass("btn-danger").addClass("btn-light"); $t.text(_sw_txt.clearText);
            sw_oper("clear", 0);
            return;
        }
        $(btn).removeClass("btn-light").addClass("btn-danger"); $t.text(_sw_txt.clearConfirm);
        _sw_clear_armed = setTimeout(function () {
            _sw_clear_armed = null;
            $(btn).removeClass("btn-danger").addClass("btn-light"); $t.text(_sw_txt.clearText);
        }, 3000);
    }

    // volá okno úkonu po uložení (časovač se odstranil)
    function hardrefresh(pid, flag) {
        sw_reload();
    }
</script>
