@model UI.Models.OutlookP31ViewModel
@inject BL.Factory _f
@using UI.Models
@{
    Layout = "~/Views/Shared/_LayoutModal.cshtml";

    var _todo = Model.Rows.Select((r, i) => (r, i)).Where(p => p.r.State == OutlookP31State.New || p.r.State == OutlookP31State.Error).ToList();
    var _skipped = Model.Rows.Select((r, i) => (r, i)).Where(p => p.r.State == OutlookP31State.Skipped).ToList();
    var _done = Model.Rows.Select((r, i) => (r, i)).Where(p => p.r.State == OutlookP31State.Saved || p.r.State == OutlookP31State.Duplicate).ToList();
    bool _hasRows = Model.Rows.Count > 0;

    string ConfText(int c) => c switch { 3 => _f.tra("vysoká jistota"), 2 => _f.tra("střední jistota"), 1 => _f.tra("nízká jistota"), _ => _f.tra("projekt nenalezen") };
    string _p41query = $"j02id_query|int|{_f.CurrentUser.pid}|p07level|int|5|p33id_for_p31_entry|int|1";
}
@addTagHelper *, UI

@section header_content
{
    <link rel="stylesheet" href="~/css/outlookp31.css" asp-append-version="true" />
}

@{
    // skrytá pole řádku (stav a údaje, které se needitují)
    async Task Hidden(int i)
    {
        <input type="hidden" asp-for="Rows[i].Key" />
        <input type="hidden" asp-for="Rows[i].State" />
        <input type="hidden" asp-for="Rows[i].Message" />
        <input type="hidden" asp-for="Rows[i].Warning" />
        <input type="hidden" asp-for="Rows[i].p31ID" />
        <input type="hidden" asp-for="Rows[i].Hours" />
        <input type="hidden" asp-for="Rows[i].Subject" />
        <input type="hidden" asp-for="Rows[i].Attendees" />
        <input type="hidden" asp-for="Rows[i].FileName" />
        <input type="hidden" asp-for="Rows[i].Confidence" />
        <input type="hidden" asp-for="Rows[i].Reason" />
        <input type="hidden" asp-for="Rows[i].Client" />
    }

    // editovatelný řádek návrhu
    async Task EditRow(OutlookP31Row r, int i)
    {
        <div class="ol-row@(r.State == OutlookP31State.Error ? " ol-has-err" : "")" data-i="@i" data-state="@((int)r.State)">
            @{ await Hidden(i); }
            <div class="ol-chk">
                <input type="checkbox" class="form-check-input" asp-for="Rows[i].IsSelected" onchange="ol_sum()" title="@_f.tra("Zapsat")" />
            </div>
            <div class="ol-when">
                <input type="date" class="form-control form-control-sm" asp-for="Rows[i].Date" />
                <div class="ol-times">
                    <input type="time" class="form-control form-control-sm" asp-for="Rows[i].TimeFrom" onchange="ol_dur(@i)" />
                    <span>–</span>
                    <input type="time" class="form-control form-control-sm" asp-for="Rows[i].TimeUntil" onchange="ol_dur(@i)" />
                </div>
                <span class="ol-dur" id="ol_dur_@i"></span>
            </div>
            <div class="ol-event">
                <div class="ol-subj" title="@r.FileName">@r.Subject</div>
                @if (!string.IsNullOrEmpty(r.Attendees))
                {
                    <div class="ol-att" title="@r.Attendees"><span class="material-icons-outlined-nosize">group</span>@r.Attendees</div>
                }
                @if (r.State == OutlookP31State.Error && !string.IsNullOrEmpty(r.Message))
                {
                    <div class="ol-err"><span class="material-icons-outlined-nosize">error</span>@r.Message</div>
                }
                else if (r.State == OutlookP31State.Skipped && !string.IsNullOrEmpty(r.Message))
                {
                    <div class="ol-note"><span class="material-icons-outlined-nosize">block</span>@r.Message</div>
                }
                @if (!string.IsNullOrEmpty(r.Warning))
                {
                    <div class="ol-warn"><span class="material-icons-outlined-nosize">warning_amber</span>@r.Warning</div>
                }
            </div>
            <div class="ol-proj">
                <mycombo entity="le5" asp-for="Rows[i].p41ID" selectedtext="Rows[i].ComboP41" filter-flag="1" view-flag="1" search-result-width="700" myqueryinline="@_p41query" placeholder="@_f.tra("Projekt")" event_after_changevalue="ol_p41_change(@i,#pid#)"></mycombo>
                <div class="ol-why" id="ol_why_@i"><span class="ol-conf ol-conf@(r.Confidence)" title="@ConfText(r.Confidence)"></span><span>@(string.IsNullOrEmpty(r.Reason) ? ConfText(r.Confidence) : r.Reason)</span></div>
            </div>
            <div class="ol-act">
                <mycombo entity="p32Activity" asp-for="Rows[i].p32ID" selectedtext="Rows[i].ComboP32" myqueryinline="p33id|int|1" placeholder="@_f.tra("Aktivita")"></mycombo>
            </div>
            <div class="ol-text">
                <textarea class="form-control form-control-sm" asp-for="Rows[i].p31Text" rows="2" placeholder="@_f.tra("Text úkonu")"></textarea>
                <a href="javascript:ol_internal(@i)" class="ol-intlink" id="ol_intlink_@i">@(string.IsNullOrEmpty(r.p31TextInternal) ? _f.tra("+ interní text") : _f.tra("Interní text"))</a>
                <textarea class="form-control form-control-sm ol-int" asp-for="Rows[i].p31TextInternal" rows="2" placeholder="@_f.tra("Interní text")" hidden></textarea>
            </div>
        </div>
    }
}

<form id="form1" asp-controller="OutlookP31" asp-action="Index" method="POST" enctype="multipart/form-data">
    <input type="hidden" asp-for="ShowSkipped" />
    <input type="file" id="olFiles" name="files" multiple accept=".msg,.ics,.ical,.vcs" hidden onchange="ol_upload()" />

    <div class="ol">

        <div class="ol-drop@(_hasRows ? " ol-drop-compact" : "")" id="olDrop">
            <span class="material-icons-outlined-nosize ol-drop-icon">event_available</span>
            <div class="ol-drop-text">
                <strong>@_f.tra("Přetáhněte sem události z Outlooku")</strong>
                <span>@_f.tra("V kalendáři označte události (Ctrl+klik, pohodlněji v zobrazení Seznam) a přetáhněte je myší do tohoto okna.")</span>
                <span class="ol-drop-hint">@_f.tra("Nový Outlook: událost otevřete, zvolte … › Uložit jako (.ics) a přetáhněte soubor.")</span>
            </div>
            <button type="button" class="btn btn-light" onclick="document.getElementById('olFiles').click()"><span class="material-icons-outlined-nosize">upload_file</span>@_f.tra("Vybrat soubory")</button>
        </div>

        @if (_todo.Count > 0)
        {
            <section class="ol-sec">
                <div class="ol-sec-head">
                    <h2>@_f.tra("K zapsání") <span class="ol-count">@_todo.Count</span></h2>
                    <div class="ol-sel">
                        <a href="javascript:ol_select('all')">@_f.tra("Vybrat vše")</a>
                        <a href="javascript:ol_select('sure')">@_f.tra("Jen s vysokou jistotou")</a>
                        <a href="javascript:ol_select('none')">@_f.tra("Nic")</a>
                    </div>
                    <div class="ol-bulk">
                        <span>@_f.tra("Vybraným nastavit:")</span>
                        <div class="ol-bulk-combo">
                            <mycombo entity="le5" asp-for="BulkP41ID" selectedtext="BulkComboP41" filter-flag="1" view-flag="1" search-result-width="700" myqueryinline="@_p41query" placeholder="@_f.tra("Projekt")" event_after_changevalue="ol_bulk('p41',#pid#)"></mycombo>
                        </div>
                        <div class="ol-bulk-combo ol-bulk-act">
                            <mycombo entity="p32Activity" asp-for="BulkP32ID" selectedtext="BulkComboP32" myqueryinline="p33id|int|1" placeholder="@_f.tra("Aktivita")" event_after_changevalue="ol_bulk('p32',#pid#)"></mycombo>
                        </div>
                    </div>
                </div>
                <div class="ol-head">
                    <span></span><span>@_f.tra("Datum a čas")</span><span>@_f.tra("Událost")</span><span>@_f.tra("Projekt")</span><span>@_f.tra("Aktivita")</span><span>@_f.tra("Text úkonu")</span>
                </div>
                @foreach (var (r, i) in _todo)
                {
                    await EditRow(r, i);
                }
            </section>
        }

        @if (_skipped.Count > 0)
        {
            <details class="ol-sec ol-skipped" @(Model.ShowSkipped || _todo.Count == 0 ? "open" : "") ontoggle="$('#ShowSkipped').val(this.open)">
                <summary><h2>@_f.tra("Přeskočené") <span class="ol-count">@_skipped.Count</span></h2><span class="ol-sec-hint">@_f.tra("celodenní, zrušené, odmítnuté, volno – zaškrtnutím je přesto zapíšete")</span></summary>
                @foreach (var (r, i) in _skipped)
                {
                    await EditRow(r, i);
                }
            </details>
        }

        @if (_done.Count > 0)
        {
            <section class="ol-sec ol-done">
                <div class="ol-sec-head">
                    <h2>@_f.tra("Zapsané") <span class="ol-count">@_done.Count</span></h2>
                    <a href="javascript:_postback('clear_done')" class="ol-sec-link">@_f.tra("Skrýt zapsané")</a>
                </div>
                @foreach (var (r, i) in _done)
                {
                    <div class="ol-donerow">
                        @{ await Hidden(i); }
                        <input type="hidden" asp-for="Rows[i].Date" />
                        <input type="hidden" asp-for="Rows[i].TimeFrom" />
                        <input type="hidden" asp-for="Rows[i].TimeUntil" />
                        <input type="hidden" asp-for="Rows[i].p41ID" />
                        <input type="hidden" asp-for="Rows[i].ComboP41" />
                        <input type="hidden" asp-for="Rows[i].p32ID" />
                        <input type="hidden" asp-for="Rows[i].ComboP32" />
                        <span class="material-icons-outlined-nosize @(r.State == OutlookP31State.Saved ? "ol-ok" : "ol-dup")">@(r.State == OutlookP31State.Saved ? "check_circle" : "content_copy")</span>
                        <span class="ol-done-when">@r.Date.ToString("d.M.yyyy") @r.TimeFrom–@r.TimeUntil</span>
                        <span class="ol-done-subj">@r.Subject</span>
                        <span class="ol-done-proj">@r.ComboP41</span>
                        <span class="ol-done-state">@(r.State == OutlookP31State.Saved ? _f.tra("zapsáno nyní") : _f.tra("zapsáno dříve"))</span>
                        @if (r.p31ID > 0)
                        {
                            <a href="javascript:_window_open('/p31/Record?pid=@(r.p31ID)',3)" class="ol-done-link">@_f.tra("Otevřít úkon")</a>
                        }
                    </div>
                }
            </section>
        }

        @if (!_hasRows)
        {
            <div class="ol-empty">
                <h2>@_f.tra("Jak to funguje")</h2>
                <ol>
                    <li>@_f.tra("Přetáhnete události z kalendáře Outlooku – jednu i celý týden najednou.")</li>
                    <li>@_f.tra("Průvodce převezme datum, čas a předmět a podle e-mailů účastníků najde klienta a projekt. Aktivitu navrhne podle toho, co v projektu obvykle vykazujete.")</li>
                    <li>@_f.tra("Návrhy zkontrolujete, opravíte a zapíšete. Stejnou událost nelze zapsat dvakrát.")</li>
                </ol>
                <p>@_f.tra("Soubory se nikam neukládají, čtou se jen při načtení.")</p>
            </div>
        }
    </div>

    @if (_todo.Count > 0 || _skipped.Count > 0)
    {
        <div class="ol-foot">
            <span class="ol-foot-sum" id="olSum"></span>
            <button type="button" class="btn btn-success" id="cmdOlSave" onclick="_postback('save')"><span class="material-icons-outlined-nosize">done_all</span>@_f.tra("Zapsat vybrané")</button>
            <button type="button" class="btn btn-light" onclick="_postback('clear')">@_f.tra("Vyčistit seznam")</button>
        </div>
    }
</form>

<script type="text/javascript">
    var _ol_txt_sum = @Json.Serialize(_f.tra("Vybráno úkonů:"));
    var _ol_txt_manual = @Json.Serialize(_f.tra("vybráno ručně"));

    // přetažení kamkoliv do okna
    (function () {
        var drop = document.getElementById("olDrop");
        var depth = 0;
        function has_files(e) { return e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], "Files") !== -1; }
        document.addEventListener("dragenter", function (e) { if (!has_files(e)) return; e.preventDefault(); depth++; document.body.classList.add("ol-dragging"); });
        document.addEventListener("dragover", function (e) { if (!has_files(e)) return; e.preventDefault(); e.dataTransfer.dropEffect = "copy"; });
        document.addEventListener("dragleave", function (e) { if (!has_files(e)) return; depth--; if (depth <= 0) { depth = 0; document.body.classList.remove("ol-dragging"); } });
        document.addEventListener("drop", function (e) {
            if (!has_files(e)) return;
            e.preventDefault(); depth = 0; document.body.classList.remove("ol-dragging");
            var files = e.dataTransfer.files;
            if (!files || files.length === 0) {
                _notify_message(@Json.Serialize(_f.tra("Prohlížeč nepředal žádný soubor. Zkuste události nejdřív přetáhnout na plochu a odtud sem.")), "info", "6000");
                return;
            }
            var dt = new DataTransfer();
            for (var i = 0; i < files.length; i++) dt.items.add(files[i]);
            document.getElementById("olFiles").files = dt.files;
            ol_upload();
        });
    })();

    function ol_upload() {
        if (document.getElementById("olFiles").files.length === 0) return;
        _loading_show("postback");
        if (!document.getElementById("IsPostback")) {
            $("#form1").append("<input type='hidden' id='IsPostback' name='IsPostback' /><input type='hidden' id='PostbackOper' name='PostbackOper' />");
        }
        $("#IsPostback").val("true");
        $("#PostbackOper").val("upload");
        form1.submit();
    }

    function ol_minutes(i) {
        var f = $("#Rows_" + i + "__TimeFrom").val(), u = $("#Rows_" + i + "__TimeUntil").val();
        if (!f || !u) return 0;
        var a = f.split(":"), b = u.split(":");
        var m = (parseInt(b[0]) * 60 + parseInt(b[1])) - (parseInt(a[0]) * 60 + parseInt(a[1]));
        if (m < 0) m += 24 * 60;
        return m;
    }
    function ol_hhmm(m) { return Math.floor(m / 60) + ":" + ("0" + (m % 60)).slice(-2); }

    function ol_dur(i) {
        $("#ol_dur_" + i).text(ol_hhmm(ol_minutes(i)) + " h");
        ol_sum();
    }

    function ol_sum() {
        var n = 0, m = 0;
        $(".ol-row").each(function () {
            var i = $(this).data("i");
            var on = $("#Rows_" + i + "__IsSelected").prop("checked");
            $(this).toggleClass("ol-off", !on);
            if (on) { n++; m += ol_minutes(i); }
        });
        $("#olSum").text(_ol_txt_sum + " " + n + " · " + ol_hhmm(m) + " h");
        $("#cmdOlSave").prop("disabled", n === 0);
    }

    function ol_select(mode) {
        $(".ol-row").each(function () {
            var i = $(this).data("i");
            var st = $(this).data("state");
            var on = false;
            if (mode === "all") on = st !== 1;
            if (mode === "sure") on = st !== 1 && $("#Rows_" + i + "__Confidence").val() === "3" && $("#Rows_" + i + "__p41ID").val() !== "0";
            $("#Rows_" + i + "__IsSelected").prop("checked", on);
        });
        ol_sum();
    }

    function ol_p41_change(i, pid) {
        // ruční volba projektu: jistota přestává platit
        $("#Rows_" + i + "__Confidence").val(pid > 0 ? "3" : "0");
        $("#Rows_" + i + "__Reason").val(pid > 0 ? _ol_txt_manual : "");
        $("#ol_why_" + i).html("<span class='ol-conf ol-conf" + (pid > 0 ? "m" : "0") + "'></span><span>" + (pid > 0 ? _ol_txt_manual : "") + "</span>");
        if (pid > 0) $("#Rows_" + i + "__IsSelected").prop("checked", true);
        ol_sum();
    }

    // hodnotu z hromadného comba zkopírovat do vybraných řádků
    function ol_bulk(prefix, pid) {
        var src = prefix === "p41" ? "BulkP41ID" : "BulkP32ID";
        var txt = $("[data-id=text_" + src + "]").val();
        if (!pid || pid === "0") return;
        $(".ol-row").each(function () {
            var i = $(this).data("i");
            if (!$("#Rows_" + i + "__IsSelected").prop("checked")) return;
            var id = "Rows_" + i + "__" + prefix + "ID";
            $("[data-id=value_" + id + "]").val(pid);
            $("[data-id=text_" + id + "]").val(txt);
            $("#cmdCombo" + id).val(txt);
            if (prefix === "p41") ol_p41_change(i, pid);
        });
        // hromadné combo vyčistit, ať je jasné, že se hodnota už rozkopírovala
        $("[data-id=value_" + src + "]").val("0"); $("[data-id=text_" + src + "]").val(""); $("#cmdCombo" + src).val("");
    }

    function ol_internal(i) {
        var t = document.getElementById("Rows_" + i + "__p31TextInternal");
        t.hidden = !t.hidden;
        if (!t.hidden) t.focus();
    }

    $(document).ready(function () {
        $(".ol-row").each(function () {
            ol_dur($(this).data("i"));
        });
        ol_sum();
    });
</script>
