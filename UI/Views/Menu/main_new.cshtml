@inject BL.Factory _f

@{
    Layout = null;

    IEnumerable<BO.p34ActivityGroup> _lisP34 = null;
    if (_f.CurrentUser.j04IsModule_p31)
    {
        _lisP34 = _f.p34ActivityGroupBL.GetList_WorksheetEntry_InAllProjects(_f.CurrentUser.pid);
    }
    IEnumerable<BO.p42ProjectType> _lisP42 = null;
    IEnumerable <BO.p44ProjectTemplate> _lisP44 = null;
    if (_f.CurrentUser.j04IsModule_p41)
    {
        _lisP42=_f.p42ProjectTypeBL.GetList_ProjectCreate();
        _lisP44 = _f.p44ProjectTemplateBL.GetList_ProjectCreate();
    }

    var _lisP29 = _f.p29ContactTypeBL.GetList_ContactCreate();
    var _lisO21 = _f.o21MilestoneTypeBL.GetList(new BO.myQuery("o21"));
    var _lisO18 = _f.o18DocTypeBL.GetList_DocumentCreate();
    var _lisJ04 = _f.j04UserRoleBL.GetList(new BO.myQueryJ04());
    var _lisP57 = _f.p57TaskTypeBL.GetList(new BO.myQuery("p57"));
    var _lisP60 = _f.p60TaskTemplateBL.GetList(new BO.myQuery("p60")).Where(p => p.p60IsPublic || p.j02ID_Owner == _f.CurrentUser.pid);

    var _lisP51Root = _f.p51PriceListBL.GetList(new BO.myQueryP51() { typeflag = 5 });
    var _lisP51Cost = _f.p51PriceListBL.GetList(new BO.myQueryP51() { typeflag = 2 });

}

@addTagHelper *, UI

@* menu Nový záznam – vzhled mn-* v site.css. Řádek = hlavní akce (nový záznam) + podtypy (druh, typ, šablona) + doplňkové odkazy *@
<div id="divMenuContainerNew" class="dynamicmenu_container mn" style="-webkit-transform: translate3d(0,0,0);">

    @if (_lisP34 != null && _lisP34.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_window_open('/p31/Record?pid=0',3)"><myicon prefix="p31"></myicon><span>@_f.tra("Vykázat úkon")</span></a>
            <div class="mn-subs">
                @if (_lisP34.Count() <= 15)
                {
                    @foreach (var c in _lisP34)
                    {
                        <a class="mn-sub" href="javascript:_window_open('/p31/Record?p34id=@(c.pid)',3)">@c.p34Name</a>
                    }
                }
                <a class="mn-extra" href="javascript:_window_open('/Import/Index?prefix=p31')"><span class="material-icons-outlined-nosize">upload_file</span>@_f.tra("Import hodin z XLS/schránky")</a>
            </div>
        </div>
    }

    @if (_lisP42 != null && _lisP42.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p41',0)"><myicon prefix="p41"></myicon><span>@_f.getP07Level(5, true)</span></a>
            <div class="mn-subs">
                @if (_lisP42.Count() <= 10)
                {
                    @foreach (var c in _lisP42)
                    {
                        <a class="mn-sub" href="javascript:_window_open('/p41/Record?p42id=@(c.pid)')">@c.p42Name</a>
                    }
                }
                @if (_lisP44.Count() <= 15 && _lisP44.Count() > 0)
                {
                    @foreach (var c in _lisP44)
                    {
                        <a class="mn-sub mn-tpl" href="javascript:_window_open('/p41cft/Index?p44id=@(c.pid)')" title="@_f.tra("Založit ze šablony")"><span class="material-icons-outlined-nosize">copy_all</span>@c.p44Name</a>
                    }
                }
                @if (_lisP44.Count() == 0 && _f.CurrentUser.TestPermission(BO.PermValEnum.GR_p41_Creator))
                {
                    <a class="mn-extra" href="javascript:_window_open('/p44/Record?pid=0')"><span class="material-icons-outlined-nosize">copy_all</span>@_f.tra("Nová šablona pro zakládání projektů")</a>
                }
            </div>
        </div>
    }

    @if (_f.CurrentUser.TestPermission(BO.PermValEnum.GR_p28_Creator) && _lisP29.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p28',0)"><myicon prefix="p28"></myicon><span>@_f.tra("Kontakt")</span></a>
            <div class="mn-subs">
                @foreach (var c in _lisP29)
                {
                    <a class="mn-sub" href="javascript:_window_open('/p28/Record?p29id=@(c.pid)')">@c.p29Name</a>
                }
                <a class="mn-extra" href="javascript:_window_open('/Import/p28_by_ico')"><span class="material-icons-outlined-nosize">upload_file</span>@_f.tra("Import kontaktů ze seznamu IČO")</a>
            </div>
        </div>
    }

    @if (_lisP60.Count() > 0 || _lisP57.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p56',0)"><myicon prefix="p56"></myicon><span>@_f.tra("Úkol")</span></a>
            <div class="mn-subs">
                @if (_lisP60.Count() > 0)
                {
                    @foreach (var c in _lisP60)
                    {
                        <a class="mn-sub mn-tpl" href="javascript:_window_open('/p56/Record?p60id=@(c.pid)')" title="@c.p60Name"><span class="material-icons-outlined-nosize">copy_all</span>@BO.Code.Bas.OM2(c.p60Name, 20)</a>
                    }
                }
                else if (_lisP57.Count() > 1)
                {
                    @foreach (var c in _lisP57)
                    {
                        <a class="mn-sub" href="javascript:_window_open('/p56/Record?p57id=@(c.pid)')">@c.p57Name</a>
                    }
                }
                <a class="mn-extra" href="javascript:_window_open('/p56/TodoList',3)"><span class="material-icons-outlined-nosize">control_point_duplicate</span>Todo-list</a>
                <a class="mn-extra" href="javascript:_window_open('/p58/Record',3)"><span class="material-icons-outlined-nosize">published_with_changes</span>@_f.tra("Opakovaný úkol")</a>
            </div>
        </div>
    }

    @if (_lisO21.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('o22',0)"><myicon prefix="o22"></myicon><span>@_f.tra("Událost/Termín/Lhůta")</span></a>
            @if (_lisO21.Count() > 1)
            {
                <div class="mn-subs">
                    @foreach (var c in _lisO21)
                    {
                        <a class="mn-sub" href="javascript:_window_open('/o22/Record?o21id=@(c.pid)')">@c.o21Name</a>
                    }
                </div>
            }
        </div>
    }

    @if (_lisO18.Count() > 0)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('o23',0)"><myicon prefix="o23"></myicon><span>@_f.tra("Dokument")</span></a>
            <div class="mn-subs">
                @foreach (var c in _lisO18)
                {
                    <a class="mn-sub" href="javascript:_window_open('/o23/Record?o18id=@(c.pid)')">@c.o18Name</a>
                }
            </div>
        </div>
    }

    <div class="mn-row">
        <a class="mn-main" href="javascript:_edit('b05',0)"><myicon prefix="b05"></myicon><span>@_f.tra("Poznámka")</span></a>
    </div>

    @if (_f.CurrentUser.j04IsModule_p90 && _f.CurrentUser.TestPermission(BO.PermValEnum.GR_p90_Creator))
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p90',0)"><myicon prefix="p90"></myicon><span>@_f.tra("Zálohová faktura")</span></a>
        </div>
    }

    @{
        bool _p51 = _f.CurrentUser.j04IsModule_p31 && _f.CurrentUser.TestPermission(BO.PermValEnum.GR_p51_Admin);
        bool _p40 = _f.CurrentUser.j04IsModule_p31 && _f.CurrentUser.TestPermission(BO.PermValEnum.GR_p41_Creator);
        bool _p49 = _f.CurrentUser.j04IsModule_p49;
        bool _j02 = _f.CurrentUser.IsAdmin && _lisJ04 != null && _lisJ04.Count() > 0;
    }
    @if (_p51 || _p40 || _p49 || _j02)
    {
        <div class="mn-sep">@_f.tra("Nastavení a plány")</div>
    }

    @if (_p51)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p51',0)"><myicon symbol="price_change"></myicon><span>@_f.tra("Ceník sazeb")</span></a>
            <div class="mn-subs">
                <a class="mn-sub" href="javascript:_window_open('/p51/Record?p51typeflag=1')">@_f.tra("Fakturační sazby")</a>
                @if (_lisP51Root.Count() == 0)
                {
                    <a class="mn-sub" href="javascript:_window_open('/p51/Record?p51typeflag=5')">@_f.tra("Root ceník fakturačních sazeb")</a>
                }
                @if (_lisP51Cost.Count() == 0)
                {
                    <a class="mn-sub" href="javascript:_window_open('/p51/Record?p51typeflag=2')">@_f.tra("Nákladové sazby")</a>
                }
            </div>
        </div>
    }

    @if (_p40)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p40',0)"><myicon symbol="repeat_on"></myicon><span>@_f.tra("Opakovaná odměna")</span></a>
        </div>
    }

    @if (_p49)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('p49',0)"><myicon symbol="energy_savings_leaf"></myicon><span>@_f.tra("Finanční plán")</span></a>
        </div>
    }

    @if (_j02)
    {
        <div class="mn-row">
            <a class="mn-main" href="javascript:_edit('j02',0)"><myicon prefix="j02"></myicon><span>@_f.tra("Uživatel")</span></a>
            <div class="mn-subs">
                @foreach (var c in _lisJ04)
                {
                    <a class="mn-sub" href="javascript:_window_open('/j02/Record?j04id=@(c.pid)')">@c.j04Name</a>
                }
            </div>
        </div>
    }
</div>

<script type="text/javascript">
    _adjust_divheight_small_display("divMenuContainerNew");
</script>
