@inject BL.Factory _f

@{
    Layout = null;

    var _culture = System.Globalization.CultureInfo.CurrentUICulture.Name;

    var cmenu = new UI.Menu.TheMenuSupport(_f);
    var _myfileboxulr = cmenu.GetMainmenuEntityUrl("o27");

    var _u = _f.CurrentUser;
    string _initials = ((_u.j02FirstName ?? "").Trim().Length > 0 ? _u.j02FirstName.Trim().Substring(0, 1) : "")
                     + ((_u.j02LastName ?? "").Trim().Length > 0 ? _u.j02LastName.Trim().Substring(0, 1) : "");
    if (_initials == "") { _initials = "?"; }
    bool _profile = _u.TestPermission(BO.PermValEnum.GR_MyProfile);
    const string _mobileUrl = "https://mobile.marktime.net";
}

@addTagHelper *, UI

@* osobní menu (offcanvas vpravo v _Layout) – vzhled mme-* v site.css *@
<div id="divMenuContainerMe" class="mme">

    @if (_profile)
    {
        <a id="linkMyProfile" class="mme-user mme-user-link" href="/Home/MyProfile" title="@_f.tra("Můj profil")">
            <div class="mme-avatar" aria-hidden="true">@_initials</div>
            <div class="mme-user-txt">
                <div class="mme-user-name">@_u.FullNameAsc</div>
                <div class="mme-user-login">@_u.j02Login · @_f.tra("Můj profil")</div>
            </div>
            <span class="mme-user-go" aria-hidden="true">›</span>
        </a>
    }
    else
    {
        <div class="mme-user">
            <div class="mme-avatar" aria-hidden="true">@_initials</div>
            <div class="mme-user-txt">
                <div class="mme-user-name">@_u.FullNameAsc</div>
                <div class="mme-user-login">@_u.j02Login</div>
            </div>
        </div>
    }

    @if (_profile)
    {
        <div class="mme-settings">
            <div class="mme-set">
                <span>@_f.tra("Písmo")</span>
                <div class="mme-seg" role="group">
                    <a href="javascript:save_fontsize(1)" class="@(_u.j02FontSizeFlag == 1 ? "mme-on" : null)" style="font-size:80%;" title="@(_f.tra("Malé písmo"))">A</a>
                    <a href="javascript:save_fontsize(2)" class="@(_u.j02FontSizeFlag == 2 ? "mme-on" : null)" style="font-weight:600;" title="@(_f.tra("Výchozí velikost písma"))">A</a>
                    <a href="javascript:save_fontsize(3)" class="@(_u.j02FontSizeFlag == 3 ? "mme-on" : null)" style="font-size:130%;font-weight:600;" title="@(_f.tra("Velké písmo"))">A</a>
                </div>
            </div>

            <div class="mme-set">
                <span>@_f.tra("Vzhled")</span>
                <div class="mme-seg" role="group">
                    <a href="javascript:mme_look('modern')" class="@(UI.Code.UiLook.IsModern(_f) ? "mme-on" : null)">@_f.tra("Moderní")</a>
                    <a href="javascript:mme_look('classic')" class="@(UI.Code.UiLook.IsModern(_f) ? null : "mme-on")">@_f.tra("Klasický")</a>
                </div>
            </div>

            <form id="formMeLang" asp-controller="Culture" asp-action="SaveLang" method="post" class="mme-set">
                <input type="hidden" name="returnUrl" id="mmeReturnUrl" value="" />
                <span>@_f.tra("Jazyk")</span>
                <div class="mme-seg mme-lang" role="radiogroup">
                    <label class="@(_culture == "cs-CZ" ? "mme-on" : null)" title="Čeština">
                        <input type="radio" name="culture" value="cs-CZ" onchange="mme_lang(this)" @(_culture == "cs-CZ" ? "checked" : null)>
                        <img src="/images/small_czechrepublic.gif" width="18" alt="" /> CZ
                    </label>
                    <label class="@(_culture == "en-US" ? "mme-on" : null)" title="English">
                        <input type="radio" name="culture" value="en-US" onchange="mme_lang(this)" @(_culture == "en-US" ? "checked" : null)>
                        <img src="/images/small_uk.gif" width="18" alt="" /> EN
                    </label>
                    <label class="@(_culture == "sk-SK" ? "mme-on" : null)" title="Slovenčina">
                        <input type="radio" name="culture" value="sk-SK" onchange="mme_lang(this)" @(_culture == "sk-SK" ? "checked" : null)>
                        <img src="/images/small_slovakia.gif" width="18" alt="" /> SK
                    </label>
                </div>
            </form>
        </div>

        <nav class="mme-list">
            <a class="mme-item" href="javascript:_bells()">
                <myicon symbol="notifications_active"></myicon>
                <span>@_f.tra("Co mě čeká...")</span>
                @if (_u.BellsCount > 0)
                {
                    <span class="mme-badge">@_u.BellsCount</span>
                }
            </a>
            <a class="mme-item" href="javascript:_window_open('/Mail/SendMail',3)">
                <myicon symbol="edit_note"></myicon>
                <span>@_f.tra("Odeslat zprávu")</span>
            </a>
            <a id="linkMyOutbox" class="mme-item" href="/TheGrid/FlatView?prefix=x40">
                <myicon symbol="outbox"></myicon>
                <span>@_f.tra("Můj OUTBOX")</span>
            </a>
            @if (_u.j04IsModule_o27)
            {
                <a id="linkMyFilebox" class="mme-item" href="@(_myfileboxulr)">
                    <myicon symbol="attachment"></myicon>
                    <span>@_f.tra("Můj FILEBOX")</span>
                </a>
            }
            @if (_u.TestPermission(BO.PermValEnum.GR_x31_Personal))
            {
                <a id="linkPersonalReport" class="mme-item" href="javascript:report()">
                    <myicon symbol="print"></myicon>
                    <span>@_f.tra("Osobní tisková sestava")</span>
                </a>
            }
            <a class="mme-item" href="javascript:_window_open('/icalgen/Index',2)">
                <myicon symbol="calendar_add_on"></myicon>
                <span>@_f.tra("Integrace s Google/Outlook kalendářem")</span>
            </a>
        </nav>
    }

    <nav class="mme-list">
        <a class="mme-item" id="linkPWD" href="/Home/ChangePassword">
            <myicon symbol="password"></myicon>
            <span>@_f.tra("Změnit přístupové heslo")</span>
        </a>
        <a class="mme-item" href="javascript:mme_toggle_mobile()" aria-expanded="false" id="linkMobileApp">
            <myicon symbol="smartphone"></myicon>
            <span>@_f.tra("Mobilní aplikace")</span>
            <span class="mme-chev">▾</span>
        </a>
        <div id="mmeMobile" class="mme-mobile" style="display:none;">
            <img src="@UI.Code.basQRCoder.GetUrlQrDataUri(_mobileUrl)" width="96" height="96" alt="QR: @_mobileUrl" />
            <div>
                <small>@_f.tra("Naskenujte telefonem, nebo otevřete:")</small>
                <a href="@_mobileUrl" target="_blank" rel="noopener">mobile.marktime.net</a>
            </div>
        </div>
        @if (_profile)
        {
            @if (_u.j02LiveChatTimestamp == null)
            {
                <a id="linkSmartSupp" class="mme-item" href="javascript:_livechat(true)">
                    <myicon symbol="headset_mic"></myicon>
                    <span>@_f.tra("Zapnout live chat s podporou")</span>
                </a>
            }
            else
            {
                <a id="linkSmartSupp" class="mme-item" href="javascript:_livechat(false)">
                    <myicon symbol="headset_off"></myicon>
                    <span>@_f.tra("Vypnout live chat s podporou")</span>
                </a>
            }
        }
        <a id="linkOnboarding" class="mme-item" href="/Onboarding">
            <myicon symbol="rocket_launch"></myicon>
            <span>@_f.tra("Onboarding (začínáme)")</span>
        </a>
        <a id="linkNews" class="mme-item" href="javascript:_news()">
            <myicon symbol="campaign"></myicon>
            <span>@_f.tra("Novinky | Blog")</span>
            @if (_u.j02LastReadNews_Timestamp == null)
            {
                <span class="mme-dot" title="@_f.tra("Nepřečtené novinky")"></span>
            }
        </a>
        <a id="linkAbout" class="mme-item" href="/Home/About">
            <myicon symbol="info"></myicon>
            <span>@_f.tra("O aplikaci")</span>
        </a>
    </nav>

    <div class="mme-bottom">
        <a class="mme-item mme-logout" href="/Home/Logout">
            <myicon symbol="logout"></myicon>
            <span>@_f.tra("Odhlásit se")</span>
        </a>
    </div>
</div>

<script type="text/javascript">
    _adjust_divheight_small_display("divMenuContainerMe");

    var _j02id_local = "@_u.pid";

    (function () {
        var url = window.location.pathname;
        if (url.indexOf("MyProfile") > 0) $("#linkMyProfile").addClass("mme-active");
        if (url.indexOf("ChangePassword") > 0) $("#linkPWD").addClass("mme-active");
        if (url.indexOf("About") > 0) $("#linkAbout").addClass("mme-active");
        if (url.indexOf("/Onboarding") >= 0) $("#linkOnboarding").addClass("mme-active");
        if (location.href.indexOf("FlatView?prefix=x40") > 0) $("#linkMyOutbox").addClass("mme-active");
    })();

    function report() {
        _window_open("/ReportsClient/ReportContext?pid=" + _j02id_local + "&prefix=j02");
    }

    function save_fontsize(fontsize) {
        $.post("/Home/SaveCurrentUserFontSize", { fontsize: fontsize }, function () {
            location.replace(window.location.href);
        });
    }

    function mme_look(look) {     //stejný parametr jako přepínač v Můj profil
        $.post(_ep("/Common/SetUserParam"), { key: "ui-look", value: look }, function () { location.reload(); });
    }

    function mme_lang(rb) {       //po změně jazyka zpět na aktuální stránku (menu je načtené AJAXem, Request.Path by byl /Menu/main_me)
        $("#mmeReturnUrl").val(location.pathname + location.search);
        rb.form.submit();
    }

    function mme_toggle_mobile() {
        var $p = $("#mmeMobile").toggle();
        $("#linkMobileApp").attr("aria-expanded", $p.is(":visible")).toggleClass("mme-open", $p.is(":visible"));
    }
</script>
