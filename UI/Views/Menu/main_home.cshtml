<script type="text/javascript">
    var _pripnout_tooltip = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_pripnout_tooltip));
    var _odepnout_tooltip = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_odepnout_tooltip));

    $(document).ready(function () {
        _adjust_divheight_small_display("divHomeMenu");

        if (location.href.toLowerCase().indexOf("/home/index") > 0) {
            $("#linkSaveAsHomePage").css("display", "none");
        }

        //špendlík: stav vykreslil server (hm-pinned), klik připne / odepne a načte stránku znovu
        $(".hm .pin").on("click", function (e) {
            e.preventDefault();
            if ($(this).hasClass("hm-pinned")) remove_from_menu(this); else append_to_menu(this);
        });

        //hledání v menu (bez ohledu na diakritiku), Enter otevře první nalezený odkaz
        var norm = function (s) { return (s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, ""); };
        $(".hm-item").each(function () {
            var sec = $(this).closest(".hm-sec").find(".hm-sec-title").text();
            $(this).data("hay", norm($(this).find(".hm-link").text() + " " + sec));
        });
        $("#hmSearch").on("input", function () {
            var words = norm(this.value).split(/\s+/).filter(function (w) { return w; });
            $(".hm-item").each(function () {
                var hay = $(this).data("hay"), ok = words.every(function (w) { return hay.indexOf(w) >= 0; });
                $(this).toggleClass("hm-hide", !ok);
            });
            $(".hm-sec").each(function () { $(this).toggleClass("hm-hide", $(this).find(".hm-item:not(.hm-hide)").length === 0); });
            $(".hm-quick").toggleClass("hm-hide", $(".hm-quick .hm-item:not(.hm-hide)").length === 0);
            $("#hmEmpty").toggle($(".hm-item:not(.hm-hide)").length === 0);
        }).on("keydown", function (e) {
            if (e.key === "Enter") {
                var a = $(".hm-item:not(.hm-hide) .hm-link").get(0);
                if (a) { e.preventDefault(); a.click(); }
            }
        });
        if (_device.type !== "Phone") setTimeout(function () { $("#hmSearch").trigger("focus"); }, 50);
    });

    var url = window.location.pathname + window.location.search;
    var urllower = url.toLowerCase();
    
    var homeurl = "@(_f.CurrentUser.j02HomePageUrl)";

    if (urllower.indexOf(homeurl.toLowerCase()) >= 0) {
