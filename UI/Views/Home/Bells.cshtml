@model UI.Models.Home.BellsViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Co na mě čeká");
    Model.PageSymbol = "notifications_active";
    Layout = "~/Views/Shared/_LayoutModal.cshtml";

    var _now = DateTime.Now;
    var _today = DateTime.Today;
    int _dow = ((int)_today.DayOfWeek + 6) % 7;                 //po=0
    var _weekEnd = _today.AddDays(7 - _dow);                    //pondělí příštího týdne

    //skupiny podle času (pořadí zobrazení)
    string Bucket(DateTime d)
    {
        if (d < _now && d < _today.AddDays(-7)) return "older";
        if (d < _now) return "overdue";
        if (d < _today.AddDays(1)) return "today";
        if (d < _today.AddDays(2)) return "tomorrow";
        if (d < _weekEnd) return "week";
        return "later";
    }
    var _buckets = new (string key, string title, string css)[] {
        ("overdue", _f.tra("Po termínu (posledních 7 dní)"), "bl-g-overdue"),
        ("today", _f.tra("Dnes"), "bl-g-today"),
        ("tomorrow", _f.tra("Zítra"), ""),
        ("week", _f.tra("Tento týden"), ""),
        ("later", _f.tra("Později"), ""),
        ("older", _f.tra("Starší"), "bl-g-older")
    };

    //typ upozornění → ikona + popisek
    (string icon, string label) Kind(BO.j97BellsLog c)
    {
        switch (c.j97UserInsert)
        {
            case "p41PlanUntil-j02id": case "p41PlanUntil-j11id": return ("work_outline", _f.tra("Termín projektu"));
            case "p56PlanUntil-j02id": case "p56PlanUntil-j11id": return ("task_alt", _f.tra("Termín úkolu"));
            case "o22PlanUntil-j02id": case "o22PlanUntil-j11id": return ("event", _f.tra("Termín"));
            case "o24-j02id": case "o24-j11id": case "o24-x67id": return ("alarm", _f.tra("Připomenutí"));
        }
        if (c.j97RecordEntity == "p40") return ("sync_problem", _f.tra("Skluz generování"));
        return ("notifications", BO.Code.Entity.GetAlias(c.j97RecordEntity));
    }

    string Rel(DateTime d)
    {
        var span = d - _now;
        var a = span.Duration();
        string s = a.TotalMinutes < 60 ? $"{Math.Max(1, (int)a.TotalMinutes)} min" : (a.TotalHours < 24 ? $"{(int)a.TotalHours} h" : $"{(int)Math.Round(a.TotalDays)} " + _f.tra("dní"));
        return span.TotalSeconds >= 0 ? _f.tra("za") + " " + s : _f.tra("před") + " " + s;
    }

    string RecUrl(BO.j97BellsLog c)
    {
        string prefix = c.j97RecordEntity == "dd2" ? "o23" : c.j97RecordEntity;
        if (prefix == "p31") return $"/TheGrid/FlatView?prefix=p31&myqueryinline=pids|list_int|{c.j97RecordPid}";
        return $"/Record/RecPage?prefix={prefix}&pid={c.j97RecordPid}";
    }

    int _overdueActive = Model.Items.Count(p => !p.j97IsHidden && Bucket(p.j97Date) == "overdue");
    int _olderActive = Model.Items.Count(p => !p.j97IsHidden && Bucket(p.j97Date) == "older");
}

@section header_content
{
    <link rel="stylesheet" href="~/css/bells.css" asp-append-version="true" />
}

<div class="bg-light bl-toolbar">
    <div class="bl-seg" role="tablist">
        <a href="/Home/Bells" class="@(Model.ViewMode == "" ? "bl-on" : null)">@_f.tra("Aktivní") <span class="bl-n" id="bl_active_n">@Model.ActiveCount</span></a>
        <a href="/Home/Bells?view=hidden" class="@(Model.ViewMode == "hidden" ? "bl-on" : null)">@_f.tra("Skryté")</a>
        <a href="/Home/Bells?view=showall" class="@(Model.ViewMode == "showall" ? "bl-on" : null)">@_f.tra("Vše")</a>
    </div>
    <a class="btn btn-sm ai-btn bl-ai" href="/AiAsk?q=@(Uri.EscapeDataString(_f.tra("Co mě čeká tento a příští týden? Termíny úkolů, projektů a události, kde jsem řešitel.")))" target="_top" title="@_f.tra("Zeptej se MARKTIME")">
        <span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Zeptat se AI")
    </a>
    <button id="cmdClose" onclick="_window_close()" class="btn btn-light btn-sm"><span class="material-icons-outlined-btn">close</span>@_f.tra("Zavřít")</button>
</div>

<div class="modal_record_container bl">

    @if (Model.Items.Count == 0)
    {
        <div class="bl-empty">
            <span class="material-icons-outlined-nosize">notifications_none</span>
            <b>@(Model.ViewMode == "hidden" ? _f.tra("Žádná skrytá upozornění.") : _f.tra("Nic na vás nečeká."))</b>
            @if (Model.ViewMode == "")
            {
                <small>@_f.tra("Upozornění na termíny úkolů, projektů, událostí a připomenutí se tu objeví samy.")</small>
            }
        </div>
    }

    @if (Model.ViewMode == "" && (_overdueActive + _olderActive) > 1)
    {
        <div class="bl-bulk">
            <span>@string.Format(_f.tra("{0} upozornění je po termínu."), _overdueActive + _olderActive)</span>
            <button type="button" class="btn btn-sm bog" id="cmdHidePast"><span class="material-icons-outlined-btn">done_all</span> @_f.tra("Skrýt vše po termínu")</button>
        </div>
    }

    @foreach (var b in _buckets)
    {
        var items = Model.Items.Where(p => Bucket(p.j97Date) == b.key).OrderBy(p => b.key == "overdue" || b.key == "older" ? -p.j97Date.Ticks : p.j97Date.Ticks).ToList();
        if (items.Count == 0) { continue; }
        <section class="bl-group @b.css" data-bucket="@b.key">
            <h2>@b.title <span class="bl-n">@items.Count</span></h2>
            @foreach (var c in items)
            {
                var k = Kind(c);
                <div class="bl-item @(c.j97IsHidden ? "bl-hidden" : null)" data-pid="@c.pid">
                    <span class="bl-ico material-icons-outlined-nosize" title="@k.label">@k.icon</span>
                    <div class="bl-main">
                        <a class="bl-text" href="@RecUrl(c)" target="_top">@c.j97Text</a>
                        <div class="bl-meta">
                            <span class="bl-kind">@k.label</span>
                            @if (!string.IsNullOrEmpty(c.j97AfterText))
                            {
                                <span class="bl-after">@c.j97AfterText</span>
                            }
                        </div>
                    </div>
                    <div class="bl-when" title="@c.j97Date.ToString("d.M.yyyy HH:mm")">
                        <b>@(c.j97Date.TimeOfDay.TotalMinutes == 0 || (c.j97Date.Hour == 23 && c.j97Date.Minute == 59) ? c.j97Date.ToString("d.M.") : c.j97Date.ToString("d.M. HH:mm"))</b>
                        <small>@Rel(c.j97Date)</small>
                    </div>
                    <button type="button" class="bl-btn bl-hide" title="@_f.tra("Skrýt (mám vyřízeno)")"><span class="material-icons-outlined-nosize">check</span></button>
                    <button type="button" class="bl-btn bl-show" title="@_f.tra("Znovu zobrazit")"><span class="material-icons-outlined-nosize">undo</span></button>
                </div>
            }
        </section>
    }
</div>

<script type="text/javascript">
    var _bl_view = "@Model.ViewMode";

    $(document).ready(function () {
        $(".bl").on("click", ".bl-hide", function () { bl_set([$(this).closest(".bl-item").data("pid")], true); });
        $(".bl").on("click", ".bl-show", function () { bl_set([$(this).closest(".bl-item").data("pid")], false); });
        $("#cmdHidePast").on("click", function () {
            var pids = $(".bl-group[data-bucket=overdue] .bl-item:not(.bl-hidden), .bl-group[data-bucket=older] .bl-item:not(.bl-hidden)").map(function () { return $(this).data("pid"); }).get();
            bl_set(pids, true);
            $(this).closest(".bl-bulk").slideUp(150);
        });
    });

    function bl_set(pids, hidden) {
        if (!pids.length) return;
        $.post(_ep("/Home/BellsSetHidden"), { pids: pids.join(","), hidden: hidden }, function (data) {
            pids.forEach(function (pid) {
                var $it = $(".bl-item[data-pid='" + pid + "']").toggleClass("bl-hidden", hidden);
                //v pohledu Aktivní / Skryté položka odjede; ve Vše jen zešedne
                if ((_bl_view === "" && hidden) || (_bl_view === "hidden" && !hidden)) {
                    $it.addClass("bl-leaving");
                    setTimeout(function () {
                        var $g = $it.closest(".bl-group");
                        $it.remove();
                        var n = $g.find(".bl-item").length;
                        if (n === 0) $g.slideUp(120); else $g.find("h2 .bl-n").text(n);
                    }, 250);
                }
            });
            $("#bl_active_n").text(data.count);
            bl_update_bell(data.count);
        });
    }

    //zvoneček v liště hlavního okna (modal běží v iframe)
    function bl_update_bell(count) {
        try {
            var doc = window.parent.document;
            var bell = doc.getElementById("cmdBells");
            if (!bell) return;
            bell.style.display = count > 0 ? "" : "none";
            var n = doc.getElementById("cmdBellsCount");
            if (n) n.textContent = count > 99 ? "99+" : count;
        } catch (e) { }
    }
</script>
