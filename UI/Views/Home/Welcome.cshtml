@inject BL.Factory _f
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@{
    Layout = null;
    //Uvítací okno „Co je nového“ – obsah v UI.Code.WelcomeContent, načítá ho _welcome_open() v _Layout
    string _imgDir = System.IO.Path.Combine(_env.WebRootPath ?? "", "images", "welcome");
}

<style type="text/css">
    .wl-back { position: fixed; inset: 0; z-index: 3000; background-color: rgba(20, 28, 40, 0.55); display: flex; align-items: center; justify-content: center; padding: 16px; }
    .wl-box { background-color: #fff; color: #212529; width: 100%; max-width: 720px; max-height: calc(100vh - 32px); display: flex; flex-direction: column; border-radius: 12px; box-shadow: 0 18px 60px rgba(0, 0, 0, 0.35); overflow: hidden; }
    .wl-head { padding: 22px 26px 14px 26px; background: linear-gradient(135deg, var(--pozadi, #0b4b92), color-mix(in srgb, var(--pozadi, #0b4b92) 65%, #7a5cf0)); color: #fff; position: relative; }
    .wl-head h2 { margin: 0; font-size: 1.5rem; font-weight: 700; }
    .wl-head p { margin: 4px 0 0 0; opacity: 0.9; }
    .wl-x { position: absolute; top: 10px; right: 12px; border: 0; background: transparent; color: #fff; font-size: 22px; line-height: 1; opacity: 0.8; cursor: pointer; }
    .wl-x:hover { opacity: 1; }
    .wl-body { padding: 8px 26px; overflow-y: auto; }
    .wl-item { display: flex; align-items: flex-start; gap: 14px; padding: 12px 0; border-bottom: 1px solid #eef0f2; }
    .wl-item:last-child { border-bottom: 0; }
    .wl-ico { flex: 0 0 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background-color: color-mix(in srgb, var(--pozadi, #0b4b92) 10%, #ffffff); color: var(--pozadi, #0b4b92); }
    .wl-ico .material-icons-outlined-nosize { font-size: 24px; }
    .wl-txt { flex: 1 1 auto; min-width: 0; }
    .wl-txt strong { display: block; font-size: 1.02rem; }
    .wl-txt span { color: #495057; }
    .wl-img { flex: 0 0 150px; }
    .wl-img img { width: 150px; height: auto; border-radius: 6px; border: 1px solid #e3e6ea; display: block; }
    .wl-foot { display: flex; align-items: center; gap: 12px; padding: 14px 26px; border-top: 1px solid #e9ecef; background-color: #f8f9fa; }
    .wl-foot a { text-decoration: none; }
    .wl-foot .btn { margin-left: auto; min-width: 120px; }
    @@media (max-width: 600px) { .wl-img { display: none; } .wl-head h2 { font-size: 1.25rem; } }
</style>

<div id="wl_back" class="wl-back" role="dialog" aria-modal="true" aria-labelledby="wl_title">
    <div class="wl-box">
        <div class="wl-head">
            <button type="button" class="wl-x" title="@_f.tra("Zavřít")" onclick="_welcome_close()">&times;</button>
            <h2 id="wl_title">@_f.tra(UI.Code.WelcomeContent.Title)</h2>
            <p>@_f.tra(UI.Code.WelcomeContent.Subtitle)</p>
        </div>
        <div class="wl-body">
            @foreach (var c in UI.Code.WelcomeContent.GetItems(_f))
            {
                bool bolImg = !string.IsNullOrEmpty(c.Image) && System.IO.File.Exists(System.IO.Path.Combine(_imgDir, c.Image));
                <div class="wl-item">
                    <div class="wl-ico"><span class="material-icons-outlined-nosize">@c.Icon</span></div>
                    <div class="wl-txt">
                        <strong>@_f.tra(c.Title)</strong>
                        <span>@_f.tra(c.Text)</span>
                    </div>
                    @if (bolImg)
                    {
                        <div class="wl-img"><img src="/images/welcome/@c.Image" alt="" /></div>
                    }
                </div>
            }
        </div>
        <div class="wl-foot">
            <a href="@UI.Code.WelcomeContent.MoreUrl" target="_blank" rel="noopener">@_f.tra("Zjistit víc") ›</a>
            <button type="button" id="wl_ok" class="btn btn-primary" onclick="_welcome_close()">@_f.tra("Rozumím")</button>
        </div>
    </div>
</div>
