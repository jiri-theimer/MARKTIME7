    _mainmenu_highlight_current("cmdme");

    $("#cmdDefaultMenuLinks").click(function () {
    if (confirm("@_f.tra("Opravdu resetovat MENU odkazy do výchozího stavu?")")) {
    _postback("resetmenu");

    }

    });
    $("#cmdClearMenuLinks").click(function () {
    if (confirm("@_f.tra("Opravdu vyčistit MENU odkazy?")")) {
    _postback("clearmenu");

    }

    });

    $("#cmdClearParams").click(function () {
    if (confirm("@_f.tra("Opravdu vyčištit servech cache?")")) {
    $(this).text("Processing...");
    $(this).attr("disabled", true);
    form1.action = "/Home/MyProfile?oper=clearparams";
    form1.submit();
    }

    });

    var qrcode = new QRCode("qrcode1", {
    text: location.href,
    width: 128,
    height: 128,
    colorDark: "#000000",
    colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
    });

    _resize_textareas();
    });


    // ------------------------------------------------------------------ barevný motiv (náhled bez postbacku, uloží „Uložit změny“)
    var _skin_themes = [
        { name: "MARKTIME", bg: "#0b4b92", sel: "#4169e1", fore: "#ffffff" },
        { name: "MT6 (původní)", bg: "#2d89ef", sel: "#808080", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Noční modrá"))), bg: "#1e2a44", sel: "#3d5080", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Grafit"))), bg: "#343a40", sel: "#5c6670", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Petrol"))), bg: "#00616f", sel: "#13808f", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Les"))), bg: "#2e6b3a", sel: "#4a8a57", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Švestka"))), bg: "#5b3a73", sel: "#7b5797", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Bordó"))), bg: "#7b2333", sel: "#a23b4e", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Terakota"))), bg: "#9a3f1f", sel: "#b9542f", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Pískovec"))), bg: "#e9e4d8", sel: "#d3c8ad", fore: "#212529" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Led"))), bg: "#e3eef8", sel: "#bcd6ee", fore: "#0b2540" }
    ];
    var _skin_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { sample = _f.tra("Označeno"), button = _f.tra("Tlačítko") }));

    function skin_hex(c) {
        c = (c || "").trim().toLowerCase();
        if (/^#[0-9a-f]{3}$/.test(c)) c = "#" + c[1] + c[1] + c[2] + c[2] + c[3] + c[3];
        return /^#[0-9a-f]{6}$/.test(c) ? c : null;
    }
    function skin_rgb(h) { return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]; }
    function skin_tohex(rgb) { return "#" + rgb.map(function (x) { x = Math.max(0, Math.min(255, Math.round(x))); return (x < 16 ? "0" : "") + x.toString(16); }).join(""); }
    // relativní jas a kontrast podle WCAG 2
    function skin_lum(h) {
        return skin_rgb(h).map(function (v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); })
            .reduce(function (a, v, i) { return a + v * [0.2126, 0.7152, 0.0722][i]; }, 0);
    }
    function skin_contrast(a, b) { var x = skin_lum(a), y = skin_lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
    function skin_mix(a, b, t) { var x = skin_rgb(a), y = skin_rgb(b); return skin_tohex(x.map(function (v, i) { return v + (y[i] - v) * t; })); }

    // z jedné barvy: písmo černé/bílé podle kontrastu, označení světlejší (tmavý akcent) nebo tmavší (světlý akcent) s čitelným písmem
    function skin_derive(bg) {
        var fore = skin_contrast("#ffffff", bg) >= skin_contrast("#212529", bg) ? "#ffffff" : "#212529";
        var toward = fore === "#ffffff" ? "#ffffff" : "#000000";
        // tmavý akcent: označení o čtvrtinu světlejší; světlý akcent: jen mírně tmavší (jinak by s tmavým písmem splýval)
        var sel = bg;
        for (var t = (fore === "#ffffff" ? 0.25 : 0.12); t >= 0.03; t -= 0.03) {
            sel = skin_mix(bg, toward, t);
            if (skin_contrast(fore, sel) >= 3) break;
        }
        return { bg: bg, sel: sel, fore: fore };
    }

    function skin_apply(bg, sel, fore, preview) {
        bg = skin_hex(bg); sel = skin_hex(sel); fore = skin_hex(fore);
        if (!bg || !sel || !fore) return;
        $("#RecJ02_j02SkinBackColor").val(bg);
        $("#RecJ02_j02SkinSelColor").val(sel);
        $("#RecJ02_j02SkinForeColor").val(fore);
        var st = document.documentElement.style;
        st.setProperty("--pozadi", bg); st.setProperty("--oznaceno", sel); st.setProperty("--popredi", fore);
        $("#skin_accent").val(bg); $("#skin_bg").val(bg); $("#skin_sel").val(sel); $("#skin_fore").val(fore);
        $("#skin_contrast_warn").toggle(skin_contrast(fore, bg) < 3);
        $(".skin-tile").each(function () {
            var t = _skin_themes[$(this).data("i")];
            $(this).toggleClass("skin-tile-on", t.bg === bg && t.sel === sel && t.fore === fore);
        });
        if (preview) $("#skin_note").show();
    }

    function skin_init() {
        var $box = $("#skin_tiles");
        _skin_themes.forEach(function (t, i) {
            var $tile = $("<button>").attr({ type: "button", title: t.name }).addClass("skin-tile").data("i", i)
                .append($("<div>").addClass("skin-tile-bar").css({ background: t.bg, color: t.fore }).text(t.name))
                .append($("<div>").addClass("skin-tile-body")
                    .append($("<span>").addClass("skin-tile-sel").css({ background: t.sel, color: t.fore }).text(_skin_txt.sample))
                    .append($("<span>").addClass("skin-tile-btn").css({ background: t.bg, color: t.fore }).text(_skin_txt.button)))
                .on("click", function () { skin_apply(t.bg, t.sel, t.fore, true); });
            $box.append($tile);
        });
        $("#skin_accent").on("input", function () { var d = skin_derive(skin_hex(this.value)); skin_apply(d.bg, d.sel, d.fore, true); });
        $("#skin_bg, #skin_sel, #skin_fore").on("input", function () { skin_apply($("#skin_bg").val(), $("#skin_sel").val(), $("#skin_fore").val(), true); });
        skin_apply($("#RecJ02_j02SkinBackColor").val() || "#0b4b92", $("#RecJ02_j02SkinSelColor").val() || "#4169e1", $("#RecJ02_j02SkinForeColor").val() || "#ffffff", false);
    }
    $(function () { skin_init(); });

   

</script>









