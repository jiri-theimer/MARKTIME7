@model UI.Models.Home.MyProfileViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Můj profil");
    Layout = "~/Views/Shared/_Layout.cshtml";

    //údaje do hlavičky vždy z databáze (po POSTu má RecJ02 jen pole z formuláře)
    var _me = _f.j02UserBL.Load(_f.CurrentUser.pid) ?? Model.RecJ02;
    string _initials = ((_me.j02FirstName ?? "").Trim().Length > 0 ? _me.j02FirstName.Trim().Substring(0, 1) : "")
                     + ((_me.j02LastName ?? "").Trim().Length > 0 ? _me.j02LastName.Trim().Substring(0, 1) : "");
    if (_initials == "") { _initials = "?"; }
    const string _mobileUrl = "https://mobile.marktime.net";
}

@addTagHelper *, UI
@section header_content
{
    <link rel="stylesheet" href="~/css/myprofile.css" asp-append-version="true" />
}

<div class="tabs_container_record">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab1" class="nav-link active" data-bs-toggle="tab" role="tab" href="#tab1">
                <myicon prefix="j02"></myicon>
                @_f.tra("Můj profil")
            </a>
        </li>
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab2" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab2">
                <myicon symbol="email"></myicon>
                @_f.tra("Poštovní účty")
                @if (Model.lisJ40 != null && Model.lisJ40.Any())
                {
                    <span class="mp-count">@Model.lisJ40.Count()</span>
                }
            </a>
        </li>
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab3" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab3">
                <myicon symbol="search"></myicon>
                @_f.tra("Vyhledávání")
            </a>
        </li>
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab4" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab4">
                <myicon symbol="devices"></myicon>
                @_f.tra("Zařízení")
            </a>
        </li>
    </ul>
</div>

<div class="modal_record_container mp">
    <div class="tab-content">

        @* ------------------------------------------------------------ PROFIL *@
        <div class="tab-pane active" id="tab1" role="tabpanel">
            <form id="form1" asp-controller="Home" asp-action="MyProfile" method="POST">
                <input type="hidden" asp-for="SearchboxJ02" />
                <input type="hidden" asp-for="SearchboxP41" />
                <input type="hidden" asp-for="SearchboxP28" />
                <input type="hidden" asp-for="SearchboxP56" />
                <input type="hidden" asp-for="SearchboxP32" />
                <input type="hidden" asp-for="SearchboxP91" />
                <input type="hidden" asp-for="ActiveTabIndex" />

                <div class="mp-savebar">
                    <button type="submit" id="cmdSave" class="btn btn-success">@_f.tra("Uložit změny")</button>
                    <span id="mp_dirty" class="mp-dirty" style="display:none;">● @_f.tra("Neuložené změny")</span>
                </div>

                <section class="mp-head">
                    <div class="mp-avatar" aria-hidden="true">@_initials</div>
                    <div class="mp-who">
                        <div class="mp-name">@_me.FullNameAsc</div>
                        <div class="mp-meta">
                            <span title="@_f.tra("Přihlašovací jméno")"><span class="material-icons-outlined-nosize">person</span>@_me.j02Login</span>
                            @if (_me.j04Name != null)
                            {
                                <span title="@_f.tra("Aplikační role")"><span class="material-icons-outlined-nosize">admin_panel_settings</span>@_me.j04Name</span>
                            }
                            @if (_me.j07Name != null)
                            {
                                <span title="@_f.tra("Pozice")"><span class="material-icons-outlined-nosize">badge</span>@_me.j07Name</span>
                            }
                        </div>
                        <dl class="mp-facts">
                            @if (_me.j18Name != null)
                            {
                                <div><dt>@_f.tra("Středisko")</dt><dd>@_me.j18Name</dd></div>
                            }
                            @if (_me.c21Name != null)
                            {
                                <div><dt>@_f.tra("Pracovní fond")</dt><dd>@_me.c21Name</dd></div>
                            }
                            @if (Model.Teams != null)
                            {
                                <div><dt>@_f.tra("Člen týmů")</dt><dd>@Model.Teams</dd></div>
                            }
                            @if (_me.j02Code != null)
                            {
                                <div><dt>@_f.tra("Osobní kód")</dt><dd>@_me.j02Code</dd></div>
                            }
                        </dl>
                    </div>
                    <div class="mp-actions">
                        <a class="btn btn-sm bog" href="/Home/ChangePassword"><span class="material-icons-outlined-btn">key</span> @_f.tra("Změnit heslo")</a>
                        <button class="btn btn-sm bog" type="button" onclick="_window_open('/p31hes/Index', 3);"><span class="material-icons-outlined-btn">more_time</span> @_f.tra("Předvolby pro vykazování a schvalování")</button>
                    </div>
                </section>

                <div class="mp-grid">
                    <section class="mp-card">
                        <h2><span class="material-icons-outlined-nosize">contact_mail</span>@_f.tra("Kontakt")</h2>
                        <div class="mp-field">
                            <label for="RecJ02_j02Email">E-mail</label>
                            <input class="form-control" asp-for="RecJ02.j02Email" type="email" autocomplete="email" />
                        </div>
                        <div class="mp-field">
                            <label for="RecJ02_j02Mobile">@_f.tra("Mobilní telefon")</label>
                            <input class="form-control" asp-for="RecJ02.j02Mobile" type="tel" autocomplete="tel" />
                        </div>
                        <div class="mp-field">
                            <label for="RecJ02_j02EmailSignature">@_f.tra("Podpis pro e-mail zprávy")</label>
                            <textarea class="form-control" asp-for="RecJ02.j02EmailSignature" rows="3"></textarea>
                        </div>
                    </section>

                    <section class="mp-card">
                        <h2><span class="material-icons-outlined-nosize">tune</span>@_f.tra("Chování aplikace")</h2>
                        <div class="mp-field">
                            <label for="RecJ02_j02NotifySubscriberFlag">@_f.tra("E-mail notifikace")</label>
                            <select asp-for="@Model.RecJ02.j02NotifySubscriberFlag" class="form-select">
                                <option value="0">@_f.tra("Nechť mi systém odesílá e-mail notifikace")</option>
                                <option value="1">@_f.tra("Odhlašuji se z e-mail notifikací")</option>
                            </select>
                        </div>
                        <div class="mp-field">
                            <label for="RecJ02_j02AutocompleteFlag">@_f.tra("Automatické vyplňování formulářů")</label>
                            <select asp-for="RecJ02.j02AutocompleteFlag" class="form-select">
                                <option value="0">@_f.tra("Vypnuto")</option>
                                <option value="1">@_f.tra("Zapnuto")</option>
                            </select>
                            <small>@_f.tra("Zda prohlížeč nabízí dříve zadané hodnoty v polích formulářů.")</small>
                        </div>
                    </section>
                </div>

                <section class="mp-card mp-wide">
                    <h2><span class="material-icons-outlined-nosize">palette</span>@_f.tra("Vzhled – barevný motiv")</h2>
                    @* barvy se ukládají do j02SkinBackColor / j02SkinSelColor / j02SkinForeColor (CSS proměnné --pozadi, --oznaceno, --popredi v layoutech) *@
                    <input type="hidden" asp-for="@Model.RecJ02.j02SkinBackColor" />
                    <input type="hidden" asp-for="@Model.RecJ02.j02SkinSelColor" />
                    <input type="hidden" asp-for="@Model.RecJ02.j02SkinForeColor" />

                    <div class="skin-look">
                        <span class="me-2">@_f.tra("Vzhled aplikace"):</span>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="ui_look" id="ui_look_modern" value="modern" autocomplete="off" @(UI.Code.UiLook.IsModern(_f) ? "checked" : "") />
                            <label class="btn btn-sm btn-outline-primary" for="ui_look_modern">@_f.tra("Moderní")</label>
                            <input type="radio" class="btn-check" name="ui_look" id="ui_look_classic" value="classic" autocomplete="off" @(UI.Code.UiLook.IsModern(_f) ? "" : "checked") />
                            <label class="btn btn-sm btn-outline-primary" for="ui_look_classic">@_f.tra("Klasický")</label>
                        </div>
                        <span class="text-muted small ms-2">@_f.tra("Přepne se hned a platí jen pro vás.")</span>
                    </div>

                    <div id="skin_tiles" class="skin-tiles"></div>

                    <div class="skin-custom">
                        <label for="skin_accent">@_f.tra("Vlastní barva"):</label>
                        <input type="color" id="skin_accent" title="@_f.tra("Zvolte jednu barvu – odstín pro označení a barvu písma dopočítá aplikace tak, aby byl text čitelný")" />
                        <span class="text-muted small">@_f.tra("Odstín pro označení a barvu písma dopočítá aplikace tak, aby text zůstal čitelný.")</span>
                    </div>

                    <details class="skin-advanced">
                        <summary>@_f.tra("Pokročilé – všechny tři barvy ručně")</summary>
                        <div class="skin-advanced-body">
                            <label>@_f.tra("Pozadí lišty") <input type="color" id="skin_bg" /></label>
                            <label>@_f.tra("Označený prvek") <input type="color" id="skin_sel" /></label>
                            <label>@_f.tra("Písmo") <input type="color" id="skin_fore" /></label>
                            <span id="skin_contrast_warn" class="text-danger small" style="display:none;">@_f.tra("Písmo je na pozadí špatně čitelné.")</span>
                        </div>
                    </details>

                    <div id="skin_note" class="alert alert-info py-1 px-2 mt-2 mb-0" style="display:none;">
                        @_f.tra("Toto je náhled. Barvy uložíte tlačítkem [Uložit změny].")
                    </div>
                </section>
            </form>

            <div class="mp-grid">
                <section class="mp-card">
                    <h2><span class="material-icons-outlined-nosize">smartphone</span>@_f.tra("Mobilní aplikace")</h2>
                    <div class="mp-mobile">
                        <img class="nonmobile" src="@UI.Code.basQRCoder.GetUrlQrDataUri(_mobileUrl)" width="112" height="112" alt="QR: @_mobileUrl" />
                        <div>
                            <p>@_f.tra("Vykazujte hodiny a výdaje z telefonu. Přihlásíte se stejným jménem a heslem.")</p>
                            <a href="@_mobileUrl" target="_blank" rel="noopener" class="btn btn-sm bog"><span class="material-icons-outlined-btn">open_in_new</span> mobile.marktime.net</a>
                            <small class="d-block mt-1 nonmobile">@_f.tra("Naskenujte QR kód fotoaparátem telefonu.")</small>
                        </div>
                    </div>
                </section>

                <section class="mp-card">
                    <h2><span class="material-icons-outlined-nosize">build</span>@_f.tra("Údržba")</h2>
                    <div class="mp-maint nonmobile">
                        <div>
                            <b>@_f.tra("MENU odkazy")</b>
                            <small>@_f.tra("Vrátí odkazy v hlavním menu do výchozího stavu, nebo je všechny odebere.")</small>
                        </div>
                        <div class="mp-maint-btns">
                            <button type="button" id="cmdDefaultMenuLinks" class="btn btn-sm bog">@_f.tra("Výchozí stav")</button>
                            <button type="button" id="cmdClearMenuLinks" class="btn btn-sm btn-outline-danger">@_f.tra("Vyčistit")</button>
                        </div>
                    </div>
                    <div class="mp-maint">
                        <div>
                            <b>@_f.tra("Paměť uživatelského profilu")</b>
                            <small>@_f.tra("Naposledy vybrané záznamy, tiskové sestavy, sloupce vyhledávání, rozložení panelů apod.")</small>
                        </div>
                        <div class="mp-maint-btns">
                            <button type="button" id="cmdClearParams" class="btn btn-sm btn-outline-danger">@_f.tra("Vyčistit")</button>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        @* ------------------------------------------------------------ POŠTOVNÍ ÚČTY *@
        <div class="tab-pane" id="tab2" role="tabpanel">
            <div class="mp-toolbar">
                <button type="button" id="cmdAddJ40" class="btn btn-sm bog"><span class="material-icons-outlined-btn">add</span> @_f.tra("Přidat poštovní účet")</button>
            </div>
            @if (Model.lisJ40 == null || !Model.lisJ40.Any())
            {
                <div class="mp-empty">@_f.tra("Zatím nemáte žádný poštovní účet. Přidáte ho tlačítkem výše.")</div>
            }
            else
            {
                <table class="table table-hover mp-table">
                    <thead>
                        <tr><th>@_f.tra("Použití")</th><th>@_f.tra("Účet")</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.lisJ40)
                        {
                            <tr class="@(c.isclosed ? "closed_item" : null)" ondblclick="_edit('j40',@c.pid)">
                                <td>@c.UsageAlias</td>
                                <td>@c.Name</td>
                                <td class="text-end"><a class="btn btn-sm bog" href="javascript:_edit('j40',@c.pid)">@_f.tra("Upravit")</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* ------------------------------------------------------------ VYHLEDÁVÁNÍ (SEARCHBOX) *@
        <div class="tab-pane" id="tab3" role="tabpanel">
            <p class="mp-intro">@_f.tra("Sloupce, které se zobrazují ve výsledcích vyhledávání (Searchbox a výběrová pole) pro jednotlivé typy záznamů. Kliknutím na tlačítko upravíte sloupce.")</p>

            <table class="table mp-table mp-sb">
                <thead>
                    <tr><th>@_f.tra("Záznam")</th><th>@_f.tra("Sloupce")</th><th>@_f.tra("Seskupit podle")</th></tr>
                </thead>
                <tbody>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('j02')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Uživatel")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxJ02)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyJ02 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyJ02" onchange="reload_after_groupby(this,'j02')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxJ02)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('p41')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Projekt")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxP41)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyP41 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyP41" onchange="reload_after_groupby(this,'p41')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxP41)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('p28')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Kontakt")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxP28)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyP28 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyP28" onchange="reload_after_groupby(this,'p28')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxP28)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('p32')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Aktivita")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxP32)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyP32 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyP32" onchange="reload_after_groupby(this,'p32')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxP32)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('p56')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Úkol")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxP56)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyP56 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyP56" onchange="reload_after_groupby(this,'p56')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxP56)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td class="mp-sb-name">
                        <button type="button" class="btn btn-sm bog" onclick="grid_designer('p91')"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Vyúčtování")</button>
                    </td>
                    <td>
                        @foreach (var col in Model.lisSearchboxP91)
                        {
                            <span class="mp-col">@col.Header</span>
                        }
                    </td>
                    <td class="mp-sb-group">
                        <select class="form-select form-select-sm @(Model.SearchboxGroupbyP91 != null ? "mp-sb-grouped" : null)" asp-for="SearchboxGroupbyP91" onchange="reload_after_groupby(this,'p91')">
                            <option value="">@_f.tra("Bez seskupení")</option>
                            @foreach (var col in Model.lisSearchboxP91)
                            {
                                <option value="@col.UniqueName">@col.Header</option>
                            }
                        </select>
                    </td>
                </tr>
                </tbody>
            </table>

            <div class="mp-field mp-inline">
                <label for="SearchboxTopRecs">@_f.tra("Maximum najednou zobrazených záznamů")</label>
                <select asp-for="SearchboxTopRecs" class="form-select form-select-sm">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="150">150</option>
                    <option value="200">200</option>
                </select>
                <small>@_f.tra("Kolik záznamů se může najednou zobrazit v nabídce. Výchozí hodnota je 50.")</small>
            </div>
        </div>

        @* ------------------------------------------------------------ ZAŘÍZENÍ *@
        <div class="tab-pane" id="tab4" role="tabpanel">
            <dl class="mp-device">
                <div><dt>@_f.tra("Zařízení")</dt><dd><span id="infoMobile"></span> @Model.client_info.Device.Family</dd></div>
                <div><dt>@_f.tra("Operační systém")</dt><dd>@Model.client_info.OS.Family @Model.client_info.OS.Major</dd></div>
                <div><dt>@_f.tra("Prohlížeč")</dt><dd>@Model.client_info.UA.Family @Model.client_info.UA.Major</dd></div>
                <div><dt>@_f.tra("Dostupné rozlišení")</dt><dd id="infoAvailResolution"></dd></div>
                <div><dt>@_f.tra("Rozlišení okna")</dt><dd id="infoInnerResolution"></dd></div>
            </dl>
            <div class="mp-ua">@Model.userAgent</div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var _prefix_grid_designer = "";
    var _mp_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { sure = _f.tra("Opravdu? Klikněte znovu"), working = _f.tra("Pracuji…") }));

    $(document).ready(function () {
        //aktivní záložka (po postbacku)
        $(".tab-pane").removeClass("active");
        $("#tab@(Model.ActiveTabIndex)").addClass("active");
        $("#link_tab@(Model.ActiveTabIndex)").attr("class", "nav-link active");

        $("#infoAvailResolution").text(_device.availWidth + " × " + _device.availHeight);
        $("#infoInnerResolution").text(_device.innerWidth + " × " + _device.innerHeight);
        $("#infoMobile").text(_device.type);

        $('a[data-bs-toggle="tab"]').on("shown.bs.tab", function (e) {
            var tabindex = e.target.id.substring(e.target.id.length - 1);
            $("#ActiveTabIndex").val(tabindex);
            if (typeof tg_adjust_for_screen === "function") tg_adjust_for_screen();
        });

        $("#SearchboxTopRecs").change(function () {
            $.post("/Common/SetUserParam", { key: "searchbox-toprecs", value: $(this).val() }, function () {
                _postback("reload");
            });
        });

        $("#cmdAddJ40").click(function () {
            _window_open("/j40/Record?pid=0", 1);
        });

        //neuložené změny (vzhled aplikace Moderní/Klasický se ukládá hned → nepočítá se)
        $("#form1").on("input change", "input:not([name=ui_look]), select, textarea", mp_dirty);
        $("#skin_tiles").on("click", ".skin-tile", mp_dirty);
        $("#form1").on("submit", function () { $(window).off("beforeunload"); });

        //destruktivní akce: první klik se zeptá v tlačítku, druhý provede (bez confirm dialogu)
        mp_twostep("#cmdDefaultMenuLinks", function () { _postback("resetmenu"); });
        mp_twostep("#cmdClearMenuLinks", function () { _postback("clearmenu"); });
        mp_twostep("#cmdClearParams", function () {
            form1.action = "/Home/MyProfile?oper=clearparams";
            form1.submit();
        });

        _mainmenu_highlight_current("cmdme");
        _resize_textareas();
    });

    function mp_dirty() {
        if ($("#mp_dirty").is(":visible")) return;
        $("#mp_dirty").show();
        $("#cmdSave").addClass("mp-save-pulse");
        $(window).on("beforeunload", function () { return true; });
    }

    function mp_twostep(sel, action) {
        var $b = $(sel), txt = $b.html(), timer = null;
        $b.on("click", function () {
            if ($b.data("armed")) {
                clearTimeout(timer);
                $(window).off("beforeunload");
                $b.prop("disabled", true).text(_mp_txt.working);
                action();
                return;
            }
            $b.data("armed", true).addClass("mp-armed").text(_mp_txt.sure);
            timer = setTimeout(function () { $b.data("armed", false).removeClass("mp-armed").html(txt); }, 4000);
        });
    }

    // ------------------------------------------------------------------ barevný motiv (náhled bez postbacku, uloží „Uložit změny“)
    var _skin_themes = [
        { name: "MARKTIME", bg: "#0b4b92", sel: "#4169e1", fore: "#ffffff" },
        { name: "MT6 (původní)", bg: "#2d89ef", sel: "#808080", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Noční modrá"))), bg: "#1e2a44", sel: "#3d5080", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Grafit"))), bg: "#343a40", sel: "#5c6670", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Petrol"))), bg: "#00616f", sel: "#13808f", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Les"))), bg: "#2e6b3a", sel: "#4a8a57", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Švestka"))), bg: "#5b3a73", sel: "#7b5797", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Bordó"))), bg: "#7b2333", sel: "#a23b4e", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Terakota"))), bg: "#9a3f1f", sel: "#b9542f", fore: "#ffffff" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Pískovec"))), bg: "#e9e4d8", sel: "#d3c8ad", fore: "#212529" },
        { name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.tra("Led"))), bg: "#e3eef8", sel: "#bcd6ee", fore: "#0b2540" }
    ];
    var _skin_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { sample = _f.tra("Označeno"), button = _f.tra("Tlačítko") }));

    function skin_hex(c) {
        c = (c || "").trim().toLowerCase();
        if (/^#[0-9a-f]{3}$/.test(c)) c = "#" + c[1] + c[1] + c[2] + c[2] + c[3] + c[3];
        return /^#[0-9a-f]{6}$/.test(c) ? c : null;
    }
    function skin_rgb(h) { return [parseInt(h.substr(1, 2), 16), parseInt(h.substr(3, 2), 16), parseInt(h.substr(5, 2), 16)]; }
    function skin_tohex(rgb) { return "#" + rgb.map(function (x) { x = Math.max(0, Math.min(255, Math.round(x))); return (x < 16 ? "0" : "") + x.toString(16); }).join(""); }
    // relativní jas a kontrast podle WCAG 2
    function skin_lum(h) {
        return skin_rgb(h).map(function (v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); })
            .reduce(function (a, v, i) { return a + v * [0.2126, 0.7152, 0.0722][i]; }, 0);
    }
    function skin_contrast(a, b) { var x = skin_lum(a), y = skin_lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); }
    function skin_mix(a, b, t) { var x = skin_rgb(a), y = skin_rgb(b); return skin_tohex(x.map(function (v, i) { return v + (y[i] - v) * t; })); }

    // z jedné barvy: písmo černé/bílé podle kontrastu, označení světlejší (tmavý akcent) nebo tmavší (světlý akcent) s čitelným písmem
    function skin_derive(bg) {
        var fore = skin_contrast("#ffffff", bg) >= skin_contrast("#212529", bg) ? "#ffffff" : "#212529";
        var toward = fore === "#ffffff" ? "#ffffff" : "#000000";
        // tmavý akcent: označení o čtvrtinu světlejší; světlý akcent: jen mírně tmavší (jinak by s tmavým písmem splýval)
        var sel = bg;
        for (var t = (fore === "#ffffff" ? 0.25 : 0.12); t >= 0.03; t -= 0.03) {
            sel = skin_mix(bg, toward, t);
            if (skin_contrast(fore, sel) >= 3) break;
        }
        return { bg: bg, sel: sel, fore: fore };
    }

    function skin_apply(bg, sel, fore, preview) {
        bg = skin_hex(bg); sel = skin_hex(sel); fore = skin_hex(fore);
        if (!bg || !sel || !fore) return;
        $("#RecJ02_j02SkinBackColor").val(bg);
        $("#RecJ02_j02SkinSelColor").val(sel);
        $("#RecJ02_j02SkinForeColor").val(fore);
        var st = document.documentElement.style;
        st.setProperty("--pozadi", bg); st.setProperty("--oznaceno", sel); st.setProperty("--popredi", fore);
        $("#skin_accent").val(bg); $("#skin_bg").val(bg); $("#skin_sel").val(sel); $("#skin_fore").val(fore);
        $("#skin_contrast_warn").toggle(skin_contrast(fore, bg) < 3);
        $(".skin-tile").each(function () {
            var t = _skin_themes[$(this).data("i")];
            $(this).toggleClass("skin-tile-on", t.bg === bg && t.sel === sel && t.fore === fore);
        });
        if (preview) $("#skin_note").show();
    }

    function skin_init() {
        var $box = $("#skin_tiles");
        _skin_themes.forEach(function (t, i) {
            var $tile = $("<button>").attr({ type: "button", title: t.name }).addClass("skin-tile").data("i", i)
                .append($("<div>").addClass("skin-tile-bar").css({ background: t.bg, color: t.fore }).text(t.name))
                .append($("<div>").addClass("skin-tile-body")
                    .append($("<span>").addClass("skin-tile-sel").css({ background: t.sel, color: t.fore }).text(_skin_txt.sample))
                    .append($("<span>").addClass("skin-tile-btn").css({ background: t.bg, color: t.fore }).text(_skin_txt.button)))
                .on("click", function () { skin_apply(t.bg, t.sel, t.fore, true); });
            $box.append($tile);
        });
        $("#skin_accent").on("input", function () { var d = skin_derive(skin_hex(this.value)); skin_apply(d.bg, d.sel, d.fore, true); });
        $("#skin_bg, #skin_sel, #skin_fore").on("input", function () { skin_apply($("#skin_bg").val(), $("#skin_sel").val(), $("#skin_fore").val(), true); });
        skin_apply($("#RecJ02_j02SkinBackColor").val() || "#0b4b92", $("#RecJ02_j02SkinSelColor").val() || "#4169e1", $("#RecJ02_j02SkinForeColor").val() || "#ffffff", false);
    }
    $(function () {
        skin_init();
        // vzhled aplikace (uživatelský parametr ui-look) – uloží se hned, stránka se načte znovu
        $("input[name=ui_look]").on("change", function () {
            $(window).off("beforeunload");
            $.post(_ep("/Common/SetUserParam"), { key: "ui-look", value: this.value }, function () { location.reload(); });
        });
    });

    function grid_designer(prefix) {
        _prefix_grid_designer = prefix;
        var cols = $("#Searchbox" + prefix.toUpperCase()).val();
        _window_open("/TheGridDesigner?prefix=" + prefix + "&cols=" + cols);
    }

    function reload_after_griddesigner(pid, cols) {
        $("#Searchbox" + _prefix_grid_designer.toUpperCase()).val(cols);
        $.post("/Common/SetUserParam", { key: "searchbox-" + _prefix_grid_designer, value: cols }, function () {
            _postback("searchbox");
        });
    }

    function reload_after_groupby(cbx, prefix) {
        $.post("/Common/SetUserParam", { key: "searchbox-groupby-" + prefix, value: cbx.value }, function () {
            _postback("searchbox-groupby");
        });
    }
</script>
