@model UI.Models.Home.ChangePasswordViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Změna přihlašovacího hesla");
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _r = Model.Rules ?? new BL.Code.PasswordSupport();
    bool _must = _f.CurrentUser.j02IsMustChangePassword;
}

@addTagHelper *,UI
@section header_content
{
    <link rel="stylesheet" href="~/css/myprofile.css" asp-append-version="true" />
}

<div class="modal_record_container">
    <div class="cp">
        <h1 class="cp-title"><span class="material-icons-outlined-nosize">password</span>@Model.PageTitle</h1>
        <div class="cp-user">@_f.CurrentUser.FullNameAsc · @_f.CurrentUser.j02Login</div>

        @if (_must)
        {
            <div class="cp-must">
                <span class="material-icons-outlined-nosize">info</span>
                <span>@_f.tra("Administrátor nastavil, že si musíte změnit přihlašovací heslo. Dokud ho nezměníte, ostatní části aplikace nebudou dostupné.")</span>
            </div>
        }

        <form id="form1" asp-action="ChangePassword" method="post" autocomplete="on">
            <input type="text" name="username" value="@_f.CurrentUser.j02Login" autocomplete="username" hidden />

            <div class="cp-field">
                <label for="CurrentPassword">@_f.tra("Současné heslo")</label>
                <div class="cp-pwd">
                    <input asp-for="@Model.CurrentPassword" type="password" class="form-control" autocomplete="current-password" autofocus />
                    <button type="button" class="cp-eye" tabindex="-1" data-for="CurrentPassword" title="@_f.tra("Zobrazit heslo")">@Html.Raw(EyeSvg)</button>
                </div>
            </div>

            <div class="cp-field">
                <label for="NewPassword">@_f.tra("Nové heslo")</label>
                <div class="cp-pwd">
                    <input type="password" asp-for="@Model.NewPassword" class="form-control" autocomplete="new-password" maxlength="@(_r.MaxLength > 0 ? _r.MaxLength : 100)" />
                    <button type="button" class="cp-eye" tabindex="-1" data-for="NewPassword" title="@_f.tra("Zobrazit heslo")">@Html.Raw(EyeSvg)</button>
                </div>
                <ul class="cp-rules" id="ulRules">
                    <li data-rule="len">@string.Format(_f.tra("{0} až {1} znaků"), _r.MinLength, _r.MaxLength)</li>
                    @if (_r.RequireUppercase)
                    {
                        <li data-rule="upper">@_f.tra("velké písmeno")</li>
                    }
                    @if (_r.RequireLowercase)
                    {
                        <li data-rule="lower">@_f.tra("malé písmeno")</li>
                    }
                    @if (_r.RequireDigit)
                    {
                        <li data-rule="digit">@_f.tra("číslice")</li>
                    }
                    @if (_r.RequireNonAlphanumeric)
                    {
                        <li data-rule="special">@_f.tra("speciální znak") <code>@BL.Code.PasswordSupport.SpecialChars</code></li>
                    }
                    <li data-rule="space">@_f.tra("bez mezer")</li>
                    <li data-rule="diff">@_f.tra("jiné než současné heslo")</li>
                </ul>
            </div>

            <div class="cp-field">
                <label for="VerifyPassword">@_f.tra("Nové heslo znovu")</label>
                <div class="cp-pwd">
                    <input type="password" asp-for="@Model.VerifyPassword" class="form-control" autocomplete="new-password" />
                    <button type="button" class="cp-eye" tabindex="-1" data-for="VerifyPassword" title="@_f.tra("Zobrazit heslo")">@Html.Raw(EyeSvg)</button>
                </div>
                <div class="cp-match" id="divMatch"></div>
            </div>

            <div class="cp-caps" id="divCaps" style="display:none;">@_f.tra("Zapnutý Caps Lock")</div>

            <div class="cp-buttons">
                <button type="submit" id="cmdSave" class="btn btn-primary">@_f.tra("Změnit heslo")</button>
                @if (!_must)
                {
                    <a href="javascript:history.back()" class="btn btn-light">@_f.tra("Zpět")</a>
                }
            </div>
        </form>
    </div>
</div>

@functions {
    const string EyeSvg = "<svg viewBox='0 0 24 24' width='20' height='20' aria-hidden='true'><path fill='currentColor' d='M12 5C6.5 5 2.7 8.6 1 12c1.7 3.4 5.5 7 11 7s9.3-3.6 11-7c-1.7-3.4-5.5-7-11-7zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z'/></svg>";
}

<script type="text/javascript">
    //pravidla stejná jako BL.Code.PasswordSupport.CheckPassword (server kontroluje znovu)
    var _cp_rules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { min = _r.MinLength, max = _r.MaxLength, upper = _r.RequireUppercase, lower = _r.RequireLowercase, digit = _r.RequireDigit, special = _r.RequireNonAlphanumeric, specials = BL.Code.PasswordSupport.SpecialChars }));
    var _cp_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { ok = _f.tra("Hesla se shodují"), bad = _f.tra("Hesla se neshodují"), working = _f.tra("Ukládám…") }));

    $(document).ready(function () {
        _mainmenu_highlight_current("cmdme");

        $(".cp-eye").on("click", function () {
            var $p = $("#" + $(this).data("for"));
            var show = $p.attr("type") === "password";
            $p.attr("type", show ? "text" : "password");
            $(this).toggleClass("cp-eye-on", show);
            $p.focus();
        });

        $("#NewPassword, #VerifyPassword, #CurrentPassword").on("input", cp_check);
        $("input[type=password], input.form-control").on("keyup keydown", function (e) {
            if (e.originalEvent && e.originalEvent.getModifierState) $("#divCaps").toggle(e.originalEvent.getModifierState("CapsLock"));
        });

        $("#form1").on("submit", function () {
            $("#cmdSave").prop("disabled", true).text(_cp_txt.working);
        });

        cp_check();
    });

    function cp_check() {
        var p = $("#NewPassword").val(), v = $("#VerifyPassword").val(), cur = $("#CurrentPassword").val();
        var test = {
            len: p.length >= _cp_rules.min && (_cp_rules.max <= 0 || p.length <= _cp_rules.max),
            upper: /[A-Z]/.test(p) || /\p{Lu}/u.test(p),
            lower: /[a-z]/.test(p) || /\p{Ll}/u.test(p),
            digit: /[0-9]/.test(p),
            special: p.split("").some(function (c) { return _cp_rules.specials.indexOf(c) >= 0; }),
            space: p.length > 0 && p.indexOf(" ") < 0,
            diff: p.length > 0 && p !== cur
        };
        $("#ulRules li").each(function () {
            var r = $(this).data("rule");
            $(this).toggleClass("cp-ok", p.length > 0 && test[r] === true);
        });
        var $m = $("#divMatch").removeClass("cp-match-ok cp-match-bad");
        if (v === "") { $m.text(""); }
        else if (v === p) { $m.text("✓ " + _cp_txt.ok).addClass("cp-match-ok"); }
        else { $m.text(_cp_txt.bad).addClass("cp-match-bad"); }
    }

    window.addEventListener("pageshow", function () { $("#cmdSave").prop("disabled", false); });
</script>
