@model UI.Models.Tab1.p31Tab1
@inject BL.Factory _f

@* Detail úkonu jen pro čtení (uzamčený / schválený / vyúčtovaný úkon, archiv, hover INFO, záložka v p31split).
   Verze 8: hlavička s hodnotou, tabulka Vykázáno (vč. korekce) | Schválení | Vyúčtování – stav fáze v záhlaví sloupce, pod ním hodnoty. Styl css/p31info.css (třídy pi-*).
   Funkce reapprove / recexclude / hardrefresh a id tlačítek (cmdClose, linkGo2Grid) beze změny. *@

@{
    Layout = "~/Views/Shared/_LayoutSubform.cshtml";
    if (Model.Rec == null) return;
    var r = Model.Rec;

    var _disp = _f.p31WorksheetBL.InhaleRecDisposition(r);
    if (!r.isdeleted && !_disp.ReadAccess)
    {
        <div class="alert alert-warning m-2">@_f.tra("Nemáte oprávnění k záznamu.")</div>
        return;
    }

    var _dispP91 = _f.p91InvoiceBL.InhaleRecDisposition(r.p91ID, Model.RecP91);
    bool _bolAllowRates = _f.CurrentUser.TestPermission(BO.PermValEnum.GR_AllowRates);
    bool _isHover = Context.Request.Query["hover_by_reczoom"] == "1";

    string _p51Name_BillingRate = null;
    string _p51Name_CostRate = null;
    if (_bolAllowRates && (r.p33ID == BO.p33IdENUM.Cas || r.p33ID == BO.p33IdENUM.Kusovnik))
    {
        try { if (r.p51ID_BillingRate > 0) _p51Name_BillingRate = _f.p51PriceListBL.Load(r.p51ID_BillingRate)?.p51Name; } catch { }
        try { if (r.p51ID_CostRate > 0) _p51Name_CostRate = _f.p51PriceListBL.Load(r.p51ID_CostRate)?.p51Name; } catch { }
    }

    var _lisB05 = _f.WorkflowBL.GetList_b05("p31", r.pid, 0, 0, 0);
    var _recP41 = _f.p41ProjectBL.Load(r.p41ID);

    string _kontaktniOsoba = null;
    if (r.p28ID_ContactPerson > 0)
    {
        _kontaktniOsoba = _f.p28ContactBL.Load(r.p28ID_ContactPerson)?.p28Name;
    }
    string _approver = null;
    if (r.p71ID != BO.p71IdENUM.Nic && r.j02ID_ApprovedBy > 0)
    {
        _approver = _f.j02UserBL.Load(r.j02ID_ApprovedBy)?.FullNameAsc;
    }
    BO.p40WorkSheet_Recurrence _recP40Source = r.p40ID_Source > 0 ? _f.p40WorkSheet_RecurrenceBL.Load(r.p40ID_Source) : null;

    var _lisFieldBagParams = _f.FBL.GetList_FieldBagParam("p31", r.pid);

    bool _isTime = r.p33ID == BO.p33IdENUM.Cas;
    bool _isKus = r.p33ID == BO.p33IdENUM.Kusovnik;
    bool _isMoney = r.p33ID == BO.p33IdENUM.PenizeBezDPH || r.p33ID == BO.p33IdENUM.PenizeVcDPHRozpisu;
    bool _hoursN = _f.CurrentUser.j02DefaultHoursFormat == "N";

    bool _hasTrim = r.p72ID_AfterTrimming != BO.p72IdENUM._NotSpecified;
    bool _isApproved = r.p71ID == BO.p71IdENUM.Schvaleno;
    bool _isInvoiced = r.p91ID > 0 && Model.RecP91 != null;
    bool _isBilled = _isInvoiced && r.p70ID == BO.p70IdENUM.Vyfakturovano;
    string _cur = r.j27Code_Billing_Orig;
    string _curInv = _isInvoiced ? Model.RecP91.j27Code : _cur;

    string N(double v) => BO.Code.Bas.Number2String(v);
    string Hrs(double h, string hhmm) => _hoursN || string.IsNullOrEmpty(hhmm) ? N(h) : hhmm;
    string Cur(double v, string c) => N(v) + (string.IsNullOrEmpty(c) ? "" : " " + c);

    // barvy stavů p72 / p70 (stejné jako badge-a* a symboly v gridu)
    string StateColor(int v) => v switch { 2 => "#dc3545", 3 => "#8b4513", 4 => "#198754", 6 => "#e889a8", 7 => "#d4a400", _ => "#8a939c" };

    // hlavní hodnota úkonu
    string _mainValue; string _mainUnit;
    if (_isTime) { _mainValue = Hrs(r.p31Hours_Orig, r.p31HHMM_Orig); _mainUnit = _hoursN ? _f.tra("hod") : null; }
    else if (_isKus) { _mainValue = N(r.p31Value_Orig); _mainUnit = _f.tra("ks"); }
    else { _mainValue = N(r.p31Amount_WithoutVat_Orig); _mainUnit = _cur + " " + _f.tra("bez DPH"); }

    string _timeRange = !string.IsNullOrEmpty(r.TimeFrom) && !string.IsNullOrEmpty(r.TimeUntil) ? r.TimeFrom + "–" + r.TimeUntil : null;

    // tabulka hodnot: řádky s hodnotami Vykázáno | po korekci | Schváleno | Vyúčtováno; null = „–“
    var _rows = new List<(string label, string orig, string trim, string appr, string inv, bool strong)>();

    if (_isTime || _isKus)
    {
        if (_isTime)
        {
            _rows.Add((_f.tra("Hodiny"), Hrs(r.p31Hours_Orig, r.p31HHMM_Orig), Hrs(r.p31Hours_Trimmed, r.p31HHMM_Trimmed), Hrs(r.p31Hours_Approved_Billing, r.p31HHMM_Approved_Billing), Hrs(r.p31Hours_Invoiced, r.p31HHMM_Invoiced), true));
            if (_isApproved) _rows.Add((_f.tra("Hodiny nákladově"), null, null, Hrs(r.p31Hours_Approved_Internal, r.p31HHMM_Approved_Internal), null, false));
        }
        else
        {
            _rows.Add((_f.tra("Počet"), N(r.p31Value_Orig), N(r.p31Value_Trimmed), N(r.p31Value_Approved_Billing), N(r.p31Value_Invoiced), true));
        }
        if (_bolAllowRates)
        {
            _rows.Add((_f.tra("Fakturační sazba"), Cur(r.p31Rate_Billing_Orig, _cur), null, _isTime ? Cur(r.p31Rate_Billing_Approved, _cur) : null, Cur(r.p31Rate_Billing_Invoiced, _curInv), false));
            _rows.Add((_f.tra("Nákladová sazba"), N(r.p31Rate_Internal_Orig), null, _isTime ? N(r.p31Rate_Internal_Approved) : null, null, false));
            _rows.Add((_f.tra("Honorář bez DPH"), Cur(r.p31Amount_WithoutVat_Orig, _cur), Cur(r.p31Value_Trimmed * r.p31Rate_Billing_Orig, _cur),
                _isTime && r.p72ID_AfterApprove == BO.p72IdENUM.Fakturovat ? Cur(r.p31Amount_WithoutVat_Approved, _cur) : null,
                Cur(r.p31Amount_WithoutVat_Invoiced, _curInv), true));
            _rows.Add((_f.tra("Nákladový honorář"), N(r.p31Amount_Internal), null, null, null, false));
            if (_isBilled)
            {
                _rows.Add((_f.tra("DPH sazba"), null, null, null, N(r.p31VatRate_Invoiced) + " %", false));
                _rows.Add((_f.tra("Částka DPH"), null, null, null, Cur(r.p31Amount_Vat_Invoiced, _curInv), false));
                _rows.Add((_f.tra("Včetně DPH"), null, null, null, Cur(r.p31Amount_WithVat_Invoiced, _curInv), false));
            }
        }
    }
    if (_isMoney)
    {
        bool apprBill = r.p72ID_AfterApprove == BO.p72IdENUM.Fakturovat;
        bool inv = _bolAllowRates;
        _rows.Add((_f.tra("Bez DPH"), Cur(r.p31Amount_WithoutVat_Orig, _cur), null, apprBill ? Cur(r.p31Amount_WithoutVat_Approved, _cur) : null, inv ? Cur(r.p31Amount_WithoutVat_Invoiced, _curInv) : null, true));
        _rows.Add((_f.tra("DPH sazba"), N(r.p31VatRate_Orig) + " %", null, apprBill ? N(r.p31VatRate_Approved) + " %" : null, inv ? N(r.p31VatRate_Invoiced) + " %" : null, false));
        _rows.Add((_f.tra("Částka DPH"), Cur(r.p31Amount_Vat_Orig, _cur), null, apprBill ? Cur(r.p31Amount_Vat_Approved, _cur) : null, inv ? Cur(r.p31Amount_Vat_Invoiced, _curInv) : null, false));
        _rows.Add((_f.tra("Včetně DPH"), Cur(r.p31Amount_WithVat_Orig, _cur), null, apprBill ? Cur(r.p31Amount_WithVat_Approved, _cur) : null, inv ? Cur(r.p31Amount_WithVat_Invoiced, _curInv) : null, false));
    }
}

@addTagHelper *, UI

@section header_content {
    <link rel="stylesheet" href="~/css/p31info.css" asp-append-version="true" />
}

@if (Model.IsRecord)
{
    <div class="pi-bar">
        @if (!r.isdeleted)
        {
            @if (r.p91ID == 0 && r.p71ID != BO.p71IdENUM.Nic)
            {
                <button type="button" class="btn btn-primary" onclick="reapprove()"><span class="material-icons-outlined-btn">fact_check</span>@_f.tra("Pře-schválit")</button>
            }
            @if (r.p31ExcludeBillingFlag == 1)
            {
                <button type="button" class="btn btn-primary" onclick="recexclude()"><span class="material-icons-outlined-btn">lock_open</span>@_f.tra("Změnit na rozpracovaný úkon")</button>
            }
            @if (r.p91ID > 0 && _dispP91.OwnerAccess)
            {
                <a class="btn btn-light" href="/p91oper/p31edit?p31id=@Model.pid"><span class="material-icons-outlined-btn">receipt_long</span>@_f.tra("Upravit položku vyúčtování")</a>
            }
            <mywrkbutton prefix="p31" pid="@r.pid" langindex="_f.CurrentUser.j02LangIndex"></mywrkbutton>
        }
        @if (_f.CurrentUser.j04IsModule_p31)
        {
            <a class="btn btn-light" id="linkGo2Grid" target="_top" href="/TheGrid/FlatView?prefix=p31&myqueryinline=pids|list_int|@(Model.pid)"><span class="material-icons-outlined-btn">grid_view</span>@_f.tra("Zobrazit v Tabulce")</a>
        }
        <button type="button" id="cmdClose" onclick="window.parent._window_close()" class="btn btn-light pi-close"><span class="material-icons-outlined-btn">close</span>@_f.tra("Zavřít")</button>
    </div>

    <div class="pi-lock@(r.isdeleted ? " pi-lock-del" : "")">
        <span class="material-icons-outlined-nosize">@(r.isdeleted ? "inventory_2" : "lock")</span>
        <span class="pi-lock-text">
            <strong>@(r.isdeleted ? _f.tra("Záznam byl přesunutý do archivu") : _f.tra("Úkon nelze upravovat"))</strong>
            @if (!string.IsNullOrWhiteSpace(_disp.LockedReasonMessage))
            {
                <span>@_disp.LockedReasonMessage</span>
            }
        </span>
    </div>
}

<div class="pi@(_isHover ? " pi-hover" : "")">

    @* hlavička: kdy, kdo, co, kolik *@
    <div class="pi-card pi-hero">
        <div class="pi-hero-main">
            <div class="pi-date">
                <span class="pi-day">@r.p31Date.ToString("dddd", System.Globalization.CultureInfo.GetCultureInfo("cs-CZ"))</span>
                <strong>@r.p31Date.ToString("d.M.yyyy")</strong>
                @if (_timeRange != null)
                {
                    <span class="pi-time"><span class="material-icons-outlined-nosize">schedule</span>@_timeRange</span>
                }
            </div>
            <div class="pi-what">
                <div class="pi-activity">
                    @if (!string.IsNullOrEmpty(r.p32Color))
                    {
                        <span class="pi-dot" style="background:@r.p32Color"></span>
                    }
                    <strong>@r.p32Name</strong>
                    <span class="pi-muted">· @r.p34Name</span>
                </div>
                <div class="pi-project">
                    <span class="pi-muted">@(_recP41?.p07Name ?? _f.tra("Projekt")):</span>
                    @if (_f.CurrentUser.j04IsModule_p41)
                    {
                        <a target="_top" href="/Record/RecPage?prefix=le5&pid=@r.p41ID">@r.p41NamePlusCode</a>
                    }
                    else
                    {
                        <span>@r.p41NamePlusCode</span>
                    }
                </div>
            </div>
        </div>
        <div class="pi-value">
            <span class="pi-num">@_mainValue</span>
            @if (_mainUnit != null)
            {
                <span class="pi-unit">@_mainUnit</span>
            }
            <span class="pi-sym">@Html.Raw(UI.Code.TheGridRowSymbol.p31_symbol(r))</span>
        </div>

        <div class="pi-facts">
            <div><span class="pi-muted">@_f.tra("Jméno")</span>
                @if (_f.CurrentUser.j04IsModule_j02)
                {
                    <a target="_top" href="/Record/RecPage?prefix=j02&pid=@r.j02ID">@r.Person</a>
                }
                else
                {
                    <span>@r.Person</span>
                }
            </div>
            @if (r.p28ID_Client > 0)
            {
                <div><span class="pi-muted">@_f.tra("Klient")</span>
                    @if (_f.CurrentUser.j04IsModule_p28)
                    {
                        <a target="_top" href="/Record/RecPage?prefix=p28&pid=@r.p28ID_Client">@r.ClientName</a>
                    }
                    else
                    {
                        <span>@r.ClientName</span>
                    }
                </div>
            }
            @if (_kontaktniOsoba != null)
            {
                <div><span class="pi-muted">@_f.tra("Kontaktní osoba")</span>
                    @if (_f.CurrentUser.j04IsModule_p28)
                    {
                        <a target="_top" href="/Record/RecPage?prefix=p28&pid=@r.p28ID_ContactPerson">@_kontaktniOsoba</a>
                    }
                    else
                    {
                        <span>@_kontaktniOsoba</span>
                    }
                </div>
            }
            @if (r.p56ID > 0)
            {
                <div><span class="pi-muted">@_f.tra("Úkol")</span><span>@r.p56Name</span></div>
            }
            @if (r.p40ID_FixPrice > 0)
            {
                <div><span class="pi-muted">@_f.tra("Vazba na paušál")</span><span class="badge-a6">@r.p40Name</span></div>
            }
            @if (_recP40Source != null)
            {
                <div><span class="pi-muted">@_f.tra("Opakovaná odměna")</span>
                    @if (_f.CurrentUser.j04IsModule_p41)
                    {
                        <a target="_top" href="/Record/RecPage?prefix=p40&pid=@r.p40ID_Source">@_recP40Source.NamePlusCerpano</a>
                    }
                    else
                    {
                        <span>@_recP40Source.p40Name</span>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(r.p31Text))
        {
            <div class="pi-text">@r.p31Text</div>
        }
        @if (!string.IsNullOrWhiteSpace(r.p31TextInternal))
        {
            <div class="pi-text pi-text-int"><span class="pi-text-label">@_f.tra("Interní text")</span>@r.p31TextInternal</div>
        }
    </div>

    @* průběh a hodnoty v jedné tabulce: sloupce Vykázáno (vč. korekce) | Schválení | Vyúčtování *@
    @{
        string apprCss = r.p71ID == BO.p71IdENUM.Schvaleno ? "pi-done" : (r.p71ID == BO.p71IdENUM.Neschvaleno ? "pi-bad" : "pi-wait");
        string invCss = _isInvoiced ? "pi-done" : (r.p31ExcludeBillingFlag == 1 ? "pi-bad" : "pi-wait");
        bool showTrim = _hasTrim && r.p72ID_AfterTrimming == BO.p72IdENUM.Fakturovat;
    }
    <div class="pi-card pi-tablecard">
        <table class="pi-table">
            <colgroup><col class="pi-col-label" /><col /><col /><col /></colgroup>
            <thead>
                <tr>
                    <th></th>
                    <th class="pi-step pi-done">
                        <div class="pi-step-head">
                            <span class="pi-step-ico"><span class="material-icons-outlined-nosize">@(_isTime || _isKus ? "more_time" : "paid")</span></span>
                            <strong>@_f.tra("Vykázáno")</strong>
                        </div>
                        <span class="pi-muted">@r.UserInsert · @BO.Code.Time.GetTimestamp(r.DateInsert)</span>
                        @if (_hasTrim)
                        {
                            <span class="pi-pill"><span class="pi-dot" style="background:@StateColor((int)r.p72ID_AfterTrimming)"></span>@_f.tra("Korekce"): @(r.p72ID_AfterTrimming switch { BO.p72IdENUM.ZahrnoutDoPausalu => _f.tra("Zahrnout do paušálu"), BO.p72IdENUM.SkrytyOdpis => _f.tra("Skrytý odpis"), BO.p72IdENUM.ViditelnyOdpis => _f.tra("Viditelný odpis"), BO.p72IdENUM.Fakturovat => _f.tra("Fakturovat"), _ => r.p72ID_AfterTrimming.ToString() })</span>
                        }
                    </th>
                    <th class="pi-step @apprCss">
                        <div class="pi-step-head">
                            <span class="pi-step-ico"><span class="material-icons-outlined-nosize">@(r.p71ID == BO.p71IdENUM.Neschvaleno ? "block" : "fact_check")</span></span>
                            <strong>@(r.p71ID == BO.p71IdENUM.Schvaleno ? _f.tra("Schváleno") : (r.p71ID == BO.p71IdENUM.Neschvaleno ? _f.tra("Neschváleno") : _f.tra("Čeká na schválení")))</strong>
                        </div>
                        @if (r.p71ID != BO.p71IdENUM.Nic)
                        {
                            <span class="pi-muted">@_approver · @BO.Code.Time.GetTimestamp(r.p31Approved_When)</span>
                            @if (!string.IsNullOrEmpty(r.approve_p72Name))
                            {
                                <span class="pi-pill"><span class="pi-dot" style="background:@StateColor((int)r.p72ID_AfterApprove)"></span>@r.approve_p72Name</span>
                            }
                        }
                    </th>
                    <th class="pi-step @invCss">
                        <div class="pi-step-head">
                            <span class="pi-step-ico"><span class="material-icons-outlined-nosize">@(r.p31ExcludeBillingFlag == 1 ? "money_off" : "receipt_long")</span></span>
                            <strong>@(_isInvoiced ? _f.tra("Vyúčtováno") : (r.p31ExcludeBillingFlag == 1 ? _f.tra("Vyloučeno z vyúčtování") : _f.tra("Nevyúčtováno")))</strong>
                        </div>
                        @if (_isInvoiced)
                        {
                            <span>
                                @if (_f.CurrentUser.j04IsModule_p91)
                                {
                                    <a target="_top" href="/Record/RecPage?prefix=p91&pid=@Model.RecP91.pid">@(Model.RecP91.p92Name + ": " + Model.RecP91.p91Code)</a>
                                }
                                else
                                {
                                    @(Model.RecP91.p92Name + ": " + Model.RecP91.p91Code)
                                }
                                @if (Model.RecP91.p91IsDraft)
                                {
                                    <span class="pi-pill">@_f.tra("koncept")</span>
                                }
                            </span>
                            <span class="pi-muted">
                                @if (_f.CurrentUser.j04IsModule_p28)
                                {
                                    <a target="_top" href="/Record/RecPage?prefix=p28&pid=@Model.RecP91.p28ID">@Model.RecP91.p91Client</a>
                                }
                                else
                                {
                                    @Model.RecP91.p91Client
                                }
                            </span>
                            <span class="pi-muted">@_f.tra("Vystaveno") @BO.Code.Bas.ObjectDate2String(Model.RecP91.p91Date, "d.M.yyyy") · @_f.tra("plnění") @BO.Code.Bas.ObjectDate2String(Model.RecP91.p91DateSupply, "d.M.yyyy")</span>
                            <span class="pi-muted">@Model.RecP91.Owner · @BO.Code.Bas.ObjectDateTime2String(Model.RecP91.DateInsert)</span>
                            @if (!string.IsNullOrEmpty(r.p70Name))
                            {
                                <span class="pi-pill"><span class="pi-dot" style="background:@StateColor((int)r.p70ID)"></span>@r.p70Name</span>
                            }
                        }
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr class="@(row.strong ? "pi-strong" : null)">
                        <th>@row.label</th>
                        <td>
                            @(row.orig ?? "–")
                            @if (showTrim && row.trim != null && row.trim != row.orig)
                            {
                                <span class="pi-trim" title="@_f.tra("Korekce pro vyúčtování")">@_f.tra("po korekci") @row.trim</span>
                            }
                        </td>
                        <td class="@apprCss">@(_isApproved ? (row.appr ?? "–") : "–")</td>
                        <td class="@invCss">@(_isBilled ? (row.inv ?? "–") : "–")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_p51Name_BillingRate != null || _p51Name_CostRate != null)
        {
            <div class="pi-pricelists">
                @if (_p51Name_BillingRate != null)
                {
                    <span><span class="pi-muted">@_f.tra("Fakturační ceník"):</span> @_p51Name_BillingRate</span>
                }
                @if (_p51Name_CostRate != null)
                {
                    <span><span class="pi-muted">@_f.tra("Nákladový ceník"):</span> @_p51Name_CostRate</span>
                }
            </div>
        }
    </div>
</div>

<div class="pi-extras">
    @Html.EditorFor(m => m, "~/Views/Shared/_TagsTab1.cshtml")

    @Html.EditorFor(m => m, "~/Views/Shared/_lisO27Tab1.cshtml")

    @if (_lisFieldBagParams != null && _lisFieldBagParams.Count() > 0)
    {
        @await Html.PartialAsync("~/Views/Shared/_FieldBagParams.cshtml", _lisFieldBagParams)
    }

    @if (_lisB05.Count() > 0)
    {
        <div class="pi-notes">
            <h2><span class="material-icons-outlined-nosize">sticky_note_2</span>@_f.tra("Poznámky") <span class="pi-count">@_lisB05.Count()</span></h2>
            @await Html.PartialAsync("~/Views/Shared/_lisB05.cshtml", _lisB05)
        </div>
    }
</div>

<script type="text/javascript">
    function reapprove() {
        parent.window._window_toggle();
        _redirect("/p31approveinput/Index?prefix=p31&pids=@r.pid");
    }
    function recexclude() {
        $.post(_ep("/p31misc/Move2ExcludeBillingFlag"), { p31id: @r.pid, flag: 0 }, function (data) {
            if (data.message != null) {
                _notify_message(data.message);
                return;
            }
            _redirect("/p31/Record?pid=@r.pid");
        });
    }

    function hardrefresh(pid, flag) {
        location.replace(location.href);
    }
</script>
