@model UI.Models.Tab1.p40Tab1
@inject BL.Factory _f

@* Opakovaná odměna – informační záložka. Verze 8: původní box vlastností (recpagebox400) vlevo + plán generování se stavy vpravo (málo místa na výšku, hodně na šířku) (css/recinfo.css, třídy ri-*).
   Existence vygenerovaných úkonů se zjišťuje v controlleru dvěma dotazy (Model.P31Existing / P31Archived), ne Load() na řádek.
   Funkce change_plusminus / generate_manually / generate_clear / p31_record beze změny. *@

@{
    Layout = "~/Views/Shared/_LayoutSubform.cshtml";
    if (Model.Rec == null) return;

    var r = Model.Rec;
    bool _bolRowHover = UI.Code.basUI.DetectIfCanRowHover(_f, Context, true);
    bool _isMoney = r.p33ID == 2 || r.p33ID == 5;
    var _now = DateTime.Now;
    var _lis = Model.lisP39 ?? new List<BO.p39WorkSheet_Recurrence_Plan>();

    // stav řádku plánu: ok = vygenerováno, gone = úkon odstraněn, wait = čeká, late = po termínu (robot to ještě zkusí), dead = robot to už nezkusí
    string State(BO.p39WorkSheet_Recurrence_Plan c)
    {
        if (c.p31ID_NewInstance > 0) return Model.P31Existing.Contains(c.p31ID_NewInstance) ? "ok" : "gone";
        if (c.p39DateCreate >= _now) return "wait";
        return c.p39DateCreate.AddDays(31) < _now ? "dead" : "late";
    }
    var _states = _lis.Select(c => State(c)).ToList();
    var _next = _lis.Where(c => c.p31ID_NewInstance == 0 && c.p39DateCreate >= _now).OrderBy(c => c.p39DateCreate).FirstOrDefault();

    bool _expired = !r.isclosed && r.p40LastSupplyDate < _now;
    bool _robotMiss = !r.isclosed && _lis.Any(p => p.p31ID_NewInstance == 0 && p.p39DateCreate < _now.AddDays(-10));

    string ErrText(string s) => string.IsNullOrEmpty(s) ? null : System.Text.RegularExpressions.Regex.Replace(System.Text.RegularExpressions.Regex.Replace(s, @"<br\s*/?>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase), "<[^>]+>", "");
}

@addTagHelper *, UI

@section header_content {
    <link rel="stylesheet" href="~/css/recinfo.css" asp-append-version="true" />
}

@Html.Raw("<div class='info_record_container'>")

<div class="ri-wide-layout">

<div class="card recpagebox400">
    <div class="card-body">

        <table class="table table-hover">

            <tr>
                <td colspan="2" class="@(Model.Rec.isclosed ? "tdarchiv" : "tdval")">
                    @Model.Rec.p40Name


                    @if (Model.Rec.p58ID != 0)
                    {
                        <a style="font-weight:bold;" href="/Record/RecPage?prefix=p58&pid=@Model.Rec.p58ID" target="_top">@_f.tra("Opakovaný úkol")</a>
                    }
                </td>
            </tr>

            <tr>
                <td class="tdlab">
                    @_f.getP07Level(Model.RecP41.p07Level, true):
                </td>
                <td class="tdval">
                    @if (_bolRowHover)
                    {
                        <myval value="@Model.RecP41.PrefferedName" hoverprefix="p41" datatype="link" hoverpid="@Model.Rec.p41ID" linktarget="_top" linkurl="/Record/RecPage?prefix=p41&pid=@(Model.RecP41.pid)"></myval>
                    }
                    else
                    {
                        @Model.RecP41.PrefferedName
                    }

                    @if (Model.RecP41.isclosed)
                    {
                        <kbd>Projekt je v archivu.</kbd>
                    }
                </td>
            </tr>
            @if (Model.RecP41.p28ID_Client > 0)
            {
                <tr>
                    <td class="tdlab">
                        @_f.tra("Klient"):
                    </td>
                    <td class="tdval">
                        @if (_bolRowHover && _f.CurrentUser.j04IsModule_p28)
                        {
                            <myval value="@Model.RecP41.Client" hoverprefix="p28" hoverpid="@Model.RecP41.p28ID_Client" datatype="@(_f.CurrentUser.j04IsModule_p28 ? "link" : "string")" linktarget="_top" linkurl="@(_f.CurrentUser.j04IsModule_p28 ? $"/Record/RecPage?prefix=p28&pid={Model.RecP41.p28ID_Client}" : "")"></myval>
                        }
                        else
                        {
                            <myval value="@Model.RecP41.Client" linktarget="_top"></myval>
                        }
                    </td>
                </tr>
            }

            <tr>
                <td class="tdlab">
                    @_f.tra("Typ opakování"):
                </td>
                <td class="tdval">
                    <myval value="@Model.Rec.RecurrenceAlias"></myval>

                </td>
            </tr>
            <tr>
                <td class="tdlab">
                    @_f.tra("Začátek"):
                </td>
                <td class="tdval">
                    <myval value="@Model.Rec.p40FirstSupplyDate" datatype="date"></myval>

                </td>
            </tr>
            <tr>
                <td class="tdlab">
                    @_f.tra("Konec"):
                </td>
                <td class="tdval">
                    <myval value="@Model.Rec.p40LastSupplyDate" datatype="date"></myval>
                    @if (!Model.Rec.isclosed && Model.Rec.p40LastSupplyDate < DateTime.Now)
                    {
                        <span class="material-icons-outlined-nosize" style="color:#FFC107;">warning</span>
                        <span class="badge text-bg-warning">Období generování expirovalo.</span>
                    }
                    @if (!Model.Rec.isclosed && Model.lisP39.Where(p => p.p31ID_NewInstance == 0 && p.p39DateCreate < DateTime.Now.AddDays(-10)).Count() > 0)
                    {
                        <span class="badge text-bg-danger">Existují nevygenerované úkony mimo dosah robota!</span>
                    }
                </td>
            </tr>

            <tr>
                <td class="tdlab">
                    @_f.tra("Maska textu"):
                </td>
                <td class="tdval">
                    <myval value="@(BO.Code.Bas.OM2(Model.Rec.p40Text, 50))" tooltip="@(Model.Rec.p40Text != null && Model.Rec.p40Text.Length > 50 ? Model.Rec.p40Text : null))"></myval>

                </td>
            </tr>

            <tr>
                <td class="tdlab">
                    @_f.tra("Aktivita"):
                </td>
                <td class="tdval">
                    <myval value="@Model.Rec.p32Name" valueafter="@Model.Rec.p34Name"></myval>

                </td>
            </tr>
            @if (Model.Rec.p33ID == 2 || Model.Rec.p33ID == 5)
            {

                <tr>
                    <td class="tdlab">
                        @_f.tra("Částka"):
                    </td>
                    <td class="tdval">
                        <myval value="@Model.Rec.p40Value" datatype="num" valueafter="@Model.Rec.j27Code"></myval>

                    </td>
                </tr>
                @if (Model.Rec.p40FreeHours != 0)
                {
                    <tr>
                        <td class="tdlab">
                            @_f.tra("Volné Fa hodiny zdarma"):
                        </td>
                        <td class="tdval">
                            <myval value="@Model.Rec.p40FreeHours" datatype="num"></myval>

                        </td>
                    </tr>
                }
                @if (Model.Rec.p40FreeFee != 0)
                {
                    <tr>
                        <td class="tdlab">
                            @_f.tra("Fakturační honorář zdarma"):
                        </td>
                        <td class="tdval">
                            <myval value="@Model.Rec.p40FreeFee" datatype="num"></myval>

                        </td>
                    </tr>
                }

            }
            else
            {
                <tr>
                    <td class="tdlab">
                        @_f.tra("Počet"):
                    </td>
                    <td class="tdval">
                        <myval value="@Model.Rec.p40Value" datatype="num"></myval>

                    </td>
                </tr>
            }


        </table>



    </div>
</div>

    @if (Model.lisP39 != null)
    {
        <section class="ri-card ri-plan">
            <h2>
                <span class="material-icons-outlined-nosize">event_repeat</span>@_f.tra("Přesný plán generování úkonů")
                <label class="ri-h2-tools" for="PlusMinusp39Mesice">
                    @_f.tra("Zobrazit")
                    <select class="form-select" onchange="change_plusminus(this)" asp-for="@Model.PlusMinusp39Mesice">
                        <option value="3">± 3</option>
                        <option value="6">± 6</option>
                        <option value="12">± 12</option>
                        <option value="24">± 24</option>
                        <option value="0">@_f.tra("Celý plán")</option>
                    </select>
                    @_f.tra("měsíců zpět i dopředu")
                </label>
            </h2>

            @{
                int nOk = _states.Count(s => s == "ok"), nWait = _states.Count(s => s == "wait"), nLate = _states.Count(s => s == "late"), nBad = _states.Count(s => s == "dead" || s == "gone");
            }
            <div class="ri-stats">
                <span class="ri-stat"><span class="ri-dot ri-ok"></span>@_f.tra("Vygenerováno") <strong>@nOk</strong></span>
                <span class="ri-stat"><span class="ri-dot ri-wait"></span>@_f.tra("Čeká") <strong>@nWait</strong></span>
                @if (nLate > 0)
                {
                    <span class="ri-stat"><span class="ri-dot ri-late"></span>@_f.tra("Po termínu") <strong>@nLate</strong></span>
                }
                @if (nBad > 0)
                {
                    <span class="ri-stat"><span class="ri-dot ri-bad"></span>@_f.tra("Vyžaduje zásah") <strong>@nBad</strong></span>
                }
                @if (_next != null)
                {
                    <span class="ri-stat"><span class="material-icons-outlined-nosize" style="font-size:15px">schedule</span>@_f.tra("Další generování") <strong>@BO.Code.Bas.ObjectDate2String(_next.p39DateCreate, "d.M.yyyy")</strong></span>
                }
            </div>

            <div class="ri-tablewrap">
                <table class="ri-table ri-stack">
                    <thead>
                        <tr>
                            <th>@_f.tra("Datum úkonu")</th>
                            <th>@_f.tra("Kdy generovat")</th>
                            <th>@_f.tra("Text úkonu")</th>
                            <th>@_f.tra("Stav")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _lis.Count(); i++)
                        {
                            var c = _lis.ElementAt(i);
                            string st = _states[i];
                            string err = ErrText(c.p39ErrorMessage_NewInstance);
                            <tr class="@(c == _next ? "ri-row-next" : null)">
                                <td class="ri-nowrap ri-c-date" data-label="@_f.tra("Datum úkonu")">@BO.Code.Bas.ObjectDate2String(c.p39Date, "d.M.yyyy")</td>
                                <td class="ri-nowrap ri-c-gen" data-label="@_f.tra("Kdy generovat")">@BO.Code.Bas.ObjectDate2String(c.p39DateCreate, "d.M.yyyy")</td>
                                <td class="ri-c-text">
                                    @(st == "ok" && !string.IsNullOrEmpty(c.p31Text) ? c.p31Text : c.p39Text)
                                    @if (err != null)
                                    {
                                        <span class="ri-err">@err</span>
                                    }
                                </td>
                                <td class="ri-c-state">
                                    @switch (st)
                                    {
                                        case "ok":
                                            <span class="ri-state ri-ok" title="@(c.p31DateInsert == null ? null : _f.tra("vytvořeno") + " " + BO.Code.Bas.ObjectDate2String(c.p31DateInsert, "d.M.yyyy HH:mm"))"><span class="material-icons-outlined-nosize">check_circle</span>@_f.tra("Vygenerováno")</span>
                                            @if (Model.P31Archived.Contains(c.p31ID_NewInstance))
                                            {
                                                <span class="ri-chip ri-chip-arch">@_f.tra("úkon v archivu")</span>
                                            }
                                            break;
                                        case "gone":
                                            <span class="ri-state ri-bad"><span class="material-icons-outlined-nosize">delete_forever</span>@_f.tra("Úkon odstraněn")</span>
                                            break;
                                        case "wait":
                                            <span class="ri-state ri-wait"><span class="material-icons-outlined-nosize">schedule</span>@_f.tra("Čeká")</span>
                                            break;
                                        case "late":
                                            <span class="ri-state ri-late"><span class="material-icons-outlined-nosize">priority_high</span>@_f.tra("Po termínu")</span>
                                            break;
                                        default:
                                            <span class="ri-state ri-bad" title="@_f.tra("Robot se již nebude pokoušet úkon vygenerovat.")"><span class="material-icons-outlined-nosize">error</span>@_f.tra("Mimo dosah robota")</span>
                                            break;
                                    }
                                </td>
                                <td class="ri-c-acts">
                                    <div class="ri-acts">
                                        @if (st == "ok")
                                        {
                                            <button type="button" class="btn btn-sm bog" onclick="p31_record(@c.p31ID_NewInstance)"><span class="material-icons-outlined-btn">open_in_new</span>@_f.tra("Otevřít úkon")</button>
                                        }
                                        else if (st == "gone")
                                        {
                                            @if (r.p58ID == 0)
                                            {
                                                <button type="button" class="btn btn-sm bog" onclick="generate_manually(@c.p39ID)">@_f.tra("Vygenerovat úkon ručně")</button>
                                            }
                                            <button type="button" class="btn btn-sm bog" onclick="generate_clear(@c.p39ID)">@_f.tra("Vyčistit stopu generování")</button>
                                        }
                                        else if (r.p58ID == 0)
                                        {
                                            <button type="button" class="btn btn-sm bog" onclick="generate_manually(@c.p39ID)">@(st == "wait" ? _f.tra("Nečekat a vygenerovat ručně") : _f.tra("Vygenerovat úkon ručně"))</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@Html.Raw("</div>")

<script type="text/javascript">
    function change_plusminus(cbx) {
        $.post(_ep("/Common/SetUserParam"), { key: "p40-PlusMinusp39Mesice", value: cbx.value }, function (data) {
            location.replace(window.location.href);
        });
    }

    function generate_manually(p39id) {
        $.post(_ep("/p40/GenerateManually"), { p39id: p39id }, function (data) {
            if (data == -1) {
                _notify_message(@Json.Serialize(_f.tra("Nemáte vlastnické oprávnění k projektu.")));
                return;
            }
            if (data == 0) {
                _notify_message(@Json.Serialize(_f.tra("Nedošlo k vygenerování záznamu úkonu.")));
                return;
            }
            location.replace(window.location.href);
        });
    }

    function generate_clear(p39id) {
        $.post(_ep("/p40/GenerateClear"), { p39id: p39id }, function (data) {
            location.replace(window.location.href);
        });
    }

    function p31_record(p31id) {
        _edit("p31", p31id);
    }
</script>
