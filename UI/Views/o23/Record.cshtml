@model UI.Models.Record.o23Record
@inject BL.Factory _f

@{
    Model.PageTitle = Model.RecO18.o18Name;
    string _FirstTabCaption = Model.PageTitle;
    if (Model.rec_pid > 0 && Model.Rec.o23Name != null && Model.Rec.o23Name != Model.RecO18.o18Name)
    {
        Model.PageTitle += ": " + BO.Code.Bas.OM2(Model.Rec.o23Name, 25);
    }
    Layout = "~/Views/Shared/_LayoutRecord.cshtml";
    
}

@addTagHelper *, UI



@section header_content
    {
    <link rel="stylesheet" href="~/css/recordform.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/p65checklist.css" asp-append-version="true" />

    @if (Model.Notepad != null && Model.Notepad.SelectedX04ID > 0)
    {
        <link href="~/lib/froala-editor/css/froala_editor.pkgd.min.css" rel="stylesheet" type="text/css" />
    }
}

    

    <div class="tabs_container_record">
        <!-- Tab panes -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item onetab" role="presentation">
                <a id="link_tab1" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab1">
                    @_FirstTabCaption
                </a>
            </li>
        @if (Model.disp.IsNotepad && Model.RecO18.o18IsSeparatedNotepadTab)
        {
            <li class="nav-item onetab" role="presentation">
                <a id="link_tab2" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab2">Notepad</a>
            </li>
        }

        @if (Model.disp.IsRoles)
        {
            <li class="nav-item onetab" role="presentation">
                <a class="nav-link" id="link_tab3" data-bs-toggle="tab" href="#tab3" role="tab">@Model.disp.GetTabText(PosEnum.Roles)</a>
            </li>
        }

        <li style="margin-left:20px;">
            @Html.EditorFor(m => Model.rec_entity,"~/Views/Shared/_cmdMoreButton.cshtml")
        </li>

    </ul>

    <div id="divMore" class="card" style="display:none;background-color:#E6F0FF;">
        <div style="width:300px;padding:30px;">
            @Html.EditorFor(m => m.disp, "~/Views/Shared/_Dispozice.cshtml")
        </div>
    </div>

</div>

<input type="hidden" asp-for="UploadGuid" />
<input type="hidden" asp-for="o18ID" />
<input type="hidden" asp-for="IsPasswordPassed" />
<input type="hidden" asp-for="Rec.o23BitStream" />

<input type="hidden" asp-for="SelectedBindEntity" value="@Model.SelectedBindEntity" />
<input type="hidden" asp-for="SelectedBindName" value="@Model.SelectedBindName" />

<input type="hidden" asp-for="current_user_lon" />
<input type="hidden" asp-for="current_cuser_lat" />


@Html.Raw("<div class='modal_record_container_flexi'>")
@Html.Raw("<div class='tab-content'>")


<div class="tab-pane" id="tab1" role="tabpanel">
    <!-- Tab1 – verze 8: moderní vzhled (třídy rf-*, css/recordform.css), názvy polí a id beze změny.
         Obsah je dynamický podle typu dokumentu (o18): vazby o20, pole o16, kód, notepad, šifrování, štítky. -->
    <div class="rf">

    @if (Model.lisO20.Count() > 0)
    {
        <section class="rf-card">
            <div class="rf-cardbar">
                <h2><span class="material-icons-outlined-nosize">link</span>@_f.tra("Vazby")</h2>
                <button class="btn btn-sm bog dropdown-toggle" type="button" id="cmdCollapseO20">@_f.tra("Přidat vazbu")</button>
                @if (Model.RecO18.o18BarcodeFlag == BO.o18BarcodeFlagEnum.BarcodeSupport)
                {
                    <div class="ms-auto">
                        @Html.EditorFor(m => m.barcodes, "~/Views/Shared/_Barcodes.cshtml")
                    </div>
                }
            </div>

            <div id="divCollapseO20" class="rf-box" style="display:none;">
                <myradiolist asp-for="SelectedO20ID" repeat-horizontal="true" datasource="@Model.lisO20" textfield="BindName" valuefield="pid" event_after_changevalue="o20id_onchange"></myradiolist>
                @if (Model.SelectedO20ID > 0)
                {
                    <div class="mt-1 mb-2">
                        <mycombo entity="@Model.SelectedBindEntity" asp-for="SelectedBindPid" placeholder="@Model.SelectedBindName" selectedtext="@Model.SelectedBindText" myqueryinline="@Model.SelectedBindMyQueryInline" filter-flag="1" view-flag="1" event_after_changevalue="bindrec_onchange"></mycombo>
                    </div>
                }
            </div>

            @if (!Model.lisO19.Any(p => !p.IsTempDeleted))
            {
                <div class="rf-hint">@_f.tra("Dokument zatím není navázaný na žádný záznam.")</div>
            }
            <div class="rf-binds">
                @for (int i = 0; i < Model.lisO19.Count; i++)
                {
                    <div class="rf-bind" style="@(Model.lisO19[i].CssTempDisplay)">
                        <span class="rf-bind-kind">@Model.lisO19[i].SelectedO20Name</span>
                        <strong class="rf-bind-name">@Model.lisO19[i].SelectedBindText</strong>
                        <input type="hidden" asp-for="lisO19[i].IsTempDeleted" value="@Model.lisO19[i].IsTempDeleted" />
                        <input type="hidden" asp-for="lisO19[i].TempGuid" value="@Model.lisO19[i].TempGuid" />
                        <input type="hidden" asp-for="lisO19[i].pid" value="@Model.lisO19[i].pid" />
                        <input type="hidden" asp-for="lisO19[i].SelectedBindText" value="@Model.lisO19[i].SelectedBindText" />
                        <input type="hidden" asp-for="lisO19[i].o19RecordPid" value="@Model.lisO19[i].o19RecordPid" />
                        <input type="hidden" asp-for="lisO19[i].o20ID" value="@Model.lisO19[i].o20ID" />
                        <input type="hidden" asp-for="lisO19[i].SelectedO20Name" value="@Model.lisO19[i].SelectedO20Name" />
                        <button type="button" class="rf-del" title="@_f.tra("Odstranit vazbu")" onclick="handle_delete_o19('@(Model.lisO19[i].TempGuid)')"><span class="material-icons-outlined-nosize">close</span></button>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.RecO18.o18EntryNameFlag == BO.o18EntryNameENUM.Manual || Model.lisFields.Count() > 0 || Model.RecO18.o18EntryCodeFlag == BO.o18EntryCodeENUM.Manual || (Model.RecO18.o18EntryCodeFlag == BO.o18EntryCodeENUM.X38ID && Model.rec_pid > 0))
    {
        <section class="rf-card">
            @if (Model.RecO18.o18EntryNameFlag == BO.o18EntryNameENUM.Manual)
            {
                <div class="rf-field">
                    <label for="Rec_o23Name">@_f.tra("Název")</label>
                    <input class="form-control record_name" asp-for="Rec.o23Name" />
                </div>
            }

            @for (int i = 0; i < Model.lisFields.Count(); i++)
            {
                var fld = Model.lisFields[i];
                <div class="rf-row">
                    @if (fld.FieldType == BO.x24IdENUM.tBoolean)
                    {
                        <span class="rf-label"></span>
                        <div class="rf-value form-check">
                            <input type="checkbox" class="form-check-input" asp-for="@Model.lisFields[i].CheckInput" />
                            <mylabel class="form-check-label" bez-dvojtecky="true" explicit-for="lisFields_@(i)__CheckInput" text="@(fld.o16Name)" tooltip="@(fld.o16HelpText)"></mylabel>
                        </div>
                    }
                    else
                    {
                        <mylabel class="rf-label @(fld.o16IsEntryRequired ? "rf-req" : null)" bez-dvojtecky="true" text="@(fld.o16Name)" tooltip="@(fld.o16HelpText)"></mylabel>
                        <div class="rf-value">
                            @if (fld.FieldType == BO.x24IdENUM.tDate)
                            {
                                <div class="rf-inline"><div class="rf-w-date"><mydate asp-for="@Model.lisFields[i].DateInput"></mydate></div>
                                @if (fld.o16ReminderNotifyBefore > 0)
                                {
                                    <small class="rf-hint m-0" title="@_f.tra("Připomenutí před termínem")"><span class="material-icons-outlined-nosize" style="font-size:15px;vertical-align:-3px;">notifications</span> -@(fld.o16ReminderNotifyBefore) h</small>
                                }
                                </div>
                            }
                            @if (fld.FieldType == BO.x24IdENUM.tDateTime)
                            {
                                <div class="rf-inline"><div class="rf-w-date"><mydate asp-for="@Model.lisFields[i].DateInput" include-time="true"></mydate></div>
                                @if (fld.o16ReminderNotifyBefore > 0)
                                {
                                    <small class="rf-hint m-0" title="@_f.tra("Připomenutí před termínem")"><span class="material-icons-outlined-nosize" style="font-size:15px;vertical-align:-3px;">notifications</span> -@(fld.o16ReminderNotifyBefore) h</small>
                                }
                                </div>
                            }
                            @if (fld.FieldType == BO.x24IdENUM.tDecimal)
                            {
                                <div class="rf-w-num"><mynumber asp-for="@Model.lisFields[i].NumInput" decimal-digits="2"></mynumber></div>
                            }
                            @if (fld.FieldType == BO.x24IdENUM.tString)
                            {
                                if (fld.o16DataSource == null)
                                {
                                    if (fld.o16TextboxHeight > 0 || fld.o16Field == "o23BigText")
                                    {
                                        <textarea class="form-control" asp-for="@Model.lisFields[i].StringInput" rows="3"></textarea>
                                    }
                                    else
                                    {
                                        <input class="form-control" asp-for="@Model.lisFields[i].StringInput" />
                                    }
                                }
                                else if (fld.o16IsFixedDataSource)
                                {
                                    <select class="form-select" asp-for="@Model.lisFields[i].StringInput">
                                        <option value=""></option>
                                        @foreach (string ss in BO.Code.Bas.ConvertString2List(fld.o16DataSource, ";"))
                                        {
                                            <option value="@ss">@ss</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input list="list@(i)" class="form-control" asp-for="@Model.lisFields[i].StringInput" />
                                    <datalist id="list@(i)">
                                        @foreach (string ss in BO.Code.Bas.ConvertString2List(fld.o16DataSource, ";"))
                                        {
                                            <option value="@ss">@ss</option>
                                        }
                                    </datalist>
                                }
                            }
                        </div>
                    }
                </div>
                <input type="hidden" asp-for="lisFields[i].o16Field" />
                <input type="hidden" asp-for="lisFields[i].o16Name" />
                <input type="hidden" asp-for="lisFields[i].o16DataSource" />
                <input type="hidden" asp-for="lisFields[i].o16IsFixedDataSource" />
                <input type="hidden" asp-for="lisFields[i].o16IsEntryRequired" />
                <input type="hidden" asp-for="lisFields[i].o16TextboxHeight" />
                <input type="hidden" asp-for="lisFields[i].o16HelpText" />
                <input type="hidden" asp-for="lisFields[i].o16ReminderNotifyBefore" />
            }

            @if (Model.RecO18.o18EntryCodeFlag == BO.o18EntryCodeENUM.Manual)
            {
                <div class="rf-row">
                    <label for="Rec_o23Code" class="rf-label">@_f.tra("Kód")</label>
                    <div class="rf-value rf-w-half"><input class="form-control record_code" asp-for="Rec.o23Code" /></div>
                </div>
            }
            @if (Model.RecO18.o18EntryCodeFlag == BO.o18EntryCodeENUM.X38ID && Model.rec_pid > 0)
            {
                <div class="rf-row">
                    <span class="rf-label">@_f.tra("Kód")</span>
                    <div class="rf-value">
                        @if (Model.CanEditRecordCode)
                        {
                            <myval value="@Model.Rec.o23Code" hoversymol="@_f.tra("Upravit kód")" hoveronclick="true" hoverurl="javascript:_edit_code('o23',@Model.rec_pid)"></myval>
                        }
                        else
                        {
                            <myval value="@Model.Rec.o23Code"></myval>
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (Model.RecO18.o18IsChecklist && _f.p65ChecklistBL.IsAvailableForDocs())
    {
        //check-list (typ dokumentu ho povoluje volbou „V dokumentu používat checklist“): u uloženého dokumentu se ukládá průběžně sám, u nového spolu s dokumentem
        var _chk = new UI.Models.p65ChecklistViewModel() { Prefix = "o23", RecPid = Model.rec_pid, CanEdit = true, PendingJson = Model.ChecklistPending, BoxCss = "rf-card" };
        if (Model.rec_pid > 0)
        {
            _chk.CanEdit = _f.p65ChecklistBL.CanEdit(Model.rec_pid, null, "o23");
            _chk.Items = _f.p65ChecklistBL.GetList(Model.rec_pid, "o23").ToList();
        }
        @await Html.PartialAsync("~/Views/Shared/_p65Checklist.cshtml", _chk)
    }

    @if (Model.disp.IsNotepad && !Model.RecO18.o18IsSeparatedNotepadTab)
    {
        <div class="rf-notepad">
            @Html.EditorFor(m => m.Notepad, "~/Views/Shared/_Notepad.cshtml")
        </div>
    }

    @if (Model.RecO18.o18IsAllowEncryption)
    {
        <section class="rf-card">
            <div class="rf-cardbar">
                <div class="form-check form-switch m-0">
                    <input type="checkbox" class="form-check-input" role="switch" asp-for="@Model.Rec.o23IsEncrypted" onchange="_postback('encrypt')" />
                    <label class="form-check-label" for="Rec_o23IsEncrypted"><span class="material-icons-outlined-nosize" style="font-size:18px;vertical-align:-4px;">lock</span> @_f.tra("Notepad zašifrovat a ochránit heslem")</label>
                </div>
                @if (Model.Rec.o23IsEncrypted)
                {
                    <input type="text" asp-for="@Model.PasswordNew" class="form-control form-control-sm rf-w-pwd" placeholder="@_f.tra("Heslo pro zašifrování")" />
                    <input type="text" asp-for="@Model.PasswordVerify" class="form-control form-control-sm rf-w-pwd" placeholder="@_f.tra("Ověření hesla")" />
                }
            </div>
        </section>
    }

    <div class="rf-extras">
        @if (Model.disp.IsTags)
        {
            <mystitky entity="o23Doc" asp-for="@Model.TagPids" tagnames="@Model.TagNames" taghtml="@Model.TagHtml" buttontext="@_f.tra("Oštítkovat")"></mystitky>
        }
        @Html.EditorFor(m => m.reminder, "~/Views/Shared/_Reminder.cshtml")
    </div>

    @if (Model.disp.IsFiles && Model.UploadGuid != null)
    {
        <iframe id="fraUpload" src="/Dropzone/UploadInFrame?recpid=@Model.rec_pid&entity=o23&guid=@Model.UploadGuid" frameborder="0" scrolling="yes" style="max-width:1200px;width:100%;height:60px;"></iframe>
    }
    </div>
</div>



@if (Model.disp.IsNotepad && Model.RecO18.o18IsSeparatedNotepadTab)
{
    <div class="tab-pane" id="tab2" role="tabpanel">
        <!-- Tab2 Notepad -->
    @Html.EditorFor(m => m.Notepad, "~/Views/Shared/_Notepad.cshtml")

    </div>
}


@if (Model.disp.IsRoles)
{
    <div class="tab-pane tab-pane-fixed" id="tab3" role="tabpanel">
        <!-- Tab3 -->

        <div class="rf">
            <section class="rf-card">
                <div class="rf-row">
                    <label for="cmdComboRec_j02ID_Owner" class="rf-label">@_f.tra("Vlastník záznamu")</label>
                    <div class="rf-value rf-w-half"><mycombo entity="j02User" asp-for="Rec.j02ID_Owner" selectedtext="@Model.SelectedComboOwner" view-flag="2"></mycombo></div>
                </div>
            </section>
        </div>



        @Html.EditorFor(m => m.roles, "~/Views/Shared/_RoleAssign.cshtml")
    </div>
}



@Html.Raw("</div>")
@Html.Raw("</div>")

@if (Model.RecO18.o18GeoFlag == BO.o18GeoFlagEnum.LoadFromCurrentUser)
{
    <iframe id="mapa" style="border:none;width:100%;height:500px;display:none;"></iframe>
}


<script type="text/javascript">
    $(document).ready(function () {                

        $("#cmdMore").click(function () {
            $("#divMore").toggle();
        });

        $("#cmdCollapseO20").click(function () {
            $("#divCollapseO20").toggle();
        });

      

    @if (Model.Rec.j95ID == 0 && Model.RecO18.o18GeoFlag == BO.o18GeoFlagEnum.LoadFromCurrentUser)
    {
        <text>
                getLocation();
        </text>
    }

    @if (Model.IsAutoCollapseO20)
    {
        @:$("#divCollapseO20").css("display", "block");
    }

        



    });


    function o20id_onchange(o20id) {
        _postback("o20ID")

    }
    function bindrec_onchange(pid) {
        _postback("bindrec");
    }

    function handle_delete_o19(guid) {
        _postback("delete_o19", "guid=" + guid);

    }


    function getLocation() {
        _notify_message("Načítám souřadnice polohy...", "info");

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(showPosition);
        } else {
            x.innerHTML = "Geolocation is not supported by this browser.";
        }
    }

    function showPosition(position) {

        $("#current_user_lon").val(position.coords.longitude);
        $("#current_cuser_lat").val(position.coords.latitude);

        showMap();
    }


    function showMap() {
        _notify_message("Poloha: " + $("#current_user_lon").val() + " - " + $("#current_cuser_lat").val(), "info");
        $("#mapa").css("display", "block");
        var x = $("#current_user_lon").val();
        var y = $("#current_cuser_lat").val();
        document.getElementById("mapa").src = "https://frame.mapy.cz/turisticka?source=coor&id=" + x + "%2C" + y + "&ds=1&x=" + x + "&y=" + y + "&z=17";

    }


    function hardrefresh(pid, flag) {
        
        if (flag != undefined) {
            
            
            if (flag.includes("recordcode")) {
                $("#Rec_o23Code").val(flag.split("|")[1]);
            }

        }


        _postback();
    }

</script>
