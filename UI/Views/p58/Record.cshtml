@model UI.Models.Record.p58Record
@inject BL.Factory _f

@* Předpis opakovaného úkolu. Verze 8: záložky jako p56/Record (třídy rf-*, css/recordform.css + css/p58record.css),
   živý náhled nejbližších termínů (js níže, orientační – přesný plán vytváří p58_aftersave, viz karta záznamu).
   Názvy polí a id beze změny; „Více“ už není postback – všechny části jsou v záložkách (IsShowMore = true → ukládá se vše). *@

@{
    Model.PageTitle = _f.tra("Předpis opakovaného úkolu");

    if (Model.Rec.p41ID > 0)
    {
        Model.PageTitle += " (" + Model.ProjectCombo.SelectedProject + ")";
    }
    else
    {
        if (Model.b05RecordEntity != null && Model.b05RecordPid > 0)
        {
            Model.PageTitle += " (" + _f.CBL.GetObjectAlias(Model.b05RecordEntity, Model.b05RecordPid) + ")";
        }
    }

    Layout = "~/Views/Shared/_LayoutRecord.cshtml";

    bool _showPlan = Model.RecP57 != null && Model.RecP57.p57PlanScope != BO.p57PlanScopeEnum.NenabizetPlan;
    bool _hasFee = Model.Rec.p34ID > 0 || Model.Rec.p58FeeAmount != 0;
    bool _hasNote = !string.IsNullOrEmpty(Model.Notepad?.HtmlContent);
    bool _hasPlan = Model.Rec.p58Plan_Hours > 0 || Model.Rec.p58Plan_Expenses > 0 || Model.Rec.p58Plan_Revenue > 0;

    var _types = new (string val, string id, string text)[] {
        ("Week", "chkWeek", _f.tra("Týden")),
        ("Weeks2", "chkWeeks2", _f.tra("2 týdny")),
        ("Month", "chkMonth", _f.tra("Měsíc")),
        ("Quarter", "chkQuarter", _f.tra("Čtvrtletí")),
        ("Year", "chkYear", _f.tra("Rok"))
    };
}

@addTagHelper *, UI

@section header_content
{
    <link rel="stylesheet" href="~/css/recordform.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/p58record.css" asp-append-version="true" />
    @if (Model.Notepad.SelectedX04ID > 0)
    {
        <link href="~/lib/froala-editor/css/froala_editor.pkgd.min.css" rel="stylesheet" type="text/css" />
    }
}

<div class="tabs_container_record">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab1" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab1">@_f.tra("Opakování")</a>
        </li>
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab2" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab2">@_f.tra("Notepad")@if (_hasNote)
                {
                    <span class="p58-dot" title="@_f.tra("Vyplněno")"></span>
                }</a>
        </li>
        @if (_showPlan)
        {
            <li class="nav-item onetab" role="presentation">
                <a id="link_tab3" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab3">@_f.tra("Plán/Rozpočet")@if (_hasPlan)
                    {
                        <span class="p58-dot" title="@_f.tra("Vyplněno")"></span>
                    }</a>
            </li>
        }
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab5" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab5">@_f.tra("Opakovaná odměna")@if (_hasFee)
                {
                    <span class="p58-dot" title="@_f.tra("Vyplněno")"></span>
                }</a>
        </li>
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab4" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab4">@_f.tra("Různé")</a>
        </li>
    </ul>
</div>

@Html.Raw("<div class='modal_record_container_flexi'>")
@Html.Raw("<div class='tab-content'>")

<div class="tab-pane tab-pane-fixed" id="tab1" role="tabpanel">
    <div class="rf">
        <section class="rf-card">
            <div class="rf-field">
                <label for="Rec_p58Name">@_f.tra("Maska názvu úkolu")</label>
                <input class="form-control record_name" asp-for="Rec.p58Name" placeholder="@_f.tra("Maska názvu úkolu")" />
                <span class="rf-hint">@_f.tra("Zástupné symboly podle rozhodného data"): <code>[YYYY]</code> @_f.tra("rok"), <code>[MM]</code> / <code>[M]</code> @_f.tra("měsíc"), <code>[QQ]</code> / <code>[Q]</code> @_f.tra("čtvrtletí")</span>
            </div>
            <div class="rf-row">
                <label for="cmdComboRec_p57ID" class="rf-label">@_f.tra("Typ úkolu")</label>
                <div class="rf-value rf-w-half"><mycombo entity="p57TaskType" asp-for="@Model.Rec.p57ID" selectedtext="@Model.ComboP57" filter-flag="1" event_after_changevalue="change_p57id"></mycombo></div>
            </div>
            <div class="rf-project">
                @Html.EditorFor(m => m.ProjectCombo, "~/Views/Shared/_ProjectCombo.cshtml")
            </div>
        </section>

        <div class="p58-grid">
            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">event_repeat</span>@_f.tra("Opakování")</h2>
                <div class="rf-row">
                    <span class="rf-label">@_f.tra("Opakovat každý")</span>
                    <div class="rf-value">
                        <div class="rf-seg p58-seg" role="radiogroup" aria-label="@_f.tra("Opakování")">
                            @foreach (var t in _types)
                            {
                                <input type="radio" value="@t.val" id="@t.id" asp-for="@Model.Rec.p58RecurrenceType" /><label for="@t.id">@t.text</label>
                            }
                        </div>
                    </div>
                </div>
                <div class="rf-row">
                    <label for="Rec_p58BaseDateStarthelper" class="rf-label" title="@_f.tra("Rozhodné datum (RD) – od něj se odvíjí název, termín i datum generování úkolu.")">@_f.tra("První rozhodné datum (RD)")</label>
                    <div class="rf-value rf-w-date"><mydate asp-for="Rec.p58BaseDateStart" include-time="false"></mydate></div>
                </div>
                <div class="rf-row">
                    <label for="Rec_p58BaseDateEndhelper" class="rf-label" title="@_f.tra("Datum, kdy má skončit generování úkolů podle této šablony. Generování skončí i v případě, že záznam přesunete do archivu.")">@_f.tra("Poslední rozhodné datum")</label>
                    <div class="rf-value rf-w-date"><mydate asp-for="Rec.p58BaseDateEnd" include-time="false"></mydate></div>
                </div>

                <div class="p58-offsets">
                    <div class="p58-off">
                        <span class="p58-off-title"><span class="material-icons-outlined-nosize">auto_awesome</span>@_f.tra("Úkol se vygeneruje")</span>
                        <div class="p58-off-inputs">
                            <div class="p58-num"><mynumber asp-for="Rec.p58Generate_DaysToBase_D" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("dní")</span>
                            <div class="p58-num"><mynumber asp-for="Rec.p58Generate_DaysToBase_M" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("měsíců")</span>
                            <span class="p58-rel">@_f.tra("od RD")</span>
                        </div>
                    </div>

                    <div class="p58-off">
                        <label class="p58-off-title form-check-label" for="Rec_p58IsPlanUntil">
                            <input type="checkbox" class="form-check-input" asp-for="Rec.p58IsPlanUntil" onchange="p58_toggle(this,'divPlanUntil')" />
                            @_f.tra("Úkol má termín (plán dokončení)")
                        </label>
                        <div id="divPlanUntil" class="p58-off-inputs" @(Model.Rec.p58IsPlanUntil ? "" : "hidden")>
                            <div class="p58-num"><mynumber asp-for="Rec.p58PlanUntil_D2Base" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("dní")</span>
                            <div class="p58-num"><mynumber asp-for="Rec.p58PlanUntil_M2Base" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("měsíců")</span>
                            <span class="p58-rel">@_f.tra("od RD")</span>
                        </div>
                    </div>

                    <div class="p58-off">
                        <label class="p58-off-title form-check-label" for="Rec_p58IsPlanFrom">
                            <input type="checkbox" class="form-check-input" asp-for="Rec.p58IsPlanFrom" onchange="p58_toggle(this,'divPlanFrom')" />
                            @_f.tra("Úkol má plánované zahájení")
                        </label>
                        <div id="divPlanFrom" class="p58-off-inputs" @(Model.Rec.p58IsPlanFrom ? "" : "hidden")>
                            <div class="p58-num"><mynumber asp-for="Rec.p58PlanFrom_D2Base" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("dní")</span>
                            <div class="p58-num"><mynumber asp-for="Rec.p58PlanFrom_M2Base" class="record_ordinary" decimal-digits="0"></mynumber></div><span>@_f.tra("měsíců")</span>
                            <span class="p58-rel">@_f.tra("od RD")</span>
                        </div>
                    </div>
                    <span class="rf-hint">@_f.tra("Záporné číslo = před RD, kladné = po RD.")</span>
                </div>
            </section>

            <section class="rf-card p58-preview">
                <h2><span class="material-icons-outlined-nosize">preview</span>@_f.tra("Náhled")</h2>
                <div id="p58Preview"></div>
                <span class="rf-hint">@_f.tra("Orientační výpočet. Přesný plán generování je po uložení na kartě opakovaného úkolu.")</span>
            </section>
        </div>

        @Html.EditorFor(m => m.roles, "~/Views/Shared/_RoleAssign.cshtml")

        <div class="rf-extras">
            @Html.EditorFor(m => m.reminder, "~/Views/Shared/_Reminder.cshtml")
        </div>
    </div>
</div>

<div class="tab-pane tab-pane-fixed" id="tab2" role="tabpanel">
    @Html.EditorFor(m => m.Notepad, "~/Views/Shared/_Notepad.cshtml")
</div>

@if (_showPlan)
{
    <div class="tab-pane tab-pane-fixed" id="tab3" role="tabpanel">
        <div class="rf">
            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">savings</span>@_f.tra("Plán/Limit rozpracovaných hodin a výdajů")</h2>
                <div class="rf-row">
                    <label class="rf-label">@(_f.tra("Plán hodin"))</label>
                    <div class="rf-value rf-w-num"><mynumber asp-for="Rec.p58Plan_Hours" decimal-digits="2"></mynumber></div>
                </div>
                <div class="rf-row">
                    <label class="rf-label">@(_f.tra("Plán výdajů"))</label>
                    <div class="rf-value rf-w-num"><mynumber asp-for="Rec.p58Plan_Expenses" decimal-digits="2"></mynumber></div>
                </div>
                <div class="rf-row">
                    <label class="rf-label">@(_f.tra("Plán odměn"))</label>
                    <div class="rf-value rf-w-num"><mynumber asp-for="Rec.p58Plan_Revenue" decimal-digits="2"></mynumber></div>
                </div>
                <div class="rf-row">
                    <label for="Rec_p58PlanFlag" class="rf-label">@_f.tra("Limit")</label>
                    <div class="rf-value">
                        <select asp-for="@Model.Rec.p58PlanFlag" class="form-select">
                            <option value="0">@_f.tra("Bez omezení")</option>
                            <option value="ZastropovatHodiny">@_f.tra("Zákaz vykázat hodiny nad Plán")</option>
                            <option value="ZastropovatVydaje">@_f.tra("Zákaz vykázat výdaje nad Plán")</option>
                            <option value="ZastropovatHodinyVydaje">@_f.tra("Zákaz vykázat hodiny i výdaje nad Plán")</option>
                        </select>
                    </div>
                </div>
            </section>
        </div>
    </div>
}
else
{
    <input type="hidden" asp-for="Rec.p58Plan_Hours" value="@Model.Rec.p58Plan_Hours" />
    <input type="hidden" asp-for="Rec.p58Plan_Expenses" value="@Model.Rec.p58Plan_Expenses" />
    <input type="hidden" asp-for="Rec.p58Plan_Revenue" value="@Model.Rec.p58Plan_Revenue" />
    <input type="hidden" asp-for="Rec.p58PlanFlag" value="@Model.Rec.p58PlanFlag" />
}

<div class="tab-pane tab-pane-fixed" id="tab5" role="tabpanel">
    <div class="rf">
        <section class="rf-card">
            <h2><span class="material-icons-outlined-nosize">payments</span>@_f.tra("Opakovaná odměna")</h2>
            <p class="p58-intro">@_f.tra("S každým vygenerovaným úkolem vznikne v projektu i úkon opakované odměny. Vyžaduje projekt, aktivitu, částku a text úkonu; 2-týdenní opakování není podporováno.")</p>
            <div class="rf-row">
                <label for="cmdComboRec_p34ID" class="rf-label">@_f.tra("Sešit")</label>
                <div class="rf-value rf-w-half"><mycombo entity="p34ActivityGroup" asp-for="Rec.p34ID" myqueryinline="isfeeinput|bool|true" selectedtext="@Model.ComboP34" event_after_changevalue="_postback()"></mycombo></div>
            </div>
            <div class="rf-row">
                <label for="cmdComboRec_p32ID" class="rf-label">@_f.tra("Aktivita")</label>
                <div class="rf-value rf-w-half"><mycombo entity="p32Activity" asp-for="Rec.p32ID" selectedtext="@Model.ComboP32" myqueryinline="p34id|int|@Model.Rec.p34ID"></mycombo></div>
            </div>
            <div class="rf-row">
                <label class="rf-label">@_f.tra("Částka bez DPH")</label>
                <div class="rf-value rf-inline p58-fee">
                    <div class="rf-w-num"><mynumber asp-for="Rec.p58FeeAmount" decimal-digits="2"></mynumber></div>
                    <div class="p58-cur"><mycombo entity="j27Currency" asp-for="Rec.j27ID" selectedtext="@Model.ComboJ27Code"></mycombo></div>
                </div>
            </div>
            <div class="rf-row">
                <label for="Rec_x15ID" class="rf-label">@_f.tra("DPH")</label>
                <div class="rf-value rf-w-half">
                    <select asp-for="@Model.Rec.x15ID" class="form-select">
                        <option value="Nic"></option>
                        <option value="BezDPH">@_f.tra("0% (Bez DPH)")</option>
                        <option value="SnizenaSazba">@_f.tra("Snížená sazba DPH")</option>
                        <option value="ZakladniSazba">@_f.tra("Základní sazba DPH")</option>
                        <option value="SpecialniSazba">@_f.tra("Speciální sazba DPH")</option>
                    </select>
                </div>
            </div>
            <div class="rf-row p58-top">
                <label for="Rec_p58FeeText" class="rf-label">@_f.tra("Maska textu úkonu")</label>
                <div class="rf-value">
                    <textarea class="form-control" asp-for="Rec.p58FeeText" rows="3"></textarea>
                    <span class="rf-hint"><code>[YYYY]</code> @_f.tra("rok"), <code>[MM]</code> / <code>[M]</code> @_f.tra("měsíc"), <code>[QQ]</code> / <code>[Q]</code> @_f.tra("čtvrtletí")</span>
                </div>
            </div>
            <div class="rf-row">
                <label class="rf-label">@_f.tra("Fa hodiny v odměně zdarma")</label>
                <div class="rf-value rf-w-num"><mynumber asp-for="Rec.p58FreeHours" decimal-digits="2"></mynumber></div>
            </div>
        </section>
    </div>
</div>

<div class="tab-pane tab-pane-fixed" id="tab4" role="tabpanel">
    <div class="rf">
        <section class="rf-card">
            <div class="rf-row">
                <label for="cmdComboRec_j02ID_Owner" class="rf-label">@_f.tra("Zadavatel (Vlastník záznamu)")</label>
                <div class="rf-value rf-w-half"><mycombo entity="j02User" asp-for="Rec.j02ID_Owner" selectedtext="@Model.ComboOwner" view-flag="2"></mycombo></div>
            </div>
            <div class="rf-row">
                <span class="rf-label"></span>
                <div class="rf-value form-check">
                    <input type="checkbox" class="form-check-input" asp-for="@Model.Rec.p58IsStopNotify" />
                    <label class="form-check-label" for="Rec_p58IsStopNotify">@_f.tra("V úkolu vypnout notifikační zprávy")</label>
                </div>
            </div>
        </section>
    </div>
</div>

@Html.Raw("</div>")
@Html.Raw("</div>")

@* všechny části jsou ve formuláři vždy → ukládat i plán, notepad a příznaky (dříve jen po rozbalení „Více“) *@
<input type="hidden" name="IsShowMore" value="true" />
<input type="hidden" asp-for="Rec.p41ID" value="@Model.Rec.p41ID" />
<input type="hidden" asp-for="ComboOwner" value="@Model.ComboOwner" />
<input type="hidden" asp-for="b05RecordPid" />
<input type="hidden" asp-for="b05RecordEntity" />

<script src="~/js/recurrence.js" asp-append-version="true"></script>
<script type="text/javascript">
    function hardrefresh(pid, flag) {
        _postback();
    }

    function change_p57id(p57id) {
        _postback("p57id");
    }

    function p58_toggle(chk, divid) {
        document.getElementById(divid).hidden = !chk.checked;
        p58_preview();
    }

    let p58_preview = function () { };
    document.addEventListener("DOMContentLoaded", function () {
        const fee = () => document.getElementById("Rec_p34ID");
        p58_preview = mtRecurrence.preview({
            host: "p58Preview", type: "Rec.p58RecurrenceType", start: "Rec_p58BaseDateStart", end: "Rec_p58BaseDateEnd",
            base: @Json.Serialize(_f.tra("RD")),
            lines: [
                { label: @Json.Serialize(_f.tra("Generování")), icon: "auto_awesome", d: "Rec_p58Generate_DaysToBase_D", m: "Rec_p58Generate_DaysToBase_M", gen: true },
                { label: @Json.Serialize(_f.tra("Zahájení")), icon: "play_arrow", d: "Rec_p58PlanFrom_D2Base", m: "Rec_p58PlanFrom_M2Base", on: "Rec_p58IsPlanFrom" },
                { label: @Json.Serialize(_f.tra("Termín")), icon: "flag", d: "Rec_p58PlanUntil_D2Base", m: "Rec_p58PlanUntil_M2Base", on: "Rec_p58IsPlanUntil" }
            ],
            warn: () => {
                const t = document.querySelector("input[name='Rec.p58RecurrenceType']:checked");
                const f = fee();
                return t && t.value === "Weeks2" && f && f.value && f.value !== "0" ? @Json.Serialize(_f.tra("U opakované odměny není podpora 2-týdenního opakování.")) : null;
            },
            txt: @Json.Serialize(new {
                count = _f.tra("Počet úkolů v období"), toomany = _f.tra("Příliš dlouhé období – nejvýše 200 úkolů. Snižte poslední rozhodné datum."),
                missing = _f.tra("Vyplňte první rozhodné datum."), more = _f.tra("… a další"), past = _f.tra("datum generování už uplynulo")
            })
        });
    });
</script>
