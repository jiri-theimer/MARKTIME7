@model UI.Models.ReminderViewModel
@inject BL.Factory _f

@{
    if (Model == null || Model.record_prefix == null)
    {
        return;
    }


    IEnumerable<BO.x67EntityRole> _lisX67 = null;

    if (Model.lisReminder == null)
    {

        Model.lisReminder = new List<ReminderRepeater>();
        if (Model.record_prefix != "p31")
        {
            _lisX67 = _f.x67EntityRoleBL.GetList(new BO.myQuery("x67") { explicit_orderby = "a.x67Entity,a.x67Ordinary" }).Where(p => p.x67Entity == Model.record_prefix);
        }


        if (Model.record_pid > 0)
        {
            var lisO24 = _f.o24ReminderBL.GetList(Model.record_prefix, Model.record_pid);
            foreach (var c in lisO24)
            {
                var ri = new ReminderRepeater() { TempGuid = BO.Code.Bas.GetGuid(), o24ID = c.pid, o24MediumFlag = (int)c.o24MediumFlag, o24Count = c.o24Count, o24Unit = c.o24Unit, o24Memo = c.o24Memo };
                if (Model.is_static_date)
                {
                    ri.o24StaticDate = c.o24StaticDate;
                }
                if (c.x67ID > 0)
                {
                    ri.x67ID = c.x67ID; ri.BindPrefix = "x67"; ri.BindAlias = c.x67Name;
                }
                if (c.j11ID > 0)
                {
                    ri.j11ID = c.j11ID; ri.BindPrefix = "j11"; ri.BindAlias = c.j11Name;
                }
                if (c.p28ID > 0)
                {
                    ri.p28ID = c.p28ID; ri.BindPrefix = "p28"; ri.BindAlias = c.p28Name;
                }
                if (c.p24ID > 0)
                {
                    ri.p24ID = c.p24ID; ri.BindPrefix = "p24"; ri.BindAlias = c.p24Name;
                }
                if (c.j02ID > 0)
                {
                    ri.j02ID = c.j02ID; ri.BindPrefix = "j02"; ri.BindAlias = c.Person;
                }

                if (c.o24DatetimeProcessed != null) ri.IsProcessed = true;
                Model.lisReminder.Add(ri);
            }
        }


    }

    if (Model.postback_par == "edit_reminder" || Model.postback_par == "add_reminder")
    {
        var rec = new ReminderRepeater() { TempGuid = BO.Code.Bas.GetGuid(), BindPrefix = "j02" };
        if (Model.postback_par == "edit_reminder")
        {
            rec = Model.lisReminder.First(p => p.TempGuid == Model.postback_guid);
        }
        rec.o24MediumFlag = Model.edit_o24mediumflag;
        rec.o24Unit = Model.edit_o24unit;
        rec.o24Count = Model.edit_o24count;
        //příjemce je právě jeden - podle zvoleného druhu (ostatní ID z dialogu se zahodí, jinak by se u řádku ukázal cizí název)
        rec.BindPrefix = string.IsNullOrEmpty(Model.edit_bindprefix) ? "j02" : Model.edit_bindprefix;
        rec.j02ID = rec.BindPrefix == "j02" ? Model.edit_j02id : 0;
        rec.j11ID = rec.BindPrefix == "j11" ? Model.edit_j11id : 0;
        rec.x67ID = rec.BindPrefix == "x67" ? Model.edit_x67id : 0;
        rec.p28ID = rec.BindPrefix == "p28" ? Model.edit_p28id : 0;
        rec.p24ID = rec.BindPrefix == "p24" ? Model.edit_p24id : 0;
        rec.o24Memo = Model.edit_o24memo;

        rec.BindAlias = null;
        if (rec.j02ID > 0) rec.BindAlias = _f.CBL.GetObjectAlias("j02", rec.j02ID);
        if (rec.j11ID > 0) rec.BindAlias = _f.j11TeamBL.Load(rec.j11ID)?.j11Name;
        if (rec.x67ID > 0) rec.BindAlias = _f.x67EntityRoleBL.Load(rec.x67ID)?.x67Name;
        if (rec.p28ID > 0) rec.BindAlias = _f.CBL.GetObjectAlias("p28", rec.p28ID);
        if (rec.p24ID > 0) rec.BindAlias = _f.p24ContactGroupBL.Load(rec.p24ID)?.p24Name;

        if (Model.is_static_date && Model.edit_o24staticdate != null)
        {
            rec.o24StaticDate = BO.Code.Bas.String2Date(Model.edit_o24staticdate);
        }

        if (Model.postback_par == "add_reminder")
        {
            Model.lisReminder.Add(rec);
        }


        Model.postback_par = null;
    }

    if (Model.postback_par == "delete_reminder")
    {
        Model.lisReminder.First(p => p.TempGuid == Model.postback_guid).IsTempDeleted = true;
        Model.postback_par = null;
        Model.postback_guid = null;

    }
    if (Model.postback_par == "clear_reminder")
    {
        Model.lisReminder.First(p => p.TempGuid == Model.postback_guid).IsProcessed = false;
        var recO24 = _f.o24ReminderBL.Load(Model.lisReminder.First(p => p.TempGuid == Model.postback_guid).o24ID);
        recO24.o24DatetimeProcessed = null;
        _f.o24ReminderBL.Save(recO24);
    }




}

@addTagHelper *, UI

<input type="hidden" asp-for="record_prefix" />
<input type="hidden" asp-for="record_pid" />
<input type="hidden" asp-for="postback_par" value="@Model.postback_par" />
<input type="hidden" asp-for="postback_guid" value="@Model.postback_guid" />
<input type="hidden" asp-for="is_static_date" />


<input type="hidden" asp-for="edit_o24count" value="@Model.edit_o24count" />
<input type="hidden" asp-for="edit_o24unit" value="@Model.edit_o24unit" />
<input type="hidden" asp-for="edit_o24mediumflag" value="@Model.edit_o24mediumflag" />
<input type="hidden" asp-for="edit_bindprefix" value="@Model.edit_bindprefix" />
<input type="hidden" asp-for="edit_j02id" value="@Model.edit_j02id" />
<input type="hidden" asp-for="edit_j11id" value="@Model.edit_j11id" />
<input type="hidden" asp-for="edit_p28id" value="@Model.edit_p28id" />
<input type="hidden" asp-for="edit_p24id" value="@Model.edit_p24id" />
<input type="hidden" asp-for="edit_x67id" value="@Model.edit_x67id" />

<input type="hidden" asp-for="edit_o24memo" value="@Model.edit_o24memo" />
<input type="hidden" asp-for="edit_o24staticdate" value="@Model.edit_o24staticdate" />

@{
    //texty řádků
    string _When(ReminderRepeater r)
    {
        if (Model.is_static_date) return r.o24StaticDate == null ? "?" : r.o24StaticDate.Value.ToString("d.M.yyyy HH:mm");
        int n = Math.Abs(r.o24Count);
        string unit = r.o24Unit == "h"
            ? (n == 1 ? _f.tra("hodinu") : (n >= 2 && n <= 4 ? _f.tra("hodiny") : _f.tra("hodin")))
            : (n == 1 ? _f.tra("den") : (n >= 2 && n <= 4 ? _f.tra("dny") : _f.tra("dní")));
        if (n == 0) return _f.tra("V okamžiku termínu");
        return $"{n} {unit} {(r.o24Count < 0 ? _f.tra("předem") : _f.tra("po termínu"))}";
    }
    string _Kind(string prefix) => prefix switch
    {
        "j02" => _f.tra("Uživatel"),
        "j11" => _f.tra("Tým"),
        "x67" => _f.tra("Role v záznamu"),
        "p28" => _f.tra("Kontakt"),
        "p24" => _f.tra("Skupina kontaktů"),
        _ => ""
    };
    string _How(int flag) => (flag == 2 ? "SMS" : (flag == 3 ? "E-mail + SMS" : "E-mail")) + " + chat";
    int _visible = Model.lisReminder == null ? 0 : Model.lisReminder.Count(p => !p.IsTempDeleted);
}

<link rel="stylesheet" href="~/css/reminder.css" asp-append-version="true" />

@if (_visible == 0)
{
    @* bez upozornění: jen tlačítko ve stejném tvaru jako sousední tlačítka formuláře (Přidat hlídače, Oštítkovat…) - stojí s nimi v jedné řadě *@
    <button type="button" class="btn btn-sm btn-light" tabindex="-1" onclick="append_reminder()" style="min-width:150px;text-align:left;">
        <myicon symbol="notifications"></myicon>
        @_f.tra("Přidat upozornění")
    </button>
}
<div class="rm-box" style="@(_visible == 0 ? "display:none;" : "")">
    <div class="rm-head">
        <span class="material-icons-outlined-nosize">notifications</span>
        <span>@_f.tra("Upozornění")</span>
        <span class="rm-count">@_visible</span>
        <button type="button" class="btn btn-sm btn-light rm-add" tabindex="-1" onclick="append_reminder()">
            <span class="material-icons-outlined-nosize">add</span>@_f.tra("Přidat upozornění")
        </button>
    </div>

    @if (Model.lisReminder != null && Model.lisReminder.Count() > 0)
    {
        <ul id="divReminderContainer" class="rm-list">
            @for (int i = 0; i < Model.lisReminder.Count(); i++)
            {
                var r = Model.lisReminder[i];
                bool late = Model.is_static_date && !r.IsProcessed && r.o24StaticDate != null && r.o24StaticDate < DateTime.Now;
                <li class="rm-item@(r.IsProcessed ? " rm-sent" : "")" style="@(r.IsTempDeleted ? "display:none;" : "")">
                    @* hodnoty řádku pro uložení formuláře a pro dialog úprav (edit_reminder čte podle id) *@
                    <input type="hidden" asp-for="lisReminder[i].o24MediumFlag" value="@r.o24MediumFlag" />
                    <input type="hidden" asp-for="lisReminder[i].o24Count" value="@r.o24Count" />
                    <input type="hidden" asp-for="lisReminder[i].o24Unit" value="@r.o24Unit" />
                    <input type="hidden" asp-for="lisReminder[i].TempGuid" />
                    <input type="hidden" asp-for="lisReminder[i].o24ID" />
                    <input type="hidden" asp-for="lisReminder[i].IsTempDeleted" value="@r.IsTempDeleted" />
                    <input type="hidden" asp-for="lisReminder[i].IsProcessed" value="@r.IsProcessed" />
                    @if (Model.is_static_date)
                    {
                        <input type="hidden" asp-for="lisReminder[i].o24StaticDate" value="@r.o24StaticDate" />
                    }
                    <input type="hidden" asp-for="lisReminder[i].BindPrefix" value="@r.BindPrefix" />
                    <input type="hidden" asp-for="lisReminder[i].BindAlias" value="@r.BindAlias" />
                    <input type="hidden" asp-for="lisReminder[i].j02ID" value="@r.j02ID" />
                    <input type="hidden" asp-for="lisReminder[i].j11ID" value="@r.j11ID" />
                    <input type="hidden" asp-for="lisReminder[i].p28ID" value="@r.p28ID" />
                    <input type="hidden" asp-for="lisReminder[i].p24ID" value="@r.p24ID" />
                    <input type="hidden" asp-for="lisReminder[i].x67ID" value="@r.x67ID" />
                    <input type="hidden" asp-for="lisReminder[i].o24Memo" value="@r.o24Memo" />

                    <div class="rm-main" onclick="edit_reminder(@(i),'@r.TempGuid')" title="@_f.tra("Upravit upozornění")">
                        <div class="rm-line">
                            <span class="rm-when@(late ? " rm-late" : "")">@_When(r)</span>
                            <span class="rm-who"><span class="rm-kind">@_Kind(r.BindPrefix)</span>@r.BindAlias</span>
                            <span class="rm-how">@_How(r.o24MediumFlag)</span>
                            @if (r.IsProcessed)
                            {
                                <span class="rm-state">@_f.tra("Odesláno")</span>
                            }
                            else if (late)
                            {
                                <span class="rm-state rm-state-late">@_f.tra("Čeká na odeslání")</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(r.o24Memo))
                        {
                            <div class="rm-memo">@r.o24Memo</div>
                        }
                    </div>
                    <div class="rm-tools">
                        @if (r.IsProcessed)
                        {
                            <button type="button" class="rm-btn" title="@_f.tra("Odeslat znovu: upozornění bude opět čekat na odeslání")" onclick="handle_clear_reminder('@(r.TempGuid)')"><span class="material-icons-outlined-nosize">replay</span></button>
                        }
                        <button type="button" class="rm-btn" title="@_f.tra("Upravit")" onclick="edit_reminder(@(i),'@r.TempGuid')"><span class="material-icons-outlined-nosize">edit</span></button>
                        <button type="button" class="rm-btn rm-btn-del" title="@_f.tra("Odstranit upozornění")" onclick="handle_delete_reminder('@(r.TempGuid)')"><span class="material-icons-outlined-nosize">delete</span></button>
                    </div>
                </li>
            }
        </ul>
        @if (_visible > 0)
        {
            <div class="rm-note">@_f.tra("Upozornění odchází zvolenou cestou a uživatelům MARKTIME také do interního chatu.")</div>
        }
    }
</div>


<script type="text/javascript">
    // Prvek „Upozornění“ (o24Reminder) ve formuláři záznamu. Řádek se zakládá a upravuje v okně /ReminderItem/Index,
    // které zapíše hodnoty do skrytých polí reminder_edit_* a zavolá reminder_hardrefresh() - seznam se přestaví postbackem formuláře.

    function reminder_set(par, guid) {
        document.getElementById("reminder_postback_par").value = par;
        document.getElementById("reminder_postback_guid").value = guid || "";
    }
    function reminder_val(rowindex, field) {
        var el = document.getElementById("reminder_lisReminder_" + rowindex + "__" + field);
        return el ? el.value : "";
    }
    function reminder_open(e, query) {
        var w = (typeof _device !== "undefined" && _device.isMobile) ? _device.availWidth : "520";
        var url = "/ReminderItem/Index?record_prefix=@Model.record_prefix&record_pid=@Model.record_pid&is_static_date=@Model.is_static_date" + (query || "");
        _zoom(e || window.event, null, null, w, "@_f.tra("Upozornění")", url);
    }

    function append_reminder() {
        reminder_set("add_reminder", "");
        reminder_open(window.event, "");
    }

    function edit_reminder(rowindex, guid) {
        reminder_set("edit_reminder", guid);
        var q = "";
        [["o24count", "o24Count"], ["o24unit", "o24Unit"], ["o24mediumflag", "o24MediumFlag"], ["bindprefix", "BindPrefix"],
         ["j02id", "j02ID"], ["j11id", "j11ID"], ["x67id", "x67ID"], ["p28id", "p28ID"], ["p24id", "p24ID"],
         ["o24memo", "o24Memo"], ["o24staticdate", "o24StaticDate"]].forEach(function (p) {
            q += "&" + p[0] + "=" + encodeURIComponent(reminder_val(rowindex, p[1]));
        });
        reminder_open(window.event, q);
    }

    function handle_delete_reminder(guid) {
        reminder_set("delete_reminder", guid);
        _postback("delete_reminder");
    }

    function handle_clear_reminder(guid) {
        reminder_set("clear_reminder", guid);
        _postback("clear_reminder");
    }

    function reminder_hardrefresh() {
        _postback();
    }
</script>
