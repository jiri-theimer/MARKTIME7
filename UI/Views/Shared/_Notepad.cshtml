@model UI.Models.Notepad.EditorViewModel
@inject BL.Factory _f

@{
    // Notepad editor (verze 8): pevná „lehká“ konfigurace Froaly, bez vazby na číselník x04.
    // Soubory a obrázky editor nenahrává – přílohy patří do FILEBOXu záznamu.
    // x04ID se dál ukládá do záznamů jen jako příznak „obsah je HTML“ (x04ID > 0 → zobrazení jako HTML, viz _NotepadRO, NotepadPreview).
    //   Vybírá se: x04ID záznamu → výchozí x04 licence → první x04 v DB. Pokud žádný není, editor je prostý textarea (jako dřív).

    bool _wasPlain = Model.SelectedX04ID == 0 && Model.ExternalConfig == null;
    if (Model.SelectedX04ID == 0)
    {
        Model.SelectedX04ID = _f.Lic.x04ID_Default;
    }
    if (Model.SelectedX04ID == 0)
    {
        Model.SelectedX04ID = _f.x04NotepadConfigBL.GetList(new BO.myQuery("x04")).Select(p => p.pid).FirstOrDefault();
    }
    bool _isEditor = Model.SelectedX04ID > 0 || Model.ExternalConfig != null;

    // dosud prostý text (x04ID = 0) → do editoru jako odstavce, aby se neztratily řádky
    if (_isEditor && _wasPlain && !string.IsNullOrEmpty(Model.HtmlContent) && !System.Text.RegularExpressions.Regex.IsMatch(Model.HtmlContent, @"<\s*/?\s*[a-zA-Z][^>]*>"))
    {
        var paras = Model.HtmlContent.Replace("\r\n", "\n").Split("\n\n");
        Model.HtmlContent = string.Concat(paras.Select(p => "<p>" + System.Net.WebUtility.HtmlEncode(p.Trim('\n')).Replace("\n", "<br>") + "</p>"));
    }

    if (string.IsNullOrEmpty(Model.PlaceHolder))
    {
        Model.PlaceHolder = _f.tra("Text…");
    }
    if (string.IsNullOrEmpty(Model.TempGuid))
    {
        Model.TempGuid = BO.Code.Bas.GetGuid();
    }
    string _lang = _f.CurrentUser.LangName?.ToLower();
}

@addTagHelper *, UI

@if (_isEditor)
{
    // jen jádro + potřebné pluginy (ne .pkgd se všemi pluginy); seznam pluginů = PLUGINS v js/notepad.js
    <script type="text/javascript" src="~/lib/froala-editor/js/froala_editor.min.js" asp-append-version="true"></script>
    @foreach (string plugin in new[] { "align", "code_beautifier", "colors", "code_view", "fullscreen", "line_breaker", "link", "lists", "paragraph_format", "quote", "table", "url", "word_paste" })
    {
        <script type="text/javascript" src="~/lib/froala-editor/js/plugins/@(plugin).min.js" asp-append-version="true"></script>
    }
    @if (_lang != null && _lang != "en")
    {
        <script type="text/javascript" src="~/lib/froala-editor/js/languages/@(_lang).js"></script>
    }
    <link rel="stylesheet" href="~/css/notepad.css" asp-append-version="true" />
    <script type="text/javascript" src="~/js/notepad.js" asp-append-version="true"></script>
}

<input type="hidden" asp-for="TempGuid" />
<input type="hidden" asp-for="Prefix" />
<input type="hidden" asp-for="SelectedX04ID" />

@if (_isEditor)
{
    <textarea id="edi1" class="my-2 np-editor" asp-for="HtmlContent"></textarea>
}
else
{
    <textarea id="edi1" class="form-control" asp-for="HtmlContent" style="margin-top:10px;" rows="8" placeholder="@Model.PlaceHolder"></textarea>
}


<script type="text/javascript">
    var _edi;
    var _x04id = "@(_isEditor ? Model.SelectedX04ID : 0)";

    @if (_isEditor)
    {
        <text>editor_init();</text>
    }

    function editor_init() {
        mtNotepad.setup({
            lang: "@(_lang != null && _lang != "en" ? _lang : "")",
            texts: {
                placeholder: @Json.Serialize(Model.PlaceHolder),
                normal: @Json.Serialize(_f.tra("Normální")), heading: @Json.Serialize(_f.tra("Nadpis")), subheading: @Json.Serialize(_f.tra("Podnadpis")),
                noFiles: @Json.Serialize(_f.tra("Obrázky a soubory vkládejte do přílohy (FILEBOX), ne do textu."))
            }
        });
        // textarea průběžně aktualizovat – postback (_postback → form1.submit()) nevyvolá událost submit, ze které Froala jinak synchronizuje
        _edi = mtNotepad.create('#edi1', { events: { 'contentChanged': editor_sync, 'keyup': editor_sync, 'blur': editor_sync, 'commands.after': editor_sync } });
    }

    // stávající API pro volající stránky (Mail/SendMail, p91sendmail)
    function editor_clear() {
        if (_x04id != "0") {
            _edi.html.set("");
            editor_sync();
            _edi.events.focus();
        } else {
            $("#edi1").val("");
        }
    }

    function editor_setcontent(html) {
        if (_x04id != "0") {
            _edi.html.set(html);
            editor_sync();
            _edi.events.focus();
        } else {
            $("#edi1").val(html);
        }
    }

    // obsah editoru do textarea (postback čte textarea)
    function editor_sync() {
        if (_edi && _edi.html) $("#edi1").val(_edi.html.get());
    }
</script>
