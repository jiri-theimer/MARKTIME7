@model UI.Models.Tab1.BaseTab1ViewModel

@inject BL.Factory _f

@{


    if (Model == null)
    {
        return;
    }

    IEnumerable<BO.RoleAssignedToRecord> _lisRoles = _f.x67EntityRoleBL.GetRolesAssignedToRecord(Model.pid, Model.prefix);

    if (_lisRoles.Count()==0)
    {
        return;
    }
}

@addTagHelper *, UI

@* Verze 8: obsazení rolí jen pro čtení jako seznam „role – kdo“ (css/roleassign.css, .ra-ro). *@
<link rel="stylesheet" href="~/css/roleassign.css" asp-append-version="true" />
<dl class="ra-ro">
    @foreach (var c in _lisRoles)
    {
        <dt>@c.x67Name</dt>
        <dd>@c.Receivers</dd>
    }
</dl>
