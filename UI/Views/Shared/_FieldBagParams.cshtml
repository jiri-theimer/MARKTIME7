@model IEnumerable<BO.FieldBagParam>



@{


    if (Model == null || Model.Count() == 0)
    {
        return;
    }

    

}

@addTagHelper *, UI

<table class="table table-hover">
    @foreach (var c in Model)
    {
        <tr>
            <td style="max-width:100px;">
                @c.o58Name
            </td>

            <td>
                @if (c.o59ValueString !=null && c.o59ValueString.StartsWith("http"))
                {
                    <myval datatype="link" linktarget="_blank" linkurl="@c.o59ValueString" value="@c.o58Name"></myval>
                }
                else
                {
                    if (c.o59ValueString != null && c.o59ValueString.StartsWith("attachment"))
                    {
                        <myval datatype="link" linktarget="_blank" linkurl="/FileUpload/FileDownloadO59?prefix=@c.o59RecPrefix&pid=@c.o59RecPid&filename=@c.o59ValueString" value="@c.o59ArchiveFileName"></myval>
                    }
                    else
                    {
                        <myval datatype="@c.DataTypeName" value="@c.DataValue"></myval>
                    }
                    
                    
                }
                
                
            </td>
        </tr>
    }

</table>
