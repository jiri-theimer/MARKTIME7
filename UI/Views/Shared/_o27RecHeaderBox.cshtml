@model BO.o27Attachment

@inject BL.Factory _f

@{


    if (Model == null)
    {
        return;
    }

    bool _bolRowHover = UI.Code.basUI.DetectIfCanRowHover(_f, Context, true);

    var _strPath = $"{_f.UploadFolder}\\{Model.o27ArchiveFolder}\\{Model.o27ArchiveFileName}";
    bool _fileExists = System.IO.File.Exists(_strPath);

    var _linkUrl = $"/Record/RecPage?prefix={Model.o27Entity}&pid={Model.o27RecordPid}";
    if (Model.o27Entity == "p31")
    {
        _linkUrl = $"javascript:_window_open('/p31/Record?pid={Model.o27RecordPid}',3)";
    }

}

@addTagHelper *, UI

<div>
    @if (_fileExists)
    {
        <a target="_blank" href="/FileUpload/FileDownloadInline?guid=@Model.o27Guid">@_f.tra("Otevřít/Stáhnout")</a>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            @_f.tra("Soubor neexistuje!")
        </div>
    }


</div>
<table class="table table-hover">
   
    <tr>
        <td class="tdlab">
            @_f.tra("Název souboru"):
        </td>
        <td class="tdval">
            @Model.o27OriginalFileName
        </td>
    </tr>
    <tr>
        <td class="tdlab">
            @_f.tra("Přípona"):
        </td>
        <td class="tdval">
            @Model.o27FileExtension
        </td>
    </tr>
    <tr>
        <td class="tdlab">
            Content type:
        </td>
        <td class="tdval">
            @Model.o27ContentType
        </td>
    </tr>
    <tr>
        <td class="tdlab">
            @_f.tra("Velikost"):
        </td>
        <td class="tdval">
            @BO.Code.Bas.FormatFileSize(Model.o27FileSize)
        </td>
    </tr>
    @if (Model.o27Name != null)
    {
        <tr>
            <td class="tdlab">
                @_f.tra("Uživatelský název"):
            </td>
            <td class="tdval">
                @Model.o27Name
            </td>
        </tr>
    }
    

    @if(Model.o27RecordPid>0 && Model.o27Entity != null)
    {
        <tr>
            <td class="tdlab">
                @_f.tra("Vazba"):
            </td>
            <td class="tdval">
                @if (_bolRowHover)
                {
                    <myval value="@_f.CBL.GetObjectAlias(Model.o27Entity, Model.o27RecordPid)" hoverprefix="@Model.o27Entity" hoverpid="@Model.o27RecordPid" datatype="link" linktarget="_top" linkurl="@_linkUrl"></myval>
                }
                else
                {
                    <myval value="@_f.CBL.GetObjectAlias(Model.o27Entity, Model.o27RecordPid)" linktarget="_top"></myval>
                }
            </td>
        </tr>
    }

    
   

</table>

