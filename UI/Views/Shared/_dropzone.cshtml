@model UI.Models.DropzoneViewModel
@inject BL.Factory _f

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    if (Model.TempGuid == null)
    {
        Model.TempGuid = BO.Code.Bas.GetGuid();
    }
    var _lisP85 = _f.p85TempboxBL.GetList(Model.TempGuid);
    var _fileboxUrl = new UI.Menu.TheMenuSupport(_f).GetMainmenuEntityUrl("o27");


    IEnumerable<BO.o27Attachment> _lisO27 = null;
    if (Model.RecPrefix != null && Model.RecPid > 0)
    {
        _lisO27 = _f.o27AttachmentBL.GetList(new BO.myQueryO27() { entity = Model.RecPrefix, recpid = Model.RecPid });
    }

    //ikona souboru podle přípony (material icons)
    string FileIcon(string ext, bool isMail)
    {
        if (isMail) return "mail";
        switch ((ext ?? "").ToLowerInvariant())
        {
            case ".pdf": return "picture_as_pdf";
            case ".xls": case ".xlsx": case ".csv": case ".ods": return "table_chart";
            case ".doc": case ".docx": case ".odt": case ".rtf": case ".txt": return "article";
            case ".png": case ".jpg": case ".jpeg": case ".gif": case ".bmp": case ".webp": case ".tif": case ".tiff": case ".heic": case ".svg": return "image";
            case ".zip": case ".rar": case ".7z": return "folder_zip";
            case ".mp3": return "audio_file";
            case ".mp4": case ".avi": return "movie";
            case ".ppt": case ".pptx": return "slideshow";
            case ".isdoc": case ".isdocx": case ".xml": return "code";
            case ".ics": return "event";
            default: return "draft";
        }
    }
}

<link rel="stylesheet" href="~/css/dropzone-mt.css" asp-append-version="true" />

@Html.Raw("<div id='dropzone-container'>")
@if (Model.IsInIframe)
{
    @Html.Raw("<div class='row m-0 p-0'><div class='col-auto'>")
}



<form asp-controller="Dropzone"
      asp-action="UploadFiles"
      method="post"
      enctype="multipart/form-data"
      class="dropzone"
      id="myDropzone">

    <input type="hidden" id="tempguid" name="tempguid" value="@Model.TempGuid" />
    <input type="hidden" id="dropzone_uids" name="dropzone_uids" />
    <input type="hidden" id="dropzone_names" name="dropzone_names" />
    <input type="hidden" id="isautosave" name="isautosave" value="@Model.IsAutoSave.ToString()" />
    <input type="hidden" id="recprefix" name="recprefix" value="@Model.RecPrefix" />
    <input type="hidden" id="recpid" name="recpid" value="@Model.RecPid" />

    <div id="divNeedToSave" style="display:none;">
        <button type="button" class="btn btn-success" onclick="save_to_filebox()" style="cursor:pointer !important">@_f.tra("Uložit do FILEBOX")</button>
    </div>

    <div id="divDropzoneMessage" class="dz-message rounded-3 text-center bg-light" style="margin:0;">

        <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap">

            <span class="badge bg-light text-dark border px-3 py-1">
                <span class="material-icons-outlined align-middle me-1">attachment</span>
                FILEBOX
            </span>
            @if (!Model.IsInIframe)
            {
                <div class="text-muted">
                    <div class="fw-semibold">
                        @_f.tra("Přetáhněte soubory nebo e-maily sem")
                    </div>
                    <small>
                        @_f.tra("nebo") <span class="text-primary fw-semibold">@_f.tra("klikněte pro výběr")</span> · @_f.tra("snímek obrazovky vložíte Ctrl+V")
                    </small>
                </div>
            }
            

        </div>
        
    </div>

    
</form>



@if (Model.IsInIframe)
{
    @Html.Raw("</div><div class='col-auto'>")
    
}




@if (_lisP85 != null && _lisP85.Count() > 0)
{
    <div class="fb-list fb-temp">
        @foreach (var c in _lisP85)
        {
            <div class="fb-item">
                <span class="fb-ico material-icons-outlined-nosize">@FileIcon(System.IO.Path.GetExtension(c.p85FreeText01 ?? ""), false)</span>
                <a class="fb-name" target="_blank" href="/Dropzone/DownloadTempFile?tempfilename=@(c.p85FreeText03)&tempguid=@(Model.TempGuid)">@c.p85FreeText01</a>
                <span class="fb-size">@(BO.Code.Bas.FormatFileSize((long)c.p85FreeNumber01))</span>
            </div>
        }
    </div>
}

@if (_lisO27 != null && _lisO27.Count() > 0)
{
    <div class="fb-list">
        @foreach (var c in _lisO27)
        {
            <div class="fb-item @(c.IsMail ? "fb-mail" : null)">
                @if (!Model.IsInIframe)
                {
                    <a class="cm fb-cm" onclick="_cm(event,'o27',@(c.pid))" title="MENU">&#9776;</a>
                }
                <span class="fb-ico material-icons-outlined-nosize">@FileIcon(c.o27FileExtension, c.IsMail)</span>
                <div class="fb-main">
                    @if (c.IsMail)
                    {
                        <a class="fb-name" href="javascript:_edit('o27',@c.pid)">@(c.o27MailSubject != null ? c.o27MailSubject : c.o27OriginalFileName)</a>
                        <div class="fb-meta">
                            <span title="@c.o27MailSenderAddress">@(c.o27MailSenderName ?? c.o27MailSenderAddress)</span>
                            <span class="fb-arrow">→</span>
                            <span title="@c.o27MailToAddress">@(c.o27MailToName ?? c.o27MailToAddress)</span>
                            @if (c.o27MailDateMessage != null)
                            {
                                <span class="fb-dot">·</span><span>@(BO.Code.Time.GetTimestamp(c.o27MailDateMessage))</span>
                            }
                        </div>
                        @if (c.o27MailAttachmentsCount > 0)
                        {
                            <div class="fb-atts">
                                @foreach (var att in BO.Code.Bas.ConvertString2List(c.o27MailAttachments, ","))
                                {
                                    <a target="_blank" class="fb-att" href="/FileUpload/FileDownloadMsgAttachment?guid=@(c.o27Guid)&origfilename=@(Uri.EscapeDataString(att))" title="@att">
                                        <span class="material-icons-outlined-nosize">@FileIcon(System.IO.Path.GetExtension(att), false)</span>@BO.Code.Bas.OM2(att, 28)
                                    </a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @if (c.o27WwwRootFolder != null)
                        {
                            <a class="fb-name" target="_blank" href="@("/_users/" + _f.Lic.x01Guid + "/" + c.o27WwwRootFolder.Replace("\\", "/") + "/" + c.o27ArchiveFileName)">@c.o27OriginalFileName</a>
                        }
                        else
                        {
                            <a class="fb-name" target="_blank" href="/FileUpload/FileDownloadInline?guid=@c.o27Guid">@c.o27OriginalFileName</a>
                        }
                        @if (c.o27Name != null || c.o27CallerFlag == BO.o27CallerFlagENUM.Notepad)
                        {
                            <div class="fb-meta">
                                @if (c.o27CallerFlag == BO.o27CallerFlagENUM.Notepad)
                                {
                                    <span class="fb-tag">Notepad@(c.o27WwwRootFolder != null ? " · image" : "")</span>
                                }
                                @if (c.o27Name != null)
                                {
                                    <span class="fb-note">@c.o27Name</span>
                                }
                            </div>
                        }
                    }
                </div>
                <span class="fb-size">@(BO.Code.Bas.FormatFileSize(c.o27FileSize))</span>
                <span class="fb-date" title="@(c.DateInsert?.ToString("d.M.yyyy HH:mm"))">@(BO.Code.Time.GetTimestamp(c.DateInsert))</span>
                @if (!c.IsMail && c.UserInsert == _f.CurrentUser.j02Login)
                {
                    <a class="fb-edit edit-link" href="javascript:_edit('o27',@(c.pid))" title="@_f.tra("Upravit")"><span class="material-icons-outlined-nosize">edit</span></a>
                }
            </div>
        }
    </div>
}

@if (Model.IsInIframe)
{
    @if (Model.RecPid > 0 && Model.RecPrefix !=null)
    {
        <a class="btn btn-sm btn-light fb-queue" id="linkDropzoneFronta" title="@_f.tra("Zatřídit přílohy bez vazby")" href="javascript:fronta_bez_vazby()"><span class="material-icons-outlined-btn">inbox</span> @_f.tra("FILEBOX fronta")</a>
    }
    
    @Html.Raw("</div></div>")
}
else
{
    @if (Model.RecPid > 0 && Model.RecPrefix != null)
    {
        <div style="padding-bottom:20px;">
            <a class="btn btn-sm btn-light fb-queue" id="linkDropzoneFronta" title="@_f.tra("Zatřídit přílohy bez vazby")" href="javascript:fronta_bez_vazby()"><span class="material-icons-outlined-btn">inbox</span> @_f.tra("FILEBOX fronta")</a>
        </div>
    }
    
    
}


@Html.Raw("</div>")

<script>
    const isinframe="@(Model.IsInIframe)";
    const _fb_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        hint = _f.tra("Přetáhněte soubory nebo e-maily, klikněte pro výběr, nebo vložte snímek obrazovky Ctrl+V"),
        rejected = _f.tra("Server soubor odmítl (typ nebo velikost):"),
        error = _f.tra("Chyba nahrávání:")
    }));

    if (isinframe=="True")
    {
        $("#divDropzoneMessage").attr("title", _fb_txt.hint);
    }

    // Dropzone v6 – explicitní inicializace
    const formEl = document.getElementById("myDropzone");
    const uploadUrl = formEl.getAttribute("action") || "/Dropzone/UploadFiles";   // url z <form action="..."> (ASP.NET ho vyplní)

    const previewTemplate = `
    <div class="dz-preview dz-file-preview">
      <div class="dz-file-row">
        <div class="dz-thumb"><img data-dz-thumbnail /></div>
        <div class="dz-meta">
          <div class="dz-name" data-dz-name></div>
          <div class="dz-size" data-dz-size></div>
          <div class="dz-progress"><span class="dz-upload" data-dz-uploadprogress></span></div>
        </div>
        <div class="dz-actions"><button data-dz-remove>✕</button></div>
      </div>
    </div>
    `;

    //náhled podle přípony (file.type je MIME – u .msg/.eml bývá prázdný)
    function fb_thumb(name) {
        const ext = ((name || "").split(".").pop() || "").toLowerCase();
        const map = { pdf: "pdf80", doc: "word80", docx: "word80", odt: "word80", rtf: "word80", xls: "excel80", xlsx: "excel80", ods: "excel80", csv: "csv80", zip: "zip80", rar: "zip80", "7z": "zip80", msg: "msg80", eml: "eml80" };
        return "/images/files/" + (map[ext] || "upload80") + ".png";
    }

    //iframe s FILEBOXem (karty záznamů): výška podle obsahu
    function fb_fit_parent() {
        if (isinframe != "True") return;
        try {
            const fr = window.parent.document.getElementById("fraUpload");
            if (fr) fr.style.height = Math.min(Math.max(document.documentElement.scrollHeight + 4, 60), 420) + "px";
        } catch (e) { }
    }

    const dz = new Dropzone(formEl, {
      url: uploadUrl,
      previewTemplate: previewTemplate,
      paramName: "files",          // musí odpovídat názvu v controlleru
      maxFilesize: 20,             // MB – stejně jako DropzoneController.MaxFileBytes
      acceptedFiles: ".msg,.eml,.pdf,image/*,.xls,.xlsx,.docx,.doc,.txt,.zip,.rar,.7z,.ppt,.pptx,.csv,.mp3,.mp4,.avi,.html,.htm,.odt,.ods,.rtf,.ics,.isdoc,.isdocx,.xml",
      uploadMultiple: true,
      parallelUploads: 3,
      thumbnailWidth: 100,
      thumbnailHeight: 100,
      dictInvalidFileType: "@_f.tra("Tento typ souboru nelze nahrát.")",
      dictFileTooBig: "@_f.tra("Soubor je příliš velký")" + " ({{filesize}} MB, max. {{maxFilesize}} MB).",
      dictResponseError: "@_f.tra("Chyba serveru")" + " ({{statusCode}}).",
      dictCancelUpload: "@_f.tra("Zrušit")",
      dictRemoveFile: "@_f.tra("Odebrat")",

      init: function () {
        const dz = this;

        dz.on("success", function (file, response) {
          if (response && response.rejected && response.rejected.length && !file._fb_reported) {
              dz.files.forEach(f => f._fb_reported = true);       //uploadMultiple: success přijde pro každý soubor dávky
              _notify_message(_fb_txt.rejected + " " + response.rejected.join(", "), "error", 6000);
          }
          fb_fit_parent();
        });

        dz.on("error", function (file, errorMessage, xhr) {
          let msg = (errorMessage && errorMessage.error) ? errorMessage.error : errorMessage;
          if (typeof msg === "string" && msg.trim().charAt(0) === "\x3C") msg = "HTTP " + (xhr ? xhr.status : "");    //chybová HTML stránka serveru – nevypisovat
          _notify_message(_fb_txt.error + " " + (file.name || "") + " – " + msg, "error", 6000);
          dz.emit("thumbnail", file, "/images/files/error80.png");
          fb_fit_parent();
        });

        dz.on("queuecomplete", function () {
          refreshstate_dropbox();
          fb_fit_parent();

          var isrefresh="@Model.IsAutoSave";
          if (isrefresh=="True")
          {
                if (document.getElementById("form1"))
                {
                    _postback();
                }else
                {
                    location.replace(location.href);
                }
          }
        });

        dz.on("sendingmultiple", function (files, xhr, formData) {
            files.forEach(function(file) {
                formData.append("dropzone_uids",file.upload.uuid);
                formData.append("dropzone_names",file.name);
            });
        });

        dz.on("removedfile", function(file) {
            const tempguid="@Model.TempGuid";
            if (!file.upload || file.status === Dropzone.ERROR) { refreshstate_dropbox(); fb_fit_parent(); return; }
            $.post("/Dropzone/DeleteTempFile", { filename: encodeURIComponent(file.name), fileuid: file.upload.uuid, tempguid: tempguid }, function (data) {
                refreshstate_dropbox();
                fb_fit_parent();
            });
        });

        dz.on("addedfile", function(file) {
            dz.emit("thumbnail", file, fb_thumb(file.name));
            fb_fit_parent();
        });
      }
    });

    //Ctrl+V: snímek obrazovky / soubory ze schránky (mimo textová pole)
    document.addEventListener("paste", function (e) {
        const t = e.target, tag = (t && t.tagName || "").toLowerCase();
        if (tag === "input" || tag === "textarea" || (t && t.isContentEditable)) return;
        const items = (e.clipboardData && e.clipboardData.files) ? Array.from(e.clipboardData.files) : [];
        if (items.length === 0) return;
        e.preventDefault();
        const d = new Date(), p2 = n => String(n).padStart(2, "0");
        const stamp = d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate()) + "-" + p2(d.getHours()) + p2(d.getMinutes()) + p2(d.getSeconds());
        items.forEach(function (f, i) {
            let file = f;
            if (!f.name || f.name === "image.png") {
                const ext = (f.type.split("/")[1] || "png").replace("jpeg", "jpg");
                file = new File([f], "snimek-" + stamp + (items.length > 1 ? "-" + (i + 1) : "") + "." + ext, { type: f.type });
            }
            dz.addFile(file);
        });
    });

    $(function () { fb_fit_parent(); });

     function refreshstate_dropbox()
     {
                if (isinframe=="True")
                {
                    return;
                }
                if (dz.files.length>0)
                {
                    $("#divNeedToSave").css("display","block");
                }else{
                    $("#divNeedToSave").css("display","none");
                }
     }

     function save_to_filebox()
     {
         const tempguid="@Model.TempGuid";

            $.post("/Dropzone/SaveToFilebox", { tempguid: tempguid,recprefix: "@Model.RecPrefix",recpid: @Model.RecPid }, function (data) {

                dz.removeAllFiles();
                refreshstate_dropbox();

                    if (document.getElementById("form1"))
                    {
                        _postback();
                    }else
                    {
                        location.replace(location.href);
                    }

            });
     }
     function fronta_bez_vazby()
     {
         _window_open("/o27/Fronta?prefix=@(Model.RecPrefix)&pid=@(Model.RecPid)");
     }

</script>