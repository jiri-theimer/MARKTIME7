@model UI.Models.AI.AiChatSettings
@inject BL.Factory _f
@*
    Společný chat AI agentů. Použití ve view agenta:
        <partial name="~/Views/Shared/AI/_AiChat.cshtml" model="new UI.Models.AI.AiChatSettings { Intro = ..., Placeholder = ... }" />
    a v JS agenta:
        var chat = new AiChat({ askUrl: "/AiXxx/Ask", page: "...", extra: function () { return {...}; }, onAnswer: function (r) { ... } });
*@
<link rel="stylesheet" href="~/css/ai/aichat.css" asp-append-version="true" />

<div class="ai-chat-col">
    <div id="ai_chat" class="ai-chat" data-feature="@Model.Feature">
        <div class="ai-msg ai-assistant">
            @Model.Intro
            @if (Model.Examples != null && Model.Examples.Count > 0)
            {
                <div class="ai-examples">
                    @foreach (var ex in Model.Examples)
                    {
                        <button type="button" class="ai-example" data-q="@ex">@ex</button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="ai-input">
        <div id="ai_history" class="ai-history" style="display:none;"></div>
        <textarea id="ai_prompt" class="form-control" rows="3" placeholder="@(Model.Placeholder ?? _f.tra("Váš dotaz…"))"></textarea>
        <div class="ai-input-buttons">
            <button id="ai_send" type="button" class="btn btn-primary">@_f.tra("Odeslat")</button>
            <button id="ai_history_btn" type="button" class="btn btn-sm btn-outline-secondary" title="@_f.tra("Předchozí dotazy (šipka nahoru/dolů)")" style="display:none;">
                <span class="material-icons-outlined-btn">history</span>
            </button>
        </div>
    </div>
</div>

<script type="text/javascript">
    var _aichat_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        thinking = Model.Thinking ?? _f.tra("Připravuji odpověď…"),
        error = _f.tra("Chyba"),
        rateUp = _f.tra("Dobrá odpověď"),
        rateDown = _f.tra("Špatná odpověď"),
        rateComment = _f.tra("Co bylo špatně? (nepovinné)"),
        send = _f.tra("Odeslat"),
        thanks = _f.tra("Děkujeme za hodnocení"),
        history = _f.tra("Předchozí dotazy")
    }));
</script>
<script src="~/js/ai/aichat.js" asp-append-version="true"></script>
