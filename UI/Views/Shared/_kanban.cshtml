@model UI.Models.Kanban.BaseKanbanViewModel
@inject BL.Factory _f

@*
    Sdílené Kanban view.
    Vstup: BaseKanbanViewModel.polozky (List<KanbanPolozka>)

    Sloupce se odvozují z polozka.sloupec_nazev,
    řadí podle polozka.sloupec_poradi (číselně, fallback dle prvního výskytu),
    barví podle polozka.sloupec_barva (horní pruh sloupce).

    Hostitelská stránka (např. p28.cshtml) může přepsat chování:
      - kanban_open(prefix, pid)                         ... otevření detailu po kliku na kartu
      - kanban_on_drop(pid, prefix, fromCol, toCol, el) ... uložení přesunu karty mezi sloupci
    Pokud nejsou definované, použijí se rozumné defaulty (viz <script> níže).
*@

@functions {
    // Čitelná barva textu (černá/bílá) na daném pozadí; null = neznámý formát → necháme dědit.
    static string TextOn(string bg)
    {
        if (string.IsNullOrWhiteSpace(bg)) return null;
        var c = bg.Trim();
        if (c.StartsWith("#")) c = c.Substring(1);
        if (c.Length == 3) c = string.Concat(c[0], c[0], c[1], c[1], c[2], c[2]);
        if (c.Length != 6) return null;
        if (!int.TryParse(c, System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out _)) return null;
        int r = Convert.ToInt32(c.Substring(0, 2), 16);
        int g = Convert.ToInt32(c.Substring(2, 2), 16);
        int b = Convert.ToInt32(c.Substring(4, 2), 16);
        double lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
        return lum > 0.6 ? "#212529" : "#ffffff";
    }

    static string Hours(double h)
    {
        return h.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("cs-CZ"));
    }
}

@{
    var vsechny = Model.polozky ?? new List<UI.Models.Kanban.KanbanPolozka>();

    // Seskupení do sloupců dle názvu, se zachováním pořadí prvního výskytu jako fallbacku.
    var sloupce = vsechny
        .Select((p, idx) => new { p, idx })
        .GroupBy(x => string.IsNullOrWhiteSpace(x.p.sloupec_nazev) ? "" : x.p.sloupec_nazev.Trim())
        .Select(g => new
        {
            Nazev = g.Key,
            Barva = g.Select(x => x.p.sloupec_barva).FirstOrDefault(b => !string.IsNullOrWhiteSpace(b)),
            // pořadí sloupce dle sloupec_poradi; nečíselné/prázdné jdou na konec
            Poradi = g.Select(x => int.TryParse(x.p.sloupec_poradi, out var n) ? (int?)n : null)
                       .FirstOrDefault(n => n.HasValue) ?? int.MaxValue,
            Polozky = g.OrderBy(x => x.idx).Select(x => x.p).ToList()
        })
        // pořadí sloupců = sloupec_poradi, poté sloupec_nazev
        .OrderBy(s => s.Poradi).ThenBy(s => s.Nazev, StringComparer.CurrentCulture)
        .ToList();
}

<div class="kanban-wrap">

    @if (!vsechny.Any())
    {
        <div class="kanban-empty">
            <span class="material-icons-outlined">view_kanban</span>
            <div>@_f.tra("Žádné položky k zobrazení.")</div>
        </div>
    }
    else
    {
        <div class="kanban-board">
            @foreach (var s in sloupce)
            {
                var hlavickaText = TextOn(s.Barva);
                var nazevZobraz = string.IsNullOrEmpty(s.Nazev) ? _f.tra("(bez zařazení)") : s.Nazev;

                <section class="kanban-col" data-col="@s.Nazev">
                    <header class="kanban-col-head"
                            style="@(s.Barva != null ? $"background:{s.Barva};" : "")@(hlavickaText != null ? $"color:{hlavickaText};" : "")">
                        <span class="kanban-col-name" title="@nazevZobraz">@nazevZobraz</span>
                        <span class="kanban-col-count">@s.Polozky.Count</span>
                    </header>

                    <div class="kanban-col-body"
                         ondragover="kanban_dragover(event)"
                         ondragleave="kanban_dragleave(event)"
                         ondrop="kanban_drop(event)">

                        @foreach (var c in s.Polozky)
                        {
                            var maHodiny = c.hodiny_vykazane > 0 || c.hodiny_nevyuctovane > 0;
                            var jeVybrana = Model.go2pid > 0 && c.pid == Model.go2pid;

                            <article class="kanban-card@(jeVybrana ? " kanban-card--selected" : "")"
                                     draggable="true"
                                     data-pid="@c.pid"
                                     data-prefix="@c.prefix"
                                     data-col="@s.Nazev"
                                     ondragstart="kanban_dragstart(event)"
                                     ondragend="kanban_dragend(event)"
                                     onclick="kanban_card_click(this, event)">

                                <div class="kanban-card-top">
                                    <a class="cm" onclick="cm(event,@c.pid)" title="@_f.tra("Menu")">&#9776;</a>
                                </div>

                                <div class="kanban-card-title">
                                    @c.nazev
                                    @if (!string.IsNullOrWhiteSpace(c.nazev_after))
                                    {
                                        <span class="kanban-card-title-after">@c.nazev_after</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(c.b02Name))
                                {
                                    <div class="kanban-card-stav">
                                        @c.b02Name<span class="tecka"><span class="dot" style="background-color:@c.b02Color"></span></span>
                                    </div>
                                }

                                @if (maHodiny)
                                {
                                    <div class="kanban-card-foot">
                                        @if (c.hodiny_vykazane > 0)
                                        {
                                            <span class="kanban-hrs" title="@_f.tra("Vykázané hodiny")">
                                                <span class="material-icons-outlined">schedule</span>@Hours(c.hodiny_vykazane)
                                            </span>
                                        }
                                        @if (c.hodiny_nevyuctovane > 0)
                                        {
                                            <span class="kanban-hrs kanban-hrs--warn" title="@_f.tra("Nevyúčtované hodiny")">
                                                <span class="material-icons-outlined">paid</span>@Hours(c.hodiny_nevyuctovane)
                                            </span>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@* ---- Styly (zapouzdřené pod .kanban-wrap, aby nekolidovaly s site.css) ---- *@
<style type="text/css">
    .kanban-wrap {
        width: 100%;
    }

    .kanban-board {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        /* výška: pod horním pruhem; uprav dle potřeby hostitelské stránky */
        height: calc(100vh - 120px);
    }

    .kanban-col {
        flex: 0 0 300px;
        max-width: 300px;
        display: flex;
        flex-direction: column;
        max-height: 100%;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
    }

    .kanban-col-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        font-weight: 600;
        background: #e9ecef;
        border-bottom: 1px solid #dee2e6;
    }

    .kanban-col-name {
        flex: 1 1 auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kanban-col-count {
        flex: 0 0 auto;
        min-width: 22px;
        text-align: center;
        font-size: .8rem;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 10px;
        background: rgba(0,0,0,.15);
    }

    .kanban-col-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 60px;
    }

        .kanban-col-body.kanban-dropzone {
            background: var(--oznaceno, #cfe2ff);
            outline: 2px dashed #adb5bd;
            outline-offset: -4px;
        }

    .kanban-card {
        background: #fff;
        border: 1px solid #e3e6ea;
        border-radius: 6px;
        padding: 8px 10px;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,.06);
        transition: box-shadow .12s ease, transform .12s ease;
        user-select: none;
    }

        .kanban-card:hover {
            box-shadow: 0 3px 8px rgba(0,0,0,.14);
            transform: translateY(-1px);
        }

        .kanban-card.kanban-dragging {
            opacity: .5;
        }

    .kanban-card--selected {
        background: var(--oznaceno, #fff3cd);
        border-color: var(--popredi, #adb5bd);
        box-shadow: 0 0 0 2px var(--popredi, #adb5bd), 0 2px 6px rgba(0,0,0,.18);
    }

    .kanban-card-top {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 2px;
    }

    .kanban-card-kod {
        font-size: .72rem;
        color: #6c757d;
        letter-spacing: .02em;
    }

    .kanban-card-top .cm {
        margin-left: auto; /* hamburger vpravo i bez kódu */
        flex: 0 0 auto;
        cursor: pointer;
        color: #868e96;
        line-height: 1;
        text-decoration: none;
        padding: 0 2px;
    }

        .kanban-card-top .cm:hover {
            color: #495057;
        }

    .kanban-card-title {
        font-weight: 600;
        line-height: 1.25;
        word-break: break-word;
    }

    .kanban-card-title-after {
        font-weight: 400;
        color: #6c757d;
        margin-left: 4px;
    }

    .kanban-card-stav {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: .78rem;
        color: #495057;
    }

    .kanban-card-foot {
        display: flex;
        gap: 12px;
        margin-top: 8px;
        padding-top: 6px;
        border-top: 1px solid #f1f3f5;
        font-size: .78rem;
        color: #495057;
    }

    .kanban-hrs {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

        .kanban-hrs .material-icons-outlined {
            font-size: 15px;
        }

    .kanban-hrs--warn {
        color: #b54708;
    }

    .kanban-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 48px 16px;
        color: #868e96;
    }

        .kanban-empty .material-icons-outlined {
            font-size: 40px;
            opacity: .6;
        }

    @@media (max-width: 576px) {
        .kanban-col {
            flex-basis: 84vw;
            max-width: 84vw;
        }
    }
</style>

@* ---- Chování (guard, aby se při vícenásobném includu nepředefinovalo) ---- *@
<script type="text/javascript">
    if (typeof window.__kanban_inited === "undefined") {
        window.__kanban_inited = true;
        window.__kanban_drag = null; // { pid, prefix, fromCol, el }

        // Default otevření detailu – host může přepsat: window.kanban_open = function(prefix, pid){...}
        if (typeof window.kanban_open !== "function") {
            window.kanban_open = function (prefix, pid) {
                if (typeof window.edit === "function") { window.edit(pid); return; }   // karta záznamu v modálu
                var url = "/" + prefix + "/MasterView?go2pid=" + pid;
                if (typeof _window_open === "function") { _window_open(url, 1); }
                else if (typeof _redirect === "function") { _redirect(url); }
                else { location.href = url; }
            };
        }

        window.kanban_card_click = function (el, ev) {
            if (window.__kanban_suppress_click) { window.__kanban_suppress_click = false; return; }
            if (ev && ev.target && ev.target.closest && ev.target.closest(".cm")) return; // hamburger řeší cm()
            window.kanban_open(el.getAttribute("data-prefix"), el.getAttribute("data-pid"));
        };

        window.kanban_dragstart = function (ev) {
            var card = ev.currentTarget;
            window.__kanban_drag = {
                pid: card.getAttribute("data-pid"),
                prefix: card.getAttribute("data-prefix"),
                fromCol: card.getAttribute("data-col"),
                el: card
            };
            card.classList.add("kanban-dragging");
            if (ev.dataTransfer) { ev.dataTransfer.effectAllowed = "move"; }
        };

        window.kanban_dragend = function (ev) {
            ev.currentTarget.classList.remove("kanban-dragging");
            // potlačit "klik", který prohlížeč pošle po dokončení tažení
            window.__kanban_suppress_click = true;
            setTimeout(function () { window.__kanban_suppress_click = false; }, 50);
        };

        window.kanban_dragover = function (ev) {
            ev.preventDefault();
            if (ev.dataTransfer) { ev.dataTransfer.dropEffect = "move"; }
            ev.currentTarget.classList.add("kanban-dropzone");
        };

        window.kanban_dragleave = function (ev) {
            ev.currentTarget.classList.remove("kanban-dropzone");
        };

        window.kanban_drop = function (ev) {
            ev.preventDefault();
            var body = ev.currentTarget;
            body.classList.remove("kanban-dropzone");

            var d = window.__kanban_drag;
            if (!d) return;

            var col = body.closest(".kanban-col");
            var toCol = col ? col.getAttribute("data-col") : null;
            if (toCol === d.fromCol) return; // beze změny

            // vizuální přesun
            body.appendChild(d.el);
            d.el.setAttribute("data-col", toCol);
            kanban_recount();

            // persistenci řeší host – pokud hook chybí, jen upozorníme do konzole
            if (typeof window.kanban_on_drop === "function") {
                window.kanban_on_drop(d.pid, d.prefix, d.fromCol, toCol, d.el);
            } else {
                console.warn("[kanban] kanban_on_drop není definováno – přesun se neuložil (pid=" + d.pid + ", " + d.fromCol + " → " + toCol + ").");
            }
        };

        window.kanban_recount = function () {
            document.querySelectorAll(".kanban-col").forEach(function (col) {
                var n = col.querySelectorAll(".kanban-card").length;
                var c = col.querySelector(".kanban-col-count");
                if (c) c.textContent = n;
            });
        };
    }

    // Scroll na výchozí (označenou) kartu – go2pid > 0. Toto je hlavní funkce: dostat go2pid do viditelné oblasti.
    (function () {
        function centerWithin(container, el, horizontal) {
            if (!container || !el) return;
            var cr = container.getBoundingClientRect();
            var er = el.getBoundingClientRect();
            if (horizontal) {
                container.scrollLeft += (er.left - cr.left) - (container.clientWidth - el.offsetWidth) / 2;
            } else {
                container.scrollTop += (er.top - cr.top) - (container.clientHeight - el.offsetHeight) / 2;
            }
        }

        function scrollToSelected() {
            var sel = document.querySelector(".kanban-card--selected");
            if (!sel) return;
            var colBody = sel.closest(".kanban-col-body");   // svislý scroll uvnitř sloupce
            var col     = sel.closest(".kanban-col");
            var board   = sel.closest(".kanban-board");       // vodorovný scroll boardu

            centerWithin(colBody, sel, false);                // kartu vycentrovat svisle ve sloupci
            centerWithin(board, col, true);                   // sloupec vycentrovat vodorovně v boardu
        }

        function run() {
            // počkat na dopočítání layoutu (fonty/ikony/výšky sloupců), pak vycentrovat
            requestAnimationFrame(function () {
                requestAnimationFrame(scrollToSelected);
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", run);
        } else {
            run();
        }
    })();
</script>