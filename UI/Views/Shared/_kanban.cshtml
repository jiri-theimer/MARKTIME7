@model UI.Models.Kanban.BaseKanbanViewModel
@inject BL.Factory _f

@*
    Sdílené Kanban view (jeden soubor).
    Vstup:
      BaseKanbanViewModel.sloupce  (List<KanbanSloupec>) ... sloupce boardu v pořadí listu (pid, nazev, barva)
      BaseKanbanViewModel.polozky  (List<KanbanPolozka>) ... karty; zařazení do sloupce přes sloupec_pid == sloupec.pid
      BaseKanbanViewModel.go2pid   ... > 0 → tahle karta se označí a odscrolluje se na ni

    Stránkování řeší controller (mq.OFFSET_PageNum / mq.OFFSET_PageSize) – view jen vykreslí, co dostane.
    Položky s neznámým sloupec_pid (mimo Model.sloupce) spadnou do koncového sloupce "(bez zařazení)".

    Hostitelská stránka může přepsat:
      - kanban_open(prefix, pid)                         ... klik na kartu (default edit(pid) v modálu)
      - kanban_on_drop(pid, prefix, fromCol, toCol, el) ... uložení přesunu karty; fromCol/toCol = pid sloupce
      - kanban_hours(ev, prefix, pid)                    ... odkaz na hodiny
*@

@functions {
    // čitelná barva textu (černá/bílá) na daném pozadí; null = neznámý formát → dědit
    static string TextOn(string bg)
    {
        if (string.IsNullOrWhiteSpace(bg)) return null;
        var c = bg.Trim();
        if (c.StartsWith("#")) c = c.Substring(1);
        if (c.Length == 3) c = string.Concat(c[0], c[0], c[1], c[1], c[2], c[2]);
        if (c.Length != 6) return null;
        if (!int.TryParse(c, System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out _)) return null;
        int r = Convert.ToInt32(c.Substring(0, 2), 16);
        int g = Convert.ToInt32(c.Substring(2, 2), 16);
        int b = Convert.ToInt32(c.Substring(4, 2), 16);
        double lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
        return lum > 0.6 ? "#212529" : "#ffffff";
    }

    static string Hours(double h)
    {
        return h.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("cs-CZ"));
    }
}

@{
    var vsechny = Model.polozky ?? new List<UI.Models.Kanban.KanbanPolozka>();
    var sloupceModel = Model.sloupce ?? new List<UI.Models.Kanban.KanbanSloupec>();

    var dleSloupce = vsechny.GroupBy(p => p.sloupec_pid).ToDictionary(g => g.Key, g => g.ToList());

    var sloupce = sloupceModel.Select(s => new
    {
        Pid = s.pid,
        Nazev = s.nazev,
        Barva = s.barva,
        Pagenum = s.pagenum,
        Pagesize = s.pagesize > 0 ? s.pagesize : 200,
        Polozky = dleSloupce.TryGetValue(s.pid, out var lp) ? lp : new List<UI.Models.Kanban.KanbanPolozka>()
    }).ToList();

    var pidySloupcu = new HashSet<int>(sloupceModel.Select(s => s.pid));
    var bezZarazeni = vsechny.Where(p => !pidySloupcu.Contains(p.sloupec_pid)).ToList();
    if (bezZarazeni.Any())
    {
        sloupce.Add(new { Pid = 0, Nazev = (string)null, Barva = (string)null, Pagenum = 0, Pagesize = 200, Polozky = bezZarazeni });
    }
}

<div class="kanban-wrap">

    @if (!sloupce.Any())
    {
        <div class="kanban-empty">
            <span class="material-icons-outlined">view_kanban</span>
            <div>@_f.tra("Žádné položky k zobrazení.")</div>
        </div>
    }
    else
    {
        <div class="kanban-board">
            @foreach (var s in sloupce)
            {
                var hlavickaText = TextOn(s.Barva);
                var nazevZobraz = string.IsNullOrWhiteSpace(s.Nazev) ? _f.tra("(bez zařazení)") : s.Nazev;
                var pagesize = s.Pagesize;
                var totalPages = (s.Polozky.Count + pagesize - 1) / pagesize;
                if (totalPages < 1) totalPages = 1;
                var aktStranka = Math.Min(Math.Max(0, s.Pagenum), totalPages - 1);

                // pokud je na boardu označená karta (go2pid) a leží v tomto sloupci, ukaž její stránku
                if (Model.go2pid > 0)
                {
                    var gi = s.Polozky.FindIndex(p => p.pid == Model.go2pid);
                    if (gi >= 0) aktStranka = gi / pagesize;
                }

                // server vyrenderuje JEN tuto stránku sloupce (lehký DOM)
                var strankaPolozky = s.Polozky.Skip(aktStranka * pagesize).Take(pagesize).ToList();

                <section class="kanban-col" data-col="@s.Pid">
                    <header class="kanban-col-head"
                            style="@(!string.IsNullOrWhiteSpace(s.Barva) ? $"background:{s.Barva};" : "")@(hlavickaText != null ? $"color:{hlavickaText};" : "")">
                        <span class="kanban-col-name" title="@nazevZobraz">@nazevZobraz</span>
                        <span class="kanban-col-count">@s.Polozky.Count</span>
                    </header>

                    <div class="kanban-col-body"
                         ondragover="kanban_dragover(event)"
                         ondragleave="kanban_dragleave(event)"
                         ondrop="kanban_drop(event)">

                        @foreach (var c in strankaPolozky)
                        {
                            var maHodiny = c.hodiny_vykazane > 0 || c.hodiny_nevyuctovane > 0;
                            var hodinyText = c.hodiny_nevyuctovane == c.hodiny_vykazane
                                ? $"{Hours(c.hodiny_vykazane)}h"
                                : $"{Hours(c.hodiny_nevyuctovane)}h/{Hours(c.hodiny_vykazane)}h";
                            var jeVybrana = Model.go2pid > 0 && c.pid == Model.go2pid;

                            var roleSkupiny = (c.role ?? new List<BO.StringPair>())
                                .Where(r => r != null && (!string.IsNullOrWhiteSpace(r.Key) || !string.IsNullOrWhiteSpace(r.Value)))
                                .GroupBy(r => r.Key ?? "")
                                .ToList();

                            <article class="kanban-card@(jeVybrana ? " kanban-card--selected" : "")"
                                     draggable="true"
                                     data-pid="@c.pid"
                                     data-prefix="@c.prefix"
                                     data-col="@s.Pid"
                                     ondragstart="kanban_dragstart(event)"
                                     ondragend="kanban_dragend(event)"
                                     onclick="kanban_card_click(this, event)">

                                <div class="kanban-card-top">
                                    <a class="cm" onclick="cm(event,@c.pid)" title="@_f.tra("Menu")">&#9776;</a>
                                </div>

                                <div class="kanban-card-title">@c.nazev</div>
                                @if (!string.IsNullOrWhiteSpace(c.nazev_after))
                                {
                                    <div class="kanban-card-title-after">@c.nazev_after</div>
                                }

                                @if (roleSkupiny.Any())
                                {
                                    <div class="kanban-card-role">
                                        @foreach (var g in roleSkupiny)
                                        {
                                            var jmena = string.Join(", ", g.Select(r => r.Value).Where(val => !string.IsNullOrWhiteSpace(val)));
                                            <span class="kanban-role">
                                                @if (!string.IsNullOrWhiteSpace(g.Key))
                                                {
                                                    <span class="kanban-role-key">@(g.Key):</span>
                                                }
                                                @jmena
                                            </span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(c.b02Name))
                                {
                                    <div class="kanban-card-stav">
                                        @c.b02Name<span class="tecka"><span class="dot" style="background-color:@c.b02Color"></span></span>
                                    </div>
                                }

                                @if (maHodiny)
                                {
                                    <div class="kanban-card-foot">
                                        <a class="kanban-hrs-link"
                                           onclick="kanban_hours(event, '@c.prefix', @c.pid)"
                                           title="@_f.tra("Nevyúčtované / vykázané hodiny")">
                                            @hodinyText
                                        </a>
                                    </div>
                                }
                            </article>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="kanban-col-pager">
                            <button type="button" class="kanban-pg-first" onclick="kanban_goto_page(@s.Pid,0)" @(aktStranka <= 0 ? "disabled" : "") title="@_f.tra("První")">&#171;</button>
                            <button type="button" class="kanban-pg-prev" onclick="kanban_goto_page(@s.Pid,@(aktStranka - 1))" @(aktStranka <= 0 ? "disabled" : "") title="@_f.tra("Předchozí")">&#8249;</button>
                            <span class="kanban-pg-info">@(aktStranka + 1) / @totalPages</span>
                            <button type="button" class="kanban-pg-next" onclick="kanban_goto_page(@s.Pid,@(aktStranka + 1))" @(aktStranka >= totalPages - 1 ? "disabled" : "") title="@_f.tra("Další")">&#8250;</button>
                            <button type="button" class="kanban-pg-last" onclick="kanban_goto_page(@s.Pid,@(totalPages - 1))" @(aktStranka >= totalPages - 1 ? "disabled" : "") title="@_f.tra("Poslední")">&#187;</button>
                        </div>
                    }
                </section>
            }
        </div>
    }
</div>

@* ---- Styly (zapouzdřené pod .kanban-wrap) ---- *@
<style type="text/css">
    .kanban-wrap {
        width: 100%;
    }

    .kanban-board {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        height: calc(100vh - 120px);
    }

    .kanban-col {
        flex: 0 0 300px;
        max-width: 300px;
        display: flex;
        flex-direction: column;
        max-height: 100%;
        background: #f1f3f5;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
    }

    .kanban-col-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        font-weight: 600;
        background: #e9ecef;
        border-bottom: 1px solid #dee2e6;
    }

    .kanban-col-name {
        flex: 1 1 auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kanban-col-count {
        flex: 0 0 auto;
        min-width: 22px;
        text-align: center;
        font-size: .8rem;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 10px;
        background: rgba(0,0,0,.15);
    }

    .kanban-col-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 60px;
    }

        .kanban-col-body.kanban-dropzone {
            background: var(--oznaceno, #cfe2ff);
            outline: 2px dashed #adb5bd;
            outline-offset: -4px;
        }

    .kanban-card {
        background: #fff;
        border: 1px solid #e3e6ea;
        border-radius: 6px;
        padding: 8px 10px;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,.06);
        transition: box-shadow .12s ease, transform .12s ease;
        user-select: none;
    }

        .kanban-card:hover {
            box-shadow: 0 3px 8px rgba(0,0,0,.14);
            transform: translateY(-1px);
        }

        .kanban-card.kanban-dragging {
            opacity: .5;
        }

    .kanban-card--selected {
        background: var(--oznaceno, #fff3cd);
        border-color: var(--popredi, #adb5bd);
        box-shadow: 0 0 0 2px var(--popredi, #adb5bd), 0 2px 6px rgba(0,0,0,.18);
    }

    .kanban-card-top {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 2px;
    }

        .kanban-card-top .cm {
            margin-left: auto;
            flex: 0 0 auto;
            cursor: pointer;
            color: #868e96;
            line-height: 1;
            text-decoration: none;
            padding: 0 2px;
        }

            .kanban-card-top .cm:hover {
                color: #495057;
            }

    .kanban-card-title {
        font-weight: 600;
        line-height: 1.25;
        word-break: break-word;
    }

    .kanban-card-title-after {
        font-weight: 400;
        color: #6c757d;
        margin-top: 2px;
        word-break: break-word;
    }

    .kanban-card-role {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        margin-top: 6px;
    }

    .kanban-role {
        font-size: .7rem;
        line-height: 1.4;
        padding: 1px 8px;
        border-radius: 10px;
        background: #eef1f4;
        color: #495057;
        border: 1px solid #e0e4e8;
        max-width: 100%;
        white-space: normal;
    }

    .kanban-role-key {
        font-weight: 600;
    }

    .kanban-card-stav {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: .78rem;
        color: #495057;
    }

    .kanban-card-foot {
        display: flex;
        gap: 12px;
        margin-top: 8px;
        padding-top: 6px;
        border-top: 1px solid #f1f3f5;
        font-size: .78rem;
        color: #495057;
    }

    .kanban-hrs-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #0d6efd;
        cursor: pointer;
        text-decoration: none;
        font-variant-numeric: tabular-nums;
    }

        .kanban-hrs-link:hover {
            text-decoration: underline;
        }

    .kanban-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 48px 16px;
        color: #868e96;
    }

        .kanban-empty .material-icons-outlined {
            font-size: 40px;
            opacity: .6;
        }

    .kanban-col-pager {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 6px 8px;
        border-top: 1px solid #dee2e6;
        background: #e9ecef;
        font-size: .8rem;
        color: #495057;
        user-select: none;
    }

        .kanban-col-pager button {
            border: 1px solid #ced4da;
            background: #fff;
            border-radius: 4px;
            width: 26px;
            height: 24px;
            line-height: 1;
            font-size: 1rem;
            cursor: pointer;
            color: #495057;
        }

            .kanban-col-pager button:hover:not(:disabled) {
                background: #f1f3f5;
            }

            .kanban-col-pager button:disabled {
                opacity: .4;
                cursor: default;
            }

    .kanban-pg-info {
        min-width: 48px;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    @@media (max-width: 576px) {
        .kanban-col {
            flex-basis: 84vw;
            max-width: 84vw;
        }
    }
</style>

@* ---- Chování (guard proti vícenásobnému includu) ---- *@
<script type="text/javascript">
    if (typeof window.__kanban_inited === "undefined") {
        window.__kanban_inited = true;
        window.__kanban_drag = null;

        // klik na kartu → detail. Host může přepsat window.kanban_open.
        if (typeof window.kanban_open !== "function") {
            window.kanban_open = function (prefix, pid) {
                if (typeof window.edit === "function") { window.edit(pid); return; }
                var url = "/" + prefix + "/MasterView?go2pid=" + pid;
                if (typeof _window_open === "function") { _window_open(url, 1); }
                else if (typeof _redirect === "function") { _redirect(url); }
                else { location.href = url; }
            };
        }

        window.kanban_card_click = function (el, ev) {
            if (window.__kanban_suppress_click) { window.__kanban_suppress_click = false; return; }
            if (ev && ev.target && ev.target.closest && ev.target.closest(".cm, .kanban-hrs-link")) return;
            window.kanban_open(el.getAttribute("data-prefix"), el.getAttribute("data-pid"));
        };

        // odkaz na hodiny → /p31dayline/Zoom?{prefix}id={pid} v modálu. Host může přepsat.
        window.kanban_hours = function (ev, prefix, pid) {
            if (ev) { ev.stopPropagation(); ev.preventDefault(); }
            var url = "/p31dayline/Zoom?" + prefix + "id=" + pid + "&d1=01.01.2000&d2=31.12.2100";
            if (typeof _window_open === "function") { _window_open(url, 1); }
            else if (typeof _redirect === "function") { _redirect(url); }
            else { location.href = url; }
        };

        window.kanban_dragstart = function (ev) {
            var card = ev.currentTarget;
            window.__kanban_drag = {
                pid: card.getAttribute("data-pid"),
                prefix: card.getAttribute("data-prefix"),
                fromCol: card.getAttribute("data-col"),
                el: card
            };
            card.classList.add("kanban-dragging");
            if (ev.dataTransfer) { ev.dataTransfer.effectAllowed = "move"; }
        };

        window.kanban_dragend = function (ev) {
            ev.currentTarget.classList.remove("kanban-dragging");
            window.__kanban_suppress_click = true;
            setTimeout(function () { window.__kanban_suppress_click = false; }, 50);
        };

        window.kanban_dragover = function (ev) {
            ev.preventDefault();
            if (ev.dataTransfer) { ev.dataTransfer.dropEffect = "move"; }
            ev.currentTarget.classList.add("kanban-dropzone");
        };

        window.kanban_dragleave = function (ev) {
            ev.currentTarget.classList.remove("kanban-dropzone");
        };

        window.kanban_drop = function (ev) {
            ev.preventDefault();
            var body = ev.currentTarget;
            body.classList.remove("kanban-dropzone");

            var d = window.__kanban_drag;
            if (!d) return;

            var col = body.closest(".kanban-col");
            var toCol = col ? col.getAttribute("data-col") : null;
            if (toCol === d.fromCol) return;

            body.appendChild(d.el);
            d.el.setAttribute("data-col", toCol);
            kanban_recount();

            if (typeof window.kanban_on_drop === "function") {
                window.kanban_on_drop(d.pid, d.prefix, d.fromCol, toCol, d.el);
            } else {
                console.warn("[kanban] kanban_on_drop není definováno – přesun se neuložil (pid=" + d.pid + ", " + d.fromCol + " → " + toCol + ").");
            }
        };

        window.kanban_recount = function () {
            document.querySelectorAll(".kanban-col").forEach(function (col) {
                var n = col.querySelectorAll(".kanban-card").length;
                var c = col.querySelector(".kanban-col-count");
                if (c) c.textContent = n;
            });
        };

        // přepnutí stránky sloupce = reload boardu s p{sloupec_pid}={stránka}.
        // Server vyrenderuje danou stránku (skutečné serverové stránkování).
        window.kanban_goto_page = function (sloupecPid, page) {
            if (page < 0) return;
            var url = new URL(window.location.href);
            url.searchParams.set("p" + sloupecPid, page);
            url.searchParams.delete("go2pid"); // při ručním listování nevnucovat stránku s go2pid
            window.location.href = url.toString();
        };
    }

    // scroll na výchozí (označenou) kartu – go2pid
    (function () {
        function centerWithin(container, el, horizontal) {
            if (!container || !el) return;
            var cr = container.getBoundingClientRect();
            var er = el.getBoundingClientRect();
            if (horizontal) {
                container.scrollLeft += (er.left - cr.left) - (container.clientWidth - el.offsetWidth) / 2;
            } else {
                container.scrollTop += (er.top - cr.top) - (container.clientHeight - el.offsetHeight) / 2;
            }
        }

        function scrollToSelected() {
            var sel = document.querySelector(".kanban-card--selected");
            if (!sel) return;
            centerWithin(sel.closest(".kanban-col-body"), sel, false);
            centerWithin(sel.closest(".kanban-board"), sel.closest(".kanban-col"), true);
        }

        function run() {
            requestAnimationFrame(function () { requestAnimationFrame(scrollToSelected); });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", run);
        } else {
            run();
        }
    })();
</script>