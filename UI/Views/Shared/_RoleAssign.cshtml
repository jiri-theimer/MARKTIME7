@model UI.Models.RoleAssignViewModel
@inject BL.Factory _f

@{
    if (Model==null || Model.RecPrefix == null)
    {
        return;
    }

    //string _lang_tymy = _f.tra("Týmy") + "...";
    //string _lang_osoby = _f.tra("Osoby/Jednotlivci") + "...";
    string _lang_vsichni = _f.tra("Všichni uživatelé");
    string _lang_neobsazeno = _f.tra("Neobsazeno");
    string _lang_uzivatele = _f.tra("Uživatelé");
    string _lang_tymy = _f.tra("Týmy uživatelů");
    string _lang_header = Model.Header;

    if (string.IsNullOrEmpty(_lang_header))
    {
        switch (Model.RolePrefix)
        {
            case "p41":
                _lang_header = _f.tra("Oprávnění v projektu (obsazení projektových rolí)"); break;
            case "p28":
                _lang_header = _f.tra("Obsazení rolí v záznamu kontaktu"); break;
            case "o23":
                _lang_header = _f.tra("Obsazení rolí v záznamu dokumentu"); break;
            case "p91":
                _lang_header = _f.tra("Obsazení rolí v záznamu vyúčtování"); break;
            case "p90":
                _lang_header = _f.tra("Obsazení rolí v záznamu zálohové faktury"); break;
            case "p56":
                _lang_header = _f.tra("Obsazení rolí v záznamu úkolu"); break;
            case "o22":
                _lang_header = _f.tra("Obsazení rolí v záznamu termínu"); break;
               
        }
    }


    if (Model.lisRepeator == null)
    {
        List<BO.x69EntityRole_Assign> lisX69 = null;        
        Model.lisRepeator = new List<RoleAssignRepeator>();
        IEnumerable<BO.x67EntityRole> lisX67 = null;
        if (Model.OnlyOne_x67ID>0){
            //na výběr pouze jedna konkrétní role
            lisX67 = _f.x67EntityRoleBL.GetList(new BO.myQuery("x67")).Where(p => p.pid == Model.OnlyOne_x67ID);
        }
        else
        {
            lisX67 = _f.x67EntityRoleBL.GetList(new BO.myQuery("x67") { explicit_orderby = "a.x67Entity,a.x67Ordinary" }).Where(p => p.x67Entity == Model.RolePrefix || p.x67Entity == Model.RolePrefixSecond);
        }
        
        
        if (Model.RecPid > 0)
        {
            lisX69 = _f.x67EntityRoleBL.GetList_X69(Model.RecPrefix, Model.RecPid).ToList();
        }
        else
        {
            if (Model.Default_j02ID > 0 || Model.Default_j11ID > 0)
            {
                if (Model.Default_x67ID == 0 && lisX67.Count()>0) Model.Default_x67ID = lisX67.First().pid; //pokud není určeno, pak výchozí role je ta první v pořadí
                lisX69 = new List<BO.x69EntityRole_Assign>();
                lisX69.Add(new BO.x69EntityRole_Assign() { x67ID = Model.Default_x67ID, j02ID = Model.Default_j02ID, j11ID = Model.Default_j11ID });
            }
        }
        foreach (var c in lisX67)
        {
            var cc = new RoleAssignRepeator() { x67ID = c.pid, x67Name = c.x67Name, IsNone = true, x67Entity = c.x67Entity,x67IsRequired=c.x67IsRequired };
            if (lisX69 != null)
            {
                var qry = lisX69.Where(p => p.x67ID == c.pid);
                if (qry.Count() > 0)
                {
                    cc.IsNone = false;
                    cc.x69IsAllUsers = qry.First().x69IsAllUsers;
                    if (!cc.x69IsAllUsers)
                    {
                        if (qry.Any(p => p.j11ID > 0))
                        {
                            cc.j11IDs = string.Join(",", qry.Where(p => p.j11ID > 0).Select(p => p.j11ID));
                            cc.Teams = string.Join(",", qry.Where(p => p.j11ID > 0).Select(p => p.j11Name));
                            if (Model.RecPid == 0 && Model.Default_j11ID > 0 && Model.Default_x67ID == c.pid)
                            {
                                cc.Teams = Model.Default_Team;
                            }
                        }

                        if (qry.Any(p => p.j02ID > 0))
                        {
                            cc.j02IDs = string.Join(",", qry.Where(p => p.j02ID > 0).Select(p => p.j02ID));
                            cc.Persons = string.Join(",", qry.Where(p => p.j02ID > 0).Select(p => p.Person));
                            if (Model.RecPid==0 && Model.Default_j02ID>0 && Model.Default_x67ID==c.pid)
                            {
                                cc.Persons = Model.Default_Person;
                            }
                        }
                    }

                }
            }
            Model.lisRepeator.Add(cc);
        }
    }

    foreach (var c in Model.lisRepeator)
    {
        if (c.IsNone)
        {
            c.CssVisibility_j02 = "hidden";
            c.CssVisibility_j11 = "hidden";
            c.CssVisibility_all = "hidden";
        }
        else
        {
            if (c.x69IsAllUsers)
            {
                c.CssVisibility_j02 = "hidden";
                c.CssVisibility_j11 = "hidden";
            }
        }

    }


}

@addTagHelper *, UI

@* Verze 8: role jako řádky s přepínačem Neobsazeno | Vybraní | Všichni uživatelé (css/roleassign.css, třídy ra-*).
   Postované hodnoty beze změny: lisRepeator[i].IsNone, .x69IsAllUsers (skrytá pole), .j02IDs, .j11IDs (mycombochecklist), x67*.
   Id prvků mají předponu podle HtmlFieldPrefix – partial může být na stránce víckrát. Funkce isnone_change/allpersons_change zachovány. *@
@{
    string _ra = "ra" + System.Text.RegularExpressions.Regex.Replace(ViewData.TemplateInfo.HtmlFieldPrefix ?? "", "[^A-Za-z0-9]", "_");
    int _filled = Model.lisRepeator.Count(p => !p.IsNone);
}

<link rel="stylesheet" href="~/css/roleassign.css" asp-append-version="true" />

<input type="hidden" asp-for="RolePrefix" />
<input type="hidden" asp-for="RolePrefixSecond" />
<input type="hidden" asp-for="RecPrefix" />
<input type="hidden" asp-for="RecPid" />
<input type="hidden" asp-for="Header" />

<section class="ra" id="@(_ra)">
    <div class="ra-head">
        <span class="material-icons-outlined-nosize">group</span>
        @if (_lang_header != null && _lang_header != ".")
        {
            <h2>@(_lang_header)</h2>
        }
        else
        {
            <h2>@_f.tra("Role")</h2>
        }
        @if (Model.lisRepeator.Count > 1)
        {
            <span class="ra-sum" id="@(_ra)sum">@_f.tra("obsazeno") <strong>@_filled</strong> / @Model.lisRepeator.Count</span>
        }
    </div>

    @for (int i = 0; i < Model.lisRepeator.Count(); i++)
    {
        var c = Model.lisRepeator[i];
        string mode = c.IsNone ? "none" : (c.x69IsAllUsers ? "all" : "sel");
        <div class="ra-row ra-@mode@(c.x67IsRequired ? " ra-req" : "")" id="@(_ra)row@(i)" data-ra="@(_ra)" data-i="@i">
            <div class="ra-name" role="button" tabindex="0" title="@_f.tra("Kliknutím obsadit / zrušit obsazení role")" onclick="ra_toggle('@(_ra)',@i)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();ra_toggle('@(_ra)',@i);}">
                <strong>@c.x67Name</strong>
                @if (c.x67IsRequired)
                {
                    <span class="ra-badge" title="@_f.tra("Role musí být obsazena")">@_f.tra("povinná")</span>
                }
            </div>

            <div class="ra-seg" role="radiogroup" aria-label="@c.x67Name">
                <input type="radio" name="@(_ra)mode@(i)" id="@(_ra)none@(i)" value="none" @(mode == "none" ? "checked" : "") onchange="ra_mode('@(_ra)',@i,'none')" /><label for="@(_ra)none@(i)">@(_lang_neobsazeno)</label>
                <input type="radio" name="@(_ra)mode@(i)" id="@(_ra)sel@(i)" value="sel" @(mode == "sel" ? "checked" : "") onchange="ra_mode('@(_ra)',@i,'sel')" /><label for="@(_ra)sel@(i)">@_f.tra("Vybraní")</label>
                <input type="radio" name="@(_ra)mode@(i)" id="@(_ra)all@(i)" value="all" @(mode == "all" ? "checked" : "") onchange="ra_mode('@(_ra)',@i,'all')" /><label for="@(_ra)all@(i)">@(_lang_vsichni)</label>
            </div>

            <div class="ra-who">
                <div class="ra-pick" id="@(_ra)pick@(i)">
                    <div class="ra-combo" id="divJ02@(i)" title="@_lang_uzivatele">
                        <span class="material-icons-outlined-nosize">person</span>
                        <mycombochecklist placeholder="@_lang_uzivatele" asp-for="@Model.lisRepeator[i].j02IDs" elementid-prefix="@(Model.elementidprefix)" entity="j02User" selectedtext="@Model.lisRepeator[i].Persons"></mycombochecklist>
                    </div>
                    <div class="ra-combo" id="divJ11@(i)" title="@_lang_tymy">
                        <span class="material-icons-outlined-nosize">groups</span>
                        <mycombochecklist placeholder="@_lang_tymy" asp-for="@Model.lisRepeator[i].j11IDs" entity="j11Team" elementid-prefix="@(Model.elementidprefix)" selectedtext="@Model.lisRepeator[i].Teams"></mycombochecklist>
                    </div>
                </div>
                <div class="ra-allnote"><span class="material-icons-outlined-nosize">public</span>@_f.tra("Roli mají všichni uživatelé")</div>
                <div class="ra-nonenote">@(c.x67IsRequired ? _f.tra("Povinnou roli je třeba obsadit.") : "–")</div>
            </div>

            <input type="hidden" asp-for="@Model.lisRepeator[i].IsNone" id="@(_ra)IsNone@(i)" value="@(c.IsNone ? "true" : "false")" />
            <input type="hidden" asp-for="@Model.lisRepeator[i].x69IsAllUsers" id="@(_ra)IsAll@(i)" value="@(c.x69IsAllUsers ? "true" : "false")" />
            <input type="hidden" asp-for="@Model.lisRepeator[i].x67ID" />
            <input type="hidden" asp-for="@Model.lisRepeator[i].x67Name" />
            <input type="hidden" asp-for="@Model.lisRepeator[i].x67Entity" />
            <input type="hidden" asp-for="@Model.lisRepeator[i].x67IsRequired" />
        </div>
    }
</section>

<script type="text/javascript">
    // přepnutí režimu role: none = neobsazeno, sel = vybraní uživatelé/týmy, all = všichni uživatelé
    function ra_mode(ra, i, mode) {
        const row = document.getElementById(ra + "row" + i);
        if (!row) return;
        row.classList.remove("ra-none", "ra-sel", "ra-all");
        row.classList.add("ra-" + mode);
        document.getElementById(ra + "IsNone" + i).value = mode === "none" ? "true" : "false";
        document.getElementById(ra + "IsAll" + i).value = mode === "all" ? "true" : "false";
        const sum = document.getElementById(ra + "sum");
        if (sum) {
            const host = document.getElementById(ra);
            sum.querySelector("strong").textContent = host.querySelectorAll(".ra-row:not(.ra-none)").length;
        }
    }
    // klik na název role: neobsazeno → vybraní (otevře výběr uživatelů), obsazeno → neobsazeno (výběr zůstane uložený v poli, jen se nepoužije)
    function ra_toggle(ra, i) {
        const row = document.getElementById(ra + "row" + i);
        if (!row) return;
        const mode = row.classList.contains("ra-none") ? "sel" : "none";
        document.getElementById(ra + mode + i).checked = true;
        ra_mode(ra, i, mode);
        if (mode === "sel") {
            const btn = row.querySelector(".ra-combo .mcl-button");
            const hasVal = Array.from(row.querySelectorAll(".ra-pick input[type=hidden]")).some(x => x.value);
            if (btn && !hasVal) setTimeout(() => btn.click(), 0);
        }
    }
    // zpětná kompatibilita (dříve zaškrtávátka chkNone/chkAll)
    function isnone_change(chk, index) {
        ra_mode("@(_ra)", index, $(chk).prop("checked") ? "none" : "sel");
    }
    function allpersons_change(chk, index) {
        ra_mode("@(_ra)", index, $(chk).prop("checked") ? "all" : "sel");
    }
</script>
