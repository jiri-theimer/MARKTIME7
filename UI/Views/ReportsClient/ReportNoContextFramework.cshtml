@model UI.Models.ReportNoContextFrameworkViewModel
@inject BL.Factory _f

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    Model.PageTitle = _f.tra("Pevné tiskové sestavy");
    int _selJ25 = Model.SelectedReport != null ? Model.SelectedReport.j25ID : -1;
}

@addTagHelper *, UI

@section header_content {
    <link rel="stylesheet" href="~/css/reportsframework.css" asp-append-version="true" />
}

<div class="rf-bar">
    <button class="btn bog rf-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#reportsPanel" title="@_f.tra("Zobrazit / skrýt nabídku sestav")">
        <span class="material-icons-outlined-btn">menu</span> @_f.tra("Tiskové sestavy")
    </button>
    <div class="rf-current">
        <span id="spanX31Name" class="rf-current-name">@_f.tra("Vyberte tiskovou sestavu")…</span>
        <span id="spanX31Code" class="rf-current-code"></span>
    </div>
</div>

<div class="app-shell">

    @* ------------------------------------------------------------ levý panel *@
    <div class="offcanvas offcanvas-start rf-panel" tabindex="-1" data-bs-scroll="true" data-bs-backdrop="false" data-bs-keyboard="false" id="reportsPanel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">@_f.tra("Tiskové sestavy")</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="rf-search">
            <div class="position-relative">
                <span class="material-icons-outlined-nosize rf-search-ico">search</span>
                <input type="search" id="rf_search" class="form-control form-control-sm" autocomplete="off"
                       placeholder="@_f.tra("Hledat sestavu…")" title="@_f.tra("Hledá v názvu, kódu, popisu a kategorii. Enter otevře první nalezenou.")" />
            </div>
            <div id="rf_search_info" class="rf-search-info" aria-live="polite"></div>
        </div>

        <div class="offcanvas-body p-0 m-0">
            @if (!Model.lisX31.Any())
            {
                <div class="rf-empty">@_f.tra("Nemáte k dispozici žádnou tiskovou sestavu.")</div>
            }
            <div id="rf_list" class="rf-list">
                @foreach (var recJ25 in Model.lisJ25.OrderBy(p => p.j25Ordinary).ThenBy(p => p.j25Name))
                {
                    <details class="rf-cat" data-cat="@recJ25.j25Name" open="@(recJ25.pid == _selJ25)">
                        <summary>@recJ25.j25Name</summary>
                        <ul>
                            @foreach (var c in Model.lisX31.Where(p => p.j25ID == recJ25.pid))
                            {
                                <li>
                                    <button type="button" class="rf-item" id="report@(c.pid)"
                                            data-id="@c.pid" data-name="@c.x31Name" data-code="@c.x31Code" data-format="@c.FormatName"
                                            title="@c.x31Code">
                                        <span class="rf-item-name">@c.x31Name</span>
                                        @if (c.x31FormatFlag == BO.x31FormatFlagENUM.XLSX)
                                        {
                                            <img src="/images/files/excel.png" width="18" height="18" alt="XLSX" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(c.x31Description))
                                        {
                                            <span class="rf-item-desc">@c.x31Description</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------------------ pravá část *@
    <div id="reportArea" class="report-area">
        <iframe id="fra1" scrolling="no"></iframe>
        <input type="hidden" id="j72id" />
    </div>
</div>

@{
    var _rfConfig = new
    {
        callerPrefix = Model.caller_prefix ?? "",
        callerPids = Model.caller_pids ?? "",
        selected = Model.SelectedReport != null ? Model.SelectedReport.pid : 0,
        txt = new
        {
            choose = _f.tra("Vyberte tiskovou sestavu") + "…",
            hits = _f.tra("Nalezeno"),
            noHits = _f.tra("Nic nenalezeno.")
        }
    };
}
@* výchozí System.Text.Json escapuje < > & ' – bezpečné uvnitř <script> *@
<script type="text/javascript">window._rf = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_rfConfig));</script>
<script src="~/js/reportsframework.js" asp-append-version="true"></script>
