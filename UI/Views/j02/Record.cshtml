@model UI.Models.Record.j02Record
@inject BL.Factory _f

@{

    Layout = "~/Views/Shared/_LayoutRecord.cshtml";
    if (Model.Rec == null) return;
    Model.PageTitle = _f.tra("Karta uživatele");
    if (Model.RecJ04 != null)
    {
        Model.PageTitle = Model.RecJ04.j04Name;
    }
    string _FirstTabCaption = Model.PageTitle;
    if (Model.rec_pid > 0)
    {
        Model.PageTitle += ": " + Model.Rec.FullNameAsc;
    }
    string _initials = ((Model.Rec.j02FirstName ?? "").Trim().Length > 0 ? Model.Rec.j02FirstName.Trim().Substring(0, 1) : "")
                     + ((Model.Rec.j02LastName ?? "").Trim().Length > 0 ? Model.Rec.j02LastName.Trim().Substring(0, 1) : "");
    if (_initials == "") { _initials = "?"; }



}
@addTagHelper *, UI

@section header_content
{
    <link rel="stylesheet" href="~/css/recordform.css" asp-append-version="true" />
}




<div class="tabs_container_record">
    <!-- Tab panes -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab1" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab1">@_FirstTabCaption</a>
        </li>

        @if (Model.ff1.VisibleInputsCount > 0)
        {
            <li class="nav-item onetab" role="presentation">
                <a id="link_tab3" class="nav-link" tabindex="-1" data-bs-toggle="tab" role="tab" href="#tab3">@_f.tra("Uživatelská pole") (@Model.ff1.VisibleInputsCount)</a>
            </li>
        }

        <li class="nav-item onetab" role="presentation">
            <a id="link_tab4" class="nav-link" tabindex="-1" data-bs-toggle="tab" role="tab" href="#tab4">@_f.tra("Různé")</a>
        </li>

        
    </ul>
</div>



@Html.Raw("<div class='modal_record_container_flexi'>")
@Html.Raw("<div class='tab-content'>")


<div class="tab-pane tab-pane-fixed" id="tab1" role="tabpanel">
    <!-- Tab1 – verze 8: moderní vzhled (třídy rf-*), názvy polí a id beze změny -->
    <div class="rf">

        <section class="rf-card">
            <div class="rf-names">
                <div class="rf-avatar" aria-hidden="true">@_initials</div>
                <div class="rf-field rf-w-s">
                    <label for="Rec_j02TitleBeforeName">@_f.tra("Titul")</label>
                    <input class="form-control" asp-for="Rec.j02TitleBeforeName" />
                </div>
                <div class="rf-field">
                    <label for="Rec_j02FirstName">@_f.tra("Křestní jméno")</label>
                    <input class="form-control" asp-for="Rec.j02FirstName" />
                </div>
                <div class="rf-field">
                    <label for="Rec_j02LastName">@_f.tra("Příjmení")</label>
                    <input class="form-control record_name" asp-for="Rec.j02LastName" />
                </div>
                <div class="rf-field rf-w-s">
                    <label for="Rec_j02TitleAfterName">@_f.tra("Za jménem")</label>
                    <input class="form-control" asp-for="Rec.j02TitleAfterName" />
                </div>
            </div>
        </section>

        <div class="rf-grid">
            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">lock</span>@_f.tra("Přihlášení a oprávnění")</h2>

                @if (Model.rec_pid > 0 && !Model.IsChangeLogin)
                {
                    <div class="rf-row">
                        <label class="rf-label">@_f.tra("Uživatelské jméno")</label>
                        <div class="rf-value"><myval value="@Model.Rec.j02Login"></myval></div>
                        <input type="hidden" asp-for="Rec.j02Login" />
                    </div>
                }
                @if (Model.rec_pid == 0 || Model.IsChangeLogin)
                {
                    <div class="rf-box">
                        <div class="rf-field">
                            <label for="Rec_j02Login">@_f.tra("Nové uživatelské jméno")</label>
                            <input class="form-control" asp-for="@Model.Rec.j02Login" value="@Model.Rec.j02Login" placeholder="@_f.tra("Login")" />
                        </div>
                    </div>
                }
                @if (Model.IsDefinePassword)
                {
                    <div id="divNewPwd" class="rf-box">
                        <div class="rf-field">
                            <label for="NewPassword">@_f.tra("Nové přístupové heslo")</label>
                            <div class="rf-inline">
                                <input class="form-control" autocomplete="off" asp-for="@Model.NewPassword" value="@Model.NewPassword" />
                                <button type="button" tabindex="-1" class="btn btn-sm btn-light" title="@_f.tra("Navrhnout jiné heslo")" onclick="_postback('newpwd')"><myicon symbol="refresh"></myicon></button>
                            </div>
                        </div>
                        <div class="rf-field">
                            <label for="VerifyPassword">@_f.tra("Ověření nového hesla")</label>
                            <input class="form-control" autocomplete="off" asp-for="@Model.VerifyPassword" value="@Model.VerifyPassword" />
                        </div>
                    </div>
                }

                <div class="rf-row">
                    <label for="cmdComboRec_j04ID" class="rf-label">@_f.tra("Aplikační role")</label>
                    <div class="rf-value">
                        @if (_f.CurrentUser.IsAdmin)
                        {
                            <mycombo entity="j04UserRole" asp-for="Rec.j04ID" selectedtext="@Model.ComboJ04Name" view-flag="2" event_after_changevalue="j04id_change"></mycombo>
                        }
                        else
                        {
                            <myval value="@Model.ComboJ04Name"></myval>
                            <input type="hidden" asp-for="Rec.j04ID" />
                        }
                    </div>
                </div>

                <div class="rf-row">
                    <label for="Rec_j02TwoFactorVerifyFlag" class="rf-label">@_f.tra("2-faktorové SMS ověření")</label>
                    <div class="rf-value">
                        <select asp-for="@Model.Rec.j02TwoFactorVerifyFlag" class="form-select">
                            <option value="None">@_f.tra("Nevyžadovat")</option>
                            <option value="AlwaysAfterLogin">@_f.tra("Vyžadovat při každém přihlášení")</option>
                            <option value="IfChangedUserAgend">@_f.tra("Vyžadovat po změně prohlížeče nebo lokality")</option>
                        </select>
                    </div>
                </div>

                @if (Model.Rec.j02IsLoginAutoLocked)
                {
                    <div class="rf-alert">
                        <span class="material-icons-outlined-nosize">lock_clock</span>
                        <div>
                            <strong>@_f.tra("Zablokovaný účet")</strong>
                            <div>@_f.tra("Došlo k automatickému zablokování účtu po neúspěšných pokusech o přihlášení do aplikace!")</div>
                            <button type="button" onclick="_postback('unblock')" class="btn btn-sm btn-primary mt-2">@_f.tra("Odblokovat účet")</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rf-row">
                        <span class="rf-label">@_f.tra("Stav účtu")</span>
                        <div class="rf-value">
                            <div class="rf-seg rf-seg-state" role="radiogroup">
                                <input type="radio" tabindex="-1" value="False" id="IsLoginManualLockedFalse" asp-for="@Model.Rec.j02IsLoginManualLocked" onchange="_postback()" /><label for="IsLoginManualLockedFalse">@_f.tra("Otevřený pro přihlašování")</label>
                                <input type="radio" tabindex="-1" value="True" id="IsLoginManualLockedTrue" asp-for="@Model.Rec.j02IsLoginManualLocked" onchange="_postback()" /><label for="IsLoginManualLockedTrue" class="rf-seg-off">@_f.tra("Uzavřený")</label>
                            </div>
                        </div>
                    </div>
                    <div class="rf-row">
                        <span class="rf-label"></span>
                        <div class="rf-value form-check">
                            <input type="checkbox" tabindex="-1" class="form-check-input" asp-for="@Model.Rec.j02IsMustChangePassword" />
                            <label class="form-check-label" for="Rec_j02IsMustChangePassword">@_f.tra("Uživatel si musí změnit heslo")</label>
                        </div>
                    </div>
                    @if (_f.CurrentUser.IsAdmin && (!Model.IsDefinePassword || (Model.rec_pid > 0 && !Model.IsChangeLogin)))
                    {
                        <div class="rf-actions">
                            @if (!Model.IsDefinePassword)
                            {
                                <button id="cmdNewPassword" tabindex="-1" type="button" class="btn btn-sm bog" onclick="_postback('newpwd')"><span class="material-icons-outlined-btn">password</span> @_f.tra("Vygenerovat nové přístupové heslo")</button>
                            }
                            @if (Model.rec_pid > 0 && !Model.IsChangeLogin)
                            {
                                <button id="cmdChangeLogin" tabindex="-1" type="button" class="btn btn-sm bog" onclick="_postback('changelogin')"><span class="material-icons-outlined-btn">badge</span> @_f.tra("Změnit uživatelské jméno")</button>
                            }
                        </div>
                    }
                }
            </section>

            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">contact_mail</span>@_f.tra("Kontakt a zařazení")</h2>
                <div class="rf-row">
                    <label for="Rec_j02Email" class="rf-label">@_f.tra("E-mail")</label>
                    <div class="rf-value"><input class="form-control" type="email" asp-for="Rec.j02Email" /></div>
                </div>
                <div class="rf-row">
                    <label for="Rec_j02Mobile" class="rf-label">@_f.tra("Mobil")</label>
                    <div class="rf-value"><input class="form-control" type="tel" asp-for="Rec.j02Mobile" /></div>
                </div>
                <div class="rf-row">
                    <label for="Rec_j02Code" class="rf-label">@_f.tra("Kód/Osobní číslo")</label>
                    <div class="rf-value"><input class="form-control" asp-for="Rec.j02Code" /></div>
                </div>
                <div class="rf-row">
                    <mylabel for="cmdComboRec_j07ID" class="rf-label" text="@_f.tra("Pozice")" tooltip="Pozice neovlivňuje oprávnění uživatele.<hr>Pro řízení oprávnění slouží [Aplikační role]."></mylabel>
                    <div class="rf-value"><mycombo entity="j07PersonPosition" asp-for="Rec.j07ID" selectedtext="@Model.ComboJ07Name" view-flag="2" event_after_changevalue="j07id_change"></mycombo></div>
                </div>
                <div class="rf-row">
                    <label for="cmdComboRec_c21ID" class="rf-label">@_f.tra("Pracovní fond")</label>
                    <div class="rf-value"><mycombo entity="c21FondCalendar" asp-for="Rec.c21ID" selectedtext="@Model.ComboC21Name" view-flag="2"></mycombo></div>
                </div>
                <div class="rf-row">
                    <mylabel explicit-for="cmdComboRec_j18ID" class="rf-label" text="@_f.tra("Středisko")" tooltip="Vazbu na středisko je možné nastavit v kartě uživatele (kde sedí na židli) a v kartě projektu."></mylabel>
                    <div class="rf-value"><mycombo entity="j18CostUnit" asp-for="Rec.j18ID" selectedtext="@Model.ComboJ18Name" view-flag="2"></mycombo></div>
                </div>
            </section>
        </div>

        <div class="rf-tags">
            <mystitky entity="j02User" asp-for="@Model.TagPids" tagnames="@Model.TagNames" taghtml="@Model.TagHtml" buttontext="@_f.tra("Oštítkovat")"></mystitky>
        </div>
    </div>
</div>



@if (Model.ff1.VisibleInputsCount > 0)
{
    <div class="tab-pane tab-pane-fixed" id="tab3" role="tabpanel">
        <!-- Tab3 -->
        @Html.EditorFor(m => m.ff1, "~/Views/Shared/_FreeFields.cshtml")

    </div>
}





<div class="tab-pane tab-pane-fixed" id="tab4" role="tabpanel">
    <!-- Tab4 -->
    <div class="rf">
        <div class="rf-grid">
            @if (_f.CurrentUser.j04IsModule_p31)
            {
                <section class="rf-card">
                    <h2><span class="material-icons-outlined-nosize">more_time</span>@_f.tra("Vykazování")</h2>
                    <div class="rf-row">
                        <label for="Rec_j02TimesheetEntryDaysBackLimit" class="rf-label">@_f.tra("Omezit zpětné vykazování hodin a kusovníku")</label>
                        <div class="rf-value">
                            <select asp-for="@Model.Rec.j02TimesheetEntryDaysBackLimit" class="form-select">
                                <option value="0">@_f.tra("Bez omezení")</option>
                                <option value="999">@_f.tra("Povolen pouze aktuální týden")</option>
                                <option value="1">-1 @_f.tra("den")</option>
                                <option value="2">-2 @_f.tra("dny")</option>
                                <option value="3">-3 @_f.tra("dny")</option>
                                <option value="4">-4 @_f.tra("dny")</option>
                                <option value="5">-5 @_f.tra("dní")</option>
                                <option value="6">-6 @_f.tra("dní")</option>
                                <option value="7">-7 @_f.tra("dní")</option>
                                <option value="8">-8 @_f.tra("dní")</option>
                                <option value="9">-9 @_f.tra("dní")</option>
                                <option value="10">-10 @_f.tra("dní")</option>
                                <option value="14">-14 @_f.tra("dní")</option>
                                <option value="20">-20 @_f.tra("dní")</option>
                                <option value="30">-30 @_f.tra("dní")</option>
                            </select>
                            <div class="mt-1">
                                <mycombochecklist asp-for="Rec.j02TimesheetEntryDaysBackLimit_p34IDs" entity="p34ActivityGroup" selectedtext="@Model.p34Names" myqueryinline="ismoneyinput|bool|0" placeholder="@_f.tra("Vybrané sešity")..."></mycombochecklist>
                            </div>
                        </div>
                    </div>
                    <div class="rf-row">
                        <label for="Rec_j02WorksheetOperFlag" class="rf-label">@_f.tra("Další omezení")</label>
                        <div class="rf-value">
                            <select asp-for="Rec.j02WorksheetOperFlag" class="form-select">
                                <option value="None"></option>
                                <option value="ZakazPrekrocitFond">@_f.tra("Zákaz vykázat hodiny nad denní fond")</option>
                                <option value="ZakazVidetVyuctovaneUkony">@_f.tra("Skrýt před uživatelem vyúčtované úkony")</option>
                                <option value="ZakazVidetSchvaleneiVyuctovane">@_f.tra("Skrýt schválené a vyúčtované úkony")</option>
                            </select>
                        </div>
                    </div>
                    <div class="rf-row">
                        <mylabel class="rf-label" text="@_f.tra("Preferovaný formát hodin")" tooltip="Systém bude uživateli zobrazovat hodiny buď v dekadickém formátu jako číslo s desetinnou čárkou nebo ve formátu HH:MM"></mylabel>
                        <div class="rf-value">
                            <select asp-for="Rec.j02DefaultHoursFormat" class="form-select">
                                <option value="N">@_f.tra("Dekadické číslo (např. 1,5)")</option>
                                <option value="T">@_f.tra("HH:MM (např. 01:30)")</option>
                            </select>
                        </div>
                    </div>
                    <div class="rf-row">
                        <label for="Rec_p72ID_NonBillable" class="rf-label">@_f.tra("Fakturační status pro vykázané Nefa hodiny")</label>
                        <div class="rf-value">
                            <select asp-for="Rec.p72ID_NonBillable" class="form-select">
                                <option value="0">@_f.tra("Rozhodne systém")</option>
                                <option value="6">@_f.tra("Zahrnout do paušálu")</option>
                                <option value="2">@_f.tra("Viditelný odpis")</option>
                                <option value="3">@_f.tra("Skrytý odpis")</option>
                            </select>
                        </div>
                    </div>
                    <div class="rf-row">
                        <mylabel class="rf-label" text="@_f.tra("Simulační nákladová sazba")" tooltip="Slouží k výpočtům ve výsledovkách."></mylabel>
                        <div class="rf-value rf-w-num"><mynumber asp-for="Rec.j02Plan_Internal_Rate" decimal-digits="2"></mynumber></div>
                    </div>
                </section>
            }

            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">draw</span>@_f.tra("Podpisy")</h2>
                <div class="rf-field">
                    <label for="Rec_j02EmailSignature">@_f.tra("Podpis pro e-mail zprávy")</label>
                    <textarea class="form-control" asp-for="Rec.j02EmailSignature" rows="3"></textarea>
                </div>
                <div class="rf-field">
                    <label for="Rec_j02InvoiceSignatureText">@_f.tra("Podpis do vystavené faktury")</label>
                    <textarea class="form-control" asp-for="Rec.j02InvoiceSignatureText" rows="3"></textarea>
                </div>
                <div class="rf-field">
                    <label>@_f.tra("Obrázek podpisu do faktury")</label>
                    <input type="hidden" asp-for="@Model.SignatureInvoiceFile" />
                    <input type="hidden" asp-for="@Model.Rec.j02InvoiceSignatureFile" value="@Model.Rec.j02InvoiceSignatureFile" />
                    <input type="hidden" asp-for="@Model.IsDeleteSignature" value="@Model.IsDeleteSignature" />
                    <input type="hidden" asp-for="@Model.UploadGuidSignature" />
                    @if (!string.IsNullOrEmpty(Model.SignatureInvoiceFile))
                    {
                        <div class="rf-sign">
                            <img src="@Model.SignatureInvoiceFile" />
                            <button type="button" id="cmdDeleteSignature" class="btn btn-sm btn-outline-danger" onclick="_postback('delete_signature');">@_f.tra("Odstranit obrázek")</button>
                        </div>
                    }
                    <iframe id="fraUpload" class="rf-upload" src="/FileUpload/SingleUpload?guid=@Model.UploadGuidSignature" frameborder="0" scrolling="yes"></iframe>
                </div>
            </section>

            <section class="rf-card">
                <h2><span class="material-icons-outlined-nosize">tune</span>@_f.tra("Ostatní")</h2>
                <div class="rf-row">
                    <label class="rf-label">@_f.tra("Kód státu")</label>
                    <div class="rf-value">@Html.EditorFor(m => m.Rec.j02CountryCode, "~/Views/Shared/_CountryCodeCombo.cshtml")</div>
                </div>
                @if (Model.UploadGuid != null)
                {
                    <iframe id="fraUpload" src="/Dropzone/UploadInFrame?recpid=@Model.rec_pid&entity=j02&guid=@Model.UploadGuid" frameborder="0" scrolling="yes" style="max-width:1200px;width:100%;height:60px;"></iframe>
                }
            </section>
        </div>
    </div>
</div>



@Html.Raw("</div>")
@Html.Raw("</div>")





<input type="hidden" asp-for="@Model.TempGuid" />
<input type="hidden" asp-for="@Model.UploadGuid" />
<input type="hidden" asp-for="@Model.IsDefinePassword" value="@Model.IsDefinePassword" />
<input type="hidden" asp-for="@Model.IsChangeLogin" value="@Model.IsChangeLogin" />
<input type="hidden" asp-for="@Model.Rec.j02IsLoginAutoLocked" />

<script type="text/javascript">
    $(document).ready(function () {

        

        myautocomplete_init_manual("Rec_j02TitleBeforeName", "@string.Join("|", Model.lisAutocomplete.Where(p => p.o15Flag == BO.AutoCompleteFlag.TitulPred).Select(p => p.o15Value))");
        myautocomplete_init_manual("Rec_j02TitleAfterName", "@string.Join("|", Model.lisAutocomplete.Where(p => p.o15Flag == BO.AutoCompleteFlag.TitulZa).Select(p => p.o15Value))");

    });

    function j07id_change(j07id) {
        _postback();
    }

    function j04id_change(j04id) {
        _postback("j04id");
    }

    function handle_delete_j14(guid) {
        _postback("delete-j14", "guid=" + guid);

    }

    function handle_delete_j15(guid) {
        _postback("delete-j15", "guid=" + guid);

    }

    function hardrefresh(pid, flag) {

        

        _postback();
    }
</script>
