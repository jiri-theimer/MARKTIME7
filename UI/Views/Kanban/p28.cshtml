@model UI.Models.Kanban.p28KanbanViewModel
@inject BL.Factory _f

@{

   
    Model.PageTitle = "KANBAN";

    
}

@addTagHelper *, UI

@section header_content {

    

}



<div class="input-group" style="margin-top:6px;margin-bottom:1px;">
    <div class="nonmobile nontablet">
        <ul class="nav nav-tabs">
            <li class="onetab">

                <a id="cmdMore" class="nav-link onetab-offcanvas" tabindex="-1" role="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_more">
                    <span class="onetab-caret"></span>
                    Kanban

                </a>

            </li>
        </ul>


    </div>

    <div class="dog">
        <select class="form-select" asp-for="viewtype" onchange="viewtype_onchange(this)">
            @foreach (var c in Model.viewtypes)
            {
                <option value="@c.Key">@c.Value</option>
            }
        </select>
    </div>

    <div class="dog">
        @Html.EditorFor(m => Model.TheGridQueryButton, "~/Views/Shared/_ButtonGridQuery.cshtml")

    </div>

    <div class="dog">
        @Html.EditorFor(m => Model.p31statequery, "~/Views/Shared/_p31StateQuery.cshtml")
    </div>

    <div class="dog">

        <a id="cmdp28" class="btn descreet_link_over_grid" href="@(new UI.Menu.TheMenuSupport(_f).GetMainmenuEntityUrl("p28"))">
            <span id="TheGridIcon" class="material-icons-outlined-btn">grid_view</span>
            GRID
        </a>

    </div>



    <div class="showmore dog" id="divQueryJ02" style="margin-left:10px;">
        <mycombochecklist asp-for="@Model.p29IDs" entity="p29ContactType" placeholder="@_f.tra("Typy kontaktu")" placeholder_icon="filter_alt" selectedtext="@Model.SelectedP29Names" event_after_changevalue="handle_can_reload"></mycombochecklist>
    </div>

    


    <div class="dog">
        <button type="button" id="cmdRefresh" class="btn btn-primary" style="display:none;margin-left:10px;" onclick="save_setting_and_reload()">@_f.tra("Občerstvit")</button>
    </div>






</div>



@await Html.PartialAsync("~/Views/Shared/_kanban.cshtml", Model)

<!-- Nabídka Více -->
<div class="offcanvas offcanvas-start" tabindex="-1" data-bs-scroll="true" data-bs-backdrop="true" data-bs-keyboard="true" id="offcanvas_more">

    <div class="offcanvas-header">
        <h5 class="offcanvas-title">
            <a href="javascript:reload()" title="Občerstvit">
                <myicon symbol="refresh"></myicon>
            </a>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body p-0 m-0" id="offcanvas_more_body">

        

        Kanban kontaktů

    </div>
</div>




<script type="text/javascript">

     $(document).ready(function () {

        

        

         register_menu("cmdgridquerymenu", "cmdgridquerymenu_menu", "/Menu/grid_query?prefix=p28&j72id=@(Model.TheGridQueryButton.j72id)");

         $("#SelectedJ72ID").mouseover(function (e) {
             $("#cmdQueryBuilder").css("visibility", "visible");

         });

         $("#cmdQueryBuilder").children().mouseout(function (e) {
             $("#cmdQueryBuilder").css("visibility", "hidden");

         });




     });


 
     function cm(e, pid)
     {
             _cm(e, "p28Contact", pid);
     }

     function edit(pid)
     {
         _edit("p28", pid, "Záznam");
     }



     function reload() {

         _redirect(location.href);
     }

    

     function reload_setting(opg) {


         $.post(_ep("/Common/SetUserParam"), { key: "kanban-groupby", value: opg.value }, function (data) {
             reload();

         });
     }

     function handle_can_reload(s) {
         $("#cmdRefresh").css("display", "block");
     }

     function save_setting_and_reload()
     {
         var k = [];
         var v = [];
         k.push("kanban-p28-p29IDs");
         v.push($("#p29IDs").val());

    
         $.post("/Common/SetUserParams", { keys: k, values: v }, function (data) {

         reload();

         });



     }

   


     function viewtype_onchange(cbx)
     {

     
       $.post(_ep("/Common/SetUserParam"), { key: "kanban-p28-viewtype", value: cbx.value }, function (data) {
         reload();
       });


    }

</script>

