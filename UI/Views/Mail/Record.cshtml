@model UI.Models.Mail.x40RecMessage
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Poštovní zpráva");
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    Model.PageSymbol = "mail";

    var r = Model.Rec;
    string _stateCss = r.x40Status switch
    {
        BO.x40StateENUM.IsProceeded => "mr-ok",
        BO.x40StateENUM.IsError => "mr-bad",
        BO.x40StateENUM.InQueque => "mr-wait",
        _ => "mr-neutral"
    };

    //tělo zprávy: přednostně z eml (přesně to, co odešlo – kostra, podpis, tabulka), jinak z databáze
    string _html = null;
    string _text = null;
    bool _fromEml = false;
    if (Model.Mail != null)
    {
        if (Model.Mail.HasBodyHtml) { _html = Model.Mail.BodyHtml; _fromEml = true; }
        else if (Model.Mail.HasBodyText) { _text = Model.Mail.BodyText; _fromEml = true; }
    }
    if (!_fromEml)
    {
        if (r.x40IsHtmlBody) { _html = r.x40Body; } else { _text = r.x40Body; }
    }
    //do iframe: odkazy do nového okna, bez skriptů (sandbox), základní písmo
    string _srcdoc = _html == null ? null : "<!doctype html><html><head><meta charset='utf-8'><base target='_blank'><style>body{font-family:Segoe UI,Arial,sans-serif;font-size:14px;margin:12px;color:#212529;word-wrap:break-word}img{max-width:100%;height:auto}</style></head><body>" + _html + "</body></html>";

    string _recAlias = (r.x40RecordEntity != null && r.x40RecordPid > 0) ? _f.CBL.GetObjectAlias(r.x40RecordEntity, r.x40RecordPid) : null;
    int _attCount = Model.Mail != null ? Model.Mail.Attachments.Count : 0;

    string _stateIcon = r.x40Status switch
    {
        BO.x40StateENUM.IsProceeded => "check_circle",
        BO.x40StateENUM.IsError => "error",
        BO.x40StateENUM.InQueque => "schedule",
        _ => "info"
    };

    //adresy: "Jméno <a@b.cz>; c@d.cz" → seznam pro chipy (zobrazí se max. _maxChips, zbytek „+N“)
    const int _maxChips = 6;
    List<(string Name, string Addr)> Parse(string s)
    {
        var res = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(s)) return res;
        foreach (var part in s.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            int lt = part.IndexOf('<'), gt = part.LastIndexOf('>');
            if (lt >= 0 && gt > lt) res.Add((part.Substring(0, lt).Trim().Trim('"'), part.Substring(lt + 1, gt - lt - 1).Trim()));
            else res.Add((null, part));
        }
        return res;
    }

    //prostý text: zakódovat a odkazy (http/https, e-mail) udělat klikací – jeden průchod, aby se odkazy nevnořovaly
    string Linkify(string t)
    {
        string enc = System.Net.WebUtility.HtmlEncode(t ?? "");
        return System.Text.RegularExpressions.Regex.Replace(enc,
            @"(?<url>\bhttps?://[^\s<>""']+?)(?=(&quot;|&#39;|&gt;|&lt;|[.,;:!?)\]])*(\s|$))|(?<mail>(?<![\w/.:=&;-])[\w.+-]+@[\w-]+(\.[\w-]+)+)",
            m => m.Groups["url"].Success
                ? $"<a href=\"{m.Value}\" target=\"_blank\" rel=\"noopener\">{m.Value}</a>"
                : $"<a href=\"mailto:{m.Value}\">{m.Value}</a>");
    }

    string AttIcon(string name)
    {
        string ext = System.IO.Path.GetExtension(name ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "picture_as_pdf",
            ".xls" or ".xlsx" or ".csv" => "table_chart",
            ".doc" or ".docx" or ".odt" or ".rtf" => "article",
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".bmp" or ".webp" => "image",
            ".zip" or ".7z" or ".rar" => "folder_zip",
            ".isdoc" or ".isdocx" or ".xml" => "code",
            _ => "description"
        };
    }
}

@addTagHelper *, UI
@section header_content
{
    <link rel="stylesheet" href="~/css/sendmail.css" asp-append-version="true" />
}

<div class="bg-light sm-toolbar">
    @if (Model.IsEmlFileExists)
    {
        <button type="button" class="btn btn-primary" onclick="clone()"><span class="material-icons-outlined-btn">forward_to_inbox</span>@_f.tra("Zkopírovat do nové zprávy")</button>
    }
    @if (r.x40Status != BO.x40StateENUM.InQueque && Model.IsEmlFileExists)
    {
        <button type="button" class="btn btn-light" onclick="eml()" title="@_f.tra("Otevřít v poštovním programu")"><span class="material-icons-outlined-btn">download</span>.eml (@(BO.Code.Bas.FormatFileSize(r.x40EmlFileSize)))</button>
    }
    <button type="button" class="btn btn-light" onclick="logfile()"><span class="material-icons-outlined-btn">receipt_long</span>@_f.tra("SMTP log")</button>
    @if (_f.CurrentUser.IsAdmin)
    {
        <button type="button" id="cmdDelete" class="btn btn-outline-danger"><span class="material-icons-outlined-btn">delete</span><span>@_f.tra("Odstranit")</span></button>
    }
    <button type="button" class="btn btn-light ms-auto" onclick="_window_close()"><span class="material-icons-outlined-btn">close</span>@_f.tra("Zavřít")</button>
</div>

<div class="modal_record_container sm mr">

    @if (r.x40ErrorMessage != null)
    {
        <div class="mr-error">
            <span class="material-icons-outlined-nosize">error</span>
            <div>
                <b>@_f.tra("Zprávu se nepodařilo odeslat")</b>
                <code>@r.x40ErrorMessage</code>
            </div>
        </div>
    }

    <div class="sm-head mr-card">
        <div class="mr-subject-row">
            <h1 class="mr-subject">@(string.IsNullOrWhiteSpace(r.x40Subject) ? _f.tra("(bez předmětu)") : r.x40Subject)</h1>
            <span class="mr-state @_stateCss"><span class="material-icons-outlined-nosize">@_stateIcon</span>@_f.tra(r.StatusAlias)</span>
        </div>

        <div class="sm-row">
            <label class="sm-lab">@_f.tra("Od")</label>
            <div class="sm-val">
                <span class="mr-person"><b>@r.x40SenderName</b> <span class="mr-addr">&lt;@r.x40SenderAddress&gt;</span></span>
                @if (Model.Creator != null)
                {
                    <span class="mr-meta">· @_f.tra("odeslal") @Model.Creator.FullNameAsc</span>
                }
            </div>
        </div>
        @foreach (var grp in new[] { (Label: _f.tra("Komu"), List: Parse(r.x40Recipient)), (Label: _f.tra("Kopie"), List: Parse(r.x40CC)), (Label: _f.tra("Skrytá kopie"), List: Parse(r.x40BCC)) })
        {
            if (grp.List.Count == 0 && grp.Label != _f.tra("Komu")) { continue; }
            <div class="sm-row">
                <label class="sm-lab">@grp.Label</label>
                <div class="sm-val mr-chips">
                    @for (int i = 0; i < grp.List.Count; i++)
                    {
                        var a = grp.List[i];
                        <span class="mr-chip @(i >= _maxChips ? "mr-more" : null)" title="@a.Addr">
                            @if (!string.IsNullOrEmpty(a.Name))
                            {
                                <b>@a.Name</b> <span class="mr-addr">@a.Addr</span>
                            }
                            else
                            {
                                @a.Addr
                            }
                        </span>
                    }
                    @if (grp.List.Count > _maxChips)
                    {
                        <button type="button" class="mr-chip mr-chip-more" onclick="mr_show_all(this)">+@(grp.List.Count - _maxChips) @_f.tra("dalších")</button>
                    }
                </div>
            </div>
        }
        <div class="sm-row">
            <label class="sm-lab">@(r.x40DatetimeProcessed == null ? _f.tra("Vytvořeno") : _f.tra("Odesláno"))</label>
            <div class="sm-val">
                @if (r.x40DatetimeProcessed != null)
                {
                    @r.x40DatetimeProcessed.Value.ToString("d.M.yyyy HH:mm")
                }
                else if (r.DateInsert != null)
                {
                    @r.DateInsert.Value.ToString("d.M.yyyy HH:mm")
                }
                else
                {
                    @("–")
                }
                @if (_recAlias != null)
                {
                    <span class="mr-meta">· @_f.tra("k záznamu") <a href="/Record/RecPage?prefix=@(r.x40RecordEntity.Substring(0, 3))&pid=@(r.x40RecordPid)" target="_blank" rel="noopener">@_recAlias</a></span>
                }
            </div>
        </div>

        @if (_attCount > 0)
        {
            <div class="sm-row">
                <label class="sm-lab"><span class="material-icons-outlined-nosize">attach_file</span></label>
                <div class="sm-val mr-atts">
                    @for (int i = 0; i < _attCount; i++)
                    {
                        var att = Model.Mail.Attachments[i];
                        string name = string.IsNullOrWhiteSpace(att.FileName) ? _f.tra("příloha") + " " + (i + 1) : att.FileName.Trim();
                        <a class="mr-att" href="/Mail/DownloadAttachment?guid=@(r.x40MessageGuid)&index=@i" title="@_f.tra("Stáhnout") @name">
                            <span class="material-icons-outlined-nosize">@AttIcon(name)</span><span class="mr-att-name">@name</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mr-body">
        @if (_srcdoc != null)
        {
            <iframe id="fraBody" class="mr-frame" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="@_srcdoc" title="@_f.tra("Text zprávy")"></iframe>
        }
        else if (!string.IsNullOrEmpty(_text))
        {
            <pre class="mr-text">@Html.Raw(Linkify(_text))</pre>
        }
        else
        {
            <div class="sm-muted p-3">@_f.tra("Zpráva nemá žádný text.")</div>
        }
    </div>

    @if (!_fromEml)
    {
        @* bez eml: tabulku a podpis skládáme z databáze (jak by vypadaly při odeslání) *@
        <div class="mr-note">
            <span class="material-icons-outlined-nosize">info</span>
            @(r.x40Status == BO.x40StateENUM.InQueque ? _f.tra("Zpráva čeká na odeslání – zobrazen text před odesláním.") : _f.tra("Soubor odeslané zprávy (.eml) není k dispozici – zobrazen text uložený v databázi."))
        </div>

        @if (Model.lisGridColumns != null && Model.lisGridColumns.Count() > 0)
        {
            <div class="sm-grid mb-2">
                <div class="sm-section-head"><span class="material-icons-outlined-nosize">table_rows</span>@_f.tra("Tabulka pod textem zprávy")</div>
                <table class="table table-sm sm-grid-table">
                    @foreach (var col in Model.lisGridColumns)
                    {
                        <tr>
                            <td class="tdlab">@(col.Header)</td>
                            <td class="tdval">@(Html.Raw(col.Rezerva))</td>
                        </tr>
                    }
                </table>
            </div>
        }

        @if (r.x40IsUserSignature && Model.Creator != null && !string.IsNullOrWhiteSpace(Model.Creator.j02EmailSignature))
        {
            <div class="sm-signature">@Html.Raw(BO.Code.Bas.Text2Html(Model.Creator.j02EmailSignature))</div>
        }
    }
</div>

<script type="text/javascript">
    var _mr_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { sure = _f.tra("Opravdu? Klikněte znovu") }));

    $(document).ready(function () {
        //výška iframe podle obsahu (sandbox bez skriptů, ale stejný původ → lze změřit)
        var fr = document.getElementById("fraBody");
        if (fr) {
            var fit = function () {
                try {
                    var d = fr.contentDocument;
                    if (d && d.body) fr.style.height = Math.max(120, d.documentElement.scrollHeight + 4) + "px";
                } catch (e) { }
            };
            fr.addEventListener("load", function () {
                fit();
                try { Array.prototype.forEach.call(fr.contentDocument.images, function (img) { img.addEventListener("load", fit); }); } catch (e) { }
            });
            $(window).on("resize", fit);
        }

        //odstranění: první klik se zeptá v tlačítku, druhý provede (bez confirm dialogu)
        var $d = $("#cmdDelete"), timer = null;
        $d.on("click", function () {
            if ($d.data("armed")) {
                clearTimeout(timer);
                $d.prop("disabled", true);
                $.post("/Mail/Delete", { x40id: "@(r.pid)" }, function () {
                    if (window.parent && window.parent.hardrefresh) window.parent.hardrefresh("0");
                    _window_close();
                });
                return;
            }
            var html = $d.html();
            $d.data("armed", true).removeClass("btn-outline-danger").addClass("btn-danger").find("span").last().text(_mr_txt.sure);
            timer = setTimeout(function () { $d.data("armed", false).removeClass("btn-danger").addClass("btn-outline-danger").html(html); }, 4000);
        });
    });

    function mr_show_all(btn) {     //„+N dalších“ adresátů
        $(btn).closest(".mr-chips").find(".mr-more").removeClass("mr-more");
        $(btn).remove();
    }

    function eml() {
        location.replace("/Mail/DownloadEmlFile?guid=@r.x40MessageGuid");
    }
    function logfile() {
        window.open("/Mail/DownloadSmtpLog?guid=@r.x40MessageGuid", "_blank");
    }
    function clone() {
        location.replace("/Mail/Sendmail?x40id=@r.pid");
    }
</script>
