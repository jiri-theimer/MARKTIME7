@model UI.Models.Mail.SendMailViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Odeslat poštovní zprávu");
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    Model.PageSymbol = "email";

    var recJ02 = _f.j02UserBL.Load(_f.CurrentUser.pid);
    var _podpis = BO.Code.Bas.Text2Html(recJ02.j02EmailSignature);

    if (Model.Rec.x40RecordEntity != null && Model.Rec.x40RecordPid > 0)
    {
        Model.PageTitleAfter = _f.CBL.GetObjectAlias(Model.Rec.x40RecordEntity, Model.Rec.x40RecordPid);
    }

    bool _hasRecord = Model.Rec.x40RecordEntity != null && Model.Rec.x40RecordEntity != "j02";
    string _recAlias = _hasRecord ? BO.Code.Entity.GetAlias(Model.Rec.x40RecordEntity) : null;
    bool _showTemplates = _hasRecord && Model.Rec.x40RecordPid > 0 && Model.b05ID == 0 && !_f.CurrentUser.IsPortalUserOnly();
    bool _showCc = !string.IsNullOrEmpty(Model.Rec.x40CC) || !string.IsNullOrEmpty(Model.Rec.x40BCC);
    bool _hasJ61Recipients = !string.IsNullOrEmpty(Model.Rec.x40TO_j61) || !string.IsNullOrEmpty(Model.Rec.x40CC_j61) || !string.IsNullOrEmpty(Model.Rec.x40BCC_j61);
}

@addTagHelper *, UI
@section header_content {
    @if (Model.Notepad.SelectedX04ID > 0)
    {
        <link href="~/lib/froala-editor/css/froala_editor.pkgd.min.css" rel="stylesheet" type="text/css" />
    }
    <link rel="stylesheet" href="~/css/sendmail.css" asp-append-version="true" />
}

<script src="~/js/mailrecipients.js" asp-append-version="true"></script>

<div class="bg-light sm-toolbar">
    <button id="cmdSave" type="submit" class="btn btn-success" onclick="_submit()"><span class="material-icons-outlined-btn">send</span>@_f.tra("Odeslat")</button>
    <button type="button" id="cmdClose" onclick="_window_close()" class="btn btn-light"><span class="material-icons-outlined-btn">close</span>@_f.tra("Zavřít")</button>
    <label class="sm-test" title="@_f.tra("Zpráva se uloží do OUTBOXu, ale neodešle se")">
        <input type="checkbox" id="chkIsTest" asp-for="@Model.IsTest" form="form1" /> @_f.tra("Testovací zpráva")
    </label>
</div>

<form id="form1" asp-controller="Mail" asp-action="SendMail" method="POST">

    <input type="hidden" asp-for="UploadGuid" />
    <input type="hidden" asp-for="Rec.x40MessageGuid" />
    <input type="hidden" asp-for="Rec.x40RecordEntity" />
    <input type="hidden" asp-for="Rec.x40RecordPid" />
    <input type="hidden" asp-for="ActiveTabIndex" />
    <input type="hidden" asp-for="b05ID" />
    <input type="hidden" asp-for="j61MailBody" value="@Model.j61MailBody" />
    <input type="hidden" asp-for="j61GridColumns" value="@Model.j61GridColumns" />

    <div class="modal_record_container sm">

        @* ------------------------------------------------ hlavička zprávy *@
        <div class="sm-head">
            <div class="sm-row">
                <label class="sm-lab">@_f.tra("Od")</label>
                <div class="sm-val sm-from">
                    <mycombo entity="j40MailAccount" asp-for="Rec.j40ID" selectedtext="@Model.SelectedJ40Name" view-flag="2" myqueryinline="is4sendmail|bool|1"></mycombo>
                    <select class="form-select nonmobile sm-skeleton" asp-for="Rec.x40SkeletonFile" title="@_f.tra("Kostra (HTML šablona) zprávy")">
                        <option value="">@_f.tra("Výchozí kostra")</option>
                        <option value="send_message_template.html">send_message_template.html</option>
                        <option value="send_message_template_plain.html">send_message_template_plain.html</option>
                        <option value="send_message_template_dayline.html">DAYLINE</option>
                        <option value="send_message_template_htmltable.html">TABLE</option>
                        <option value="send_message_template_calendar.html">CALENDAR</option>
                        <option value="send_message_template_grid.html">GRID</option>
                    </select>
                </div>
            </div>

            <div class="sm-row">
                <label class="sm-lab" for="Recipient">@_f.tra("Komu")</label>
                <div class="sm-val">
                    <div class="sm-to">
                        <input class="form-control" asp-for="Recipient" value="@Model.Recipient" autocomplete="off" placeholder="@_f.tra("E-mailové adresy oddělené čárkou")" />
                        <div class="sm-to-links">
                            <a href="javascript:sm_toggle('#divCc')" id="lnkCc" class="@(_showCc ? "sm-on" : null)">@_f.tra("Kopie")</a>
                            <a href="javascript:sm_toggle('#divPoziceTym')" id="lnkGroups" title="@_f.tra("Vložit příjemce podle pozice nebo týmu")"><span class="material-icons-outlined-nosize">group_add</span></a>
                        </div>
                    </div>
                </div>
            </div>

            <div id="divPoziceTym" class="sm-row sm-sub" style="display:none;">
                <label class="sm-lab"></label>
                <div class="sm-val sm-groups">
                    <div>
                        <small>@_f.tra("Přidat všechny s pozicí")</small>
                        <mycombo entity="j07PersonPosition" asp-for="SelectedJ07ID" selectedtext="@Model.SelectedJ07Name" view-flag="2" event_after_changevalue="j07id_onchange"></mycombo>
                    </div>
                    <div>
                        <small>@_f.tra("Přidat všechny z týmu")</small>
                        <mycombo entity="j11Team" asp-for="@Model.SelectedJ11ID" selectedtext="@Model.SelectedJ11Name" view-flag="2" event_after_changevalue="j11id_onchange"></mycombo>
                    </div>
                </div>
            </div>

            <div id="divCc" style="@(_showCc ? null : "display:none;")">
                <div class="sm-row">
                    <label class="sm-lab" for="Rec_x40CC">@_f.tra("Kopie")</label>
                    <div class="sm-val"><input class="form-control" asp-for="Rec.x40CC" value="@Model.Rec.x40CC" /></div>
                </div>
                <div class="sm-row">
                    <label class="sm-lab" for="Rec_x40BCC">@_f.tra("Skrytá kopie")</label>
                    <div class="sm-val"><input class="form-control" asp-for="Rec.x40BCC" value="@Model.Rec.x40BCC" /></div>
                </div>
            </div>

            @* příjemci ze šablony zprávy (j61) – plní je výběr šablony; zobrazí se, jen když nějaké jsou *@
            <div id="divJ61Recipients" class="sm-row sm-sub" style="@(_hasJ61Recipients ? null : "display:none;")">
                <label class="sm-lab"></label>
                <div class="sm-val">
                    <div class="sm-j61">
                        <div class="sm-j61-head"><span class="material-icons-outlined-nosize">description</span>@_f.tra("Příjemci ze šablony zprávy (přidají se k ostatním)")</div>
                        <div class="sm-j61-grid">
                            <label for="Rec_x40TO_j61">@_f.tra("Komu")</label><input class="form-control form-control-sm" asp-for="Rec.x40TO_j61" value="@Model.Rec.x40TO_j61" />
                            <label for="Rec_x40CC_j61">@_f.tra("Kopie")</label><input class="form-control form-control-sm" asp-for="Rec.x40CC_j61" value="@Model.Rec.x40CC_j61" />
                            <label for="Rec_x40BCC_j61">@_f.tra("Skrytá kopie")</label><input class="form-control form-control-sm" asp-for="Rec.x40BCC_j61" value="@Model.Rec.x40BCC_j61" />
                        </div>
                    </div>
                </div>
            </div>

            @if (_showTemplates)
            {
                <div class="sm-row">
                    <label class="sm-lab">@_f.tra("Šablona")</label>
                    <div class="sm-val sm-template">
                        <mycombo entity="j61TextTemplate" asp-for="SelectedJ61ID" selectedtext="@Model.SelectedJ61Name" placeholder="@_f.tra("Bez šablony")" myqueryinline="entity|string|@(Model.Rec.x40RecordEntity)|MyRecordsDisponible|bool|1" event_after_changevalue="j61id_onchange"></mycombo>
                        @if (Model.SelectedJ61ID > 0)
                        {
                            <button type="button" class="btn btn-sm bog" onclick="j61_edit(@(Model.SelectedJ61ID))" title="@_f.tra("Upravit e-mail šablonu")"><span class="material-icons-outlined-btn">edit</span></button>
                        }
                        <button type="button" class="btn btn-sm bog" onclick="j61_create()" title="@_f.tra("Nová šablona")"><span class="material-icons-outlined-btn">add</span></button>
                    </div>
                </div>
            }

            <div class="sm-row">
                <label class="sm-lab" for="txtSubject">@_f.tra("Předmět")</label>
                <div class="sm-val"><input class="form-control sm-subject" asp-for="Rec.x40Subject" id="txtSubject" /></div>
            </div>
        </div>

        @* ------------------------------------------------ text zprávy *@
        <div class="sm-body">
            @Html.EditorFor(m => m.Notepad, "~/Views/Shared/_Notepad.cshtml")
        </div>

        <div id="divSignature" class="sm-signature" style="@(Model.Rec.x40IsUserSignature ? null : "display:none;")">
            @if (string.IsNullOrWhiteSpace(recJ02.j02EmailSignature))
            {
                <span class="sm-muted">@_f.tra("Podpis zatím nemáte vyplněný – nastavíte ho v Můj profil.")</span>
            }
            else
            {
                @Html.Raw(_podpis)
            }
        </div>

        @* ------------------------------------------------ volby *@
        <div class="sm-options">
            <label class="sm-chip">
                <input type="checkbox" asp-for="@Model.Rec.x40IsUserSignature" />
                <span class="material-icons-outlined-nosize">draw</span>@_f.tra("Můj podpis")
            </label>
            @if (_hasRecord)
            {
                <label class="sm-chip">
                    <input type="checkbox" asp-for="@Model.Rec.x40IsRecordLink" />
                    <span class="material-icons-outlined-nosize">link</span>@_f.tra("Odkaz na") @_recAlias
                </label>
            }
            @if (_hasRecord && Model.Rec.x40RecordPid > 0)
            {
                <label class="sm-chip">
                    <input type="checkbox" asp-for="@Model.IsShowGridColumns" onchange="_postback()" />
                    <span class="material-icons-outlined-nosize">table_rows</span>@_f.tra("Tabulka údajů z") @_recAlias
                </label>
            }
        </div>

        <div class="sm-bottom">
            <div class="sm-attach">
                <div class="sm-section-head"><span class="material-icons-outlined-nosize">attach_file</span>@_f.tra("Přílohy")</div>
                <iframe id="fraUpload" src="/FileUpload/DoUpload?entity=x40&guid=@Model.UploadGuid" frameborder="0" scrolling="yes"></iframe>
            </div>

            @if (Model.IsShowGridColumns)
            {
                <div class="sm-grid">
                    <div class="sm-section-head">
                        <span class="material-icons-outlined-nosize">table_rows</span>@_f.tra("Tabulka pod textem zprávy")
                        @if (!_f.CurrentUser.IsPortalUserOnly())
                        {
                            <button type="button" class="btn btn-sm bog ms-auto" onclick="grid_designer()"><span class="material-icons-outlined-btn">view_column</span> @_f.tra("Sloupce")</button>
                            <button type="button" onclick="_postback('j61id')" class="btn btn-sm bog" title="@_f.tra("Občerstvit")"><span class="material-icons-outlined-btn">refresh</span></button>
                        }
                    </div>
                    @if (Model.lisGridColumns != null && Model.lisGridColumns.Count() > 0)
                    {
                        <table class="table table-sm sm-grid-table">
                            @foreach (var col in Model.lisGridColumns)
                            {
                                <tr>
                                    <td class="tdlab">@(col.Header)</td>
                                    <td class="tdval">@(Html.Raw(col.Rezerva))</td>
                                </tr>
                            }
                        </table>
                    }
                    else
                    {
                        <div class="sm-muted">@_f.tra("Zatím nejsou vybrané žádné sloupce.")</div>
                    }
                </div>
            }
        </div>
    </div>
</form>

<script type="text/javascript">
    var _sm_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { recent = _f.tra("Naposledy použité") }));
    var _sm_recent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last10Receivers ?? new List<string>()));

    $(document).ready(function () {

        //našeptávač adres (bez Kendo) – Komu, Kopie, Skrytá kopie
        mailrecipients_init({
            inputs: ["#Recipient", "#Rec_x40CC", "#Rec_x40BCC"],
            url: "/Mail/AutoCompleteSource",
            recent: _sm_recent,
            recentTitle: _sm_txt.recent
        });

        //podpis: náhled se přepíná hned, bez postbacku
        $("#Rec_x40IsUserSignature").on("change", function () {
            $("#divSignature").toggle(this.checked);
        });

        $("#Rec_x40TO_j61, #Rec_x40CC_j61, #Rec_x40BCC_j61").on("input", sm_j61_visibility);

        @if (Model.IsPostback && Model.PostbackOper == "j61id")
        {
            <text>editor_setcontent($("#j61MailBody").val());</text>
        }

        _resize_textareas();
        _resize_iframe_onpage("fraUpload");
    });

    function sm_toggle(sel) {
        var $d = $(sel).toggle();
        if (sel === "#divCc") {
            $("#lnkCc").toggleClass("sm-on", $d.is(":visible"));
            if ($d.is(":visible")) $("#Rec_x40CC").focus();
        }
        if (sel === "#divPoziceTym") $("#lnkGroups").toggleClass("sm-on", $d.is(":visible"));
    }

    function sm_j61_visibility() {
        var any = ["#Rec_x40TO_j61", "#Rec_x40CC_j61", "#Rec_x40BCC_j61"].some(function (s) { return ($(s).val() || "") !== ""; });
        if (any) $("#divJ61Recipients").show();
    }

    function j11id_onchange(j11id) {
        _postback("j11id");
    }
    function j07id_onchange(j07id) {
        _postback("j07id");
    }
    function j61id_onchange(j61id) {
        $.post("/Mail/MailMergeByTextTemplate", { j61id: j61id, prefix: "@(Model.Rec.x40RecordEntity)", recpid: @(Model.Rec.x40RecordPid) }, function (data) {
            if (data.j61MailSubject != null && data.j61MailSubject != "") {
                $("#txtSubject").val(data.j61MailSubject);
            }
            if (data.j61UserSignatureFlag == 1) $("#Rec_x40IsUserSignature").prop("checked", true);
            if (data.j61UserSignatureFlag == 2) $("#Rec_x40IsUserSignature").prop("checked", false);
            if (data.j61RecordLinkFlag == 1) $("#Rec_x40IsRecordLink").prop("checked", true);
            if (data.j61RecordLinkFlag == 2) $("#Rec_x40IsRecordLink").prop("checked", false);
            if (data.j61GridColumnsFlag == 1) $("#IsShowGridColumns").prop("checked", true);
            if (data.j61GridColumnsFlag == 2) $("#IsShowGridColumns").prop("checked", false);

            $("#Rec_x40BCC_j61").val(data.j61MailBCC);
            $("#Rec_x40CC_j61").val(data.j61MailCC);
            $("#Rec_x40TO_j61").val(data.j61MailTO);

            _postback("j61id");
        });
    }

    function grid_designer() {
        var cols = $("#j61GridColumns").val();
        var prefix = "@Model.Rec.x40RecordEntity";
        _window_open("/TheGridDesigner?prefix=" + prefix + "&cols=" + cols);
    }

    function hardrefresh(pid, cols) {
        if (cols != "j61id" && cols != "") {
            $("#j61GridColumns").val(cols);
            _postback("cols");
            return;
        }
        _postback();
    }

    function j61_create() {
        var prefix = "@(Model.Rec.x40RecordEntity == "p84" ? "p91" : Model.Rec.x40RecordEntity)";
        _window_open("/j61/Record?prefix=" + prefix);
    }
    function j61_edit(j61id) {
        _window_open("/j61/Record?pid=" + j61id);
    }

    function reload_after_griddesigner(pid, cols) {
        if (cols != "j61id" && cols != "") {
            $("#j61GridColumns").val(cols);
            _postback("cols");
            return;
        }
    }

    window.addEventListener("pageshow", function (e) { if (e.persisted) location.reload(); });
</script>
