@model UI.Models.r11.r11ViewModel
@inject BL.Factory _f

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    Model.PageTitle = _f.tra("Kapacitní plány");
    if (Model.RecP41 != null)
    {
        Model.PageTitle = _f.tra("Kapacitní plán") + ": " + Model.RecP41.p41Name;
    }
    bool _canadd = (Model.p41id == 0 || Model.CanEditContext);
}

@addTagHelper *, UI

@section header_content {
    <link rel="stylesheet" href="~/css/r11.css" asp-append-version="true" />
}

<div class="input-group rc-toolbar">
    <ul class="nav nav-tabs">
        <li class="onetab">
            <a class="nav-link active" href="/r11/Index@(Model.p41id > 0 ? "?p41id=" + Model.p41id.ToString() : "")">@_f.tra("Kapacitní plány")</a>
        </li>
    </ul>

    @if (Model.RecP41 != null)
    {
        <div class="rc-context">
            <span class="material-icons-outlined-btn">work_outline</span>
            <a href="javascript:_edit('p41',@Model.p41id)" title="@_f.tra("Karta projektu")">@Model.RecP41.p41Name</a>
            <span class="rc-muted">(@Model.RecP41.p41Code)</span>
            <a class="rc-all" href="/r11/Index">@_f.tra("Všichni lidé")</a>
        </div>
    }

    <div class="btn-group rc-nav" role="group">
        <button type="button" id="rc_prev" class="btn btn-outline-secondary" title="@_f.tra("Předchozí měsíc")">&#8249;</button>
        <button type="button" id="rc_today" class="btn btn-outline-secondary">@_f.tra("Dnes")</button>
        <button type="button" id="rc_next" class="btn btn-outline-secondary" title="@_f.tra("Další měsíc")">&#8250;</button>
    </div>

    <select id="rc_months" class="form-select rc-months" title="@_f.tra("Zobrazené období")">
        @foreach (int m in new int[] { 2, 4, 6, 12 })
        {
            <option value="@m" selected="@(Model.Months == m)">@m @_f.tra("měs.")</option>
        }
    </select>

    <div class="btn-group rc-zoom rc-view" role="group" aria-label="@_f.tra("Pohled")">
        <button type="button" class="btn btn-outline-secondary" data-view="people">@_f.tra("Lidé")</button>
        <button type="button" class="btn btn-outline-secondary" data-view="projects">@_f.tra("Projekty")</button>
    </div>

    @if (Model.lisJ11.Count() > 0)
    {
        <select id="rc_j11id" class="form-select rc-filter" title="@_f.tra("Tým")">
            <option value="0">@_f.tra("Všechny týmy")</option>
            @foreach (var c in Model.lisJ11)
            {
                <option value="@c.pid" selected="@(Model.j11ID == c.pid)">@c.j11Name</option>
            }
        </select>
    }
    @if (Model.lisJ18.Count() > 0)
    {
        <select id="rc_j18id" class="form-select rc-filter" title="@_f.tra("Středisko")">
            <option value="0">@_f.tra("Všechna střediska")</option>
            @foreach (var c in Model.lisJ18)
            {
                <option value="@c.pid" selected="@(Model.j18ID == c.pid)">@c.j18Name</option>
            }
        </select>
    }

    <div class="btn-group rc-zoom rc-heat" role="group" aria-label="@_f.tra("Co ukazují uplynulá období")">
        <button type="button" class="btn btn-outline-secondary" data-heat="plan" title="@_f.tra("Plán proti kapacitě")">@_f.tra("Plán")</button>
        <button type="button" class="btn btn-outline-secondary" data-heat="actual" title="@_f.tra("Uplynulá období: vykázáno proti plánu. Budoucí období: plán proti kapacitě.")">@_f.tra("Skutečnost")</button>
    </div>

    <div class="btn-group rc-zoom" role="group" aria-label="@_f.tra("Měřítko")">
        <button type="button" class="btn btn-outline-secondary" data-zoom="day">@_f.tra("Dny")</button>
        <button type="button" class="btn btn-outline-secondary" data-zoom="week">@_f.tra("Týdny")</button>
        <button type="button" class="btn btn-outline-secondary" data-zoom="month">@_f.tra("Měsíce")</button>
    </div>

    <div class="rc-search">
        <input type="text" id="rc_search" class="form-control" autocomplete="off" placeholder="@_f.tra("Najít")…" />
    </div>

    @if (_canadd)
    {
        <button type="button" id="rc_add" class="btn btn-primary rc-add"><span class="material-icons-outlined-btn">person_add</span>@_f.tra("Přidat strop")</button>
    }

    <button type="button" id="rc_xls" class="btn btn-outline-secondary rc-add" title="@_f.tra("Export zobrazeného období do XLSX")"><span class="material-icons-outlined-btn">file_download</span>XLS</button>

    <div class="rc-legend" data-legend="plan">
        <span class="rc-lg rc-s-free"></span>@_f.tra("volno")
        <span class="rc-lg rc-s-full"></span>@_f.tra("plno")
        <span class="rc-lg rc-s-over"></span>@_f.tra("přetíženo")
        <span class="rc-lg rc-lg-abs"></span>@_f.tra("absence")
    </div>
    <div class="rc-legend" data-legend="actual" style="display:none;">
        <span class="rc-lg rc-a-under"></span>@_f.tra("vykázáno méně")
        <span class="rc-lg rc-a-ok"></span>@_f.tra("podle plánu")
        <span class="rc-lg rc-a-over"></span>@_f.tra("vykázáno více")
        <span class="rc-lg rc-lg-abs"></span>@_f.tra("absence")
    </div>
</div>

<div id="r11grid" class="rc-scroll"></div>
<div id="rc_tip" class="rc-tip"></div>
<div id="rc_dlg" class="rc-dlg"></div>

<script src="~/js/r11.js" asp-append-version="true"></script>
<script type="text/javascript">
    if (typeof _mainmenu_highlight_current === "function") _mainmenu_highlight_current("cmdCapacity");

    var _r11 = MtCapacity.init({
        el: document.getElementById("r11grid"),
        p41id: @Model.p41id,
        zoom: "@Model.Zoom",
        months: @Model.Months,
        view: "@Model.ViewMode",
        heat: "@Model.Heat",
        j11id: @Model.j11ID,
        j18id: @Model.j18ID,
        tra: {
            osoba: "@_f.tra("Osoba / projekt")",
            projektosoba: "@_f.tra("Projekt / osoba")",
            absence: "@_f.tra("absence")",
            absencezkratka: "@_f.tra("A")",
            otevritukony: "@_f.tra("Kliknutím otevřete tabulku časových úkonů")",
            zbyva2: "@_f.tra("Zbývá")",
            rozdil: "@_f.tra("rozdíl")",
            strop: "@_f.tra("Strop")",
            rozpl: "@_f.tra("Rozplán.")",
            vykazano: "@_f.tra("Vykázáno")",
            zadnadata: "@_f.tra("Zatím není zadaný žádný strop hodin.")",
            zadnyvysledek: "@_f.tra("Hledání neodpovídá žádný řádek.")",
            chyba: "@_f.tra("Operace se nezdařila.")",
            plan: "@_f.tra("plán")",
            kapacita: "@_f.tra("kapacita")",
            volno: "@_f.tra("volno")",
            pretizeni: "@_f.tra("přetížení")",
            obdobi: "@_f.tra("v období projektu")",
            nerozplanovano: "@_f.tra("nerozplánováno")",
            vycerpano: "@_f.tra("Strop je už celý rozplánovaný. Nejdřív zvyšte strop nebo zmenšete jiný blok.")",
            skryte: "@_f.tra("další projekty, které nevidíte")",
            blok: "@_f.tra("Blok plánu")",
            upravitstrop: "@_f.tra("Strop hodin")",
            hodiny: "@_f.tra("Hodiny")",
            poznamka: "@_f.tra("Poznámka")",
            zbyva: "@_f.tra("k rozplánování zbývá")",
            ulozit: "@_f.tra("Uložit")",
            smazat: "@_f.tra("Smazat")",
            zrusit: "@_f.tra("Zrušit")",
            dni: "@_f.tra("dní")"
        }
    });

    function hardrefresh(pid, flag) {   //volá okno s kartou záznamu po uložení
        _r11.reload();
    }

    // ---- okno se seznamem úkonů (/p31dayline/Zoom), stejné jako v kalendáři; volá se klikem na vykázané hodiny ----
    var _zoom_normal = null;
    var _zoom_maximized = false;

    function zoom_open(ctl, url) {
        url = _ep(url);
        $(".zoom_ctl_current").removeClass("zoom_ctl_current");
        $(ctl).addClass("zoom_ctl_current");

        var c = $("#zoomwin");
        var w = window.innerWidth - 100;
        var h = 450;
        var y = $(ctl).offset().top + 24;
        if (y + h + 20 > window.innerHeight + $(window).scrollTop()) {
            y = $(ctl).offset().top - h - 2;
        }
        if (w < 400) w = window.innerWidth;
        var x = (window.innerWidth - w) / 2;
        if (x < 0) x = 0;
        if (y < 0) y = 0;

        c.css({ display: "block", width: w + "px", height: h + "px", left: x + "px", top: y + "px" });
        c.html("<iframe id='frazoom' style='border:solid 1px gray;background-color:white;' width='100%' height='" + (h - 2) + "px' src='" + url + "'></iframe>");
        _zoom_maximized = false;
    }

    function zoom_toggle() {
        var c = $("#zoomwin");
        if (!_zoom_maximized) {
            _zoom_normal = { left: parseInt(c.css("left")), top: parseInt(c.css("top")), width: c.width(), height: c.height() };
            c.css({ left: "0px", top: $(window).scrollTop() + "px", width: "100vw", height: "100vh" });
            $("#frazoom").css({ height: (window.innerHeight - 2) + "px" });
            _zoom_maximized = true;
        } else {
            c.css({ left: _zoom_normal.left + "px", top: _zoom_normal.top + "px", width: _zoom_normal.width + "px", height: _zoom_normal.height + "px" });
            $("#frazoom").css({ height: (_zoom_normal.height - 2) + "px" });
            _zoom_maximized = false;
        }
    }

    function zoom_close() {
        $("#zoomwin").css("display", "none").html("");
        $(".zoom_ctl_current").removeClass("zoom_ctl_current");
        _zoom_maximized = false;
    }

    function p31c(d, t1, t2, j02id) {   //tlačítko "Vykázat úkon" v okně úkonů
        _window_open("/p31/Record?j02id=" + j02id + "&d=" + d, 3);
    }

    $(document).on("keydown", function (e) {
        if (e.keyCode == 27 && $("#zoomwin").css("display") == "block") zoom_close();
    });
</script>

<div id="zoomwin" style="position:absolute;top:0px;left:0px;z-index:1000;display:none;box-shadow:0 6px 24px rgba(0,0,0,.25);"></div>
