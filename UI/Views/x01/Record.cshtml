@model UI.Models.Record.x01Record
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Globální parametry databáze");
    Layout = "~/Views/Shared/_LayoutRecord.cshtml";
    Model.PageSymbol = "manufacturing";
}

@addTagHelper *, UI

<input type="hidden" asp-for="ComboX04" />


<div class="tabs_container_record">
    <!-- Tab panes -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab1" class="nav-link" data-bs-toggle="tab" role="tab" href="#tab1">@_f.tra("Karta licence")</a>
        </li>
      
        <li class="nav-item onetab" role="presentation">
            <a id="link_tab2" class="nav-link" tabindex="-1" data-bs-toggle="tab" role="tab" href="#tab2">@_f.tra("Billing")</a>
        </li>

        <li class="nav-item onetab" role="presentation">
            <a id="link_tab4" class="nav-link" tabindex="-1" data-bs-toggle="tab" role="tab" href="#tab4">AI</a>
        </li>

        <li class="nav-item onetab" role="presentation">
            <a id="link_tab3" class="nav-link" tabindex="-1" data-bs-toggle="tab" role="tab" href="#tab3">@_f.tra("Různé")</a>
        </li>

      
    </ul>
</div>

@Html.Raw("<div class='modal_record_container_flexi'>")
@Html.Raw("<div class='tab-content'>")

<div class="tab-pane tab-pane-fixed" id="tab1" role="tabpanel">
    <!-- Tab1 -->
    <div class="row">
        <label class="col-sm-2 col-md-3 col-form-label">@_f.tra("Název"):</label>
        <div class="col-sm-10 col-md-9">
            <input class="form-control record_name" asp-for="Rec.x01AppName" />
        </div>

    </div>

    <div class="row my-2">
        <label class="col-sm-2 col-md-3 col-form-label">@_f.tra("Veřejná URL adresa"):</label>
        <div class="col-sm-10 col-md-9">
            <input class="form-control" asp-for="Rec.x01AppHost" />
        </div>

    </div>

    <div class="row my-2">
        <label class="col-sm-2 col-md-3 col-form-label">@_f.tra("Výchozí aplikační jazyk"):</label>
        <div class="col-sm-10 col-md-9">
            <input type="radio" value="0" id="chkLang0" asp-for="@Model.Rec.x01LangIndex" />
            <label for="chkLang0">
                Česky<img src="/images/czechrepublic.gif" alt="" />
            </label>

            <input type="radio" value="1" id="chkLang1" asp-for="@Model.Rec.x01LangIndex" style="margin-left:30px;" />
            <label for="chkLang1">
                English<img src="/images/uk.gif" alt="" />
            </label>

            <input type="radio" value="4" id="chkLang4" asp-for="@Model.Rec.x01LangIndex" style="margin-left:30px;" />
            <label for="chkLang4">
                Slovenčina<img src="/images/slovakia.gif" alt="" />
            </label>
        </div>

    </div>

    <div class="row mt-4">
        <label class="col-sm-2 col-md-3 col-form-label">ISO kód státu:</label>
        <div class="col-sm-5 col-md-4">
            @Html.EditorFor(m => m.Rec.x01CountryCode, "~/Views/Shared/_CountryCodeCombo.cshtml")

        </div>

    </div>


    <div class="row mt-2">
        <label class="col-sm-2 col-md-3 col-form-label">Domácí měna:</label>
        <div class="col-sm-5 col-md-4">
            <select class="form-select" asp-for="Rec.j27ID">
                <option value="2">CZK</option>
                <option value="3">EUR</option>
                <option value="58">USD</option>
                <option value="59">GBP</option>
                <option value="56">CHF</option>
                <option value="50">PLN</option>

            </select>
        </div>

    </div>

    <div class="row my-2">
        <label class="col-sm-2 col-md-3 col-form-label">@_f.tra("Omezení provozu"):</label>
        <div class="col-sm-5 col-md-4">
            <select asp-for="Rec.x01LockFlag" class="form-select">
                <option value="0">--Bez omezení--</option>
                <option value="2">Povolen přístup pouze pro admina</option>
                <option value="6">Povolen přístup pouze pro admina+vypnutý robot</option>
                <option value="4">Vypnutý robot</option>
            </select>
        </div>
       

    </div>
    

    
  
    
    <div class="row my-2">
        <label class="col-sm-2 col-md-3 col-form-label">Robot login:</label>
        <div class="col-sm-5 col-md-4">
            <input class="form-control" asp-for="Rec.x01RobotLogin" />
        </div>

    </div>
    

    


    <div class="card mt-2">
        <div class="card-header">
            @_f.tra("Kontrola záznamů v modulu Kontakty")
        </div>
        <div class="card-body">
            <input type="checkbox" asp-for="Rec.x01IsAllowDuplicity_RegID" />
            <label class="col-form-label" for="Rec_x01IsAllowDuplicity_RegID">@_f.tra("Povolit duplicity se shodným IČO")</label>

            <input type="checkbox" asp-for="Rec.x01IsAllowDuplicity_VatID" style="margin-left:50px;" />
            <label class="col-form-label" for="Rec_x01IsAllowDuplicity_VatID">@_f.tra("Povolit duplicity se shodným DIČ")</label>
            <code>Duplicity ve skupinovém DIČ (CZ699) systém ignoruje.</code>
        </div>
    </div>

    <div class="card mt-2">
        <div class="card-header">
            @_f.tra("Kontrola duplicity bankovních účtů")
        </div>
        <div class="card-body">
            <input type="checkbox" asp-for="Rec.x01IsAllowDuplicity_p86" />
            <label class="col-form-label" for="Rec_x01IsAllowDuplicity_p86">@_f.tra("U vystavovatelů faktur povolit duplicity v bankovních účtech")</label>

            
        </div>
    </div>
    
</div>

<div class="tab-pane tab-pane-fixed" id="tab2" role="tabpanel">
    <!-- Tab2 -->

    <div class="row mt-2">
        
        <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01Round2Minutes" text="@_f.tra("Zaokrouhlovat vykazovaný čas")" tooltip="Definuje se v minutách.<hr>Výchozí jednotka zaokrouhlování hodin se definuje v administraci (základní parametry databáze).<hr>Pokud uvedete -1, systém nebude zaokrouhlovat čas vůbec."></mylabel>

        <div class="col-sm-3 col-md-2">
                <input class="form-control" type="number" asp-for="Rec.x01Round2Minutes" />
        </div>
       
    </div>

    <div class="row my-2">
        
        <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01InvoiceMaturityDays" text="@_f.tra("Výchozí splatnost faktury")" tooltip="Počet dní, nebere v potaz víkendy a svátky. Individuálně lze definovat v kartě projektu nebo klienta projektu."></mylabel>

        <div class="col-sm-3 col-md-2">
            <input class="form-control" type="number" asp-for="Rec.x01InvoiceMaturityDays" />
        </div>
        <div class="col-sm-5 co-md-5">
            <i>Dny</i>
        </div>
    </div>
    <div class="row my-2">
        <mylabel class="col-sm-2 col-md-3 col-form-label" text="@_f.tra("Výchozí hladina sazby DPH")" tooltip="Výchozí sazbu DPH můžete nastavit u každé aktivity."></mylabel>

        
        <div class="col-sm-3 col-md-2">
            @Html.EditorFor(m => m.Rec.x15ID, "~/Views/Shared/_x15Combo.cshtml")

        </div>

    </div>

    

    <div class="card" style="margin-top:20px;">
        <div class="card-header">
            @_f.tra("Nastavení ostatních fakturačních jazyků")

            <code style="margin-left:30px;">@_f.tra("Domácí jazyk se zde neuvádí!")</code>
        </div>
        <div class="card-body">
            <div class="row">
                <label class="col-sm-1 col-md-2 col-form-label">@(_f.tra("Jazyk")) #1:</label>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingLang1" />

                </div>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingFlag1" placeholder="@_f.tra("Obrázek vlajky")" />

                </div>
            </div>
            <div class="row my-2">
                <label class="col-sm-1 col-md-2 col-form-label">@(_f.tra("Jazyk")) #2:</label>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingLang2" />

                </div>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingFlag2" placeholder="@_f.tra("Obrázek vlajky")" />

                </div>

            </div>
            <div class="row my-2">
                <label class="col-sm-1 col-md-2 col-form-label">@(_f.tra("Jazyk")) #3:</label>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingLang3" />

                </div>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingFlag3" placeholder="@_f.tra("Obrázek vlajky")" />

                </div>
            </div>
            <div class="row my-2">
                <label class="col-sm-1 col-md-2 col-form-label">@(_f.tra("Jazyk")) #4:</label>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingLang4" />

                </div>
                <div class="col-sm-5 col-md-5">
                    <input type="text" class="form-control" asp-for="Rec.x01BillingFlag4" placeholder="@_f.tra("Obrázek vlajky")" />

                </div>
            </div>
        </div>
    </div>
</div>


<div class="tab-pane tab-pane-fixed" id="tab3" role="tabpanel">
    <!-- Tab3 -->

    <div class="card mt-2">
        <div class="card-header">
            @_f.tra("Obnovení zapomenutého hesla")
        </div>
        <div class="card-body">
            <input type="checkbox" id="chkIsAllowPasswordRecovery" asp-for="@Model.Rec.x01IsAllowPasswordRecovery" />
            <label class="col-form-label" for="chkIsAllowPasswordRecovery">@_f.tra("Povolit uživatelům obnovu zapomenutého hesla")</label>

            <textarea class="form-control" asp-for="Rec.x01PasswordRecovery_Question" placeholder="@_f.tra("Otázka pro žadatele před vygenerováním nového hesla.")"></textarea>
            <br />
            <textarea class="form-control" asp-for="Rec.x01PasswordRecovery_Answer" placeholder="@_f.tra("Správná odpověď, kterou musí žadatel napsat.")"></textarea>
        </div>
    </div>

    <div class="row my-2">
        <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01InfosoudToken" text="Infosoud token" tooltip="Token, který si vygenerujete v aplikaci Infosoud. V kartě projektu je možné zadávat spisové značky ke sledování průběhu soudních řízení."></mylabel>

        <div class="col-sm-10 col-md-9">
            <input class="form-control" asp-for="Rec.x01InfosoudToken" />
        </div>

    </div>


    <div class="row my-2">
        <label class="col-sm-2 col-md-3 col-form-label">@_f.tra("Výchozí Notepad editor"):</label>
        <div class="col-sm-5 col-md-4">
            <mycombo entity="x04NotepadConfig" asp-for="Rec.x04ID_Default" selectedtext="@Model.ComboX04" filter-flag="1"></mycombo>
        </div>

    </div>

    <div class="my-2">
        <input type="checkbox" asp-for="@Model.Rec.x01IsCapacityFaNefa" />
        <label class="col-form-label" for="Rec_x01IsCapacityFaNefa">@_f.tra("V plánování rozdělovat plán hodin na [Plán Fa hodin] a [Plán Nefa hodin]")</label>
    </div>

    <hr />
    <button type="button" class="btn btn-sm btn-light" onclick="_postback('ping')">Poslat ping na MARKTIME cloud uložiště</button>
</div>

<div class="tab-pane tab-pane-fixed" id="tab4" role="tabpanel">
    <!-- Tab4: AI -->
    @{
        var aiG = Model.AiGlobal;
        int aiFlag = (int)Model.Rec.x01AiUsageFlag;
    }

    <div class="row my-2">
        <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01AiUsageFlag" text="@_f.tra("Použití AI")" tooltip="Vypnuto: AI funkce se uživatelům nezobrazí.<hr>Podle konfigurace serveru: připojení, model a limity z appsettings.json (sekce AI).<hr>Vlastní připojení: API klíč, model a limity zadané zde. Endpoint a verze API zůstávají ze serveru."></mylabel>
        <div class="col-sm-5 col-md-4">
            <select asp-for="Rec.x01AiUsageFlag" class="form-select" onchange="x01_ai_mode()">
                <option value="0">@_f.tra("Vypnuto")</option>
                <option value="1">@_f.tra("Podle konfigurace serveru")</option>
                <option value="2">@_f.tra("Vlastní připojení (API klíč)")</option>
            </select>
        </div>
    </div>

    <div id="divAiGlobal" class="alert alert-secondary mt-2 @(aiFlag == 1 ? "" : "d-none")" role="alert">
        @if (aiG.Enabled)
        {
            <div>@_f.tra("Konfigurace serveru je aktivní"): <b>@aiG.Model</b>, max. @aiG.MaxTokens tokenů, limit @aiG.TimeoutSeconds s.</div>
        }
        else
        {
            <div>@_f.tra("Konfigurace serveru AI nepovoluje"): @aiG.DisabledReason</div>
        }
    </div>

    <div id="divAiPrivate" class="@(aiFlag == 2 ? "" : "d-none")">
        <div class="row my-2">
            <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="AiApiKeyNew" text="API klíč" tooltip="Klíč z console.anthropic.com (sk-ant-…). Uložený klíč se ze zabezpečení nezobrazuje; pole nechte prázdné, pokud ho nechcete měnit."></mylabel>
            <div class="col-sm-6 col-md-5">
                <input type="password" class="form-control" id="AiApiKeyNew" name="AiApiKeyNew" value="@Model.AiApiKeyNew" autocomplete="new-password" spellcheck="false"
                       placeholder="@(Model.AiApiKeyMasked == null ? "sk-ant-…" : _f.tra("Uložen") + " " + Model.AiApiKeyMasked + " – " + _f.tra("prázdné = beze změny"))" />
            </div>
            @if (Model.AiApiKeyMasked != null)
            {
                <div class="col-sm-4 col-md-4">
                    <input type="checkbox" asp-for="AiApiKeyClear" />
                    <label class="col-form-label" for="AiApiKeyClear">@_f.tra("Odstranit uložený klíč")</label>
                </div>
            }
        </div>

        <div class="row my-2">
            <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01AiModel" text="Model" tooltip="Prázdné = model podle konfigurace serveru."></mylabel>
            <div class="col-sm-6 col-md-5">
                <input class="form-control" asp-for="Rec.x01AiModel" list="x01AiModels" placeholder="@aiG.Model" spellcheck="false" />
                <datalist id="x01AiModels">
                    <option value="claude-sonnet-5-5"></option>
                    <option value="claude-opus-5-5"></option>
                    <option value="claude-haiku-5-5"></option>
                </datalist>
            </div>
        </div>

        <div class="row my-2">
            <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01AiMaxTokens" text="@_f.tra("Max. tokenů odpovědi")" tooltip="0 = podle konfigurace serveru. Jinak 1024–64000."></mylabel>
            <div class="col-sm-3 col-md-2">
                <input class="form-control" type="number" min="0" max="64000" step="256" asp-for="Rec.x01AiMaxTokens" />
            </div>
            <div class="col-sm-5 col-md-5 col-form-label"><i>0 = @aiG.MaxTokens</i></div>
        </div>

        <div class="row my-2">
            <mylabel class="col-sm-2 col-md-3 col-form-label" explicit-for="Rec_x01AiTimeoutSeconds" text="@_f.tra("Časový limit volání")" tooltip="V sekundách. 0 = podle konfigurace serveru. Jinak 10–600."></mylabel>
            <div class="col-sm-3 col-md-2">
                <input class="form-control" type="number" min="0" max="600" asp-for="Rec.x01AiTimeoutSeconds" />
            </div>
            <div class="col-sm-5 col-md-5 col-form-label"><i>@_f.tra("Sekundy"), 0 = @aiG.TimeoutSeconds</i></div>
        </div>
    </div>

    <div id="divAiTest" class="mt-3 @(aiFlag == 0 ? "d-none" : "")">
        <button type="button" class="btn btn-sm btn-light" onclick="_postback('aitest')">
            <span class="material-icons-outlined-btn">network_check</span> @_f.tra("Otestovat připojení")
        </button>
        <span class="ms-2 small">@_f.tra("Testuje hodnoty ve formuláři, nic neukládá.")</span>
        @if (Model.AiTestResult != null)
        {
            <div class="alert @(Model.AiTestOk ? "alert-success" : "alert-danger") mt-2" role="alert">@Model.AiTestResult</div>
        }
    </div>
</div>
    
@Html.Raw("</div>")
@Html.Raw("</div>")


<script type="text/javascript">
    function x01_ai_mode() {
        var flag = $("#Rec_x01AiUsageFlag").val();
        $("#divAiGlobal").toggleClass("d-none", flag != "1");
        $("#divAiPrivate").toggleClass("d-none", flag != "2");
        $("#divAiTest").toggleClass("d-none", flag == "0");
    }
</script>
