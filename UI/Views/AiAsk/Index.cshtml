@model UI.Models.AI.AiAskViewModel
@inject BL.Factory _f
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    //příklady jen k datům a akcím, na které má uživatel oprávnění (moduly role)
    //agent neumí jen reporting: příklad akce (vykázání hodin) je hned druhý, další akce sem budou přibývat
    var _u = _f.CurrentUser;
    bool _canAct = _u.j04IsModule_p31;      //akce, které agent umí: zatím vykázání hodin
    var _examples = new List<string> { _f.tra("Co mě čeká?") };
    if (_u.j04IsModule_p31) _examples.Add(_f.tra("Zapiš mi 2 hodiny jednání v Microsoftu od 14 do 16"));
    if (_u.j04IsModule_p31) _examples.Add(_f.tra("Kolik hodin jsme minulý měsíc vykázali podle klientů?"));
    if (_u.j04IsModule_p31) _examples.Add(_f.tra("Ukaž moje včerejší úkony s popisem"));
    if (_u.j04IsModule_p41 && _u.j04IsModule_p91) _examples.Add(_f.tra("Projekty podle manažerů, kde jsou neuhrazené faktury po splatnosti"));
    if (_u.j04IsModule_p91) _examples.Add(_f.tra("Neuhrazené faktury po splatnosti"));
    if (!_u.j04IsModule_p31 && _u.j04IsModule_p56) _examples.Add(_f.tra("Moje úkoly po termínu"));
    var chatSettings = new UI.Models.AI.AiChatSettings
    {
        Intro = _canAct
            ? _f.tra("Zeptejte se na svá data v MARKTIME, nebo mi řekněte, co mám udělat. Zatím umím vykázat hodiny, další akce postupně přibývají. Napište to vlastními slovy, nebo klikněte na příklad:")
            : _f.tra("Zeptejte se na svá data v MARKTIME. Napište dotaz vlastními slovy, nebo klikněte na příklad:"),
        Examples = _examples,
        Placeholder = _canAct ? _f.tra("Dotaz nebo pokyn…") : null,
        Thinking = _f.tra("Pracuji na tom…"),
        Feature = Model.Feature
    };
}

<link rel="stylesheet" href="~/css/ai/aiask.css" asp-append-version="true" />

<div class="ai-ask-page">
    <div class="ai-toolbar">
        <span class="ai-ask-title me-auto"><span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Zeptej se MARKTIME")</span>
        <button type="button" id="cmdAskNew" class="btn btn-light" title="@_f.tra("Začít novou konverzaci")"><span class="material-icons-outlined-btn">add_comment</span>@_f.tra("Nová konverzace")</button>
    </div>

    <div class="ai-ask-wrap">
        <partial name="~/Views/Shared/AI/_AiChat.cshtml" model="chatSettings" />
    </div>
</div>

<script type="text/javascript">
    var _ask_user = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_f.CurrentUser.pid));
    var _ask_pin = @(_f.CurrentUser.j04IsModule_Widgets ? "true" : "false");     //„Na plochu“ jen s přístupem k dashboardu
    var _ask_edit = @Html.Raw(Model.EditJson ?? "null");     //úprava AI widgetu (/AiAsk?editx55=…): { x55id, name, intro, thread, table }
    var _ask_txt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        total = _f.tra("Celkem"),
        yes = _f.tra("ano"),
        no = _f.tra("ne"),
        shown = _f.tra("Zobrazeno {0} z {1} řádků, celkem je spočítáno ze všech."),
        shownList = _f.tra("Zobrazeno {0} z {1} záznamů, celkem je spočítáno ze všech."),
        countList = _f.tra("Nalezeno záznamů: {0}"),
        pivot = _f.tra("Pivot-Explorer"),
        pivotTitle = _f.tra("Otevřít výsledek v kontingenční tabulce"),
        drill = _f.tra("Zobrazit úkony"),
        drillTitle = _f.tra("Všechny úkony výsledku v gridu"),
        drillRow = _f.tra("Kliknutím na řádek zobrazíte jeho úkony"),
        cardRow = _f.tra("Kliknutím otevřete stránku záznamu"),
        cardRec = _f.tra("Otevřít stránku záznamu (nová záložka)"),
        cardP31 = _f.tra("Otevřít úkon"),
        cardMenu = _f.tra("Menu záznamu"),
        drillError = _f.tra("Zdrojové úkony se nepodařilo načíst."),
        empty = _f.tra("Nic nenalezeno."),
        pin = _f.tra("Uložit na dashboard"),
        pinTitle = _f.tra("Uložit jako AI widget na dashboard (skupina Moje AI widgety) – data se pak počítají vždy aktuálně, bez dalšího volání AI"),
        pinName = _f.tra("Název widgetu"),
        pinLive = _f.tra("Vždy aktuální období"),
        pinFixed = _f.tra("Období je pevné (data z dotazu)."),
        pinCount = _f.tra("Osobní AI widgety: {0} z {1}"),
        pinView = _f.tra("Zobrazení"),
        pinViewTable = _f.tra("Pouze tabulka"),
        pinViewBoth = _f.tra("Tabulka i graf"),
        pinViewChart = _f.tra("Pouze graf"),
        pinSave = _f.tra("Uložit na dashboard"),
        pinCancel = _f.tra("Zrušit"),
        pinDone = _f.tra("Widget je na dashboardu ve skupině „Moje AI widgety“."),
        pinOpen = _f.tra("Otevřít dashboard"),
        pinError = _f.tra("Widget se nepodařilo uložit."),
        saveTo = _f.tra("Uložit do widgetu"),
        saveToTitle = _f.tra("Nahradit zadání upravovaného widgetu tímto výsledkem (název a místo na ploše zůstanou)"),
        savedTo = _f.tra("Uloženo do widgetu."),
        ukonTitle = _f.tra("Návrh úkonu – zatím nezapsáno"),
        ukonSavedTitle = _f.tra("Úkon je zapsán"),
        ukonCancelledTitle = _f.tra("Návrh úkonu byl zrušen"),
        ukonDate = _f.tra("Den"),
        ukonTime = _f.tra("Čas"),
        ukonProject = _f.tra("Projekt"),
        ukonClient = _f.tra("Klient"),
        ukonActivity = _f.tra("Aktivita"),
        ukonTask = _f.tra("Úkol"),
        ukonHours = _f.tra("Hodiny"),
        ukonText = _f.tra("Popis"),
        ukonTextInternal = _f.tra("Interní poznámka"),
        ukonSave = _f.tra("Zapsat"),
        ukonCancel = _f.tra("Zrušit"),
        ukonOpen = _f.tra("Otevřít úkon"),
        ukonHint = _f.tra("Chcete něco změnit? Napište to asistentovi a dostanete nový návrh."),
        ukonError = _f.tra("Úkon se nepodařilo zapsat.")
    }));
</script>
<script src="~/js/ai/aiask.js" asp-append-version="true"></script>
