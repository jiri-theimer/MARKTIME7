@model UI.Models.Widgets.WidgetsViewModel
@inject BL.Factory _f

@{
    Model.PageTitle = (Model.RecX54 != null ? Model.RecX54.x54Name : "Dashboard");
    Layout = _f.CurrentUser.GetLayoutPerDisplay();
    bool _IsGrid = false;
    var _userIds = Model.lisUserWidgets.Select(p => p.pid).ToHashSet();
    var _skinNames = new Dictionary<string, string>() {
        { "index", "#0 " + _f.tra("Výchozí plocha") }, { "1huascaran", "#1 Huascarán" }, { "2sajama", "#2 Sajama" }, { "3chimborazo", "#3 Chimborazo" },
        { "4denali", "#4 Denali" }, { "5aconcagua", "#5 Aconcagua" }, { "6tajumulco", "#6 Tajumulco" }, { "7roraima", "#7 Roraima" },
        { "8mogoton", "#8 Mogotón" }, { "9liamuiga", "#9 Liamuiga" } };
}
@addTagHelper *, UI

@section header_content {

    @if (Model.IsDataTables)
    {
        <link rel="stylesheet" href="/lib/datatables/css/jquery.dataTables.min.css" />
    }

    <link rel="stylesheet" href="~/css/widgets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/htmltable.css" />
}

@{
    //jeden widget – společné pro všechny sloupce (dříve 3× kopie; název měl id jen v 1. sloupci)
    void RenderBox(BO.x55Widget c)
    {
        <div id="box_@(c.pid)" class="portlet wd-card">
            <div class="portlet-header wd-head" @Html.Raw(c.CssHeaderDiv)>
                <span class="material-icons-outlined-nosize wd-grip nonmobile" title="@_f.tra("Přetáhnout")">drag_indicator</span>
                <span class="material-icons-outlined-nosize wd-icon">@(c.HeaderImage)</span>
                <span class="wd-title" id="box_header_@(c.pid)">@(c.x55Name)</span>

                <div class="wd-actions">
                    <button type="button" class="wd-btn" title="@_f.tra("Občerstvit obsah widgetu")" onclick="load_widget_content(@c.pid)"><span class="material-icons-outlined-nosize">refresh</span></button>
                    @if (c.x55Help != null)
                    {
                        <button type="button" class="wd-btn" title="@_f.tra("Nápověda")" onclick="widget_help(@c.pid)"><span class="material-icons-outlined-nosize">help_outline</span></button>
                    }
                    <div class="dropdown d-inline-block">
                        <button type="button" class="wd-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="@_f.tra("Další akce")"><span class="material-icons-outlined-nosize">more_vert</span></button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="javascript:_copy_element_to_clipboard('@c.x55Code')"><span class="material-icons-outlined-btn">content_copy</span> @_f.tra("Zkopírovat do schránky")</a></li>
                            <li><a class="dropdown-item" href="javascript:_html2mail('box_content_@(c.pid)','@c.x55Name','send_message_template_htmltable.html')"><span class="material-icons-outlined-btn">alternate_email</span> @_f.tra("Odeslat e-mailem")</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (c.IsPersonal && c.IsAiWidget)
                            {
                                <li><a class="dropdown-item" href="javascript:aiw_edit(@c.pid)"><span class="material-icons-outlined-btn">edit</span> @_f.tra("Upravit")</a></li>
                                @if (Model.IsAiEnabled)
                                {
                                    <li><a class="dropdown-item" href="/AiAsk?editx55=@c.pid"><span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Upravit v Zeptej se MARKTIME")</a></li>
                                }
                            }
                            @if (c.IsAiWidget && c.x55AiTask.Contains("\"kind\":\"agg\""))
                            {
                                <li><a class="dropdown-item" href="javascript:aiw_pivot(@c.pid)"><span class="material-icons-outlined-btn">functions</span> Pivot-Explorer</a></li>
                            }
                            @if (!Model.IsAiGroup)
                            {
                                <li><a class="dropdown-item" href="javascript:handle_after_close_snippet(@c.pid)"><span class="material-icons-outlined-btn">close</span> @_f.tra("Odebrat z plochy")</a></li>
                            }
                            @if (c.IsPersonal)
                            {
                                <li><a class="dropdown-item wd-remove" href="javascript:void(0)" data-confirm="@_f.tra("Opravdu smazat? Klikněte znovu")" onclick="wd_confirm(this, function () { aiw_delete(@c.pid); })"><span class="material-icons-outlined-btn">delete_forever</span> @_f.tra("Smazat widget")</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div id="box_content_@(c.pid)" class="portlet-content wd-body" @Html.Raw(c.CssContentDiv)>
                @Html.Raw(c.x55Content)
            </div>
        </div>
    }
}


<script src="~/lib/sortable/Sortable.min.js"></script>
@if (Model.IsDataTables)
{
    <script src="/lib/datatables/js/jquery.dataTables.min.js"></script>

    @if (Model.IsExportButtons || Model.IsPdfButtons)
    {
        <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/1.6.5/js/dataTables.buttons.min.js"></script>
        <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/1.6.5/js/buttons.html5.min.js"></script>
        <script type="text/javascript" language="javascript" src="https://cdn.datatables.net/buttons/1.6.5/js/buttons.print.min.js"></script>
        <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    }
    @if (Model.IsPdfButtons)
    {
        <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
        <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    }
}
@if (Model.IsCharts)
{
    <script src="https://www.gstatic.com/charts/loader.js"></script>
}

@* ------------------------------------------------------------ lišta *@
<div id="@(BO.Code.Bas.IIFS(Model.IsSubform, "header_subform", "header_index"))" class="wd-toolbar">
    @if (!Model.IsSubform)
    {
        <a class="wd-who" href="javascript:reload()" title="@_f.tra("Občerstvit")">
            <span class="material-icons-outlined-nosize">dashboard</span>
            <span>@Model.lisJ02.First(p => p.pid == Model.j02id_me).FullNameAsc</span>
            @if (Model.Skin != "index")
            {
                <span class="wd-skin">@(_skinNames.ContainsKey(Model.Skin) ? _skinNames[Model.Skin] : Model.Skin)</span>
            }
        </a>
    }

    <div class="wd-field" title="@_f.tra("Widget skupina")">
        <mydropdown datasource="lisX54" asp-for="SelectedX54ID" textfield="x54Name" isfirstemptyrow="false" valuefield="pid" event_after_changevalue="x54id_onchange"></mydropdown>
    </div>

    @if (Model.RecX54.x54IsParamToday)
    {
        <div class="wd-field wd-date">
            <label class="col-form-label">@(_f.tra("Datum DNES")):</label>
            <div style="width:120px;">
                <mydate asp-for="@Model.d0"></mydate>
            </div>
        </div>
    }

    @if (Model.RecX54.x54IsParamP28ID)
    {
        <div class="wd-field" style="width:250px;" title="@_f.tra("Klient")">
            @if (Model.lisP28 != null)
            {
                <mydropdown datasource="lisP28" asp-for="SelectedP28ID" textfield="p28Name" isfirstemptyrow="true" firstemptyrowvalue="0" firstemptyrowtext="--Vyberte klienta--" valuefield="pid" event_after_changevalue="p28id_dropdown_onchange"></mydropdown>
            }
            else
            {
                <mycombo entity="p28Contact" placeholder="@_f.tra("Klient")" asp-for="SelectedP28ID" selectedtext="SelectedP28Name" filter-flag="1" search-result-width="700" event_after_changevalue="p28id_reload"></mycombo>
            }
        </div>
    }

    @if (Model.IsAiGroup)
    {
        @if (Model.IsAiEnabled)
        {
            <a class="btn btn-primary btn-sm wd-add" href="/AiAsk" title="@_f.tra("Zeptejte se a výsledek uložte tlačítkem Uložit na dashboard")">
                <span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Nový AI widget")
            </a>
        }
    }
    else
    {
        <button type="button" class="btn btn-primary btn-sm wd-add" id="cmdInsertWidget" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_widgets">
            <span class="material-icons-outlined-btn">add</span> @_f.tra("Vložit widget")
        </button>
    }

    <button type="button" id="cmdRefresh" class="btn btn-primary" style="display:none;margin-left:10px;" onclick="reload()">@_f.tra("Občerstvit")</button>

    <myshowmore></myshowmore>
    <div class="showmore">
        <mydropdown asp-for="j02id_me" textfield="FullnameDesc" valuefield="pid" datasource="@Model.lisJ02" event_after_changevalue="j02id_change"></mydropdown>
    </div>

    <div class="wd-right nonmobile">
        <button type="button" class="btn btn-sm bog" onclick="reload_all_widgets()" title="@_f.tra("Občerstvit všechny widgety")"><span class="material-icons-outlined-btn">refresh</span></button>
        <a id="cmdMore" class="btn btn-sm bog" tabindex="-1" role="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_more"><span class="material-icons-outlined-btn">tune</span> @_f.tra("Nastavení plochy")</a>
    </div>
</div>


@* ------------------------------------------------------------ plocha *@
@if (Model.IsAiGroup && !Model.IsAiEnabled)
{
    <div class="wd-ai-off">
        <span class="material-icons-outlined-nosize">info</span>
        <span>@_f.tra("AI je vypnuté. Vaše AI widgety se dál počítají z aktuálních dat, ale nové vytvářet ani upravovat jejich obsah přes Zeptej se MARKTIME teď nejde.")</span>
    </div>
}

@if (Model.lisUserWidgets.Count == 0 && Model.IsAiGroup)
{
    <div class="wd-empty">
        <span class="material-icons-outlined-nosize">auto_awesome</span>
        <h5>@_f.tra("Zatím nemáte žádné AI widgety")</h5>
        <p>@_f.tra("Zeptejte se MARKTIME na cokoli z vašich dat a výsledek uložte tlačítkem „Uložit na dashboard“. Widget se pak bude sám přepočítávat z aktuálních dat.")</p>
        @if (Model.IsAiEnabled)
        {
            <a class="btn btn-primary" href="/AiAsk"><span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Zeptej se MARKTIME")</a>
        }
    </div>
}
else if (Model.lisUserWidgets.Count == 0)
{
    <div class="wd-empty">
        <span class="material-icons-outlined-nosize">dashboard_customize</span>
        <h5>@_f.tra("Plocha je zatím prázdná")</h5>
        <p>@_f.tra("Vložte widgety, které chcete mít po ruce – přehledy, grafy, tabulky. Rozložení si pak upravíte přetažením.")</p>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_widgets"><span class="material-icons-outlined-btn">add</span> @_f.tra("Vložit widget")</button>
    </div>
}

<div id="@(Model.IsSubform ? "container_subform" : "container_index")" class="row wd-board wd-cols-@(Model.ColumnsPerPage)">
    <div class="column @Model.BoxColCss" id="col1">
        @foreach (var c in Model.DockStructure.Col1) { RenderBox(c); }
    </div>
    @if (Model.ColumnsPerPage > 1)
    {
        <div class="column @Model.BoxColCss" id="col2">
            @foreach (var c in Model.DockStructure.Col2) { RenderBox(c); }
        </div>
    }
    @if (Model.ColumnsPerPage > 2)
    {
        <div class="column @Model.BoxColCss" id="col3">
            @foreach (var c in Model.DockStructure.Col3) { RenderBox(c); }
        </div>
    }
</div>


@* ------------------------------------------------------------ galerie widgetů *@
<div class="offcanvas offcanvas-end wd-gallery" tabindex="-1" data-bs-scroll="true" id="offcanvas_widgets">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">@_f.tra("Vložit widget na plochu")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <input type="search" id="wd_search" class="form-control form-control-sm mb-2" placeholder="@_f.tra("Hledat widget…")" autocomplete="off" />
        <ul id="rp1_menu" class="wd-gallery-list">
            @foreach (var c in Model.lisAllWidgets)
            {
                @if (c.Rezerva != null)
                {
                    <li class="wd-cat">@(c.Rezerva)</li>
                }
                bool _on = _userIds.Contains(c.pid);
                <li class="wd-item @(_on ? "wd-on" : "")" data-name="@c.x55Name.ToLower()">
                    <span class="material-icons-outlined-nosize wd-kind">@(c.IsAiWidget ? "auto_awesome" : (c.x55ChartType != null ? "bar_chart" : (c.x55TableSql != null ? "table_chart" : "widgets")))</span>
                    @if (_on)
                    {
                        <span class="wd-item-name">@c.x55Name</span>
                        <span class="wd-item-on">@_f.tra("Na ploše")</span>
                    }
                    else
                    {
                        <a class="wd-item-name" href="javascript:handle_insert_snippet(@c.pid)">@c.x55Name</a>
                        <a class="wd-item-add" href="javascript:handle_insert_snippet(@c.pid)" title="@_f.tra("Vložit")"><span class="material-icons-outlined-nosize">add_circle_outline</span></a>
                    }
                    @if (c.IsPersonal)
                    {
                        <a class="wd-item-del" href="javascript:void(0)" title="@_f.tra("Smazat widget")" data-confirm="✕?" onclick="wd_confirm(this, function () { aiw_delete(@c.pid); })"><span class="material-icons-outlined-nosize">delete_outline</span></a>
                    }
                </li>
            }
        </ul>
    </div>
</div>


@* ------------------------------------------------------------ rychlá úprava AI widgetu (bez AI) *@
<div class="offcanvas offcanvas-end wd-settings" tabindex="-1" data-bs-scroll="true" id="offcanvas_aiedit">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">@_f.tra("Upravit AI widget")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <input type="hidden" id="aiw_edit_id" />
        <section class="wd-set">
            <h6>@_f.tra("Název")</h6>
            <input type="text" class="form-control form-control-sm" id="aiw_edit_name" maxlength="100" />
        </section>
        <section class="wd-set" id="aiw_edit_period_box">
            <h6>@_f.tra("Období")</h6>
            <select class="form-select form-select-sm" id="aiw_edit_period"></select>
            <small class="text-muted">@_f.tra("Pojmenované období se počítá vždy k dnešku (tento měsíc, letos…). Pevné období zůstává stejné.")</small>
        </section>
        <section class="wd-set">
            <h6>@_f.tra("Počet řádků")</h6>
            <select class="form-select form-select-sm" id="aiw_edit_limit" style="width:auto;"></select>
        </section>
        <section class="wd-set">
            <button type="button" class="btn btn-primary btn-sm" onclick="aiw_edit_save()">@_f.tra("Uložit")</button>
            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="offcanvas">@_f.tra("Zrušit")</button>
        </section>
        <section class="wd-set" id="aiw_edit_ask_box">
            <h6>@_f.tra("Změnit obsah – sloupce, filtry, seskupení")</h6>
            <a class="btn btn-sm bog" id="aiw_edit_ask"><span class="material-icons-outlined-btn">auto_awesome</span> @_f.tra("Upravit v Zeptej se MARKTIME")</a>
        </section>
    </div>
</div>


@* ------------------------------------------------------------ nastavení plochy *@
<div class="offcanvas offcanvas-end wd-settings" tabindex="-1" data-bs-scroll="true" data-bs-backdrop="true" data-bs-keyboard="true" id="offcanvas_more">

    <div class="offcanvas-header">
        <h5 class="offcanvas-title">@_f.tra("Nastavení plochy")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body" id="offcanvas_more_body">

        <section class="wd-set">
            <h6>@_f.tra("Počet sloupců na ploše")</h6>
            <div class="wd-seg">
                <input type="radio" class="btn-check" id="opgCols1" asp-for="ColumnsPerPage" value="1" onchange="handle_pocet_sloupcu(this)" />
                <label class="btn btn-sm btn-outline-secondary" for="opgCols1">1</label>
                <input type="radio" class="btn-check" id="opgCols2" asp-for="ColumnsPerPage" value="2" onchange="handle_pocet_sloupcu(this)" />
                <label class="btn btn-sm btn-outline-secondary" for="opgCols2">2</label>
                <input type="radio" class="btn-check" id="opgCols3" asp-for="ColumnsPerPage" value="3" onchange="handle_pocet_sloupcu(this)" />
                <label class="btn btn-sm btn-outline-secondary" for="opgCols3">3</label>
            </div>
        </section>

        @if (Model.RecX54.x54IsAllowSkins)
        {
            <section class="wd-set">
                <h6>@_f.tra("Pracovat na ploše")</h6>
                <select class="form-select form-select-sm" id="wd_skin" onchange="handle_change_skin(this)">
                    @foreach (var sk in _skinNames)
                    {
                        <option value="@sk.Key" selected="@(Model.Skin == sk.Key)">@sk.Value</option>
                    }
                </select>
                <small class="text-muted">@_f.tra("Každá plocha má vlastní sadu a rozložení widgetů.")</small>
            </section>
        }

        @if (Model.RecX54.x54IsAllowAutoRefresh)
        {
            <section class="wd-set">
                <h6>@_f.tra("Automaticky obnovovat widgety")</h6>
                <select class="form-select form-select-sm" id="wd_autorefresh" onchange="handle_autorefresh(this)">
                    <option value="0" selected="@(Model.PageAutoRefreshPerSeconds == 0)">@_f.tra("Bez auto-obnovování")</option>
                    <option value="30" selected="@(Model.PageAutoRefreshPerSeconds == 30)">@_f.tra("Po 30ti sekundách")</option>
                    <option value="60" selected="@(Model.PageAutoRefreshPerSeconds == 60)">@_f.tra("Po 60ti sekundách")</option>
                    <option value="300" selected="@(Model.PageAutoRefreshPerSeconds == 300)">@_f.tra("Po 5ti minutách")</option>
                    <option value="600" selected="@(Model.PageAutoRefreshPerSeconds == 600)">@_f.tra("Po 10ti minutách")</option>
                </select>
            </section>
        }

        <section class="wd-set">
            <h6>@_f.tra("Nastavit vzhled tabulek")</h6>
            @Html.EditorFor(m => _IsGrid, "~/Views/Shared/_TableLayoutDeisgner.cshtml")
        </section>

        <section class="wd-set">
            <h6>@_f.tra("Obnovit plochu")</h6>
            <button type="button" class="btn btn-sm bog wd-confirm" data-confirm="@_f.tra("Opravdu přepsat? Klikněte znovu")" onclick="wd_confirm(this, clear_to_factory_silent)">@_f.tra("Nahodit do výchozího továrního nastavení")</button>
        </section>

        @if (_f.CurrentUser.IsAdmin && !Model.IsAiGroup)
        {
            <section class="wd-set wd-admin">
                <h6><span class="material-icons-outlined-btn">settings</span> Admin</h6>
                <button id="cmdX54Admin" type="button" class="btn btn-sm bog" onclick="_window_open('/x54/Record?pid=@Model.SelectedX54ID')">@_f.tra("Skupina widgetů") <strong>@Model.RecX54.x54Name</strong></button>
                @if (!_f.CurrentUser.IsHostingModeTotalCloud)
                {
                    <button type="button" id="cmdGlobalColumns" class="btn btn-sm bog wd-confirm" data-confirm="@_f.tra("Výchozí pro všechny? Klikněte znovu")" onclick="wd_confirm(this, set_as_global_silent)">@_f.tra("Nastavit jako výchozí globální obsah")</button>
                }
                <button type="button" id="cmdUpdateAllUsers" class="btn btn-sm bog wd-confirm" data-confirm="@_f.tra("Přepsat všem? Klikněte znovu")" onclick="wd_confirm(this, update2allusers_silent)">@_f.tra("Přepsat obsah všem uživatelům")</button>
            </section>
        }
    </div>
</div>

<script type="text/javascript">
    //konfigurace plochy pro widgets.js (logika plochy je tam)
    window._wd = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        x54id = Model.SelectedX54ID,
        p28id = Model.SelectedP28ID,
        j02idme = Model.j02id_me,
        j02idsys = _f.CurrentUser.pid,
        skin = Model.Skin,
        cols = Model.ColumnsPerPage,
        autorefresh = Model.PageAutoRefreshPerSeconds,
        count = Model.lisUserWidgets.Count,
        txt = new
        {
            saved = _f.tra("Změna rozložení plochy uložena."),
            error = _f.tra("Chyba"),
            loadError = _f.tra("Obsah widgetu se nepodařilo načíst."),
            retry = _f.tra("Zkusit znovu"),
            globalSet = _f.tra("Plocha nastavena jako výchozí pro všechny uživatele."),
            allUpdated = _f.tra("Obsah plochy přepsán všem uživatelům."),
            fixedPeriod = _f.tra("Pevné"),
            print = _f.tra("Tisk"),
            pdfPortrait = _f.tra("PDF (na výšku)"),
            pdfLandscape = _f.tra("PDF (na šířku)")
        }
    }));
</script>
<script src="~/js/widgets.js" asp-append-version="true"></script>
