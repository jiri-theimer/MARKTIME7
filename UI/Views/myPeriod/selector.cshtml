@model UI.Views.Shared.Components.myPeriod.myPeriodViewModel
@inject BL.Singleton.ThePeriodProvider _pp
@inject BL.Factory _f
@{
    Layout = null;


    var _lisPeriods = _pp.getPallete();
    if (_f.CurrentUser.j02LangIndex > 0)
    {
        foreach (BO.ThePeriod c in _lisPeriods)
        {
            c.PeriodName = _f.tra(c.PeriodName);

        }
    }

    var lisX21 = _f.FBL.GetListX21(_f.CurrentUser.pid);

    //mřížka: řádky = délka období, sloupce = minulost / současnost / budoucnost
    var _rows = new List<(string label, int[] past, int[] now, int[] future)>()
    {
        (_f.tra("Den"), new[] { 11 }, new[] { 10 }, new[] { 12 }),
        (_f.tra("Týden"), new[] { 21 }, new[] { 20 }, new[] { 22, 23, 24 }),
        (_f.tra("Měsíc"), new[] { 33, 31 }, new[] { 30 }, new[] { 32 }),
        (_f.tra("Kvartál"), new[] { 41 }, new[] { 40 }, new[] { 42 }),
        (_f.tra("Rok"), new[] { 51 }, new[] { 50 }, new[] { 52 }),
        (_f.tra("Souhrnně"), new[] { 34, 35, 36 }, new[] { 37 }, new int[] { })
    };
    var _used = _rows.SelectMany(r => r.past.Concat(r.now).Concat(r.future)).ToHashSet();
    var _others = _lisPeriods.Where(p => p.pid > 1 && p.pid <= 60 && !_used.Contains(p.pid)).ToList();   //případná další období z palety

    BO.ThePeriod P(int pid) => _lisPeriods.FirstOrDefault(p => p.pid == pid);
    string fieldtra(string s) => _f.tra(s);
}

@addTagHelper *, UI

@functions {
    //jedno období jako štítek: název + rozsah
    void chip(BO.ThePeriod c, int curvalue, string cls)
    {
        if (c == null) return;
        <button type="button" onclick="change_period(@c.pid)" class="mp-chip @cls @(c.pid == curvalue ? "active" : null)" title="@(c.d1 != null ? BO.Code.Bas.ObjectDate2String(c.d1, "d.M.yyyy") + " – " + BO.Code.Bas.ObjectDate2String(c.d2, "d.M.yyyy") : null)">
            <span class="mp-chip-name">@c.PeriodName</span>
            @if (!string.IsNullOrEmpty(c.PeriodInterval))
            {
                <span class="mp-chip-int">@c.PeriodInterval</span>
            }
        </button>
    }
}

<div id="myPeriodSelector" class="dynamicmenu_container mp-sel">

    <input type="hidden" asp-for="PeriodValue" />

    <div class="mp-top">
        @if (Model.prefix != null)
        {
            <label for="PeriodField" class="mp-top-lab">@_f.tra("Filtrovat podle")</label>
            <select id="PeriodField" asp-for="@Model.PeriodField" class="form-select form-select-sm mp-fieldsel">
                @switch (Model.prefix)
                {
                    case "p11":
                        <option value="p11Date">@fieldtra("Datum docházky")</option>
                        break;
                    case "b05":
                        <option value="b05DateInsert">@fieldtra("Čas záznamu")</option>
                        <option value="b05Date">@fieldtra("Datum")</option>
                        break;
                    case "j02":
                        <option value="p31Date">@fieldtra("Datum úkonu")</option>
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP vyúčtování")</option>
                        <option value="j02DateInsert">@fieldtra("Čas založení uživatele")</option>
                        break;
                    case "p31":
                        <option value="p31Date">@fieldtra("Datum úkonu")</option>
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP vyúčtování")</option>
                        <option value="p91DateBilled">@fieldtra("Úhrada vyúčtování")</option>
                        <option value="p31Approved_When">@fieldtra("Čas schválení úkonu")</option>
                        <option value="p31DateInsert">@fieldtra("Čas založení úkonu")</option>
                        break;
                    case "p28":
                        <option value="p31Date">@fieldtra("Datum úkonu")</option>
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP vyúčtování")</option>
                        <option value="p28DateInsert">@fieldtra("Čas založení kontaktu")</option>
                        break;
                    case "p41":
                    case "le1":
                    case "le2":
                    case "le3":
                    case "le4":
                    case "le5":
                        <option value="p31Date">@fieldtra("Datum úkonu")</option>
                        <option value="p41PlanFrom">@fieldtra("Plán zahájení")</option>
                        <option value="p41PlanUntil">@fieldtra("Plán dokončení")</option>
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP vyúčtování")</option>
                        <option value="p41DateInsert">@fieldtra("Čas založení projektu")</option>
                        break;
                    case "p56":
                        <option value="p31Date">@fieldtra("Datum úkonu")</option>
                        <option value="p56PlanFrom">@fieldtra("Plán zahájení úkolu")</option>
                        <option value="p56PlanUntil">@fieldtra("Plán dokončení úkolu")</option>
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP vyúčtování")</option>
                        <option value="p56DateInsert">@fieldtra("Čas založení úkolu")</option>
                        break;
                    case "o22":
                        <option value="o22PlanFrom">@fieldtra("Začátek")</option>
                        <option value="o22PlanUntil">@fieldtra("Konec")</option>
                        <option value="o22DateInsert">@fieldtra("Čas založení termínu")</option>
                        break;
                    case "p90":
                        <option value="p90Date">@fieldtra("Datum zálohy")</option>
                        <option value="p90DateMaturity">@fieldtra("Datum splatnosti")</option>
                        <option value="p90DateInsert">@fieldtra("Čas založení zálohy")</option>
                        break;
                    case "p91":
                        <option value="p91Date">@fieldtra("Datum vyúčtování")</option>
                        <option value="p91DateSupply">@fieldtra("Datum zdanitelného plnění")</option>
                        <option value="p91DateMaturity">@fieldtra("Datum splatnosti")</option>
                        <option value="p91DateInsert">@fieldtra("Čas vygenerování vyúčtování")</option>
                        break;
                    case "p84":
                        <option value="p84Date">@fieldtra("Datum upomínky")</option>
                        <option value="p91DateMaturity">@fieldtra("Splatnost faktury")</option>
                        <option value="p91DateSupply">@fieldtra("DUZP faktury")</option>
                        break;
                    case "p78":
                        <option value="p78Date">@fieldtra("Datum upomínky")</option>
                        break;
                    case "o23":
                        <option value="o23DateInsert">@fieldtra("Čas založení dokumentu")</option>
                        break;
                    case "p39":
                    case "p40":
                        <option value="p39Date">@fieldtra("Datum úkonu")</option>
                        <option value="p39DateCreate">@fieldtra("Datum generování")</option>
                        break;
                    case "o43":
                        <option value="o43DateMessage">@fieldtra("Datum zprávy")</option>
                        <option value="o43DateInsert">@fieldtra("Datum importu")</option>
                        break;
                    case "p49":
                    case "fp1":
                    case "fp2":
                    case "fp3":
                        <option value="p49Date">@fieldtra("Datum plánu")</option>
                        break;
                }
            </select>
        }
        <span class="mp-top-space"></span>
        @if (Model.PeriodValue > 0)
        {
            <button type="button" id="cmdClearPeriod" class="btn btn-sm btn-outline-danger"><span class="material-icons-outlined-nosize">filter_alt_off</span> @_f.tra("Nefiltrovat období")</button>
        }
    </div>

    <div class="mp-grid">
        <div class="mp-gh"></div>
        <div class="mp-gh mp-past">@_f.tra("Minulé")</div>
        <div class="mp-gh mp-now">@_f.tra("Aktuální")</div>
        <div class="mp-gh mp-future">@_f.tra("Budoucí")</div>

        @foreach (var r in _rows)
        {
            <div class="mp-rl">@r.label</div>
            <div class="mp-cell">@foreach (var pid in r.past) { chip(P(pid), Model.PeriodValue, "mp-past"); }</div>
            <div class="mp-cell">@foreach (var pid in r.now) { chip(P(pid), Model.PeriodValue, "mp-now"); }</div>
            <div class="mp-cell">@foreach (var pid in r.future) { chip(P(pid), Model.PeriodValue, "mp-future"); }</div>
        }
        @if (_others.Count > 0)
        {
            <div class="mp-rl">@_f.tra("Další")</div>
            <div class="mp-cell mp-span3">@foreach (var c in _others) { chip(c, Model.PeriodValue, c.OrdinaryIndex == 2 ? "mp-past" : (c.OrdinaryIndex == 10 ? "mp-future" : "mp-now")); }</div>
        }
    </div>

    <div class="mp-sec">
        <div class="mp-sec-h">@_f.tra("Vlastní rozsah")</div>
        <div class="mp-range-row @(Model.PeriodValue == 1 ? "active" : null)">
            <div id="div_d1helper" class="mp-date">
                <mydate asp-for="@Model.d1"></mydate>
            </div>
            <span class="mp-dash">–</span>
            <div id="div_d2helper" class="mp-date">
                <mydate asp-for="@Model.d2"></mydate>
            </div>
            <div id="div_cmdRefreshPeriod">
                <button type="button" id="cmdRefreshPeriod" class="btn btn-sm btn-success" title="@_f.tra("Použít rozsah")"><span class="material-icons-outlined-btn">check</span> @_f.tra("Použít")</button>
            </div>
        </div>
    </div>

    <div class="mp-sec">
        <div class="mp-sec-h">@_f.tra("Moje období")</div>
        <div class="mp-cell">
            @foreach (var rec in lisX21)
            {
                <button type="button" onclick="change_period(@rec.pid)" class="mp-chip mp-user @(rec.pid == Model.PeriodValue ? "active" : null)">
                    <span class="mp-chip-name">@rec.x21Name</span>
                    <span class="mp-chip-int">@BO.Code.Bas.ObjectDate2String(rec.x21ValidFrom, "d.M.yyyy") – @BO.Code.Bas.ObjectDate2String(rec.x21ValidUntil, "d.M.yyyy")</span>
                </button>
            }
            <button type="button" class="btn btn-sm bog mp-add" onclick="customperiods()"><span class="material-icons-outlined-nosize">edit_calendar</span> @(lisX21.Any() ? _f.tra("Upravit moje období") : _f.tra("Přidat vlastní časová období"))</button>
        </div>
    </div>

</div>


<script type="text/javascript">
    _adjust_divheight_small_display("myPeriodSelector");

    $("#myPeriodSelector").on("click.bs.dropdown", function (e) {
        e.stopPropagation();                                    //click na dropdown oblast nemá zavírat dropdown div
    });

    var _userparamkey = "@(Model.UserParamKey)";

    $("#d1helper, #d2helper").on("change", function () {   //změna data = vlastní rozsah, tlačítko Použít zvýraznit
        $("#PeriodValue").val("1");
        $("#cmdRefreshPeriod").addClass("mp-pending");
    })



    $("#PeriodValue").on("change", function () {
        if ($(this).val() == "1") {
            $("#cmdRefreshPeriod").addClass("mp-pending");
            handle_showhide();
            return;
        }
        $.post("/Common/SetUserParam", { key: _userparamkey + "-value", value: $(this).val() }, function (data) {
            _loading_show();
            location.reload(location.href);
        });
    });
    $("#PeriodField").on("change", function () {
        $.post("/Common/SetUserParam", { key: _userparamkey + "-field", value: $(this).val() }, function (data) {
            if ($("#PeriodValue").val() != "0") {
                _loading_show();
                location.reload(location.href);
            }

        });
    });

    $("#cmdClearPeriod").on("click", function () {
        $.post("/Common/SetUserParam", { key: _userparamkey + "-value", value: "0" }, function (data) {
            location.reload(location.href);
        });
    });

    $("#cmdRefreshPeriod").on("click", function () {
        if ($("#d1helper").val() == "" || $("#d2helper").val() == "") {
            _notify_message("@_f.tra("Chybí vyplnit datum.")");
            return;
        }
        $("#PeriodValue").val("1");
        var k = [];
        var v = [];
        k.push(_userparamkey + "-value");
        v.push($("#PeriodValue").val());
        k.push(_userparamkey + "-d1");
        v.push($("#d1helper").val());
        k.push(_userparamkey + "-d2");
        v.push($("#d2helper").val());

        $.post("/Common/SetUserParams", { keys: k, values: v }, function (data) {
            location.reload(location.href);

        });

    });

    //$("#PeriodValue").css("background-color", "#FFFFE0");

    handle_showhide();



    function handle_showhide() {
        //vlastní rozsah je vidět vždy (dřív se schovával, dokud nebylo zvoleno „Časové období ručně“)
    }

    function change_period(periodvalue)
    {
        $("#PeriodValue").val(periodvalue);
        if (periodvalue == "1") {
            $("#cmdRefreshPeriod").addClass("mp-pending");
            $("#d1helper").focus();
            return;
        }
        $.post("/Common/SetUserParam", { key: _userparamkey + "-value", value: periodvalue }, function (data) {
            location.reload(location.href);
        });
    }

    function customperiods() {
         
        try {
           
                _window_open("/myPeriod/UserPeriods",3);
            } catch (err)
            {
               
                window.open("/myPeriod/UserPeriods","_blank");
            }
    }

    

</script>