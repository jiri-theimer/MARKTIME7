@model UI.Models.Admin.AdminLogAsUser
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Přihlásit se pod identitou jiného uživatele");
    Layout = "~/Views/Shared/_LayoutModal.cshtml";
    Model.PageSymbol = "login";
}

@addTagHelper *, UI

@if (Model.Impersonator != null)
{
    <div class="bg-light" style="padding:10px;">
        <button type="button" onclick="_window_close()" class="btn btn-light">@_f.tra("Zavřít")</button>
    </div>
    <div class="modal_record_container">
        <div class="alert alert-warning">
            @(string.Format(_f.tra("Už pracujete pod identitou uživatele {0}. Než se přepnete jinam, vraťte se ke své identitě tlačítkem v pruhu dole na stránce."), _f.CurrentUser.FullNameAsc))
        </div>
    </div>
}
else
{
    <div class="bg-light" style="padding:10px;">
        <button id="cmdSave" type="button" class="btn btn-success">@_f.tra("Potvrdit")</button>
        <button type="button" onclick="_window_close()" class="btn btn-light">@_f.tra("Zavřít")</button>
    </div>
    <form id="form1" asp-controller="Admin" asp-action="LogAsUser" method="POST" autocomplete="off">
        <div class="modal_record_container">

            <div class="row">
                <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("Přepnout na login"):</label>
                <div class="col-sm-6 col-md-5">
                    <input id="txtLogin" class="form-control" asp-for="@Model.Login" autocomplete="off" />
                </div>
            </div>
            <div class="row my-2">
                <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("Vaše heslo"):</label>
                <div class="col-sm-6 col-md-5">
                    <input id="txtPwd" class="form-control" type="password" name="MyPassword" autocomplete="current-password" />
                </div>
            </div>
            <div class="row my-2">
                <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("API key"):</label>
                <div class="col-sm-6 col-md-5">
                    <input id="txtCode" class="form-control" type="password" name="SecurityCode" autocomplete="off" />
                </div>
            </div>

            <div style="color:#6c757d;font-size:90%;margin-top:10px;">
                @_f.tra("Přepnutí platí jednu hodinu a zapíše se do přihlašovacího logu u vás i u uživatele. Po dobu přepnutí je dole na stránce pruh s tlačítkem pro návrat k vaší identitě.")
            </div>
        </div>
    </form>

    <script type="text/javascript">
        $(document).ready(function () {
            $("#cmdSave").click(function () {
                $(this).attr("disabled", true);
                form1.submit();
            });
        });
    </script>
}
