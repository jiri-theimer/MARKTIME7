@model UI.Models.Record.p92Record
@inject BL.Factory _f

@{
    Model.PageTitle = _f.tra("Typ faktury");
    Layout = "~/Views/Shared/_LayoutRecord.cshtml";
    Model.PageSymbol = "settings";
}

@addTagHelper *, UI

@section header_content
{
    <link rel="stylesheet" href="~/css/recordform.css" asp-append-version="true" />
}

<div class="modal_record_container">

    <div class="row">
        <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Název pravidla"):</label>
        <div class="col-sm-9 col-md-8">
            <input class="form-control record_name" asp-for="Rec.p92Name" />
        </div>
        <label class="col-sm-1 col-md-1 col-form-label">@_f.tra("Index pořadí"):</label>
        <div class="col-sm-1 col-md-1">
            <mynumber asp-for="Rec.p92Ordinary" decimal-digits="0"></mynumber>
        </div>
    </div>
    <div>
        <input type="radio" id="p92InvoiceType1" asp-for="@Model.Rec.p92TypeFlag" value="ClientInvoice">
        <label for="p92InvoiceType1">@_f.tra("Klientská faktura")</label>
        <br />
        <input type="radio" id="p92InvoiceType2" asp-for="@Model.Rec.p92TypeFlag" value="CreditNote">
        <label for="p92InvoiceType2">@_f.tra("Opravný doklad (dobropis)")</label>
    </div>
    <div class="row my-2">
        <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Číselná řada faktury"):</label>
        <div class="col-sm-11 col-md-10">
            <mycombo entity="x38CodeLogic" asp-for="Rec.x38ID" selectedtext="@Model.ComboX38Name" myqueryinline="x38entity|string|p91"></mycombo>
        </div>

    </div>
    @if (Model.Rec.p92TypeFlag == BO.p92TypeFlagENUM.CreditNote)
    {
        <div class="row my-2">
            <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Aktivita dobropisované částky"):</label>
            <div class="col-sm-11 col-md-10">
                <mycombo entity="p32Activity" asp-for="Rec.p32ID_CreditNote" selectedtext="@Model.ComboP32Name" myqueryinline="ismoneyinput|bool|1"></mycombo>
            </div>

        </div>
    }
    <div class="row my-2">
        <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Výchozí měna faktury"):</label>
        <div class="col-sm-5 col-md-4">
            <mycombo entity="j27Currency" asp-for="Rec.j27ID" selectedtext="@Model.ComboJ27Code"></mycombo>
        </div>
        <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("Výchozí zaokrouhlovací pravidlo"):</label>
        <div class="col-sm-3 col-md-3">
            <mycombo entity="p98Invoice_Round_Setting_Template" asp-for="Rec.p98ID" selectedtext="@Model.ComboP98Name"></mycombo>
        </div>
    </div>
    <div class="row my-2">
        <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Vystavovatel faktury"):</label>
        <div class="col-sm-5 col-md-4">
            <mycombo entity="p93InvoiceHeader" asp-for="Rec.p93ID" selectedtext="@Model.ComboP93Name"></mycombo>
        </div>
        <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("Výchozí struktura cenového rozpisu"):</label>
        <div class="col-sm-3 col-md-3">
            <mycombo entity="p80InvoiceAmountStructure" asp-for="Rec.p80ID" selectedtext="@Model.ComboP80Name"></mycombo>
        </div>
    </div>
    <div class="row my-2">
        <label class="col-sm-1 col-md-2 col-form-label">@_f.tra("Typ upomínek"):</label>
        <div class="col-sm-5 col-md-4">
            <mycombo entity="p83TypUpominka" asp-for="Rec.p83ID" selectedtext="@Model.ComboP83Name"></mycombo>
        </div>
        <label class="col-sm-3 col-md-3 col-form-label">@_f.tra("Workflow šablona"):</label>
        <div class="col-sm-3 col-md-3">
            <mycombo entity="b01WorkflowTemplate" asp-for="Rec.b01ID" selectedtext="@Model.ComboB01" view-flag="2" myqueryinline="b01entity|string|p91"></mycombo>
        </div>
    </div>
  


    @if (Model.Rec.p92TypeFlag == BO.p92TypeFlagENUM.ClientInvoice)
    {
        <div class="card">
            <div class="card-header">
                @_f.tra("DPH režim faktury")
            </div>
            <div class="card-body">
                <div class="row">
                    <label class="col-form-label col-auto">@_f.tra("U všech fakturovaných úkonů nahodit DPH sazbu"):</label>
                    <div class="col-sm-3 col-md-3">
                        @Html.EditorFor(m => m.Rec.x15ID, "~/Views/Shared/_x15Combo.cshtml")

                    </div>

                </div>

            </div>
        </div>

    }

    <p></p>
    @Html.Raw("<div class='row'>")

    @Html.Raw("<div class='col-auto'>")

    <div class="card">
        <div class="card-header">
            @_f.tra("Výchozí Rozšíření karty vyúčtování")
        </div>
        <div class="card-body">
            <table>
               
                <tr>
                    <td>
                        <label>@_f.tra("Nahrávání příloh v kartě faktury"):</label>
                    </td>
                    <td>
                        @Html.EditorFor(m => m.Rec.p92FilesTab, "~/Views/Shared/_BitStreamFlag.cshtml")
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>@_f.tra("Role a oprávnění"):</label>
                    </td>
                    <td>
                        @Html.EditorFor(m => m.Rec.p92RolesTab, "~/Views/Shared/_BitStreamFlag.cshtml")
                    </td>
                </tr>


            </table>



        </div>
    </div>

    @Html.Raw("</div>")
    @Html.Raw("<div class='col-auto'>")
    <table>
        <tr>
            <td>
                @_f.tra("Výchozí sestava faktury"):
            </td>
            <td style="min-width:450px;">
                <mycombo entity="x31Report" asp-for="Rec.x31ID_Invoice" selectedtext="@Model.ComboX31_Report" myqueryinline="entity|string|p91"></mycombo>
            </td>
        </tr>
        <tr>
            <td>
                @_f.tra("Výchozí sestava přílohy faktury"):
            </td>
            <td style="min-width:450px;">
                <mycombo entity="x31Report" asp-for="Rec.x31ID_Attachment" selectedtext="@Model.ComboX31_Attachment" myqueryinline="entity|string|p91"></mycombo>
            </td>
        </tr>
        <tr>
            <td>
                @_f.tra("Výchozí průvodní dopis"):
            </td>
            <td style="min-width:450px;">
                <mycombo entity="x31Report" asp-for="Rec.x31ID_Letter" selectedtext="@Model.ComboX31_Letter" myqueryinline="entity|string|p91"></mycombo>
            </td>
        </tr>
        <tr>
            <td>
                @_f.tra("Šablona e-mail zprávy"):               
            </td>
            <td>
                <mycombo entity="j61TextTemplate" asp-for="Rec.j61ID" selectedtext="@Model.ComboJ61Name" myqueryinline="entity|string|p91"></mycombo>
            </td>
        </tr>
      
        <tr>
            <td>
                @_f.tra("Qr kód na faktuře"):
            </td>
            <td>
                <select class="form-select" asp-for="@Model.Rec.p92QrCodeFlag">
                    <option value="_None">--- Nezobrazovat qr kód ---</option>
                    <option value="QrPlatba">qr platba ČR</option>
                    <option value="QrFaktura">qr faktura ČR</option>
                    <option value="QrPlatbaBezSplatnosti">qr platba bez data splatnosti ČR</option>
                    <option value="QrFakturaBezSplatnosti">qr faktura bez data splatnosti ČR</option>
                    <option value="Slovensko">qr platba SK</option>
                    <option value="SlovenskoBezSplatnosti">qr platba SK bez data splatnosti</option>
                </select>
            </td>
        </tr>
        <tr>
            <td>
                @_f.tra("Název na sestavě faktury"):
            </td>
            <td>
                <input type="text" asp-for="Rec.p92RepDocName" class="form-control" />
            </td>
        </tr>
        <tr>
            <td>
                @_f.tra("Číslo na sestavě faktury"):
            </td>
            <td>
                <input type="text" asp-for="Rec.p92RepDocNumber" class="form-control" />
            </td>
        </tr>
    </table>


    @Html.Raw("</div>")
    @Html.Raw("</div>")




    @* Texty typu faktury: výchozí je prostý text; formátování přes Html editor (Views/Record/HtmlEditor.cshtml).
       Štítek HTML, náhled a „Zrušit formátování“ řídí _text_html_preview v mycontrols.js. *@
    <div class="rf-text my-3">
        <div class="rf-cardbar">
            <label for="Rec_p92ReportConstantPreText1" class="fw-semibold mb-0">@_f.tra("Preambule hlavního textu faktury")</label>
            <span class="rf-mode" id="Rec_p92ReportConstantPreText1-mode" data-title="@_f.tra("Text obsahuje HTML značky – na faktuře se vykreslí formátovaně. Náhled je pod polem.")"></span>
            <div class="rf-text-tools">
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" onclick="_html_editor(this,event,'Rec_p92ReportConstantPreText1',0)" title="@_f.tra("Formátovaný text (HTML) – jen pokud je potřeba")"><span class="material-icons-outlined-btn">code</span> @_f.tra("Html editor")</button>
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" id="Rec_p92ReportConstantPreText1-plaincmd" style="display:none;" onclick="_text_to_plain('Rec_p92ReportConstantPreText1')" title="@_f.tra("Odstraní HTML značky a ponechá jen text. Lze vrátit Ctrl+Z.")"><span class="material-icons-outlined-btn">format_clear</span> @_f.tra("Zrušit formátování")</button>
            </div>
        </div>
        <textarea class="form-control" asp-for="Rec.p92ReportConstantPreText1" rows="3" oninput="p92_text_changed(this)" onchange="_text_html_preview(this.id)"></textarea>
        <div class="rf-preview" id="Rec_p92ReportConstantPreText1-html" title="@_f.tra("Náhled HTML textu")"></div>
    </div>
    <div class="rf-text my-3">
        <div class="rf-cardbar">
            <label for="Rec_p92InvoiceDefaultText1" class="fw-semibold mb-0">@_f.tra("Výchozí hlavní text faktury")</label>
            <span class="rf-mode" id="Rec_p92InvoiceDefaultText1-mode" data-title="@_f.tra("Text obsahuje HTML značky – na faktuře se vykreslí formátovaně. Náhled je pod polem.")"></span>
            <div class="rf-text-tools">
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" onclick="_html_editor(this,event,'Rec_p92InvoiceDefaultText1',0)" title="@_f.tra("Formátovaný text (HTML) – jen pokud je potřeba")"><span class="material-icons-outlined-btn">code</span> @_f.tra("Html editor")</button>
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" id="Rec_p92InvoiceDefaultText1-plaincmd" style="display:none;" onclick="_text_to_plain('Rec_p92InvoiceDefaultText1')" title="@_f.tra("Odstraní HTML značky a ponechá jen text. Lze vrátit Ctrl+Z.")"><span class="material-icons-outlined-btn">format_clear</span> @_f.tra("Zrušit formátování")</button>
            </div>
        </div>
        <textarea class="form-control" asp-for="Rec.p92InvoiceDefaultText1" rows="3" oninput="p92_text_changed(this)" onchange="_text_html_preview(this.id)"></textarea>
        <div class="rf-preview" id="Rec_p92InvoiceDefaultText1-html" title="@_f.tra("Náhled HTML textu")"></div>
    </div>
    <div class="rf-text my-3">
        <div class="rf-cardbar">
            <label for="Rec_p92ReportConstantText" class="fw-semibold mb-0">@_f.tra("Preambule technického textu")</label>
            <span class="rf-mode" id="Rec_p92ReportConstantText-mode" data-title="@_f.tra("Text obsahuje HTML značky – na faktuře se vykreslí formátovaně. Náhled je pod polem.")"></span>
            <div class="rf-text-tools">
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" onclick="_html_editor(this,event,'Rec_p92ReportConstantText',0)" title="@_f.tra("Formátovaný text (HTML) – jen pokud je potřeba")"><span class="material-icons-outlined-btn">code</span> @_f.tra("Html editor")</button>
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" id="Rec_p92ReportConstantText-plaincmd" style="display:none;" onclick="_text_to_plain('Rec_p92ReportConstantText')" title="@_f.tra("Odstraní HTML značky a ponechá jen text. Lze vrátit Ctrl+Z.")"><span class="material-icons-outlined-btn">format_clear</span> @_f.tra("Zrušit formátování")</button>
            </div>
        </div>
        <textarea class="form-control" asp-for="Rec.p92ReportConstantText" rows="3" oninput="p92_text_changed(this)" onchange="_text_html_preview(this.id)"></textarea>
        <div class="rf-preview" id="Rec_p92ReportConstantText-html" title="@_f.tra("Náhled HTML textu")"></div>
    </div>
    <div class="rf-text my-3">
        <div class="rf-cardbar">
            <label for="Rec_p92InvoiceDefaultText2" class="fw-semibold mb-0">@_f.tra("Výchozí technický text")</label>
            <span class="rf-mode" id="Rec_p92InvoiceDefaultText2-mode" data-title="@_f.tra("Text obsahuje HTML značky – na faktuře se vykreslí formátovaně. Náhled je pod polem.")"></span>
            <div class="rf-text-tools">
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" onclick="_html_editor(this,event,'Rec_p92InvoiceDefaultText2',0)" title="@_f.tra("Formátovaný text (HTML) – jen pokud je potřeba")"><span class="material-icons-outlined-btn">code</span> @_f.tra("Html editor")</button>
                <button type="button" tabindex="-1" class="btn btn-sm btn-light" id="Rec_p92InvoiceDefaultText2-plaincmd" style="display:none;" onclick="_text_to_plain('Rec_p92InvoiceDefaultText2')" title="@_f.tra("Odstraní HTML značky a ponechá jen text. Lze vrátit Ctrl+Z.")"><span class="material-icons-outlined-btn">format_clear</span> @_f.tra("Zrušit formátování")</button>
            </div>
        </div>
        <textarea class="form-control" asp-for="Rec.p92InvoiceDefaultText2" rows="3" oninput="p92_text_changed(this)" onchange="_text_html_preview(this.id)"></textarea>
        <div class="rf-preview" id="Rec_p92InvoiceDefaultText2-html" title="@_f.tra("Náhled HTML textu")"></div>
    </div>


    
    
    
</div>



<script type="text/javascript">
    const _p92_texts = ["Rec_p92ReportConstantPreText1", "Rec_p92InvoiceDefaultText1", "Rec_p92ReportConstantText", "Rec_p92InvoiceDefaultText2"];
    function show_hide_html() {     //volá i Views/Record/HtmlEditor po uložení
        _p92_texts.forEach(function (id) { _text_html_preview(id); });
    }
    let _p92_text_timer = null;
    function p92_text_changed(ta) {
        clearTimeout(_p92_text_timer);
        _p92_text_timer = setTimeout(function () { _text_html_preview(ta.id); }, 400);
    }

    $(document).ready(function () {
        show_hide_html();

        $("#p92InvoiceType1").on("change", function () {
            _postback();
        });
        $("#p92InvoiceType2").on("change", function () {
            _postback();
        });


    });




</script>