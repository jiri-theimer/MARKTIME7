@model string
@{
    // Mezistránka doplňku pro Outlook (OutlookAddinController.ConnectStart, Go). Model = adresa, kam pokračovat.
    // Prohlížeč sem přišel z Outlooku (cizí web), a proto neposlal přihlašovací cookie MARKTIME (SameSite=Strict).
    // Přechod odsud už je požadavek z MARKTIME – cookie se pošle a přihlášený uživatel se nemusí hlásit znovu.
    Layout = null;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <title>MARKTIME</title>
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; margin: 0; padding: 32px 20px; color: #1f2937; text-align: center; }
        a { color: #1f5fbf; }
    </style>
</head>
<body>
    <p>MARKTIME…</p>
    <p><a id="cmdContinue" href="@Model">Pokračovat</a></p>
    <script>
        window.location.replace(document.getElementById("cmdContinue").href);
    </script>
</body>
</html>
